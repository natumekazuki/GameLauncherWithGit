@page "/login"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms
@attribute [AllowAnonymous]
@inject PlayRecordingWebView View

<main class="play-web-entry">
    <h1>プレイ中の記録</h1>
    <form method="post" action="@(new Uri(View.Origin, "/login"))">
        <AntiforgeryToken />
        <div class="play-web-field">
            <label for="code">PCに表示された接続コード</label>
            <input id="code" name="code" type="password" autocomplete="one-time-code"
                   minlength="32" maxlength="32" spellcheck="false" required
                   aria-invalid="@(InvalidCode ? "true" : null)"
                   aria-describedby="@(InvalidCode ? "play-web-code-error" : null)" />
        </div>
        <div class="play-web-actions">
            <button class="play-web-action play-web-action-primary" type="submit">接続</button>
            @if (InvalidCode)
            {
                <span id="play-web-code-error" class="play-web-sr-only" role="alert">接続コードが無効です。</span>
                <details class="play-web-error-details">
                    <summary class="play-web-action">コード無効</summary>
                    <p class="play-web-error-body">PCで接続コードを発行し直してください。</p>
                </details>
            }
        </div>
    </form>
</main>

@code {
    [SupplyParameterFromQuery(Name = "error")]
    public string? Error { get; set; }

    private bool InvalidCode => Error == "code";
}
