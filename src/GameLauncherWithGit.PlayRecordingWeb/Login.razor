@page "/login"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms
@attribute [AllowAnonymous]
@inject PlayRecordingWebView View

<main class="play-web-login">
    <h1>プレイ中の記録</h1>
    <form method="post" action="@(new Uri(View.Origin, "/login"))">
        <AntiforgeryToken />
        <label for="code">PCに表示された接続コード</label>
        <input id="code" name="code" type="password" autocomplete="one-time-code"
               minlength="32" maxlength="32" spellcheck="false" required />
        @if (Error == "code")
        {
            <p role="alert">接続コードが無効です。PCで接続コードを発行し直してください。</p>
        }
        <button type="submit">接続</button>
    </form>
</main>

@code {
    [SupplyParameterFromQuery(Name = "error")]
    public string? Error { get; set; }
}
