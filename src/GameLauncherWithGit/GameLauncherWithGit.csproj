<Project Sdk="Microsoft.NET.Sdk.Razor">

    <PropertyGroup>
        <TargetFrameworks>net9.0-android;net9.0-ios;net9.0-maccatalyst</TargetFrameworks>
        <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net9.0-windows10.0.19041.0</TargetFrameworks>
        <!-- Uncomment to also build the tizen app. You will need to install tizen by following this: https://github.com/Samsung/Tizen.NET -->
        <!-- <TargetFrameworks>$(TargetFrameworks);net9.0-tizen</TargetFrameworks> -->

        <!-- Note for MacCatalyst:
            The default runtime is maccatalyst-x64, except in Release config, in which case the default is maccatalyst-x64;maccatalyst-arm64.
            When specifying both architectures, use the plural <RuntimeIdentifiers> instead of the singular <RuntimeIdentifier>.
            The Mac App Store will NOT accept apps with ONLY maccatalyst-arm64 indicated;
            either BOTH runtimes must be indicated or ONLY macatalyst-x64. -->
        <!-- For example: <RuntimeIdentifiers>maccatalyst-x64;maccatalyst-arm64</RuntimeIdentifiers> -->

        <OutputType>Exe</OutputType>
        <RootNamespace>GameLauncherWithGit</RootNamespace>
        <UseMaui>true</UseMaui>
        <SingleProject>true</SingleProject>
        <ImplicitUsings>enable</ImplicitUsings>
        <EnableDefaultCssItems>false</EnableDefaultCssItems>
        <Nullable>enable</Nullable>

        <!-- Display name -->
        <ApplicationTitle>GameLauncherWithGit</ApplicationTitle>

        <!-- App Identifier -->
        <ApplicationId>com.monochromememory.gamelauncherwithgit</ApplicationId>

        <!-- Versions -->
        <ApplicationDisplayVersion>2.1.0</ApplicationDisplayVersion>
        <ApplicationVersion>25</ApplicationVersion>

        <!-- To develop, package, and publish an app to the Microsoft Store, see: https://aka.ms/MauiTemplateUnpackaged -->
        <WindowsPackageType>None</WindowsPackageType>
        <!-- Include .NET and the loopback hosts' ASP.NET runtime on Windows. -->
        <SelfContained Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">true</SelfContained>

        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
        <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'tizen'">6.5</SupportedOSPlatformVersion>
    </PropertyGroup>

    <ItemGroup>
        <!-- App Icon -->
        <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#0C1528" />

        <!-- Splash Screen -->
        <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#512BD4" BaseSize="128,128"
                          Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) != 'windows'" />

        <!-- Images -->
        <MauiImage Include="Resources\Images\*" />
        <MauiImage Update="Resources\Images\dotnet_bot.svg" BaseSize="168,208" />

        <!-- Custom Fonts -->
        <MauiFont Include="Resources\Fonts\*" />

        <!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
        <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
    </ItemGroup>

    <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
        <ProjectReference Include="..\GameLauncherWithGit.PlayRecordingWeb\GameLauncherWithGit.PlayRecordingWeb.csproj" />
        <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.4.0" />
        <EmbeddedResource Include="wwwroot\css\scenario-shared.css" LogicalName="PlayRecordingWeb.scenario-shared.css" />
        <None Include="Resources\TrayIcon\*.ico" CopyToOutputDirectory="PreserveNewest" Link="TrayIcon\%(Filename)%(Extension)" />
        <None Include="..\..\artifacts\luna-native\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Link="Luna\%(Filename)%(Extension)" />
        <None Include="..\..\LICENSE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Link="LICENSE.txt" />
    </ItemGroup>

    <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) != 'windows'">
        <Compile Remove="Infrastructure\Mcp\**\*.cs" />
        <Compile Remove="Infrastructure\PlayRecordingWeb\**\*.cs;Components\PlayRecording\**\*.cs" />
        <Content Remove="Components\PlayRecording\**\*.razor;Components\PlayRecording\**\*.razor.css" />
        <RazorComponent Remove="Components\PlayRecording\**\*.razor" />
        <None Remove="Components\PlayRecording\**\*.razor.css" />
    </ItemGroup>

    <!-- Ship only the generated scoped styles used by the Web UI, without exposing MAUI wwwroot. -->
    <Target Name="EmbedPlayRecordingWebScopedStyles" BeforeTargets="AssignTargetPaths"
            DependsOnTargets="_ProcessScopedCssFiles"
            Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows' and '$(DesignTimeBuild)' != 'true'">
        <ItemGroup>
            <EmbeddedResource Include="$(IntermediateOutputPath)scopedcss\Components\CaptureTagsEditor.razor.rz.scp.css"
                              LogicalName="PlayRecordingWeb.capture-tags.css" />
            <EmbeddedResource Include="$(IntermediateOutputPath)scopedcss\Components\ScenarioFlowView.razor.rz.scp.css"
                              LogicalName="PlayRecordingWeb.scenario-flow.css" />
            <EmbeddedResource Include="$(IntermediateOutputPath)scopedcss\Components\PlayRecording\PlayRecordingPanel.razor.rz.scp.css"
                              LogicalName="PlayRecordingWeb.play-recording-panel.css"
                              Condition="Exists('Components\PlayRecording\PlayRecordingPanel.razor.css')" />
        </ItemGroup>
    </Target>

    <ItemGroup>
        <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
        <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="$(MauiVersion)" />
        <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.0" />
        <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="9.0.9" />
        <PackageReference Include="SkiaSharp" Version="2.88.9" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\library\MonochromeMemory.Log\MonochromeMemory.Log\MonochromeMemory.Log.csproj" />
        <ProjectReference Include="..\..\library\MonochromeMemory.Log\MonochromeMemory.Log.Sinks.File\MonochromeMemory.Log.Sinks.File.csproj" />
    </ItemGroup>

    <Target Name="RequireLunaNativeBuild" BeforeTargets="PrepareForBuild" Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows' and '$(DesignTimeBuild)' != 'true'">
        <ItemGroup>
            <RequiredLunaFile Include="LunaHost32.dll;LunaHost64.dll;LunaHook32.dll;LunaHook64.dll;LunaInjector32.exe;LunaInjector64.exe;LunaTmpFontLoader.dll;LunaTranslator-LICENSE.txt;MinHook-LICENSE.txt;uchardet-COPYING.txt;uchardet-AUTHORS.txt;THIRD-PARTY-NOTICES.md" />
        </ItemGroup>
        <Error Condition="!Exists('$(MSBuildProjectDirectory)/../../artifacts/luna-native/%(RequiredLunaFile.Identity)')" Text="Native capture component missing: %(RequiredLunaFile.Identity). Run scripts/build-luna-native.ps1 first." />
    </Target>

</Project>
