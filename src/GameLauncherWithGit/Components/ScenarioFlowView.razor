@using GameLauncherWithGit.Application.Models

<section class="scenario-flow" aria-label="シナリオのフローチャート" data-flow-chart-id="@_chartId">
    @if (_nodes.Length == 0)
    {
        <p class="flow-empty">観測した経路はありません。</p>
    }
    else
    {
        <div class="flow-toolbar">
            <div class="flow-chart-picker">
                <label for="@_chartSelectId">フローチャート</label>
                <select id="@_chartSelectId" class="scenario-focus" @bind="_chartId" @bind:after="ChangeChart">
                    @for (var i = 0; i < Graph.Charts.Count; i++)
                    {
                        var chart = Graph.Charts[i];
                        <option value="@chart.Id">フローチャート @(i + 1) · @chart.NodeIds.Count 区間</option>
                    }
                </select>
            </div>
            <div class="flow-zoom" role="group" aria-label="フローの倍率">
                <button type="button" class="scenario-action" @onclick="Fit" aria-pressed="@(_fit ? "true" : "false")">全体表示</button>
                <button type="button" class="scenario-action flow-zoom-step" @onclick="ZoomOut" disabled="@(_fit || _zoomIndex == 0)" aria-label="縮小">−</button>
                <output aria-live="polite">@(_fit ? "全体" : $"{Zoom}%")</output>
                <button type="button" class="scenario-action flow-zoom-step" @onclick="ZoomIn" disabled="@(!_fit && _zoomIndex == ZoomLevels.Length - 1)" aria-label="拡大"><CaptureIcon Name="Plus" /></button>
            </div>
            <span class="flow-matching" role="status">@(MatchingComplete ? "照合済み" : "照合途中")</span>
        </div>
        <div class="flow-workarea">
            <div @key="_viewportRevision" class="flow-viewport @(_fit ? "flow-viewport-fit" : "") scenario-focus" tabindex="0" role="region" aria-label="観測した経路">
                <svg class="flow-surface" width="@Scaled(_canvasWidth)" height="@Scaled(_canvasHeight)" viewBox="@($"0 0 {_canvasWidth} {_canvasHeight}")" preserveAspectRatio="xMidYMin meet">
                    <defs>
                        <marker id="@_arrowId" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto">
                            <path class="flow-arrow" d="M 0 0 L 10 5 L 0 10 z" />
                        </marker>
                    </defs>
                    <g aria-hidden="true">
                        @foreach (var edge in _edges)
                        {
                            <path class="flow-edge @(edge.Revisit ? "flow-edge-revisit" : "")" d="@edge.Path" marker-end="@($"url(#{_arrowId})")"
                                  data-flow-from="@edge.Edge.FromId" data-flow-to="@edge.Edge.ToId" />
                        }
                    </g>
                    @foreach (var node in _nodes)
                    {
                        var position = _positions[node.Id];
                        <foreignObject @key="node.Id" x="@(position.X - FocusInset)" y="@(position.Y - FocusInset)"
                                       width="@(NodeWidth + FocusInset * 2)" height="@(NodeHeight + FocusInset * 2)">
                            <div class="flow-node-frame" xmlns="http://www.w3.org/1999/xhtml">
                                <button type="button" class="flow-node scenario-focus" data-flow-node-id="@node.Id"
                                        aria-pressed="@(_selected?.Id == node.Id ? "true" : "false")" @onclick="() => _selected = node">
                                    <span>@node.Name</span>
                                </button>
                            </div>
                        </foreignObject>
                    }
                </svg>
            </div>
            @if (_selected is { } selected && OpenRange.HasDelegate)
            {
                <div class="flow-selection" role="group" aria-label="選択した区間">
                    <strong id="@_selectedNameId">@selected.Name</strong>
                    <button type="button" class="scenario-action" data-flow-open-range="@selected.Id"
                            aria-describedby="@_selectedNameId" @onclick="() => OpenRange.InvokeAsync(selected)">区間の本文を見る</button>
                </div>
            }
        </div>
    }
</section>

@code {
    private const int NodeWidth = 220;
    private const int NodeHeight = 90;
    private const int FocusInset = 6;
    private const int RowStep = 160;
    private const int ColumnStep = 286;
    private const int Margin = 32;
    private const int DefaultZoom = 2;
    private static readonly int[] ZoomLevels = [50, 75, 100, 125, 150, 200];

    [Parameter, EditorRequired] public ScenarioRangeFlowGraph Graph { get; set; } = new([], [], []);
    [Parameter] public bool MatchingComplete { get; set; }
    [Parameter] public EventCallback<ScenarioRangeFlowNode> OpenRange { get; set; }

    private readonly string _arrowId = $"flow-arrow-{Guid.NewGuid():N}";
    private readonly string _selectedNameId = $"flow-range-{Guid.NewGuid():N}";
    private readonly string _chartSelectId = $"flow-chart-{Guid.NewGuid():N}";
    private ScenarioRangeFlowGraph? _laidOutGraph;
    private string? _chartId;
    private ScenarioRangeFlowNode? _selected;
    private ScenarioRangeFlowNode[] _nodes = [];
    private readonly Dictionary<string, (int X, int Y)> _positions = [];
    private readonly List<(ScenarioRangeFlowEdge Edge, string Path, bool Revisit)> _edges = [];
    private int _canvasWidth = 1, _canvasHeight = 1;
    private int _viewportRevision;
    private int _zoomIndex = DefaultZoom;
    private bool _fit;

    private int Zoom => ZoomLevels[_zoomIndex];
    private int Scaled(int size) => _fit ? size : (int)Math.Ceiling(size * Zoom / 100d);

    protected override void OnParametersSet()
    {
        if (ReferenceEquals(_laidOutGraph, Graph))
            return;

        _laidOutGraph = Graph;
        // A matching pass may regroup charts; the selected range ID still identifies the same node.
        var selectedId = _selected?.Id;
        if (selectedId is not null && !Graph.Charts.Any(chart => chart.Id == _chartId && chart.NodeIds.Contains(selectedId)))
            _chartId = Graph.Charts.FirstOrDefault(chart => chart.NodeIds.Contains(selectedId))?.Id ?? _chartId;
        Layout(selectedId);
    }

    private void ChangeChart()
    {
        _zoomIndex = DefaultZoom;
        _fit = false;
        _viewportRevision++;
        Layout(null);
    }

    private void Fit() => _fit = true;
    private void ZoomOut() => _zoomIndex = Math.Max(0, _zoomIndex - 1);
    private void ZoomIn()
    {
        _zoomIndex = _fit ? DefaultZoom : Math.Min(ZoomLevels.Length - 1, _zoomIndex + 1);
        _fit = false;
    }

    private void Layout(string? selectedId)
    {
        _positions.Clear();
        _edges.Clear();
        var chart = Graph.Charts.FirstOrDefault(c => c.Id == _chartId) ?? Graph.Charts.FirstOrDefault();
        _chartId = chart?.Id;
        var nodesById = Graph.Nodes.ToDictionary(node => node.Id);
        _nodes = chart?.NodeIds.Select(id => nodesById[id]).ToArray() ?? [];
        _selected = _nodes.FirstOrDefault(node => node.Id == selectedId) ?? _nodes.FirstOrDefault();
        if (_nodes.Length == 0)
            return;

        // Show only the provided relationships within this chart, never infer edges from names or positions.
        var order = _nodes.Select((node, i) => (node.Id, Index: i)).ToDictionary(x => x.Id, x => x.Index);
        var edges = Graph.Edges.Where(e => order.ContainsKey(e.FromId) && order.ContainsKey(e.ToId)).ToArray();

        var outgoing = edges.GroupBy(e => e.FromId).ToDictionary(g => g.Key, g => g.ToArray());
        var inputs = edges.Where(e => e.FromId != e.ToId).Select(e => e.ToId).ToHashSet();
        var returns = FindReturns(_nodes.OrderBy(node => inputs.Contains(node.Id)).Select(node => node.Id), outgoing);

        // Rank only the acyclic part so a merge stays below its forward inputs, even if it was
        // first observed on a shorter path. Cycles are represented by their return arrows.
        var levels = new int[_nodes.Length];
        var indegrees = new int[_nodes.Length];
        foreach (var edge in edges.Where(e => !returns.Contains(e)))
            indegrees[order[edge.ToId]]++;
        var queue = new Queue<string>(_nodes.Where(node => indegrees[order[node.Id]] == 0).Select(node => node.Id));
        while (queue.TryDequeue(out var id))
        {
            var from = order[id];
            foreach (var edge in outgoing.GetValueOrDefault(id) ?? [])
            {
                if (returns.Contains(edge))
                    continue;
                var to = order[edge.ToId];
                levels[to] = Math.Max(levels[to], levels[from] + 1);
                if (--indegrees[to] == 0)
                    queue.Enqueue(edge.ToId);
            }
        }

        var rows = _nodes.GroupBy(node => levels[order[node.Id]]).ToArray();
        var columns = rows.Max(r => r.Count());
        _canvasWidth = Margin * 2 + (columns - 1) * ColumnStep + NodeWidth;
        _canvasHeight = Margin * 2 + levels.Max() * RowStep + NodeHeight;
        foreach (var row in rows)
        {
            var left = Margin + (columns - row.Count()) * ColumnStep / 2;
            foreach (var node in row)
            {
                _positions.Add(node.Id, (left, Margin + row.Key * RowStep));
                left += ColumnStep;
            }
        }
        _nodes = rows.OrderBy(row => row.Key).SelectMany(row => row).ToArray();

        foreach (var edge in edges)
        {
            var from = _positions[edge.FromId];
            var to = _positions[edge.ToId];
            var revisit = returns.Contains(edge);
            var nearLeft = from.X + NodeWidth / 2 <= _canvasWidth / 2;
            var rail = revisit ? Margin / 4 : nearLeft ? Margin * 3 / 4 : _canvasWidth - Margin / 2;
            _edges.Add((edge, EdgePath(from, to, rail), revisit));
        }
    }

    private static HashSet<ScenarioRangeFlowEdge> FindReturns(IEnumerable<string> roots,
        Dictionary<string, ScenarioRangeFlowEdge[]> outgoing)
    {
        var visited = new HashSet<string>();
        var active = new HashSet<string>();
        var returns = new HashSet<ScenarioRangeFlowEdge>();
        var stack = new Stack<(string Id, int Next)>();
        foreach (var root in roots)
        {
            if (!visited.Add(root))
                continue;
            active.Add(root);
            stack.Push((root, 0));
            while (stack.TryPop(out var frame))
            {
                var edges = outgoing.GetValueOrDefault(frame.Id);
                if (edges is null || frame.Next == edges.Length)
                {
                    active.Remove(frame.Id);
                    continue;
                }

                stack.Push((frame.Id, frame.Next + 1));
                var edge = edges[frame.Next];
                if (active.Contains(edge.ToId))
                    returns.Add(edge);
                else if (visited.Add(edge.ToId))
                {
                    active.Add(edge.ToId);
                    stack.Push((edge.ToId, 0));
                }
            }
        }
        return returns;
    }

    private static string EdgePath((int X, int Y) from, (int X, int Y) to, int rail)
    {
        var start = (X: from.X + NodeWidth / 2, Y: from.Y + NodeHeight);
        var end = (X: to.X + NodeWidth / 2, Y: to.Y);
        if (from == to)
            return $"M {from.X + NodeWidth} {from.Y + 62} C {from.X + NodeWidth + 23} {from.Y + 62}, {from.X + NodeWidth + 23} {from.Y + 28}, {from.X + NodeWidth} {from.Y + 28}";
        if (to.Y - from.Y == RowStep)
            return $"M {start.X} {start.Y} C {start.X} {start.Y + 34}, {end.X} {end.Y - 34}, {end.X} {end.Y}";

        // Route shortcuts and returns around intervening cards. Use a separate port from the
        // adjacent-row path so the arrowheads at a merge do not cover each other.
        var fromPort = rail < start.X ? from.X + NodeWidth / 4 : from.X + NodeWidth * 3 / 4;
        var toPort = rail < end.X ? to.X + NodeWidth / 4 : to.X + NodeWidth * 3 / 4;
        var gutter = to.Y > from.Y ? 18 : 30;
        return $"M {fromPort} {start.Y} V {start.Y + gutter} H {rail} V {end.Y - gutter} H {toPort} V {end.Y}";
    }
}
