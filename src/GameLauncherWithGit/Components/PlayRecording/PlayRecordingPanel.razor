@using GameLauncherWithGit.Application.Services
@implements IAsyncDisposable

<div class="play-recording">
    <div class="play-shell">
        <header class="play-header">
            <h1>プレイ記録</h1>
            @if (!_unauthorized && _gameTitle is not null)
            {
                <div class="play-toolbar">
                    <h2>@_gameTitle</h2>
                    <span class="play-status" role="status">@(_statusError ? "状態未確認" : RecordingStatus)</span>
                </div>
            }
        </header>

        @if (_unauthorized)
        {
            <section class="play-panel play-stack" aria-label="接続許可">
                <div><CaptureFailureDetails Label="接続失効" Detail="この画面では接続を確認できません。ページを再読込してください。" Web="true" /></div>
                <div><button type="button" class="play-labeled-button" @onclick="ReloadPage"><CaptureIcon Name="Refresh" />ページを再読込</button></div>
            </section>
        }
        else if (_gameTitle is null)
        {
            @if (_statusError)
            {
                <div class="play-stack">
                    <div><CaptureFailureDetails Label="記録の取得失敗" Detail="記録対象を読み込めませんでした。再読込してください。" Web="true" /></div>
                    <div><button type="button" class="play-labeled-button" @onclick="RefreshAsync" disabled="@_busy"><CaptureIcon Name="Refresh" />再読込</button></div>
                </div>
            }
            else
            {
                <p role="status">記録対象を読み込み中…</p>
            }
        }
        else if (!HasUsableTarget && !_statusError)
        {
            <section class="play-panel play-stack" aria-label="記録操作">
                <p>PCで対象のゲームに戻ると、記録操作を再開できます。</p>
            </section>
        }
        else
        {
            <div class="play-workspace" data-play-recording-workspace aria-busy="@Bool(_busy)" @key="(_state?.Target, _displayedConnectionVersion)">
                <section class="play-controls play-stack" aria-label="プレイ中の操作">
                    <div class="play-panel play-stack">
                        <div class="play-control-heading">
                            <h2>記録操作</h2>
                            @if (_actionError is { } error && !_statusError)
                            {
                                <div class="play-control-result"><CaptureFailureDetails Label="@error.Label" Detail="@error.Detail" Web="true" /></div>
                            }
                            else if (_screenshotResult is { } shot && _state is { } state)
                            {
                                var target = ForDisplay(state.Target);
                                <div class="play-control-result">
                                    <span class="capture-failure-announcement" role="status">ゲーム画像を保存しました。</span>
                                    <button type="button" class="play-labeled-button" aria-label="撮影した本文・画像へ" disabled="@ControlsDisabled" @onclick="() => OpenCapturedEventAsync(target, shot)"><CaptureIcon Name="Image" />撮影結果</button>
                                </div>
                            }
                        </div>
                        @RecordingControls
                        @RangeControls
                    </div>
                    @if (_statusError)
                    {
                        <div><CaptureFailureDetails Label="記録の取得失敗" Detail="PCの記録状態を確認できません。再読込してください。" Web="true" /></div>
                        <div><button type="button" class="play-labeled-button" @onclick="RefreshAsync" disabled="@_busy"><CaptureIcon Name="Refresh" />再読込</button></div>
                    }
                </section>
                @if (!_statusError)
                {
                    <div class="play-body">
                        @if (_rangeDraft is not null) { @RangeEditor }
                        <nav class="play-nav" aria-label="記録内容">
                            <button type="button" aria-pressed="@Pressed(Pane.Text)" disabled="@_busy" @onclick="() => SelectPaneAsync(Pane.Text)">本文</button>
                            <button type="button" class="play-labeled-button" @ref="_rangesTab" aria-pressed="@Pressed(Pane.Ranges)" disabled="@_busy" @onclick="() => SelectPaneAsync(Pane.Ranges)"><CaptureIcon Name="Range" />区間</button>
                            <button type="button" class="play-labeled-button" aria-pressed="@Pressed(Pane.Paths)" disabled="@_busy" @onclick="() => SelectPaneAsync(Pane.Paths)"><CaptureIcon Name="Flow" />経路</button>
                            <button type="button" aria-pressed="@Pressed(Pane.Scenes)" disabled="@_busy" @onclick="() => SelectPaneAsync(Pane.Scenes)">場面</button>
                        </nav>
                        @switch (_pane)
                        {
                            case Pane.Text:
                                @TextPane
                                break;
                            case Pane.Ranges:
                                @RangesPane
                                break;
                            case Pane.Paths:
                                @PathsPane
                                break;
                            case Pane.Scenes:
                                @ScenesPane
                                break;
                        }
                    </div>
                }
            </div>
        }
    </div>
</div>

@code {
    private RenderFragment RecordingControls => @<div class="play-stack" aria-label="記録の制御">
        @if (_state is { } state)
        {
            var target = ForDisplay(state.Target);
            <div class="play-actions">
                @if (state.CanStart)
                {
                    <button type="button" class="primary play-labeled-button" disabled="@ControlsDisabled" @onclick="() => StartRecordingAsync(target)"><CaptureIcon Name="Play" />記録を開始</button>
                }
                @if (state.Paused)
                {
                    <button type="button" class="primary play-labeled-button" @ref="_resumeButton" aria-label="記録を再開" disabled="@ControlsDisabled" @onclick="() => ResumeRecordingAsync(target)"><CaptureIcon Name="Play" />再開</button>
                }
                else if (state.Recording)
                {
                    <button type="button" class="play-icon-button" @ref="_pauseButton" title="記録を一時停止" aria-label="記録を一時停止" disabled="@ControlsDisabled" @onclick="() => PauseRecordingAsync(target)"><CaptureIcon Name="Pause" /></button>
                    <button type="button" class="play-labeled-button" aria-label="ゲームを撮影" @ref="_screenshotButton" disabled="@(ControlsDisabled || !state.CanTakeScreenshot)" @onclick="() => TakeScreenshotAsync(target)"><CaptureIcon Name="Camera" />撮影</button>
                }
                @if (state.Recording || state.CanFinish)
                {
                    <button type="button" class="play-labeled-button" @ref="_finishButton" disabled="@ControlsDisabled" popovertarget="play-recording-tools" aria-haspopup="dialog"><CaptureIcon Name="Settings" />操作</button>
                    <section id="play-recording-tools" class="play-row-actions" popover="auto" role="dialog" aria-label="記録中のその他の操作">
                        <h3>記録中のその他の操作</h3>
                        <div class="play-actions">
                            @if (state.Recording && !state.Paused)
                            {
                                <button type="button" class="play-labeled-button" popovertarget="play-recording-tools" popovertargetaction="hide" disabled="@ControlsDisabled" @onclick="() => BreakLivePathAsync(target)"><CaptureIcon Name="PathBreak" />次の本文から別経路</button>
                            }
                            @if (state.CanFinish && !_confirmFinish)
                            {
                                <button type="button" class="play-labeled-button" popovertarget="play-recording-tools" popovertargetaction="hide" disabled="@ControlsDisabled" @onclick="OpenFinishConfirmation"><CaptureIcon Name="Stop" />記録を終了…</button>
                            }
                            <button type="button" popovertarget="play-recording-tools" popovertargetaction="hide">閉じる</button>
                        </div>
                    </section>
                }
            </div>
            @if (_confirmFinish && state.CanFinish)
            {
                <div class="play-stack play-selection" role="group" aria-label="記録終了の確認" @onkeydown="e => HandleEscape(e, CloseFinishConfirmation)">
                    <p @ref="_finishImpact" tabindex="-1">「@_gameTitle」の記録を終了します。@(state.RangeStart is not null || state.PendingRange is not null ? "保存していないプレイ中の区間は残りません。" : "")</p>
                    <div class="play-actions">
                        <button type="button" disabled="@ControlsDisabled" @onclick="CloseFinishConfirmation">取消</button>
                        <button type="button" class="play-labeled-button" disabled="@ControlsDisabled" @onclick="() => FinishRecordingAsync(target)"><CaptureIcon Name="Stop" />記録を終了</button>
                    </div>
                </div>
            }
        }
    </div>;

    private RenderFragment RangeControls => @<div class="play-stack" aria-label="プレイ中の区間">
        @if (_state is { } state)
        {
            var target = ForDisplay(state.Target);
            <div class="play-actions play-range-controls">
                @if (state.PendingRange is not null)
                {
                    <p class="play-status" role="status">区間の末尾を固定済み</p>
                }
                else if (state.RangeStart is not null)
                {
                    <button type="button" class="primary play-labeled-button" disabled="@(ControlsDisabled || !state.CanEndRange)" @onclick="() => EndRangeAsync(target)"><CaptureIcon Name="End" />末尾を固定</button>
                    <button type="button" class="play-icon-button" title="区間を取り消す" aria-label="区間を取り消す" disabled="@ControlsDisabled" @onclick="() => CancelRangeAsync(target)"><CaptureIcon Name="Close" /></button>
                    <p class="play-status" role="status" @ref="_rangeStatus" tabindex="-1">区間を記録中</p>
                }
                else if (state.Recording && !state.Paused)
                {
                    <button type="button" class="primary play-labeled-button" @ref="_startRangeButton" disabled="@(ControlsDisabled || !state.CanStartRange || _rangeDraft is not null)" @onclick="() => StartRangeAsync(target)"><CaptureIcon Name="Start" />区間を開始</button>
                }
            </div>
        }
    </div>;

    private RenderFragment RangeEditor => @<div>
        @if (_rangeDraft is { } draft)
        {
            <PlayRecordingRangeEditor @key="draft"
                AvailableTags="_rangeTags" SuggestedTags="_speakers" Disabled="ControlsDisabled" AutoFocus="draft.AutoFocus"
                Save="data => SaveRangeAsync(draft, data)"
                Cancel="() => CloseRangeEditorAsync(draft)" />
        }
    </div>;

    private RenderFragment TextPane => @<section class="play-panel play-stack" aria-labelledby="play-text-title">
        @{ var target = ForDisplay(_state!.Target); }
        <div class="play-toolbar play-text-toolbar">
            <h2 id="play-text-title" @ref="_textHeading" tabindex="-1">本文</h2>
            @if (_textError && _galleryItem is null)
            {
                <div class="play-text-failure"><CaptureFailureDetails Label="本文の取得失敗" Detail="本文を更新して再試行してください。" Web="true" /></div>
            }
            <div class="play-actions">
                <button type="button" aria-pressed="@Bool(_latest && _textRangeId is null)" disabled="@_busy" @onclick="ShowLatestAsync">直近</button>
                <button type="button" aria-pressed="@Bool(!_latest && _textRangeId is null)" disabled="@_busy" @onclick="ShowHistoryAsync">過去</button>
            </div>
        </div>
        @if (_textRangeId is { } rangeId)
        {
            <p>区間：@RangeName(rangeId)</p>
        }
        @if (_galleryItem is null)
        {
            <div class="play-actions">
                @if (_textRangeId is null && _textItems is { Count: > 0 })
                {
                    <button type="button" class="play-labeled-button" @ref="_pickRangeButton" aria-pressed="@Bool(_pickingRange)" disabled="@(_busy || _textError)" @onclick="ToggleRangePick"><CaptureIcon Name="Pick" />本文から区間を選ぶ</button>
                }
                <button type="button" class="play-icon-button" title="本文を更新" aria-label="本文を更新" disabled="@_busy" @onclick="RefreshTextAsync"><CaptureIcon Name="Refresh" /></button>
            </div>
        }
        @if (_pickingRange)
        {
            <div class="play-stack play-selection">
                <p title="@_first?.Text">開始：@(_first?.Text ?? "未選択")</p>
                <p title="@_last?.Text">終了：@(_last?.Text ?? "未選択")</p>
                <div class="play-actions">
                    <button type="button" class="play-labeled-button" disabled="@(_busy || !TextRangeValid || _rangeDraft is not null)" @onclick="() => PrepareTextRangeAsync(target)"><CaptureIcon Name="Save" />区間名を入力</button>
                    @if (_first is not null && _last is not null && !TextRangeValid)
                    {
                        <CaptureFailureDetails Label="区間指定エラー" Detail="開始より後の終了位置を選んでください。" Web="true" />
                    }
                </div>
            </div>
        }
        @if (_galleryItem is not null)
        {
            @Gallery
        }
        else if (_textItems is null)
        {
            @if (!_textError) { <p role="status">本文を読み込み中…</p> }
        }
        else if (_textItems.Count == 0)
        {
            @if (!_textError) { <p>本文はありません。</p> }
        }
        else
        {
            <ul class="play-list">
                @foreach (var item in _textItems)
                {
                    var rowActionsId = $"play-row-actions-{item.Id}";
                    <li class="play-item" @key="item.Id">
                        @if (_editItem?.Id == item.Id || _pickingRange)
                        {
                            <div class="play-row-content">
                                @if (!string.IsNullOrWhiteSpace(item.Speaker)) { <strong>@item.Speaker</strong> }
                                <p>@item.Text</p>
                            </div>
                        }
                        @if (_editItem?.Id == item.Id)
                        {
                            @TextEditor
                        }
                        else if (_pickingRange)
                        {
                            <div class="play-actions">
                                <button type="button" class="play-icon-button" title="ここから" aria-label="ここから" aria-pressed="@Bool(_first?.Id == item.Id)" disabled="@(_busy || _textError)" @onclick="() => PickRangeEdge(item, true)"><CaptureIcon Name="Start" /></button>
                                <button type="button" class="play-icon-button" title="ここまで" aria-label="ここまで" aria-pressed="@Bool(_last?.Id == item.Id)" disabled="@(_busy || _textError)" @onclick="() => PickRangeEdge(item, false)"><CaptureIcon Name="End" /></button>
                            </div>
                        }
                        else
                        {
                            <button type="button" class="play-row-content play-row-select" popovertarget="@rowActionsId" aria-haspopup="dialog" @ref="_rowButtons[item.Id].Open" disabled="@(_busy || _textError)">
                                @if (!string.IsNullOrWhiteSpace(item.Speaker)) { <strong>@item.Speaker</strong> }
                                <span>@item.Text</span>
                            </button>
                            <section id="@rowActionsId" class="play-row-actions" popover="auto" role="dialog" aria-label="この本文の操作">
                                <div class="play-stack">
                                    <h3>この本文の操作</h3>
                                    <p>@item.Text</p>
                                    <small><time datetime="@item.ReceivedAt.ToString("O")">@item.ReceivedAt.ToLocalTime().ToString("M/d HH:mm:ss")</time> · @ClassificationName(item.Kind)</small>
                                    <div class="play-actions">
                                        <button type="button" class="play-labeled-button" popovertarget="@rowActionsId" popovertargetaction="hide" autofocus disabled="@(_busy || _textError)" @onclick="() => OpenGalleryAsync(target, item)"><CaptureIcon Name="Image" />画像を見る</button>
                                        @if (_textRangeId is null)
                                        {
                                            <button type="button" class="play-labeled-button" popovertarget="@rowActionsId" popovertargetaction="hide" disabled="@(_busy || _textError)" @onclick="() => EditTextAsync(target, item)"><CaptureIcon Name="Edit" />話者・分類を訂正</button>
                                            <button type="button" class="play-labeled-button" popovertarget="@rowActionsId" popovertargetaction="hide" disabled="@(_busy || _textError)" @onclick="() => CutPathAsync(target, item)"><CaptureIcon Name="PathBreak" />ここから別経路</button>
                                        }
                                        <button type="button" popovertarget="@rowActionsId" popovertargetaction="hide">閉じる</button>
                                    </div>
                                </div>
                            </section>
                        }
                    </li>
                }
            </ul>
            @if (_nextBefore is not null || _olderPages.Count > 0)
            {
                <div class="play-actions" aria-label="本文のページ">
                    <button type="button" class="play-labeled-button" disabled="@(_busy || _textError || _olderPages.Count == 0)" @onclick="() => PageTextAsync(-1)"><CaptureIcon Name="Previous" />新しい本文</button>
                    <button type="button" class="play-labeled-button" disabled="@(_busy || _textError || _nextBefore is null)" @onclick="() => PageTextAsync(1)"><CaptureIcon Name="Next" />古い本文</button>
                </div>
            }
        }
    </section>;

    private RenderFragment TextEditor => @<div class="play-stack" @onkeydown="e => HandleEscape(e, CancelTextEdit)">
        @{ var target = ForDisplay(_state!.Target); var item = _editItem; }
        <label>分類
            <select @ref="_editClassification" @bind="_editLabel" disabled="@_busy">
                <option value="0">未判定</option>
                @foreach (var label in LabelChoices) { <option value="@label.Id">@ClassificationName(label.Kind, label.Name)</option> }
            </select>
        </label>
        <label>話者 <input @bind="_editSpeaker" @bind:event="oninput" disabled="@(_busy || EditingNarration)" /></label>
        <div class="play-actions">
            <button type="button" disabled="@_busy" @onclick="CancelTextEdit">取消</button>
            <button type="button" class="primary play-labeled-button" aria-label="訂正を保存" disabled="@(_busy || !TextLabelChanged(item) && !TextSpeakerChanged(item))" @onclick="() => SaveTextAsync(target, item)"><CaptureIcon Name="Save" />保存</button>
        </div>
    </div>;

    private RenderFragment Gallery => @<div class="play-stack" aria-label="本文の画像" @onkeydown="e => HandleEscape(e, ReturnFromGallery)">
        <div class="play-toolbar"><h3 @ref="_galleryHeading" tabindex="-1">本文の画像</h3><button type="button" class="play-icon-button" title="本文一覧へ戻る" aria-label="本文一覧へ戻る" disabled="@_busy" @onclick="ReturnFromGallery"><CaptureIcon Name="Back" /></button></div>
        @if (_galleryText is not null) { <p>@_galleryText</p> }
        @if (_galleryError)
        {
            <div><CaptureFailureDetails Label="画像の取得失敗" Detail="画像を読み込めませんでした。画像を再読込してください。" Web="true" /></div>
            <div><button type="button" class="play-labeled-button" @onclick="ReloadGalleryAsync" disabled="@_busy"><CaptureIcon Name="Refresh" />画像を再読込</button></div>
        }
        else if (_galleryCount == 0)
        {
            <p>この本文に画像はありません。</p>
        }
        else if (_galleryImage is { } image)
        {
            <figure class="play-gallery">
                <img @key="image" src="@image" alt="本文に対応するゲーム画面" @onerror="() => GalleryDecodeFailed(image)" />
                <figcaption>@(_galleryIndex + 1) / @_galleryCount</figcaption>
            </figure>
            @if (_galleryCount > 1)
            {
                <div class="play-actions">
                    <button type="button" class="play-icon-button" title="前の画像" aria-label="前の画像" disabled="@(_busy || _galleryIndex == 0)" @onclick="() => PageGalleryAsync(-1)"><CaptureIcon Name="Previous" /></button>
                    <button type="button" class="play-icon-button" title="次の画像" aria-label="次の画像" disabled="@(_busy || _galleryIndex + 1 >= _galleryCount)" @onclick="() => PageGalleryAsync(1)"><CaptureIcon Name="Next" /></button>
                </div>
            }
        }
        else
        {
            <p role="status">画像を読み込み中…</p>
        }
    </div>;

    private RenderFragment RangesPane => @<section class="play-panel play-stack" aria-labelledby="play-ranges-title">
        @{ var target = ForDisplay(_state!.Target); }
        <div class="play-toolbar"><h2 id="play-ranges-title">保存した区間</h2><button type="button" class="play-icon-button" title="区間を更新" aria-label="区間を更新" disabled="@_busy" @onclick="RefreshRangesAsync"><CaptureIcon Name="Refresh" /></button></div>
        @if (_rangesError)
        {
            <div><CaptureFailureDetails Label="区間の取得失敗" Detail="区間を読み込めませんでした。区間を更新してください。" Web="true" /></div>
        }
        else if (_ranges is null)
        {
            <p role="status">区間を読み込み中…</p>
        }
        else if (_ranges.Count == 0)
        {
            <p>保存した区間はありません。</p>
        }
        else
        {
            <ul class="play-list">
                @foreach (var range in _ranges)
                {
                    <li class="play-item" @key="range.Id">
                        <h3>@RangeName(range.Id)</h3>
                        @if (range.Tags.Length > 0) { <p>@string.Join(" · ", range.Tags)</p> }
                        <div class="play-actions">
                            <button type="button" class="play-labeled-button" disabled="@_busy" @onclick="() => OpenRangeAsync(target, range.Id)"><CaptureIcon Name="Next" />区間の本文へ</button>
                        </div>
                    </li>
                }
            </ul>
        }
    </section>;

    private RenderFragment PathsPane => @<section class="play-panel play-stack" aria-labelledby="play-paths-title">
        @{ var target = ForDisplay(_state!.Target); }
        <div class="play-toolbar"><h2 id="play-paths-title">観測した経路</h2><button type="button" class="play-icon-button" title="経路を更新" aria-label="経路を更新" disabled="@_busy" @onclick="RefreshPathsAsync"><CaptureIcon Name="Refresh" /></button></div>
        @if (_pathsError) { <div><CaptureFailureDetails Label="経路の取得失敗" Detail="経路を読み込めませんでした。経路を更新してください。" Web="true" /></div> }
        else if (_graph is null) { <p role="status">経路を読み込み中…</p> }
        else if (_graph.Occurrences.Count == 0) { <p>観測した経路はありません。</p> }
        else
        {
            <div inert="@_busy"><ScenarioFlowView Graph="_graph" MatchingComplete="_matchingComplete" OpenOccurrence="occurrence => OpenOccurrenceAsync(target, occurrence)" CutOccurrence="occurrence => CutOccurrenceAsync(target, occurrence)" /></div>
        }
    </section>;

    private RenderFragment ScenesPane => @<section class="play-panel play-stack" aria-labelledby="play-scenes-title">
        @{ var target = ForDisplay(_state!.Target); }
        <div class="play-toolbar"><h2 id="play-scenes-title">手動場面</h2><button type="button" class="play-icon-button" title="場面を更新" aria-label="場面を更新" disabled="@_busy" @onclick="RefreshScenesAsync"><CaptureIcon Name="Refresh" /></button></div>
        @if (_scenesError)
        {
            <div><CaptureFailureDetails Label="場面の取得失敗" Detail="場面を読み込めませんでした。場面を更新してください。" Web="true" /></div>
        }
        else if (_sceneFlow is null)
        {
            <p role="status">場面を読み込み中…</p>
        }
        else
        {
            <div class="play-actions">
                <button type="button" class="play-labeled-button" disabled="@_busy" @onclick="NewScene"><CaptureIcon Name="Plus" />場面を追加</button>
            </div>
            @if (_sceneFlow.Scenes.Count > 0)
            {
                <label>場面
                    <select value="@(_sceneDraft?.Id ?? 0)" @onchange="SelectScene" disabled="@_busy">
                        <option value="0">場面を選択</option>
                        @foreach (var scene in _sceneFlow.Scenes) { <option value="@scene.Id">@SceneName(scene.Definition)</option> }
                    </select>
                </label>
            }
            else if (_sceneDraft is null)
            {
                <p>手動場面はありません。</p>
            }
            @if (_sceneDraft is { } draft)
            {
                <section class="play-stack play-selection" @key="draft" aria-label="場面の編集">
                    <h3>@(draft.Id == 0 ? "新しい場面" : "選んだ場面")</h3>
                    <label>主ラベル <input @bind="draft.Title" @bind:event="oninput" disabled="@_busy" /></label>
                    <label>表示番号 <input @bind="draft.Number" @bind:event="oninput" disabled="@_busy" /></label>
                    <label>章見出し <input @bind="draft.Chapter" @bind:event="oninput" disabled="@_busy" /></label>
                    <CaptureTagsEditor Label="場面タグ" @bind-Tags="draft.Tags" AvailableTags="@SceneTags" AllowCreate="false" Disabled="_busy" />
                    <fieldset class="play-related" disabled="@_busy">
                        <legend>対応する区間</legend>
                        @if (_rangesError) { <CaptureFailureDetails Label="区間の取得失敗" Detail="対応する区間を読み込めませんでした。場面の更新から再試行してください。" Web="true" /> }
                        else if (_ranges is null) { <p role="status">区間を読み込み中…</p> }
                        else if (_ranges.Count > 0)
                        {
                            @foreach (var range in _ranges)
                            {
                                <label @key="range.Id"><input type="checkbox" checked="@draft.RangeIds.Contains(range.Id)" @onchange="e => SetSceneRange(draft, range.Id, e.Value is true)" /> @RangeName(range.Id)</label>
                            }
                        }
                        else { <p>保存した区間はありません。</p> }
                    </fieldset>
                    <div class="play-actions">
                        <button type="button" disabled="@_busy" @onclick="CancelScene">取消</button>
                        <button type="button" class="primary play-labeled-button" disabled="@(_busy || _rangesError || string.IsNullOrWhiteSpace(draft.Title))" @onclick="() => SaveSceneAsync(target, draft)"><CaptureIcon Name="Save" />場面を保存</button>
                    </div>
                </section>
                @if (draft.Id != 0)
                {
                    <section class="play-stack play-selection" aria-label="場面の有向接続">
                        <h3>場面の接続</h3>
                        @foreach (var edge in _sceneFlow.Connections.Where(x => x.ToSceneId == draft.Id))
                        {
                            <p>前：@SceneName(edge.FromSceneId) → @SceneName(draft.Id)</p>
                        }
                        @foreach (var edge in _sceneFlow.Connections.Where(x => x.FromSceneId == draft.Id))
                        {
                            <div class="play-toolbar">
                                <p>次：@SceneName(draft.Id) → @SceneName(edge.ToSceneId)</p>
                                <button type="button" class="play-icon-button" title="接続を削除" aria-label="@($"{SceneName(edge.ToSceneId)}への接続を削除")" disabled="@_busy" @onclick="() => SetSceneConnectionAsync(target, edge.FromSceneId, edge.ToSceneId, false)"><CaptureIcon Name="Close" /></button>
                            </div>
                        }
                        <label>次の場面
                            <select @bind="_connectionTarget" disabled="@_busy">
                                <option value="0">接続先を選択</option>
                                @foreach (var scene in _sceneFlow.Scenes) { <option value="@scene.Id">@SceneName(scene.Definition)</option> }
                            </select>
                        </label>
                        <div><button type="button" class="play-labeled-button" disabled="@(_busy || _connectionTarget == 0)" @onclick="() => SetSceneConnectionAsync(target, draft.Id, _connectionTarget, true)"><CaptureIcon Name="Plus" />接続を追加</button></div>
                    </section>
                }
            }
        }
    </section>;
}
