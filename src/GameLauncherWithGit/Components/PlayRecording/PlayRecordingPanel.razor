@using GameLauncherWithGit.Application.Services
@implements IAsyncDisposable

<div class="play-recording">
    <div class="play-shell" data-play-recording-workspace @key="_shellKey">
        <header class="play-header">
            @if (!_statusError && _state is { } current)
            {
                <div class="play-toolbar">
                    <h1>@current.Title</h1>
                    <span class="play-record-root">記録先：@current.RecordingDestinationLabel</span>
                </div>
            }
            else
            {
                <h1>プレイ記録</h1>
            }
        </header>

        @if (_statusError)
        {
            <div class="play-panel play-stack">
                <div><CaptureFailureDetails Label="記録の取得失敗" Detail="記録対象を読み込めませんでした。再読込してください。" Web="true" /></div>
                <div><button type="button" class="scenario-action play-labeled-button" @onclick="RefreshAsync" disabled="@_busy"><CaptureIcon Name="Refresh" />再読込</button></div>
            </div>
        }
        @if (_state is not { } displayed)
        {
            if (!_statusError && _statusLoading)
            {
                <ScenarioLoading Label="記録対象を読み込み中…" />
            }
            else if (!_statusError && _statusLoaded)
            {
                <p role="status">PCのプレイ対象を待っています。</p>
            }
        }
        else
        {
            var workspaceTarget = ForDisplay(displayed);
            <div class="play-workspace" hidden="@_statusError" aria-busy="@Bool(_busy)">
                <section class="play-controls play-stack" aria-label="プレイ中の操作">
                    <div class="play-panel play-stack">
                        <div class="play-control-heading">
                            <h2>記録操作</h2>
                            @if (_actionError is { } error)
                            {
                                <div class="play-control-result"><CaptureFailureDetails Label="@error.Label" Detail="@error.Detail" Web="true" /></div>
                            }
                            else if (_screenshotResult is { } shot)
                            {
                                <div class="play-control-result">
                                    <span class="capture-failure-announcement" role="status">ゲーム画像を保存しました。</span>
                                    <button type="button" class="scenario-action play-labeled-button" aria-label="撮影した本文・画像へ" disabled="@ControlsDisabled" @onclick="() => OpenCapturedEventAsync(workspaceTarget, shot)"><CaptureIcon Name="Image" />撮影結果</button>
                                </div>
                            }
                            else if (_actionSuccess is { } success)
                            {
                                <span class="play-control-result play-status" role="status">@success</span>
                            }
                        </div>
                        @RecordingControls
                        @RangeControls
                    </div>
                </section>
                <div class="play-body">
                    @if (_rangeDraft is not null) { @RangeEditor }
                    @if (_finishConfirmation is { } confirmation && displayed.CanFinish) { @FinishPrompt(workspaceTarget, displayed, confirmation) }
                    @{ var overlay = _rangeDraft?.Open == true || _finishConfirmation is not null; }
                    <div class="play-nav-line" inert="@overlay">
                        <nav class="play-nav" aria-label="記録内容">
                            <button type="button" class="scenario-action" aria-pressed="@Pressed(Pane.Text)" disabled="@_busy" @onclick="() => SelectPaneAsync(workspaceTarget, Pane.Text)">本文</button>
                            <button type="button" class="scenario-action play-labeled-button" aria-pressed="@Pressed(Pane.Paths)" disabled="@_busy" @onclick="() => SelectPaneAsync(workspaceTarget, Pane.Paths)"><CaptureIcon Name="Flow" />フロー</button>
                        </nav>
                        @if (_pane == Pane.Text)
                        {
                            <button type="button" class="scenario-action" disabled="@(_busy || _latest && _textRangeId is null)" @onclick="() => FollowLatestAsync(workspaceTarget)">最新へ</button>
                        }
                    </div>
                    <div class="play-view" hidden="@(_pane != Pane.Text)" inert="@overlay">
                        @TextPane
                    </div>
                    <div class="play-view" hidden="@(_pane != Pane.Paths)" inert="@overlay">
                        @if (_pane == Pane.Paths || _graph is not null) { @PathsPane }
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@code {
    private RenderFragment RecordingControls => @<div class="play-stack" aria-label="記録の制御">
        @if (_state is { } state)
        {
            var target = ForDisplay(state);
            <ScenarioRecordingBar @ref="_recordingBar" State="@RecordingDisplay" ShowControls="state.CanFinish"
                                  CanTogglePause="state.CanFinish" CanBreakPath="@(state.Recording && !state.Paused)" Disabled="ControlsDisabled"
                                  TogglePause="() => state.Paused ? ResumeRecordingAsync(target) : PauseRecordingAsync(target)"
                                  BreakPath="() => BreakLivePathAsync(target)">
                <div class="play-actions play-device-actions">
                    @if (state.CanStart)
                    {
                        <button type="button" class="scenario-action scenario-action--primary play-labeled-button" disabled="@ControlsDisabled" @onclick="() => StartRecordingAsync(target)"><CaptureIcon Name="Play" />記録を開始</button>
                    }
                    else if (RecordingDisplay == ScenarioRecordingDisplay.Unconfigured)
                    {
                        <p>PCで記録の準備をしてください。</p>
                    }
                    @if (state.CanFinish)
                    {
                        <button type="button" class="scenario-action scenario-action--primary play-labeled-button play-camera" aria-label="ゲームを撮影" @ref="_screenshotButton"
                                disabled="@(ControlsDisabled || !state.CanTakeScreenshot)" @onclick="() => TakeScreenshotAsync(target)"><CaptureIcon Name="Camera" />撮影</button>
                        <button type="button" class="scenario-action play-labeled-button" @ref="_finishButton" disabled="@ControlsDisabled" popovertarget="play-recording-tools" aria-haspopup="dialog"><CaptureIcon Name="Settings" />その他</button>
                        <section id="play-recording-tools" class="play-row-actions" popover="auto" role="dialog" aria-label="記録のその他の操作">
                            <h3>記録のその他の操作</h3>
                            <div class="play-actions">
                                <button type="button" class="scenario-action play-labeled-button" popovertarget="play-recording-tools" popovertargetaction="hide" disabled="@ControlsDisabled" @onclick="() => OpenFinishConfirmation(target, state)"><CaptureIcon Name="Stop" />記録を終了…</button>
                                <button type="button" class="scenario-action" popovertarget="play-recording-tools" popovertargetaction="hide">閉じる</button>
                            </div>
                        </section>
                    }
                </div>
            </ScenarioRecordingBar>
        }
    </div>;

    private RenderFragment FinishPrompt(DisplayTarget target, PlayRecordingState state, FinishConfirmation confirmation) => @<div class="play-draft-layer">
        <div class="play-panel play-stack" role="group" aria-label="記録終了の確認" @onkeydown="e => HandleEscape(target, e, CloseFinishConfirmation)">
            <p class="play-finish-impact" @ref="_finishImpact" tabindex="-1">「@confirmation.Title」の記録を終了します。@(confirmation.HasUnsavedRange ? "未保存の区間があります。" : "")</p>
            <div class="play-actions">
                @if (confirmation.HasUnsavedRange)
                {
                    <button type="button" class="scenario-action scenario-action--primary" disabled="@(ControlsDisabled || (_rangeDraft is null && state.PendingRange is null && !state.CanEndRange))" @onclick="() => OpenFinishSaveAsync(target, confirmation)">保存して終了</button>
                }
                <button type="button" class="scenario-action play-labeled-button" disabled="@ControlsDisabled" @onclick="() => FinishRecordingAsync(target, confirmation)"><CaptureIcon Name="Stop" />@(confirmation.HasUnsavedRange ? "破棄して終了" : "記録を終了")</button>
                <button type="button" class="scenario-action" disabled="@ControlsDisabled" @onclick="() => EditWorkspace(target, CloseFinishConfirmation)">戻る</button>
            </div>
        </div>
    </div>;

    private RenderFragment RangeControls => @<div class="play-stack" aria-label="プレイ中の区間">
        @if (_state is { } state)
        {
            var target = ForDisplay(state);
            <div class="play-actions play-range-controls">
                @if (_rangeDraft is { Open: false } draft)
                {
                    <button type="button" class="scenario-action play-labeled-button" @ref="_rangeDraftButton" disabled="@ControlsDisabled" @onclick="() => OpenRangeEditor(target, draft)"><CaptureIcon Name="Range" />区間草稿を開く</button>
                }
                @if (state.PendingRange is not null)
                {
                    <p class="play-status" role="status">区間の末尾を固定済み</p>
                }
                else if (state.RangeStart is not null)
                {
                    <button type="button" class="scenario-action play-labeled-button" disabled="@(ControlsDisabled || !state.CanEndRange)" @onclick="() => EndRangeAsync(target)"><CaptureIcon Name="End" />末尾を固定</button>
                    <button type="button" class="scenario-action play-icon-button" title="区間を取り消す" aria-label="区間を取り消す" disabled="@ControlsDisabled" @onclick="() => CancelRangeAsync(target)"><CaptureIcon Name="Close" /></button>
                    <p class="play-status" role="status" @ref="_rangeStatus" tabindex="-1">区間を記録中</p>
                }
                else if (state.Recording && !state.Paused)
                {
                    <button type="button" class="scenario-action play-labeled-button" @ref="_startRangeButton" disabled="@(ControlsDisabled || !state.CanStartRange || _rangeDraft is not null)" @onclick="() => StartRangeAsync(target)"><CaptureIcon Name="Start" />区間を開始</button>
                }
            </div>
        }
    </div>;

    private RenderFragment RangeEditor => @<div class="play-draft-layer" hidden="@(_rangeDraft?.Open != true || _finishConfirmation is not null)">
        @if (_rangeDraft is { } draft)
        {
            var target = ForDisplay(_state!);
            <section class="range-editor" @key="draft" hidden="@(!draft.Open)" aria-label="区間名とタグ">
                <h3 @ref="_rangeEditorHeading" tabindex="-1">@(_finishAfterRangeSave ? "終了前に区間を保存" : "区間名とタグ")</h3>
                <ScenarioRangeDraftEditor Name="@draft.Name" Tags="@draft.Tags"
                    NameChanged="value => EditWorkspace(target, () => { if (ReferenceEquals(draft, _rangeDraft)) draft.Name = value; })"
                    TagsChanged="value => EditWorkspace(target, () => { if (ReferenceEquals(draft, _rangeDraft)) draft.Tags = value; })"
                    AvailableTags="_rangeTags" SuggestedTags="_speakers" Disabled="ControlsDisabled" AutoFocus="@(draft.AutoFocus && draft.Open)"
                    Save="() => SaveRangeAsync(target, draft)"
                    Close="() => CloseRangeEditor(target, draft)"
                    Discard="() => DiscardRangeEditorAsync(target, draft)" />
            </section>
        }
    </div>;

    private RenderFragment TextPane => @<section class="play-panel play-stack" aria-labelledby="play-text-title">
        @{ var target = ForDisplay(_state!); }
        <h2 id="play-text-title" class="capture-failure-announcement">本文</h2>
        @if (_textError && _galleryItem is null)
        {
            <div class="play-text-failure"><CaptureFailureDetails Label="本文取得失敗" Detail="本文を更新して再試行してください。" Web="true" /></div>
        }
        @if (_textRangeId is { } rangeId)
        {
            <p>区間：@RangeName(rangeId)</p>
        }
        <form class="play-search" @onsubmit="() => SearchTextsAsync(target)" @onsubmit:preventDefault>
            <input class="scenario-focus" type="search" aria-label="本文で検索" placeholder="本文" @bind="_textSearchInput" @bind:event="oninput" disabled="@_busy" />
            <input class="scenario-focus" type="search" aria-label="話者で検索" placeholder="話者" @bind="_speakerSearchInput" @bind:event="oninput" disabled="@_busy" />
            <button type="submit" class="scenario-action" disabled="@_busy">検索</button>
        </form>
        @if (_galleryItem is null)
        {
            <div class="play-actions">
                @if (_textRangeId is null && _textItems is { Count: > 0 })
                {
                    <button type="button" class="scenario-action play-labeled-button" @ref="_pickRangeButton" aria-pressed="@Bool(_pickingRange)" disabled="@(_busy || _textError)" @onclick="() => EditWorkspace(target, ToggleRangePick)"><CaptureIcon Name="Pick" />本文から区間を選ぶ</button>
                }
                <button type="button" class="scenario-action play-icon-button" title="本文を更新" aria-label="本文を更新" disabled="@_busy" @onclick="() => ReadForDisplayedTargetAsync(target, LoadTextAsync)"><CaptureIcon Name="Refresh" /></button>
                <button type="button" class="scenario-action play-labeled-button" @ref="_rangesTab" aria-expanded="@Bool(_savedRangesOpen)" disabled="@_busy" @onclick="() => ToggleSavedRangesAsync(target)"><CaptureIcon Name="Range" />保存した区間</button>
            </div>
        }
        @if (_savedRangesOpen) { @RangesPane }
        @if (_pickingRange)
        {
            <div class="play-stack play-selection">
                <p title="@_first?.Text">開始：@(_first?.Text ?? "未選択")</p>
                <p title="@_last?.Text">終了：@(_last?.Text ?? "未選択")</p>
                <div class="play-actions play-range-selection-actions">
                    <button type="button" class="scenario-action play-labeled-button" disabled="@(_busy || !TextRangeValid || _rangeDraft is not null)" @onclick="() => PrepareTextRangeAsync(target)"><CaptureIcon Name="Save" />区間名を入力</button>
                    @if (_first is not null && _last is not null && !TextRangeValid)
                    {
                        <div class="play-range-selection-failure"><CaptureFailureDetails Label="端点エラー" Detail="開始より後の終了位置を選んでください。" Web="true" /></div>
                    }
                </div>
            </div>
        }
        <div class="play-text-work" data-detail-open="@(_galleryItem is not null ? "true" : null)">
        <div class="play-text-scroll scenario-focus" @ref="_textScroller" tabindex="0" aria-label="本文一覧">
        @if (_textItems is null)
        {
            @if (_textLoading && !_textError) { <ScenarioLoading Label="本文を読み込み中…" /> }
        }
        else if (_textItems.Count == 0)
        {
            @if (!_textError) { <p>@(_textSearch is not null || _speakerSearch is not null ? "一致する本文はありません。" : "本文はありません。")</p> }
        }
        else
        {
            <ul class="play-list">
                @foreach (var item in _textItems)
                {
                    <li class="play-item" @key="item.Id">
                        @if (_pickingRange)
                        {
                            <div class="play-row-content">
                                <div class="play-row-main">
                                    @if (!string.IsNullOrWhiteSpace(item.Speaker)) { <strong>@item.Speaker</strong> }
                                    <p>@item.Text</p>
                                </div>
                                <CaptureImageCount Count="@ImageCount(item)" Failed="@_imageCountsFailed" />
                            </div>
                            <div class="play-actions">
                                <button type="button" class="scenario-action play-icon-button" aria-label="ここから" aria-pressed="@Bool(_first?.Id == item.Id)" disabled="@(_busy || _textError)" @onclick="() => EditWorkspace(target, () => PickRangeEdge(item, true))"><CaptureIcon Name="Start" /></button>
                                <button type="button" class="scenario-action play-icon-button" aria-label="ここまで" aria-pressed="@Bool(_last?.Id == item.Id)" disabled="@(_busy || _textError)" @onclick="() => EditWorkspace(target, () => PickRangeEdge(item, false))"><CaptureIcon Name="End" /></button>
                            </div>
                        }
                        else
                        {
                            <button type="button" class="play-row-content play-row-select scenario-focus" aria-current="@(_selectedItemId == item.Id ? "true" : null)"
                                    @ref="_rowButtons[item.Id].Open" disabled="@(_busy || _textError)" @onclick="() => OpenDetailAsync(target, item)">
                                <span class="play-row-main">
                                    @if (!string.IsNullOrWhiteSpace(item.Speaker)) { <strong>@item.Speaker</strong> }
                                    <span>@item.Text</span>
                                </span>
                                <CaptureImageCount Count="@ImageCount(item)" Failed="@_imageCountsFailed" />
                            </button>
                        }
                    </li>
                }
            </ul>
            @if (_nextBefore is not null || _olderPages.Count > 0)
            {
                <div class="play-actions" aria-label="本文のページ">
                    <button type="button" class="scenario-action play-labeled-button" disabled="@(_busy || _textError || _olderPages.Count == 0)" @onclick="() => PageTextAsync(target, -1)"><CaptureIcon Name="Previous" />新しい本文</button>
                    <button type="button" class="scenario-action play-labeled-button" disabled="@(_busy || _textError || _nextBefore is null)" @onclick="() => PageTextAsync(target, 1)"><CaptureIcon Name="Next" />古い本文</button>
                </div>
            }
        }
        </div>
        @if (_galleryItem is not null) { @Gallery(target) }
        </div>
    </section>;

    private RenderFragment TextEditor(DisplayTarget target) => @<div class="play-stack" @onkeydown="e => HandleEscape(target, e, CancelTextEdit)">
        @{ var item = _editItem; }
        <label>分類
            <select class="scenario-focus" @ref="_editClassification" @bind:get="_editLabel" @bind:set="value => EditWorkspace(target, () => { if (ReferenceEquals(item, _editItem)) _editLabel = value; })" disabled="@_busy">
                <option value="0">未判定</option>
                @foreach (var label in LabelChoices) { <option value="@label.Id">@ClassificationName(label.Kind, label.Name)</option> }
            </select>
        </label>
        <label>話者 <input class="scenario-focus" @bind:get="_editSpeaker" @bind:set="value => EditWorkspace(target, () => { if (ReferenceEquals(item, _editItem)) _editSpeaker = value ?? string.Empty; })" @bind:event="oninput" disabled="@(_busy || EditingNarration)" /></label>
        <div class="play-actions">
            <button type="button" class="scenario-action" disabled="@_busy" @onclick="() => EditWorkspace(target, CancelTextEdit)">取消</button>
            <button type="button" class="scenario-action scenario-action--primary play-labeled-button" aria-label="訂正を保存" disabled="@(_busy || !TextLabelChanged(item) && !TextSpeakerChanged(item))" @onclick="() => SaveTextAsync(target, item)"><CaptureIcon Name="Save" />保存</button>
        </div>
    </div>;

    private RenderFragment Gallery(DisplayTarget target) => @<div class="play-detail scenario-focus" @ref="_galleryHeading" tabindex="-1"
            @onkeydown="e => HandleEscape(target, e, _detailRangeEdit is null ? ReturnFromGallery : CloseDetailRangeEdit)">
        @if (_galleryItem is { } item)
        {
            var key = new CaptureOccurrenceKey(target.Recording.HistoryRoot, item.StartPosition);
            var shownImage = _galleryImage;
            <CaptureOccurrenceDetail @key="key" RecordId="key.RecordId" Item="item"
                ImageCount="@_galleryImages?.Count" ImageIndex="_galleryIndex" ImageSource="@shownImage?.Source"
                ImagesLoading="_galleryLoading"
                ImageError="@(_galleryError ? "選んだ本文の画像を読み込めませんでした。" : null)" Disabled="ControlsDisabled"
                Close="selected => { if (IsDetailCurrent(target, selected)) ReturnFromGallery(); }"
                Edit="selected => IsDetailCurrent(target, selected) ? EditTextAsync(target, item) : Task.CompletedTask"
                Copy="selected => CopyDetailAsync(target, selected)"
                RetryImages="selected => ReadForDisplayedTargetAsync(target, () => IsDetailCurrent(target, selected) ? LoadGalleryImageAsync() : Task.CompletedTask)"
                MoveImage="request => PageGalleryAsync(target, request)"
                ImageDecodeFailed="request => { if (shownImage is not null && IsDetailCurrent(target, request.Occurrence) && request.Source == shownImage.Source) GalleryDecodeFailed(shownImage); }">
                @if (_editItem is not null)
                {
                    @TextEditor(target)
                }
                <div class="play-actions">
                    @if (_textRangeId is null && _rangeDraft is null)
                    {
                        <button type="button" class="scenario-action" disabled="@ControlsDisabled" @onclick="() => PickRangeFromDetail(target, key)">区間をここから選ぶ</button>
                    }
                    <button type="button" class="scenario-action" disabled="@ControlsDisabled" @onclick="() => CutPathAsync(target, item)">ここから別経路</button>
                    @if (_detailSuccess is { } detailSuccess) { <span role="status">@detailSuccess</span> }
                </div>
                @foreach (var range in RangesFor(item))
                {
                    var label = RangeName(range.Id);
                    if (!_detailRangeButtons.TryGetValue(range.Id, out var rangeButton))
                        _detailRangeButtons[range.Id] = rangeButton = new();
                    <div class="play-detail-range" @key="range.Id">
                        <p>@label@if (range.Tags.Length > 0) { <small> · @string.Join(" · ", range.Tags)</small> }</p>
                        @if (_detailRangeEdit is { } draft && draft.Id == range.Id)
                        {
                            <div class="play-stack" role="group" aria-label="@($"{label}の名前・タグ")">
                                <CaptureRangeFields @key="draft" Name="@draft.Name" NameChanged="value => EditWorkspace(target, () => { if (IsDetailRangeEditCurrent(target, draft)) draft.Name = value; })"
                                                    Tags="draft.Tags" TagsChanged="value => EditWorkspace(target, () => { if (IsDetailRangeEditCurrent(target, draft)) draft.Tags = value; })"
                                                    AvailableTags="_rangeTags" SuggestedTags="_speakers" AutoFocus="true" Disabled="ControlsDisabled" />
                                <div class="play-actions">
                                    <button type="button" class="scenario-action scenario-action--primary" disabled="@(ControlsDisabled || !draft.CanSave)" @onclick="() => SaveDetailRangeAsync(target, draft)">名前・タグを保存</button>
                                    <button type="button" class="scenario-action" disabled="@ControlsDisabled" @onclick="() => EditWorkspace(target, CloseDetailRangeEdit)">閉じる</button>
                                </div>
                            </div>
                        }
                        else
                        {
                            <button type="button" class="scenario-action" @ref="rangeButton.Open" aria-label="@($"{label}の名前・タグを編集")"
                                    disabled="@ControlsDisabled" @onclick="() => OpenDetailRangeEdit(target, key, range)">名前・タグを編集</button>
                        }
                    </div>
                }
            </CaptureOccurrenceDetail>
        }
    </div>;

    private RenderFragment RangesPane => @<section class="play-panel play-stack" aria-labelledby="play-ranges-title">
        @{ var target = ForDisplay(_state!); }
        <div class="play-toolbar"><h2 id="play-ranges-title">保存した区間</h2><button type="button" class="scenario-action play-icon-button" title="区間を更新" aria-label="区間を更新" disabled="@_busy" @onclick="() => ReadForDisplayedTargetAsync(target, LoadRangesAsync)"><CaptureIcon Name="Refresh" /></button></div>
        @if (_rangesError)
        {
            <div><CaptureFailureDetails Label="区間の取得失敗" Detail="区間を読み込めませんでした。区間を更新してください。" Web="true" /></div>
        }
        else if (_rangesLoading && _ranges is null)
        {
            <ScenarioLoading Label="区間を読み込み中…" />
        }
        else if (_ranges is { Count: 0 })
        {
            <p>保存した区間はありません。</p>
        }
        else if (_ranges is not null)
        {
            <ul class="play-list">
                @foreach (var range in _ranges)
                {
                    <li class="play-item" @key="range.Id">
                        <h3>@RangeName(range.Id)</h3>
                        @if (range.Tags.Length > 0) { <p>@string.Join(" · ", range.Tags)</p> }
                        <div class="play-actions">
                            <button type="button" class="scenario-action play-labeled-button" disabled="@_busy" @onclick="() => OpenRangeAsync(target, range.Id)"><CaptureIcon Name="Next" />区間の本文へ</button>
                        </div>
                    </li>
                }
            </ul>
        }
        <div>
            <button type="button" class="scenario-action" aria-expanded="@Bool(_savedScenesOpen)" aria-disabled="@Bool(_busy)" @onclick="() => ReadForDisplayedTargetAsync(target, ToggleSavedScenesAsync)">保存済みの手動場面</button>
        </div>
        @if (_savedScenesOpen)
        {
            @if (_scenesError)
            {
                <div><CaptureFailureDetails Label="場面の取得失敗" Detail="保存済みの手動場面を開き直してください。" Web="true" /></div>
            }
            else if (_sceneFlow is { } savedScenes)
            {
                <SavedSceneList Snapshot="savedScenes" RangeName="SavedSceneRangeName" />
            }
            else if (_scenesLoading)
            {
                <ScenarioLoading Label="場面を読み込み中…" />
            }
        }
    </section>;

    private RenderFragment PathsPane => @<section class="play-panel play-stack" aria-labelledby="play-paths-title">
        @{ var target = ForDisplay(_state!); }
        <div class="play-toolbar"><h2 id="play-paths-title">観測した経路</h2><button type="button" class="scenario-action play-icon-button" title="経路を更新" aria-label="経路を更新" disabled="@_busy" @onclick="() => ReadForDisplayedTargetAsync(target, LoadPathsAsync)"><CaptureIcon Name="Refresh" /></button></div>
        @if (_pathsError) { <div><CaptureFailureDetails Label="経路の取得失敗" Detail="経路を読み込めませんでした。経路を更新してください。" Web="true" /></div> }
        else if (_pathsLoading) { <ScenarioLoading Label="経路を読み込み中…" /> }
        else if (_graph is { Occurrences.Count: 0 }) { <p>観測した経路はありません。</p> }
        @if (_graph is { } graph)
        {
            var hidden = _pathsLoading || _pathsNeedReload || _pathsError || graph.Occurrences.Count == 0;
            <div hidden="@hidden" inert="@(_busy || hidden)">
                <ScenarioFlowView @key="(target.GameId, target.Recording.HistoryRoot, target.ConnectionVersion)"
                                  Graph="graph" MatchingComplete="_matchingComplete"
                                  OpenOccurrence="occurrence => OpenOccurrenceAsync(target, occurrence)"
                                  CutOccurrence="occurrence => CutOccurrenceAsync(target, occurrence)">
                    <OccurrenceImages Context="occurrence">
                        @{ var key = new CaptureOccurrenceKey(target.Recording.HistoryRoot, occurrence.Start); }
                        <CaptureFlowOccurrenceImages @key="(target.GameId, key.RecordId, target.ConnectionVersion)"
                                                     Occurrence="key"
                                                     LoadImageIds="(requested, token) => LoadFlowImageIdsAsync(target, key, requested, token)"
                                                     ReadImage="(requested, imageId, token) => ReadFlowImageBytesAsync(target, key, requested, imageId, token)" />
                    </OccurrenceImages>
                </ScenarioFlowView>
            </div>
        }
    </section>;
}
