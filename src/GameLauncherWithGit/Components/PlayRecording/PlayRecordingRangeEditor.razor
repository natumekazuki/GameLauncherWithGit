<section class="range-editor" aria-labelledby="play-range-editor-title">
    <h3 id="play-range-editor-title">固定した区間</h3>
    <label>区間名
        <input @ref="_nameInput" @bind="Name" @bind:event="oninput" disabled="@Disabled" />
    </label>
    <CaptureTagsEditor Label="区間タグ" @bind-Tags="Tags" AvailableTags="AvailableTags" SuggestedTags="SuggestedTags" Disabled="Disabled" />
    <div class="range-editor-actions">
        <button type="button" disabled="@Disabled" @onclick="Cancel">取消</button>
        <button type="button" class="primary play-labeled-button" disabled="@(Disabled || string.IsNullOrWhiteSpace(Name))" @onclick="SaveAsync"><CaptureIcon Name="Save" />区間を保存</button>
    </div>
</section>

@code {
    [Parameter] public IReadOnlyList<string> AvailableTags { get; set; } = [];
    [Parameter] public IReadOnlyList<string> SuggestedTags { get; set; } = [];
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool AutoFocus { get; set; }
    [Parameter, EditorRequired] public EventCallback<(string Name, string[] Tags)> Save { get; set; }
    [Parameter, EditorRequired] public EventCallback Cancel { get; set; }

    private ElementReference _nameInput;
    private bool _focused;
    private string Name { get; set; } = "";
    private string[] Tags { get; set; } = [];

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (AutoFocus && !_focused && !Disabled)
        {
            _focused = true;
            try { await _nameInput.FocusAsync(); }
            catch (JSDisconnectedException) { }
        }
    }

    private Task SaveAsync() => Disabled || string.IsNullOrWhiteSpace(Name)
        ? Task.CompletedTask
        : Save.InvokeAsync((Name.Trim(), Tags));
}
