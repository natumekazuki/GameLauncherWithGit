    private void FindProcesses() => _processes = CaptureService.GetProcesses();
    private async Task PickWindowAsync()
    {
        CancelWindowPick(); _error = null;
        var expected = _settingsTarget;
        using var cancellation = CancellationTokenSource.CreateLinkedTokenSource(_stop.Token);
        _windowPick = cancellation;
        try
        {
            for (_windowCountdown = 3; _windowCountdown > 0; _windowCountdown--)
            {
                StateHasChanged();
                await Task.Delay(1000, cancellation.Token);
            }
            var current = CaptureService.Snapshot;
            if (expected != PlayRecordingOperations.DesktopTarget(current, current.Profile?.Id ?? 0))
                throw new InvalidOperationException("記録対象が変わりました。抽出設定を開き直してください。");
            var process = CaptureService.GetForegroundProcess()
                ?? throw new InvalidOperationException("ゲーム画面を選択できませんでした。前面にして再試行するか、一覧から選択してください。");
            FindProcesses();
            _processes = _processes.Where(x => x.Id != process.Id).Prepend(process).ToArray();
            _processId = process.Id; _processSearch = ""; _windowsOnly = !string.IsNullOrEmpty(process.WindowTitle);
        }
        catch (OperationCanceledException) { }
        catch (Exception ex) { if (_windowPick == cancellation) _error = ex.Message; }
        finally { if (_windowPick == cancellation) { _windowPick = null; _windowCountdown = 0; } }
    }
    private void CancelWindowPick() { _windowPick?.Cancel(); _windowPick = null; _windowCountdown = 0; }
