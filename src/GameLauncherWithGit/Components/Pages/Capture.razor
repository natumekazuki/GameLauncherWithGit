@page "/capture"
@using GameLauncherWithGit.Application.Models
@using GameLauncherWithGit.Application.Services
@using GameLauncherWithGit.Infrastructure.Abstractions
@using GameLauncherWithGit.Components
@using System.Text
@implements IAsyncDisposable
@inject IScenarioCaptureStore Store
@inject IScenarioHistoryStore HistoryStore
@inject IScenarioScreenshotStore ScreenshotStore
@inject IScenarioMaterialReader MaterialReader
@inject IScenarioSceneFlowStore SceneStore
@inject ScenarioScreenshotService Screenshots
@inject ScenarioCaptureService CaptureService
@inject PlayRecordingOperations RecordingOperations
@inject IPathPickerService Picker
@inject IJSRuntime JS
@inject NavigationManager Navigation

@{
    var displayedScope = _displayedScope;
    var displayedLive = PlayRecordingOperations.DesktopTarget(_snapshot, _snapshot.Profile?.Id ?? 0);
    var displayedSetup = PlayRecordingOperations.DesktopTarget(_snapshot, _snapshot.Profile?.Id ?? 0);
    var displayedProfile = HistoryTarget(_snapshot);
    var displayedPlay = _playState;
    var liveSnapshot = _snapshot.Profile?.Id == _profileId ? _snapshot : new CaptureSnapshot { Status = _profileId == 0 ? "未接続" : "記録開始前" };
    var displayedGameId = SelectedGameId;
    var displayedWorkId = _profileId;
    var displayedPaused = _snapshot.Paused;
    var displayedProcessId = _processId;
    var displayedPending = _pendingLiveRange;
    var displayedDraft = _rangeSelection;
    var displayedDraftTarget = _rangeDraftTarget;
    var displayedScreenshotTarget = _screenshotSettingsTarget;
    var displayedFirst = _rangeFirst;
    var displayedLast = _rangeLast;
    var pageFailures = PageFailures().ToArray();
}
<PageTitle>シナリオ抽出</PageTitle>
<section class="capture-page">
    <header class="capture-header">
        <div class="capture-heading">
            <a class="secondary-button capture-icon-button" href="/" title="ゲーム一覧" aria-label="ゲーム一覧"><CaptureIcon Name="Back" /></a>
            <h1>シナリオ</h1>
        </div>
        @if (pageFailures.Length > 0)
        {
            <div class="capture-page-failure">
                <CaptureFailureDetails Label="@(pageFailures.Length == 1 ? pageFailures[0].Label : "シナリオの警告")"
                    Detail="@(pageFailures.Length == 1 ? pageFailures[0].Detail : string.Join("\n\n", pageFailures.Select(x => $"{x.Label}\n{x.Detail}")))" />
            </div>
        }
        @if (!_loading && _initialError is null && !InvalidGameId)
        {
            <nav class="capture-tabs" aria-label="表示切替">
                <button class="secondary-button capture-text-button" aria-pressed="@(!_flowOpen)" @onclick="() => ShowViewAsync(false)" disabled="@_busy">本文</button>
                <button class="secondary-button capture-text-button" aria-pressed="@_flowOpen" @onclick="() => ShowViewAsync(true)" disabled="@(_busy || displayedScope is null)">フロー</button>
            </nav>
        }
    </header>
    @if (_loading) { <p role="status">読込中…</p> }
    else if (_initialError is not null)
    {
        <button type="button" class="secondary-button capture-text-button" @ref="_initialRetry" @onclick="RetryInitialAsync"><CaptureIcon Name="Refresh" />シナリオを再読込</button>
    }
    else if (InvalidGameId)
    {
        <p role="status">指定の作品は見つかりません。</p>
    }
    else
    {
        <div class="capture-targets">
            @if (SelectedGameTitle is { } title)
            {
                <strong>@title</strong>
                <span>@(ViewingLiveRecord ? "記録先" : "閲覧中")：@(_scopeLabel ?? "通常の記録")</span>
            }
            @if (displayedPlay is { GameId: not null } current && !ViewingLiveRecord)
            {
                <button class="secondary-button capture-text-button" @onclick="() => ReturnToRecordingAsync(current.GameId)" disabled="@_busy">記録先：@current.Title</button>
            }
        </div>
        @if (ViewingLiveRecord || ViewingSetup)
        {
            <section class="capture-livebar" aria-label="記録操作">
                <ScenarioRecordingBar State="RecordingDisplay" Disabled="_busy"
                    ShowControls="@(ViewingLiveRecord && (liveSnapshot.Recording || liveSnapshot.Paused))"
                    CanTogglePause="@(liveSnapshot.Connected && !liveSnapshot.Preview)" CanBreakPath="liveSnapshot.Recording"
                    TogglePause="() => AtScopeAsync(displayedScope, () => ToggleRecordingPauseAsync(displayedLive, !displayedPaused))"
                    BreakPath="() => AtScopeAsync(displayedScope, () => BreakLivePathAsync(displayedLive))">
                    @if (ViewingLiveRecord && displayedPlay is { CanStart: true })
                    {
                        <button class="secondary-button scenario-action scenario-action--primary" @onclick="() => AtScopeAsync(displayedScope, () => StartRecordingAsync(displayedPlay))" disabled="@_busy">記録を開始</button>
                    }
                    else if (CanPrepareRecording && displayedGameId is not null)
                    {
                        <button class="secondary-button scenario-action scenario-action--primary" @onclick="() => PrepareRecordingAsync(displayedGameId, displayedWorkId)" disabled="@_busy">記録の準備</button>
                    }
                    @if (ViewingLiveRecord && displayedPlay?.CanFinish == true)
                    {
                        <details class="capture-live-range-menu">
                            <summary class="scenario-focus">@(liveSnapshot.RangeStart is not null || displayedPending is not null ? "区間指定中" : "区間")</summary>
                            <div class="capture-play-range">
                                <button class="secondary-button scenario-action" @onclick="() => AtScopeAsync(displayedScope, () => StartLiveRangeAsync(displayedLive))" disabled="@(_busy || !liveSnapshot.RangeCanStart || displayedDraft is not null || displayedPending is not null)">区間を開始</button>
                                <button class="secondary-button scenario-action" @onclick="() => AtScopeAsync(displayedScope, () => EndLiveRangeAsync(displayedLive))" disabled="@(_busy || !liveSnapshot.RangeCanEnd || displayedDraft is not null || displayedPending is not null)">末尾を固定</button>
                                <button class="secondary-button scenario-action" @onclick="() => AtScopeAsync(displayedScope, () => CancelLiveRangeAsync(displayedLive, displayedPending))" disabled="@(_busy || (liveSnapshot.RangeStart is null && displayedPending is null))">区間指定を破棄</button>
                            </div>
                        </details>
                    }
                </ScenarioRecordingBar>
            </section>
        }
        <div class="capture-operation-result" role="status">@_message</div>
        <section class="capture-content" aria-busy="@(_busy ? "true" : "false")">
            <div class="capture-filters @(ShowHistoryScopes ? "capture-filters-scoped" : "")" hidden="@_flowOpen">
                @if (_profiles.Count > 0)
                {
                    <label class="capture-filter" title="ゲーム"><CaptureIcon Name="Game" /><select aria-label="ゲーム" value="@_profileId" @onchange="ChangeProfileAsync" disabled="@_busy">
                        <option value="0">@(_requestedGame is { } requested && !_profiles.Any(p => p.GameId == requested.Id) ? requested.Title : "ゲームを選択")</option>
                        @foreach (var profile in _profiles) { <option value="@profile.Id">@profile.Title@(profile.GameId is null ? "（登録なし）" : "")</option> }
                    </select></label>
                    @if (ShowHistoryScopes)
                    {
                        <label class="capture-filter" title="記録範囲"><CaptureIcon Name="History" /><select aria-label="記録範囲" value="@_historyChoice" @onchange="ChangeHistoryScopeAsync" disabled="@_busy">
                            @if (_profile?.GameId is not null) { <option value="0">@CurrentScopeLabel</option> }
                            @foreach (var scope in _historyScopes)
                            {
                                <option value="@scope.RecordId">@HistoryScopeLabel(scope)</option>
                            }
                        </select></label>
                    }
                }
                <label class="capture-filter" title="区間"><CaptureIcon Name="Range" /><select @ref="_rangeFilter" aria-label="区間" value="@_rangeId" @onchange="e => AtScopeAsync(displayedScope, () => ChangeRangeAsync(e))" disabled="@(_busy || displayedScope is null)">
                    <option value="0">全本文</option>
                    @foreach (var range in _ranges) { <option value="@range.Id">@RangeName(range)</option> }
                </select></label>
                <label class="capture-filter" title="分類"><CaptureIcon Name="Tag" /><select aria-label="分類" value="@_filter" @onchange="e => AtScopeAsync(displayedScope, () => FilterAsync(e))" disabled="@(_busy || displayedScope is null)">
                    <option value="all">すべて</option><option value="none">未判定</option>
                    <option value="dialogue">セリフ</option><option value="narration">地の文</option>
                </select></label>
            </div>
            @if (!_flowOpen)
            {
                <div class="capture-history-toolbar">
                    <form class="capture-search" @onsubmit="() => AtScopeAsync(displayedScope, SearchHistoryAsync)" @onsubmit:preventDefault>
                        <label>名前（部分一致）<input type="search" placeholder="例：美咲" value="@_speakerSearchInput" @oninput="e => AtScope(displayedScope, () => _speakerSearchInput = e.Value?.ToString() ?? string.Empty)" disabled="@(_busy || _recordId == 0)" /></label>
                        <label>本文（部分一致）<input type="search" placeholder="例：約束" value="@_textSearchInput" @oninput="e => AtScope(displayedScope, () => _textSearchInput = e.Value?.ToString() ?? string.Empty)" disabled="@(_busy || _recordId == 0)" /></label>
                        <button type="submit" class="secondary-button capture-icon-button" title="検索" aria-label="検索" disabled="@(_busy || _recordId == 0)"><CaptureIcon Name="Search" /></button>
                        <button type="button" class="secondary-button capture-icon-button" title="名前・本文の検索を解除（区間・分類は保持）" aria-label="名前・本文の検索を解除" @onclick="() => AtScopeAsync(displayedScope, ClearHistorySearchAsync)" disabled="@(_busy || !HasHistorySearch && _textSearchInput.Length == 0 && _speakerSearchInput.Length == 0)"><CaptureIcon Name="Close" /></button>
                    </form>
                    <button class="secondary-button capture-text-button" @onclick="() => AtScopeAsync(displayedScope, OpenHistoryManagementAsync)" disabled="@(_busy || _recordId == 0)"><CaptureIcon Name="History" />履歴管理</button>
                </div>
                <span class="capture-sr-only" role="status">@(_busy ? "読込中…" : HistorySearchPending ? "検索条件は未適用" : "")</span>
            }
            <div class="capture-tools">
                <div class="capture-tool-group capture-view-tools">
                    @if (_flowOpen)
                    {
                        <button class="secondary-button capture-icon-button" title="フローチャートを更新" aria-label="フローチャートを更新" @onclick="() => AtScopeAsync(displayedScope, RefreshAsync)" disabled="@_busy"><CaptureIcon Name="Refresh" /></button>
                    }
                    else
                    {
                        <button class="secondary-button capture-text-button" aria-pressed="@(_following && _offset == 0)" @onclick="() => AtScopeAsync(displayedScope, FollowAsync)" disabled="@(_busy || displayedScope is null || _selected.Count > 0 || _pickingRange)"><CaptureIcon Name="Follow" />最新へ</button>
                        <button class="secondary-button capture-icon-button" title="古い200件" aria-label="古い200件" @onclick="() => AtScopeAsync(displayedScope, NextAsync)" disabled="@(_busy || !_hasMore)"><CaptureIcon Name="Previous" /></button>
                        <button class="secondary-button capture-icon-button" title="新しい200件" aria-label="新しい200件" @onclick="() => AtScopeAsync(displayedScope, PreviousAsync)" disabled="@(_busy || _offset == 0)"><CaptureIcon Name="Next" /></button>
                    }
                </div>
                @if (!_flowOpen)
                {
                    @if (!_rangeEditorOpen && (displayedDraft ?? displayedPending) is { } draftToOpen)
                    {
                        <button class="secondary-button scenario-action" @onclick="() => AtScope(displayedScope, () => OpenRangeDraft(draftToOpen, displayedDraftTarget ?? displayedLive))" disabled="@_busy">区間草稿を開く</button>
                    }
                    <div class="capture-tool-group" aria-label="本文で区間指定">
                        <button class="secondary-button capture-icon-button" title="本文から区間を選ぶ" aria-label="本文から区間を選ぶ" aria-pressed="@(_pickingRange ? "true" : "false")" @onclick="() => AtScopeAsync(displayedScope, ToggleTextRange)" disabled="@(_busy || _recordId == 0)"><CaptureIcon Name="Pick" /></button>
                        @if (_pickingRange)
                        {
                            <button class="secondary-button capture-icon-button" title="区間名を入力" aria-label="区間名を入力" @onclick="() => AtScopeAsync(displayedScope, () => OpenTextRangeAsync(displayedProfile, displayedFirst, displayedLast))" disabled="@(_busy || !TextRangeValid || displayedDraft is not null || displayedPending is not null || (ViewingLiveRecord && liveSnapshot.RangeStart is not null))"><CaptureIcon Name="Save" /></button>
                            <button class="secondary-button capture-icon-button" title="本文の区間指定を解除" aria-label="本文の区間指定を解除" @onclick="() => AtScopeAsync(displayedScope, ClearTextRangeAsync)" disabled="@_busy"><CaptureIcon Name="Close" /></button>
                            <button class="secondary-button capture-icon-button" title="選択範囲を独立したフローチャートにする" aria-label="選択範囲を独立したフローチャートにする" @onclick="() => AtScope(displayedScope, () => OpenIndependentFlow())" disabled="@(_busy || !TextRangeValid)"><CaptureIcon Name="Flow" /></button>
                        }
                    </div>
                }
                <div class="capture-tool-group capture-utilities">

                    <button @ref="_toolsButton" type="button" class="secondary-button capture-text-button" popovertarget="capture-tools-menu" aria-haspopup="dialog" disabled="@_busy"><CaptureIcon Name="Settings" />その他</button>
                    <section id="capture-tools-menu" class="capture-action-popover" popover="auto" role="dialog" aria-label="その他の操作">
                        <h3>その他の操作</h3>
                        <div class="capture-action-list">
                            @if (ViewingLiveRecord && displayedPlay is { CanFinish: true })
                            {
                                <button type="button" class="secondary-button capture-text-button" popovertarget="capture-tools-menu" popovertargetaction="hide" @onclick="() => AtScopeAsync(displayedScope, () => RequestFinishAsync(displayedLive))" disabled="@_busy"><CaptureIcon Name="Stop" />記録を終了</button>
                            }
                            @if (!_flowOpen)
                            {
                                <label><input type="checkbox" aria-label="表示分を選択" checked="@(_items.Count > 0 && _selected.Count == _items.Count)" @onchange="e => AtScope(displayedScope, () => SelectPage(e))" disabled="@(_busy || _items.Count == 0 || !CanEdit)" />表示分を選択</label>
                                <span role="status">@_selected.Count 件選択</span>
                                <button type="button" class="secondary-button capture-text-button" popovertarget="capture-tools-menu" popovertargetaction="hide" @onclick="() => AtScope(displayedScope, () => OpenBulk())" disabled="@(_busy || !CanOperateOnSelection)"><CaptureIcon Name="BulkEdit" />一括修正</button>
                                <button type="button" class="secondary-button capture-text-button" @onclick="() => AtScope(displayedScope, () => ClearSelection())" disabled="@(_busy || _selected.Count == 0)"><CaptureIcon Name="ClearSelection" />選択解除</button>
                                @if (!ViewingLiveRecord || !_snapshot.Active)
                                {
                                    <button type="button" class="secondary-button capture-text-button" popovertarget="capture-tools-menu" popovertargetaction="hide" @onclick="() => AtScopeAsync(displayedScope, OpenSelectedDeletionAsync)" disabled="@(_busy || !CanOperateOnSelection)"><CaptureIcon Name="Trash" />選択した本文の原文を削除</button>
                                }
                            }
                            @if (ViewingLiveRecord)
                            {
                                <button type="button" class="secondary-button capture-text-button" aria-label="スクリーンショット設定" popovertarget="capture-tools-menu" popovertargetaction="hide" @onclick="OpenScreenshotSettings" disabled="@_busy"><CaptureIcon Name="Camera" />撮影設定</button>
                            }
                            <button type="button" class="secondary-button capture-text-button" popovertarget="capture-tools-menu" popovertargetaction="hide" @onclick="OpenExtractionSettings" disabled="@_busy"><CaptureIcon Name="Settings" />抽出設定</button>
                            <button type="button" class="secondary-button capture-text-button" popovertarget="capture-tools-menu" popovertargetaction="hide" @onclick="() => AtScopeAsync(displayedScope, OpenExportAsync)" disabled="@(_busy || _recordId == 0)"><CaptureIcon Name="Export" />書き出し</button>
                            <button type="button" class="secondary-button" popovertarget="capture-tools-menu" popovertargetaction="hide" @onclick="() => AtScopeAsync(displayedScope, () => OpenSavedScenesAsync(displayedScope!))" disabled="@(_busy || _recordId == 0)">保存済みの手動場面</button>
                            @if (_screenshotCountsError is not null)
                            {
                                <button type="button" class="secondary-button capture-text-button" popovertarget="capture-tools-menu" popovertargetaction="hide" @onclick="() => AtScopeAsync(displayedScope, RetryScreenshotCountsAsync)" disabled="@_busy"><CaptureIcon Name="Refresh" />画像件数を再読込</button>
                            }
                            @if (_screenshotCleanup is { RemainingImageCount: > 0 })
                            {
                                <button type="button" class="secondary-button capture-text-button" popovertarget="capture-tools-menu" popovertargetaction="hide" @onclick="RetryScreenshotCleanupAsync" disabled="@_busy"><CaptureIcon Name="Refresh" />後片付けを再試行</button>
                            }
                            <button type="button" class="secondary-button" popovertarget="capture-tools-menu" popovertargetaction="hide">閉じる</button>
                        </div>
                    </section>
                </div>
            </div>
            @if (_pickingRange && !_flowOpen)
            {
                <div class="capture-range-summary" role="status" aria-label="@TextRangeSummary" title="@TextRangeSummary">
                    <span><CaptureIcon Name="Start" />@(_rangeFirst is null ? "—" : CandidatePreview(_rangeFirst.Text))</span>
                    <span><CaptureIcon Name="End" />@(_rangeLast is null ? "—" : CandidatePreview(_rangeLast.Text))</span>
                </div>
            }
            <div class="capture-flow-workspace" hidden="@(!_flowOpen)">
                @if (_flowGraph is not null)
                {
                    <ScenarioFlowView Graph="_flowGraph" MatchingComplete="_flowMatchingComplete"
                        OpenOccurrence="occurrence => AtScopeAsync(displayedScope, () => OpenFlowOccurrenceAsync(occurrence))"
                        CutOccurrence="occurrence => AtScopeAsync(displayedScope, () => CutFlowOccurrenceAsync(displayedProfile, occurrence))" />
                }
                else if (_flowOpen && _busy) { <p role="status">フローチャートを読込中…</p> }
            </div>
            <div class="capture-feed" hidden="@_flowOpen" @ref="_feed" tabindex="0" aria-label="抽出本文" data-capture-scope="@displayedScope?.ViewKey">
                @if (_scopeError is not null)
                {
                    <div class="capture-feed-error">
                        <CaptureFailureDetails Label="記録範囲の取得失敗" Detail="@_scopeError" />
                        <button class="secondary-button capture-text-button" @onclick="RetryScopeAsync" disabled="@_busy"><CaptureIcon Name="Refresh" />記録範囲を再読込</button>
                    </div>
                }
                else if (_itemsError is not null)
                {
                    <div class="capture-feed-error">
                        <CaptureFailureDetails Label="本文の取得失敗" Detail="@_itemsError" />
                        <button class="secondary-button capture-text-button" @onclick="() => AtScopeAsync(displayedScope, RetryItemsAsync)" disabled="@_busy"><CaptureIcon Name="Refresh" />本文を再読込</button>
                    </div>
                }
                else if (_items.Count == 0) { <p class="capture-empty">@EmptyMessage</p> }
                @foreach (var item in _items)
                {
                    var rowActionsId = $"capture-row-actions-{item.Id}";
                    <article class="capture-item @(IsRangeEdge(item) || _flowHighlighted == item.StartPosition || _selected.Contains(item.Id) ? "capture-range-edge" : "")" @key="item.Id">
                        @if (_pickingRange)
                        {
                            <div class="capture-row-reading">
                                @if (item.Speaker is not null) { <strong>@item.Speaker</strong> }
                                <p>@item.Text</p>
                            </div>
                            <div class="capture-row-edge">
                                <button class="secondary-button capture-icon-button" title="ここから" aria-label="ここから" aria-pressed="@(item.StartPosition == _rangeFirst?.StartPosition ? "true" : "false")" @onclick="() => AtScope(displayedScope, () => PickRangeStart(item))" disabled="@_busy"><CaptureIcon Name="Start" /></button>
                                <button class="secondary-button capture-icon-button" title="ここまで" aria-label="ここまで" aria-pressed="@(item.EndPosition == _rangeLast?.EndPosition ? "true" : "false")" @onclick="() => AtScope(displayedScope, () => PickRangeEnd(item))" disabled="@_busy"><CaptureIcon Name="End" /></button>
                            </div>
                        }
                        else
                        {
                            <button type="button" class="capture-row-reading capture-row-select" popovertarget="@rowActionsId" aria-haspopup="dialog" disabled="@_busy">
                                @if (item.Speaker is not null) { <strong>@item.Speaker</strong> }
                                <span>@item.Text</span>
                            </button>
                            <section id="@rowActionsId" class="capture-action-popover" popover="auto" role="dialog" aria-label="この本文の操作">
                                <h3>この本文の操作</h3>
                                <p>@item.Text</p>
                                <small><time datetime="@item.ReceivedAt.ToString("O")">@item.ReceivedAt.ToLocalTime().ToString("M/d HH:mm:ss")</time> · @(item.LabelName ?? "未判定")@(item.ManualLabel || item.ManualSpeaker || item.ManualBoundaries ? " · 手動修正" : "")</small>
                                <div class="capture-action-list">
                                    <label><input type="checkbox" aria-label="この本文を選択" checked="@_selected.Contains(item.Id)" @onchange="e => AtScope(displayedScope, () => SelectItem(item.Id, e.Value is true))" disabled="@(_busy || !CanEdit)" />一括操作の対象</label>
                                    <button type="button" class="secondary-button capture-text-button" aria-label="@ScreenshotLabel(item)" popovertarget="@rowActionsId" popovertargetaction="hide" @onclick="() => AtScopeAsync(displayedScope, () => OpenScreenshotsAsync(item))" disabled="@(_busy || ScreenshotCount(item) is not > 0)"><CaptureIcon Name="Image" />画像 @(ScreenshotCount(item)?.ToString() ?? "?")</button>
                                    <button type="button" class="secondary-button capture-text-button" popovertarget="@rowActionsId" popovertargetaction="hide" @onclick="() => AtScope(displayedScope, () => Edit(item))" disabled="@(_busy || !CanEdit)"><CaptureIcon Name="Edit" />話者・分類を訂正</button>
                                    <button type="button" class="secondary-button capture-text-button" popovertarget="@rowActionsId" popovertargetaction="hide" @onclick="() => AtScopeAsync(displayedScope, () => OpenPartitionAsync(item))" disabled="@(_busy || !CanEdit)"><CaptureIcon Name="Split" />原文・分割</button>
                                    @if (!ViewingLiveRecord || !_snapshot.Active)
                                    {
                                        <button type="button" class="secondary-button capture-text-button" popovertarget="@rowActionsId" popovertargetaction="hide" @onclick="() => AtScopeAsync(displayedScope, () => CutHistoryOccurrenceAsync(displayedProfile, item))" disabled="@_busy"><CaptureIcon Name="PathBreak" />ここから別経路</button>
                                    }
                                    <button type="button" class="secondary-button" popovertarget="@rowActionsId" popovertargetaction="hide">閉じる</button>
                                </div>
                            </section>
                        }
                    </article>
                }
            </div>
        </section>
    }
</section>

@if (_savedScenes is { } savedScenes)
{
    <div class="modal-backdrop"><section id="capture-editor" class="capture-dialog" role="dialog" aria-modal="true" aria-labelledby="capture-scenes-title">
        <header class="capture-dialog-header"><h2 id="capture-scenes-title">保存済みの手動場面</h2><button class="secondary-button capture-icon-button" aria-label="閉じる" title="閉じる" @onclick="CloseEditors"><CaptureIcon Name="Close" /></button></header>
        <SavedSceneList Snapshot="savedScenes" RangeName="SavedSceneRangeName" />
    </section></div>
}

@if (_independentFlowConfirm)
{
    <div class="modal-backdrop"><section id="capture-editor" class="capture-dialog" role="dialog" aria-modal="true" aria-labelledby="capture-independent-title">
        <header class="capture-dialog-header"><h2 id="capture-independent-title">独立したフローチャートにする</h2>@DialogFailure("経路の変更失敗")<button class="secondary-button capture-icon-button" aria-label="閉じる" title="閉じる" @onclick="CloseEditors"><CaptureIcon Name="Close" /></button></header>
        <p>@CandidatePreview(_rangeFirst?.Text ?? "") → @CandidatePreview(_rangeLast?.Text ?? "")</p>
        <p>この範囲の本文・画像・順番は残ります。本編との接続を外し、本編の前後も直結しません。</p>
        <div class="capture-dialog-actions"><button class="secondary-button" @onclick="CloseEditors" disabled="@_busy">取消</button><button class="launch-button" @onclick="() => AtScopeAsync(displayedScope, () => CreateIndependentFlowAsync(displayedProfile))" disabled="@_busy">独立させる</button></div>
    </section></div>
}

@if (_screenshotSettingsOpen)
{
    <div class="modal-backdrop"><section id="capture-editor" class="capture-dialog" role="dialog" aria-modal="true" aria-labelledby="capture-screenshot-settings-title">
        <header class="capture-dialog-header"><h2 id="capture-screenshot-settings-title">撮影設定</h2>
            @if (Screenshots.Snapshot is { LastFailure: { } failure } screenshotStatus)
            {
                <CaptureFailureDetails Label="撮影失敗" Detail="@ScreenshotFailureDetails(failure, screenshotStatus)" />
            }
            <button class="secondary-button capture-icon-button" title="閉じる" aria-label="閉じる" @onclick="CloseEditors"><CaptureIcon Name="Close" /></button>
        </header>
        <div class="capture-dialog-body"><ScenarioScreenshotSettings SelectCaptureWindow="window => SelectScreenshotWindowAsync(displayedScreenshotTarget, window)" /></div>
    </section></div>
}
@if (_screenshotItem is not null)
{
    <div class="modal-backdrop"><section id="capture-editor" class="capture-dialog capture-gallery-dialog" role="dialog" aria-modal="true" aria-labelledby="capture-gallery-title" aria-busy="@(_busy ? "true" : "false")">
        <header class="capture-dialog-header"><h2 id="capture-gallery-title">この本文を受信した頃のシーン</h2><button class="secondary-button capture-icon-button" title="閉じる" aria-label="閉じる" @onclick="CloseEditors" disabled="@_busy"><CaptureIcon Name="Close" /></button></header>
        <p class="capture-gallery-text">@_screenshotItem.Text</p>
        <div class="capture-gallery-stage" tabindex="0" aria-label="撮影したシーン">
            @if (_busy) { <span class="capture-sr-only" role="status">画像を読込中…</span> }
            else if (_galleryError is not null) { <CaptureFailureDetails Label="画像の取得失敗" Detail="@_galleryError" /> }
            else if (_eventScreenshots is { Count: 0 }) { <p class="capture-muted">この本文に関連付けられた画像はありません。</p> }
            else if (_galleryImage is { } image) { <img @key="image" src="@image.Source" alt="この本文を受信した頃に撮影したゲーム画面" @onerror="() => ScreenshotDecodeFailed(image)" /> }
        </div>
        <div class="capture-gallery-navigation">
            @if (_galleryError is not null)
            {
                <button class="secondary-button capture-icon-button capture-gallery-retry" title="画像を再読込" aria-label="画像を再読込" @onclick="() => AtScopeAsync(displayedScope, ReloadScreenshotAsync)" disabled="@_busy"><CaptureIcon Name="Refresh" /></button>
            }
            <button class="secondary-button capture-icon-button" title="前の画像" aria-label="前の画像" @onclick="() => AtScopeAsync(displayedScope, () => ChangeScreenshotAsync(-1))" disabled="@(_busy || !CanMoveGallery(-1))"><CaptureIcon Name="Previous" /></button>
            <span>@(_eventScreenshots is not { } images ? "件数未確認" : images.Count == 0 ? "0枚" : $"{_galleryIndex + 1} / {images.Count}枚")</span>
            <button class="secondary-button capture-icon-button" title="次の画像" aria-label="次の画像" @onclick="() => AtScopeAsync(displayedScope, () => ChangeScreenshotAsync(1))" disabled="@(_busy || !CanMoveGallery(1))"><CaptureIcon Name="Next" /></button>
        </div>
    </section></div>
}

@if (_historyDialog != HistoryDialog.None)
{
    <div class="modal-backdrop"><section id="capture-editor" class="capture-dialog capture-history-dialog" role="dialog" aria-modal="true" aria-labelledby="capture-history-title">
        <header class="capture-dialog-header"><h2 id="capture-history-title">@HistoryDialogTitle</h2>@DialogFailure("履歴の操作失敗")<button class="secondary-button capture-icon-button" title="閉じる" aria-label="閉じる" @onclick="CloseEditors" disabled="@_busy"><CaptureIcon Name="Close" /></button></header>
        <div class="capture-dialog-body capture-history-body">
            <strong class="capture-history-title">@ScopeTitle</strong>
            @if (_historyDialog == HistoryDialog.Manage)
            {
                <p class="capture-history-counts">本文 @_historyCounts.Items 件 · 原文 @_historyCounts.Events 件 · 区間 @_historyCounts.Ranges 件</p>
                <section class="capture-history-section">
                    <h3>区間</h3>
                    @if (_ranges.Count == 0) { <p class="capture-muted">保存した区間はありません。</p> }
                    else
                    {
                        <select aria-label="管理する区間" @bind="_managedRangeId" @bind:after="LoadManagedRangeName" disabled="@_busy">
                            @foreach (var range in _ranges) { <option value="@range.Id">@RangeName(range)</option> }
                        </select>
                        <label>区間名<input @bind="_managedRangeName" disabled="@_busy" /></label>
                        <CaptureTagsEditor Label="区間タグ" @bind-Tags="_managedRangeTags" AvailableTags="AvailableRangeTags" SuggestedTags="_gameSpeakers" Disabled="_busy" />
                        <div class="capture-history-actions">
                            <button class="secondary-button capture-text-button" @onclick="() => AtScopeAsync(displayedScope, () => SaveManagedRangeAsync(displayedProfile))" disabled="@_busy"><CaptureIcon Name="Check" />名前とタグを保存</button>
                            <button class="secondary-button capture-text-button" @onclick="() => AtScope(displayedScope, () => SetHistoryDialog(HistoryDialog.DeleteRange))" disabled="@_busy"><CaptureIcon Name="Trash" />区間を削除</button>
                        </div>
                    }
                </section>
                <section class="capture-history-section">
                    <h3>選択した記録範囲の全履歴</h3>
                    <p class="capture-muted">本文・名前の原文・区間を消去します。ゲーム登録・抽出設定・手動場面・接続・作品タグは残ります。</p>
                    <button class="secondary-button capture-text-button capture-danger" @onclick="() => AtScopeAsync(displayedScope, PrepareClearHistoryAsync)" disabled="@(_busy || (_historyCounts.Events == 0 && _historyCounts.Ranges == 0))"><CaptureIcon Name="Trash" />全履歴を消去…</button>
                </section>
                <section class="capture-history-section">
                    <div class="capture-cleanup-heading">
                        <h3>不要画像の後片付け</h3>
                        @if (_screenshotCleanup is { RemainingImageCount: > 0 } pending)
                        {
                            <div class="capture-cleanup-details"><CaptureFailureDetails Label="残件あり" Detail="@CleanupDetails(pending)" /></div>
                        }
                    </div>
                    <p class="capture-muted">すべてのゲームの未参照画像だけを整理します。本文や参照中の画像は削除しません。</p>
                    <button class="secondary-button capture-text-button" @onclick="RetryScreenshotCleanupAsync" disabled="@_busy"><CaptureIcon Name="Refresh" />不要画像の後片付けを再試行</button>
                </section>
            }
            else if (_historyDialog == HistoryDialog.DeleteSelected)
            {
                <p>選択した本文を含む @_deletionTargets.Count 件の原文（本文 @(_deletionTargets.Sum(x => x.ItemCount)) 件）を削除します。</p>
                <p class="capture-warning">同じ原文から分割された本文も、検索・分類の条件に関係なく削除します。元に戻せません。</p>
                <div class="capture-deletion-preview" aria-label="削除する原文">
                    @foreach (var target in _deletionTargets) { <article><small>本文 @target.ItemCount 件</small><p>@target.RawText</p></article> }
                </div>
                <p class="capture-muted">区間の位置は残り、削除した本文だけが区間表示から除かれます。</p>
            }
            else if (_historyDialog == HistoryDialog.Clear)
            {
                <p>選択した記録範囲の本文 @_historyCounts.Items 件、原文 @_historyCounts.Events 件（名前の受信を含む）、区間 @_historyCounts.Ranges 件をすべて消去します。</p>
                <p class="capture-warning">検索・分類・選択中の区間に関係なく、この記録範囲の全履歴が対象です。元に戻せません。</p>
                <p class="capture-warning">手動場面・接続・作品タグは残ります。消去した区間との関連は外れます。</p>
                <p>ゲーム登録・セーブデータ・抽出設定・他の記録範囲は変更しません。</p>
            }
            else if (_historyDialog == HistoryDialog.DeleteRange)
            {
                <p>区間「@ManagedRangeDisplayName」を削除します。</p>
                <p>区間と場面・タグとの関連だけを削除します。本文・画像・手動場面・接続・作品タグは残ります。区間の削除は元に戻せません。</p>
            }
            @if (_historyDialog is HistoryDialog.DeleteSelected or HistoryDialog.Clear && HistoryCaptureActive)
            {
                <div class="capture-history-section" role="status">
                    <p>このゲームは取得中です。削除するには取得を停止してください。ゲーム自体は終了しません。</p>
                    @if (ViewingLiveRecord)
                    {
                        <button class="secondary-button capture-text-button" @onclick="() => AtScopeAsync(displayedScope, () => StopHistoryCaptureAsync(displayedLive))" disabled="@_busy"><CaptureIcon Name="Stop" />取得を停止</button>
                    }
                </div>
            }
        </div>
        <footer class="capture-dialog-actions">
            <button class="secondary-button" @onclick="CloseEditors" disabled="@_busy">@(_historyDialog == HistoryDialog.Manage ? "閉じる" : "キャンセル")</button>
            @if (_historyDialog != HistoryDialog.Manage)
            {
                <button class="secondary-button capture-text-button capture-danger" @onclick="() => AtScopeAsync(displayedScope, () => ConfirmHistoryDeletionAsync(displayedProfile))" disabled="@(_busy || (_historyDialog != HistoryDialog.DeleteRange && HistoryCaptureActive))"><CaptureIcon Name="Trash" />@(_historyDialog == HistoryDialog.Clear ? "全履歴を消去" : "削除する")</button>
            }
        </footer>
    </section></div>
}

@code {
    private RenderFragment DialogFailure(string label) => @<div class="capture-dialog-feedback">
        @if (_error is not null) { <CaptureFailureDetails Label="@label" Detail="@_error" /> }
    </div>;
}

@if (_finishOpen && _finishTarget is { } finishTarget)
{
    <div class="modal-backdrop"><section id="capture-editor" class="capture-dialog" role="dialog" aria-modal="true" aria-labelledby="capture-finish-title">
        <header class="capture-dialog-header"><h2 id="capture-finish-title">記録を終了</h2>@DialogFailure("記録終了失敗")</header>
        <p>「@SelectedGameTitle」の記録を終了します。保存していない区間は終了すると残りません。</p>
        @if (!CanSaveBeforeFinish) { <p>末尾を固定できる本文がまだありません。</p> }
        <div class="capture-dialog-actions">
            <button type="button" class="secondary-button scenario-action" @onclick="BackFromFinish" disabled="@_busy">戻る</button>
            <button type="button" class="secondary-button scenario-action capture-danger" @onclick="() => AtScopeAsync(displayedScope, () => FinishDiscardingRangeAsync(finishTarget))" disabled="@_busy">区間を破棄して終了</button>
            <button type="button" class="launch-button scenario-action scenario-action--primary" @onclick="() => AtScopeAsync(displayedScope, () => OpenRangeForFinishAsync(finishTarget))" disabled="@(_busy || !CanSaveBeforeFinish)">区間を保存して終了</button>
        </div>
    </section></div>
}

@if (_rangeEditorOpen && displayedDraft is not null && displayedDraftTarget is not null)
{
    <div class="modal-backdrop"><section id="capture-editor" class="capture-dialog" role="dialog" aria-modal="true" aria-labelledby="capture-range-title">
        <header class="capture-dialog-header"><h2 id="capture-range-title">@(_finishTarget is null ? "区間" : "保存して記録を終了")</h2>@DialogFailure("区間の操作失敗")</header>
        <ScenarioRangeDraftEditor @key="displayedDraft" Name="@_rangeName" NameChanged="name => UpdateRangeDraft(displayedDraft, () => _rangeName = name)"
            Tags="_rangeTags" TagsChanged="tags => UpdateRangeDraft(displayedDraft, () => _rangeTags = tags)"
            AvailableTags="AvailableRangeTags" SuggestedTags="_gameSpeakers" Disabled="_busy"
            Save="() => AtScopeAsync(displayedScope, () => SaveRangeAsync(displayedDraft.Live ? displayedLive : displayedDraftTarget, displayedDraft))"
            Discard="() => AtScopeAsync(displayedScope, () => CancelRangeDraftAsync(displayedDraft.Live ? displayedLive : displayedDraftTarget, displayedDraft))"
            Close="HideRangeDraft" />
    </section></div>
}

@if (_settingsOpen)
{
    <div class="modal-backdrop"><section id="capture-editor" class="capture-dialog capture-settings-dialog" role="dialog" aria-modal="true" aria-labelledby="capture-settings-title">
        <header class="capture-dialog-header"><h2 id="capture-settings-title">抽出設定</h2>@DialogFailure("抽出の操作失敗")<button class="secondary-button capture-icon-button" title="閉じる" aria-label="閉じる" @onclick="CloseEditors" disabled="@_busy"><CaptureIcon Name="Close" /></button></header>
        <div class="capture-settings capture-dialog-body">
            @if (_settingsForConnection)
            {
                <nav class="capture-settings-tabs" aria-label="設定切替">
                    <button class="secondary-button" aria-pressed="@(_settingsTab == 0 ? "true" : "false")" @onclick="() => SetSettingsTab(0)"><CaptureIcon Name="Link" />接続</button>
                    <button class="secondary-button" aria-pressed="@(_settingsTab == 1 ? "true" : "false")" @onclick="() => SetSettingsTab(1)"><CaptureIcon Name="Receive" />取得元</button>
                    <button class="secondary-button" aria-pressed="@(_settingsTab == 2 ? "true" : "false")" @onclick="() => SetSettingsTab(2)"><CaptureIcon Name="Check" />判定</button>
                </nav>
            }
            @if (_settingsForConnection && _settingsTab == 0)
            {
                    <section class="capture-process-panel"><h3>ゲーム本体</h3>
                        <div class="capture-window-picker">
                            <button class="secondary-button capture-text-button" title="3秒後に前面のゲーム画面を選択" @onclick="PickWindowAsync" disabled="@(_busy || _snapshot.Connecting || _windowCountdown > 0)"><CaptureIcon Name="Pick" />画面から選択</button>
                            <span class="capture-setting-status" role="status">@(_windowCountdown > 0 ? $"ゲームを前面に — {_windowCountdown}" : SelectedProcess?.WindowTitle)</span>
                            <button class="secondary-button capture-icon-button @(_windowCountdown == 0 ? "capture-hidden" : "")" title="画面選択を中止" aria-label="画面選択を中止" @onclick="CancelWindowPick"><CaptureIcon Name="Close" /></button>
                        </div>
                        <div class="capture-setting-row">
                            <select aria-label="探し方" value="@(_windowsOnly ? "window" : "all")" @onchange="ChangeProcessMode"><option value="window">ウィンドウ</option><option value="all">全プロセス</option></select>
                            <button class="secondary-button capture-icon-button" title="一覧を更新" aria-label="一覧を更新" @onclick="FindProcesses" disabled="@_busy"><CaptureIcon Name="Refresh" /></button>
                        </div>
                        <input type="search" placeholder="タイトル・プロセス名・PID・パス" aria-label="プロセスを検索" @bind="_processSearch" @bind:event="oninput" />
                        <div class="capture-process-list" aria-label="ゲーム本体プロセス" role="group">
                            @foreach (var process in VisibleProcesses)
                            {
                                <button class="capture-process secondary-button" aria-pressed="@(process.Id == _processId ? "true" : "false")" @onclick="() => SelectProcess(process.Id, displayedSetup)" disabled="@(_busy || _snapshot.Connecting || displayedSetup != _settingsTarget)">
                                    <strong>@(string.IsNullOrEmpty(process.WindowTitle) ? process.Name : process.WindowTitle)</strong>
                                    <span>@process.Name · PID @process.Id</span><small>@process.Path</small>
                                </button>
                            }
                            @if (!VisibleProcesses.Any()) { <p class="capture-empty">@(_windowsOnly ? "該当するウィンドウなし" : "該当するプロセスなし")</p> }
                        </div>
                        <div class="capture-process-action">
                            <span class="capture-setting-status">@(_snapshot.Connected && !_snapshot.Preview ? "切替は現在の記録を終了" : "")</span>
                            <button class="launch-button capture-text-button" @onclick="() => ConnectAsync(displayedSetup, displayedProcessId)" disabled="@(_busy || _snapshot.Connecting || _windowCountdown > 0 || SelectedProcess is null || _snapshot.Profile is null || displayedSetup != _settingsTarget)"><CaptureIcon Name="Link" />テスト接続</button>
                        </div>
                    </section>
            }
            else if (_settingsForConnection && _settingsTab == 1)
            {
                <div class="capture-source-toolbar">
                    <input type="search" placeholder="画面の文章で検索" aria-label="受信した文章を検索" @bind="_sourceSearch" @bind:event="oninput" />
                    <button class="secondary-button capture-icon-button" title="@(_pausedCandidates is null ? "一覧の表示を停止（受信は継続）" : "一覧の表示を再開")" aria-label="@(_pausedCandidates is null ? "一覧の表示を停止" : "一覧の表示を再開")" aria-pressed="@(_pausedCandidates is not null ? "true" : "false")" @onclick="ToggleSourcePause"><CaptureIcon Name="@(_pausedCandidates is null ? "Pause" : "Play")" /></button>
                </div>
                <div class="capture-source-grid">
                    <div class="capture-candidate-list" role="group" aria-label="取得元の比較">
                        @foreach (var candidate in VisibleCandidates)
                        {
                            <button @key="candidate.Source.Key" class="secondary-button capture-candidate @(_updatedSources.Contains(candidate.Source.Key) && _pausedCandidates is null ? "capture-updated" : "")" aria-pressed="@(candidate.Source.Key == _candidateKey ? "true" : "false")" @onclick="() => _candidateKey = candidate.Source.Key">
                                <span class="capture-candidate-heading"><span>@CandidateUseName(candidate)</span><small>@candidate.Source.HookName</small></span>
                                <span class="capture-sample-summary">@string.Join("\n", candidate.Samples.TakeLast(3).Select(x => x.Text))</span>
                            </button>
                        }
                        @if (!VisibleCandidates.Any()) { <p class="capture-empty">@(!_snapshot.Connected ? "先にテスト接続" : _snapshot.Candidates.Length == 0 ? "ゲームの文章を進めてください" : "一致する文章なし")</p> }
                    </div>
                    <section class="capture-source-panel">
                        <label>用途<select aria-label="候補の用途" value="@CandidateUse(CurrentCandidate)" @onchange="ChangeCandidateUseAsync" disabled="@(_busy || CurrentCandidate is null || !_snapshot.Connected)">
                            <option value="none">取得しない</option><option value="body">本文（自動判定）</option><option value="name">名前</option><option value="dialogue">セリフ</option><option value="narration">地の文</option>
                        </select></label>
                        <div class="capture-samples" aria-label="選択した取得元の受信履歴">
                            @if (CurrentCandidate is { } current)
                            {
                                @foreach (var sample in current.Samples)
                                {
                                    <div class="capture-sample" @key="sample.Sequence">
                                        <p>@sample.Text</p>
                                        @if (sample.Truncated) { <small class="capture-warning">先頭1500文字</small> }
                                    </div>
                                }
                            }
                            else { <p class="capture-empty">取得元を選択</p> }
                        </div>
                        <details class="capture-source-details"><summary>取得元の詳細</summary><small class="capture-diagnostics">@(CurrentCandidate is { } detail ? $"{detail.Source.HookCode} / {detail.Source.Context:x} / {detail.Source.Context2:x}" : "—")</small></details>
                    </section>
                </div>
            }
            else if (_profile is not null)
            {
                <div class="@(_settingsForConnection ? "capture-result-grid" : "capture-rules-only")">
                    <section class="capture-rules"><h3>自動判定</h3>
                        <label><input type="checkbox" @bind="_split" @bind:after="PreviewRulesAsync" /> 「…」はセリフ</label>
                        <label><input type="checkbox" @bind="_outside" @bind:after="PreviewRulesAsync" disabled="@(!_split)" /> 括弧の外は地の文</label>
                    </section>
                    @if (_settingsForConnection)
                    {
                    <section class="capture-result-panel"><h3>仕上がり <small>直近の受信</small></h3>
                        <div class="capture-result-feed">
                            @foreach (var item in _snapshot.PreviewItems)
                            {
                                <article class="capture-preview-item"><header><span>@(item.LabelName ?? "未判定")</span><span>@(item.Kind == CaptureKind.Narration ? "" : item.Speaker ?? "話者未確定")</span></header><p>@item.Text</p></article>
                            }
                            @if (_snapshot.PreviewItems.Length == 0) { <p class="capture-empty">@(!_snapshot.Preview ? "テスト接続で確認" : !_snapshot.Candidates.Any(x => x.Role == CaptureRole.Body) ? "本文の取得元を選択" : "本文待ち")</p> }
                        </div>
                        <small class="capture-preview-limit capture-warning">@(_snapshot.Preview && _snapshot.Candidates.Any(x => x.Role != CaptureRole.None && x.Samples.Any(s => s.Truncated)) ? "1500文字を超える受信は判定プレビュー対象外" : "")</small>
                    </section>
                    }
                </div>
            }
        </div>
        <footer class="capture-settings-footer">
            <span class="capture-setting-status" role="status">
                @if (_settingsForConnection && CaptureStatusLabel != _snapshot.Status) { <CaptureFailureDetails Label="@CaptureStatusLabel" Detail="@_snapshot.Status" /> }
                else { @(_settingsForConnection ? CaptureStatusLabel : "保存済み本文は自動で変更しません") }
            </span>
            @if (_settingsForConnection && _settingsTab < 2)
            {
                <button class="secondary-button capture-text-button" @onclick="() => SetSettingsTab(_settingsTab == 0 ? 1 : 2)" disabled="@(!_snapshot.Connected)"><CaptureIcon Name="Next" />@(_settingsTab == 0 ? "取得元" : "判定を確認")</button>
            }
            else if (_settingsForConnection && _snapshot.Preview)
            {
                <button class="launch-button capture-text-button" @onclick="() => ConfirmProcessAsync(displayedSetup)" disabled="@(_busy || !_snapshot.Connected || !_snapshot.Preview || !_snapshot.Candidates.Any(x => x.Role == CaptureRole.Body))"><CaptureIcon Name="Check" />確定して記録</button>
            }
            else
            {
                <button class="launch-button capture-text-button" @onclick="SaveRulesAsync" disabled="@_busy"><CaptureIcon Name="Check" />新着に適用</button>
            }
        </footer>
    </section></div>
}

@if (_bulkOpen)
{
    <div class="modal-backdrop"><section id="capture-editor" class="capture-dialog" role="dialog" aria-modal="true" aria-labelledby="capture-bulk-title">
        <header class="capture-dialog-header"><h2 id="capture-bulk-title">一括修正 · @_selected.Count</h2>@DialogFailure("一括修正失敗")<button class="secondary-button capture-icon-button" title="キャンセル" aria-label="キャンセル" @onclick="CloseEditors" disabled="@_busy"><CaptureIcon Name="Close" /></button></header>
