    /// <summary>Writes the applied history selection to a new file after revalidating its scope.</summary>
    private async Task WriteExportAsync(ExportFormat exportFormat, string profileTitle)
    {
        var expected = _displayedScope;
        var recordId = _recordId;
        var scopeTitle = _scopeLabel;
        var rangeName = _ranges.FirstOrDefault(x => x.Id == _rangeId)?.Name;
        // Both ZIP modes keep the existing access-level mapping and selection.
        var archive = exportFormat != ExportFormat.Text;
        var accessLevel = exportFormat == ExportFormat.Full ? ScenarioMaterialAccessLevel.Full : ScenarioMaterialAccessLevel.Structure;
        var selection = new ScenarioArchiveSelection(RangeId: _rangeId == 0 ? null : _rangeId,
            UnclassifiedOnly: _filter == "none", Kind: FilterKind, TextSearch: _textSearch, SpeakerSearch: _speakerSearch,
            IncludeTags: _exportIncludeTags.ToArray(), ExcludeTags: _exportExcludeTags.ToArray());
        var format = archive ? accessLevel == ScenarioMaterialAccessLevel.Structure ? "構造情報ZIP" : "完全版ZIP" : "本文TXT";
        var folder = await Picker.PickFolderPathAsync($"{format}の保存先フォルダを選択");
        if (folder is null) return;
        await RequireCurrentScopeAsync(expected);
        var title = string.Concat(string.Join("-", new[] { profileTitle, scopeTitle, rangeName }.OfType<string>())
            .Select(x => Path.GetInvalidFileNameChars().Contains(x) ? '_' : x));
        var modeSuffix = archive ? accessLevel == ScenarioMaterialAccessLevel.Structure ? "-structure" : "-full" : "";
        var path = Path.Combine(folder, $"{title}{modeSuffix}-{DateTime.Now:yyyyMMdd-HHmmss-fff}.{(archive ? "zip" : "txt")}");
        // ZIP uses the shared projection and archive writer.
        if (archive) await Task.Run(() => ScreenshotStore.ExportScenarioArchiveAsync(recordId, selection, path, accessLevel));
        else
        {
            // TXT exports the effective text in history order without archive metadata.
            var items = await Task.Run(() => Store.GetCaptureExportItemsAsync(recordId, selection));
            await using var file = new FileStream(path, FileMode.CreateNew, FileAccess.Write);
            await using var writer = new StreamWriter(file, new UTF8Encoding(false));
            await writer.WriteAsync(ScenarioTextProcessor.FormatTxt(items));
            await writer.FlushAsync();
        }
        CloseEditors(); _message = $"{format}を保存しました：{Path.GetFileName(path)}";
    }
