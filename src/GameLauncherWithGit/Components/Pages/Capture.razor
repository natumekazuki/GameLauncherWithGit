    private Task CancelRangeDraftAsync(PlayRecordingTarget expected, PlayRecordingRangeSelection draft) => RunAsync(async () =>
    {
        RequireRangeDraft(expected, draft);
        if (draft.Live)
        {
            // The shared service owns cancellation of a live range visible to both recorders.
            await RecordingOperations.CancelDesktopRangeAsync(expected, draft);
            _pendingLiveRange = null;
            _snapshot = CaptureService.Snapshot;
        }
        ClearRangeDraft();
        if (_finishTarget is not null) BackFromFinish();
        else _restoreFocus = true;
        _message = "区間指定を破棄しました。";
