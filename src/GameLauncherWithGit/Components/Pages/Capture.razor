        _profiles = _profiles.Select(x => x.Id == _profile.Id ? _profile : x).ToArray();
    }
    private bool IsNarration(long id) => _labels.FirstOrDefault(x => x.Id == id)?.Kind == CaptureKind.Narration;
    private void Edit(CaptureTextItem item) { _error = null; _edit = item; _editLabel = item.LabelId ?? 0; _editSpeaker = item.Speaker ?? ""; _following = false; _focusEditor = true; }
    private bool EditLabelChanged(CaptureTextItem item) => (item.LabelId ?? 0) != _editLabel;
    // A narration label hides the speaker; it does not erase the stored value.
    private bool EditSpeakerChanged(CaptureTextItem item) => !IsNarration(_editLabel) && _editSpeaker.Trim() != (item.Speaker ?? "");
    private Task SaveEditAsync(PlayRecordingTarget target) => RunAsync(async () =>
    {
        if (_edit is not { } item) return;
        var changeLabel = EditLabelChanged(item);
        var changeSpeaker = EditSpeakerChanged(item);
        if (!changeLabel && !changeSpeaker) return;
        await WriteHistoryAsync(target, recordId => Store.CorrectCaptureItemAsync(recordId, item, changeLabel,
            _editLabel == 0 ? null : _editLabel, changeSpeaker, _editSpeaker));
        CloseEditors();
        await LoadItemsAsync();
        _message = "訂正を保存しました。";
    });
    private Task OpenPartitionAsync(CaptureTextItem item) => RunAsync(async () =>
    {
        _partition = item; _following = false;
        _focusEditor = true;
        var original = (await Store.GetCaptureItemsAsync(item.SessionId, 0)).Where(x => x.Sequence == item.Sequence).ToArray();
        _boundaries.Clear(); _boundaries.AddRange(original.SkipLast(1).Select(x => x.Start + x.Length));
        _parts = original.Select(x => new PartDraft { Text = x.Text, Label = x.LabelId ?? 0, Speaker = x.Speaker ?? "" }).ToList();
    });
    private void RebuildParts()
    {
        if (_partition is null) return;
        var start = 0; _parts = [];
        foreach (var end in _boundaries.Append(_partition.RawText.Length)) { _parts.Add(new() { Text = _partition.RawText[start..end] }); start = end; }
    }
    private Task AddBoundaryAsync() => RunAsync(async () => { if (_partition is null || _module is null) return; var position = await _module.InvokeAsync<int>("selectionStart", _rawInput); var next = _boundaries.Append(position).Distinct().Order().ToArray(); ScenarioTextProcessor.ValidateBoundaries(_partition.RawText, next); _boundaries.Clear(); _boundaries.AddRange(next); RebuildParts(); });
    private void RemoveBoundary(int index) { _boundaries.RemoveAt(index); RebuildParts(); }
    private Task SavePartitionAsync(PlayRecordingTarget target) => RunAsync(async () =>
    {
        if (_partition is not { } partition) return;
        var boundaries = _boundaries.ToArray();
        var parts = _parts.Select(x => new CaptureManualPart(x.Label == 0 ? null : x.Label,
            IsNarration(x.Label) || string.IsNullOrWhiteSpace(x.Speaker) ? null : x.Speaker.Trim())).ToArray();
        await WriteHistoryAsync(target, _ => Store.SplitCaptureEventAsync(partition.SessionId, partition.Sequence, boundaries, parts));
        CloseEditors(); _selected.Clear(); await LoadItemsAsync();
    }, "分割を保存しました。");
    /// <summary>Closes the active dialog and restores focus to its entry point.</summary>
