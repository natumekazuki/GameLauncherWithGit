        _rangeSelection = new(_profileId, _rangeFirst!.StartPosition, _rangeLast!.EndPosition); _rangeName = ""; _focusEditor = true;
    }
    private Task SaveRangeAsync() => RunAsync(async () =>
    {
        if (_rangeSelection is null) return;
        await CaptureService.FlushPendingAsync();
        await Store.SaveCaptureRangeAsync(_rangeSelection.CaptureGameId, _rangeName, _rangeSelection.Start, _rangeSelection.End);
        if (_profileId == _rangeSelection.CaptureGameId) _ranges = await Store.GetCaptureRangesAsync(_profileId);
