    private async Task LoadFlowAsync()
    {
        var expected = _displayedScope;
        if (expected is null) return;
        var recordId = expected.RecordId;
        try
        {
            for (var attempt = 0; attempt < 2; attempt++)
            {
                var material = await Task.Run(() => MaterialReader.GetScenarioMaterialAsync(recordId, new()));
                var overrides = await Store.GetScenarioFlowOverridesAsync(recordId);
                var version = await MaterialReader.GetScenarioMaterialVersionAsync(recordId);
                if (material.Version != version) continue;
                var graph = await Task.Run(() => ScenarioFlowMaterialAdapter.Build(material, overrides));
                if (!await CanPublishAsync(expected)) return;
                _flowGraph = graph;
                _flowMatchingComplete = material.MatchingComplete;
                return;
            }
            throw new InvalidOperationException("記録が更新されました。フローチャートを更新して再試行してください。");
        }
        catch { _flowGraph = null; throw; }
    }
