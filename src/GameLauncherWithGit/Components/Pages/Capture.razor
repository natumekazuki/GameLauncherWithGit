@page "/capture"
@using GameLauncherWithGit.Application.Models
@using GameLauncherWithGit.Application.Services
@using GameLauncherWithGit.Infrastructure.Abstractions
@using GameLauncherWithGit.Components
@using System.Text
@implements IAsyncDisposable
@inject IScenarioCaptureStore Store
@inject ScenarioCaptureService CaptureService
@inject IPathPickerService Picker
@inject IJSRuntime JS

<PageTitle>シナリオ抽出</PageTitle>
<section class="capture-page">
    <header class="capture-header">
        <div class="capture-heading">
            <a class="secondary-button capture-icon-button" href="/" title="ゲーム一覧" aria-label="ゲーム一覧"><CaptureIcon Name="Back" /></a>
            <h1>シナリオ</h1>
        </div>
        <div class="capture-tabs" aria-label="表示切替">
            <button class="secondary-button capture-icon-button" title="取得中" aria-label="取得中のゲーム" aria-pressed="@(_live ? "true" : "false")" @onclick="ShowLiveAsync"><CaptureIcon Name="Live" /></button>
            <button class="secondary-button capture-icon-button" title="履歴" aria-label="保存履歴" aria-pressed="@(!_live ? "true" : "false")" @onclick="ShowHistoryAsync"><CaptureIcon Name="History" /></button>
        </div>
    </header>
    @if (_loading) { <p role="status">読込中…</p> }
    else
    {
        @if (_live)
        {
            <div class="capture-livebar">
                <strong class="capture-game-title">@(_snapshot.Profile?.Title ?? "ゲームなし")</strong>
                <div class="capture-play-range" aria-label="プレイ中の区間指定">
                    <span class="capture-range-caption">区間</span>
                    <button class="launch-button capture-icon-button" title="区間を開始" aria-label="ここから開始" @onclick="StartLiveRangeAsync" disabled="@(_busy || !_snapshot.Connected || _snapshot.Preview || _snapshot.RangeStart is not null)"><CaptureIcon Name="Play" /></button>
                    <button class="launch-button capture-icon-button" title="区間を終了" aria-label="ここまでで終了" @onclick="EndLiveRangeAsync" disabled="@(_busy || _snapshot.RangeStart is null)"><CaptureIcon Name="Stop" /></button>
                    <button class="secondary-button capture-icon-button" title="区間指定を取消" aria-label="区間指定を取消" @onclick="CancelLiveRange" disabled="@(_busy || _snapshot.RangeStart is null)"><CaptureIcon Name="Close" /></button>
                </div>
                <div class="capture-live-details">
                    <span class="capture-connection" role="status" title="@_snapshot.Status">@_snapshot.Status</span>
                    <span class="capture-count" title="今回の受信" aria-label="@($"今回の受信 {_snapshot.Received}件")"><CaptureIcon Name="Receive" />@_snapshot.Received</span>
                    <span class="capture-count" title="今回の保存" aria-label="@($"今回の保存 {_snapshot.Saved}件")"><CaptureIcon Name="Save" />@_snapshot.Saved</span>
                    <span class="capture-loss @(_snapshot.Lost == 0 ? "capture-hidden" : "")" title="未保存・破棄（未選択候補を含む）" aria-label="@($"未保存・破棄 {_snapshot.Lost}件、未選択候補を含む")"><CaptureIcon Name="Warning" />@_snapshot.Lost</span>
                    <span class="capture-range-active @(_snapshot.RangeStart is null ? "capture-hidden" : "")" role="status">区間指定中</span>
                </div>
            </div>
        }
        <section class="capture-content" aria-busy="@(_busy ? "true" : "false")">
            <div class="capture-filters @(_live ? "capture-filters-live" : "")">
                @if (!_live)
                {
                    <label class="capture-filter" title="ゲーム"><CaptureIcon Name="Game" /><select aria-label="ゲーム" value="@_profileId" @onchange="ChangeProfileAsync" disabled="@_busy">
                        <option value="0">ゲームを選択</option>
                        @foreach (var profile in _profiles) { <option value="@profile.Id">@profile.Title@(profile.GameId is null ? "（登録なし）" : "")</option> }
                    </select></label>
                }
                <label class="capture-filter" title="区間"><CaptureIcon Name="Range" /><select aria-label="区間" @bind="_rangeId" @bind:after="ChangeRangeAsync" disabled="@_busy">
                    <option value="0">ゲーム全体</option>
                    @foreach (var range in _ranges) { <option value="@range.Id">@RangeName(range)</option> }
                </select></label>
                <label class="capture-filter" title="分類"><CaptureIcon Name="Tag" /><select aria-label="分類" @bind="_filter" @bind:after="FilterAsync" disabled="@_busy">
                    <option value="all">すべて</option><option value="none">未判定</option>
                    <option value="dialogue">セリフ</option><option value="narration">地の文</option>
                </select></label>
            </div>
            <div class="capture-tools">
                <div class="capture-tool-group capture-view-tools">
                    @if (LatestOrder)
                    {
                        <button class="secondary-button capture-icon-button" title="@(_following ? "末尾に追従中" : "末尾へ戻る")" aria-label="末尾を表示" aria-pressed="@(_following ? "true" : "false")" @onclick="FollowAsync" disabled="@(_busy || _following || _selected.Count > 0 || _pickingRange)"><CaptureIcon Name="Follow" /></button>
                    }
                    else
                    {
                        <button class="secondary-button capture-icon-button" title="前の200件" aria-label="前の200件" @onclick="PreviousAsync" disabled="@(_busy || _offset == 0)"><CaptureIcon Name="Previous" /></button>
                        <span class="capture-page-count">@(_items.Count == 0 ? "0" : $"{_offset + 1}–{_offset + _items.Count}")</span>
                        <button class="secondary-button capture-icon-button" title="次の200件" aria-label="次の200件" @onclick="NextAsync" disabled="@(_busy || _items.Count < 200)"><CaptureIcon Name="Next" /></button>
                        <button class="secondary-button capture-icon-button" title="更新" aria-label="更新" @onclick="RefreshAsync" disabled="@_busy"><CaptureIcon Name="Refresh" /></button>
                    }
                </div>
                <div class="capture-tool-group" aria-label="本文で区間指定">
                    <button class="secondary-button capture-icon-button" title="本文から区間を指定" aria-label="本文で区間指定" aria-pressed="@(_pickingRange ? "true" : "false")" @onclick="ToggleTextRange" disabled="@(_busy || _profileId == 0)"><CaptureIcon Name="Pick" /></button>
                    <button class="secondary-button capture-icon-button" title="区間を保存" aria-label="区間を保存" @onclick="OpenTextRange" disabled="@(_busy || !TextRangeValid)"><CaptureIcon Name="Save" /></button>
                    <button class="secondary-button capture-icon-button" title="本文の区間指定を解除" aria-label="本文の区間指定を解除" @onclick="ClearTextRangeAsync" disabled="@(_busy || !_pickingRange)"><CaptureIcon Name="Close" /></button>
                </div>
                <div class="capture-tool-group capture-bulk" aria-label="本文の修正" title="@(_rangeId != 0 ? "修正はゲーム全体で" : "本文の修正")">
                    <input type="checkbox" aria-label="表示分を選択" title="表示分を選択" checked="@(_items.Count > 0 && _selected.Count == _items.Count)" @onchange="SelectPage" disabled="@(_busy || _items.Count == 0 || !CanEdit)" />
                    <span class="capture-selection-count" aria-label="@($"{_selected.Count}件選択")">@_selected.Count</span>
                    <button class="secondary-button capture-icon-button" title="一括修正" aria-label="一括修正" @onclick="OpenBulk" disabled="@(_busy || _selected.Count == 0)"><CaptureIcon Name="BulkEdit" /></button>
                    <button class="secondary-button capture-icon-button" title="選択解除" aria-label="選択解除" @onclick="ClearSelection" disabled="@(_busy || _selected.Count == 0)"><CaptureIcon Name="ClearSelection" /></button>
                </div>
                <div class="capture-tool-group capture-utilities">
                    <button class="secondary-button capture-icon-button" title="抽出設定" aria-label="抽出設定" @onclick="OpenSettings" disabled="@_busy"><CaptureIcon Name="Settings" /></button>
                    <button class="secondary-button capture-icon-button" title="TXT出力（条件の全件）" aria-label="条件の全件をTXT出力" @onclick="ExportAsync" disabled="@(_busy || _profileId == 0)"><CaptureIcon Name="Export" /></button>
                </div>
            </div>
            <div class="capture-range-summary" role="status" aria-label="@TextRangeSummary" title="@TextRangeSummary">
                @if (_pickingRange)
                {
                    <span><CaptureIcon Name="Start" />@(_rangeFirst is null ? "—" : CandidatePreview(_rangeFirst.Text))</span>
                    <span><CaptureIcon Name="End" />@(_rangeLast is null ? "—" : CandidatePreview(_rangeLast.Text))</span>
                }
            </div>
            <div class="capture-feed" @ref="_feed" tabindex="0" aria-label="抽出本文">
                @if (_items.Count == 0) { <p class="capture-empty">@EmptyMessage</p> }
                @foreach (var item in _items)
                {
                    <article class="capture-item @(IsRangeEdge(item) ? "capture-range-edge" : "")" @key="item.Id">
                        <header>
                            <input type="checkbox" aria-label="この本文を選択" title="選択" checked="@_selected.Contains(item.Id)" @onchange="e => SelectItem(item.Id, e.Value is true)" disabled="@(_busy || !CanEdit)" />
                            <span class="capture-label" title="@(item.LabelName ?? "未判定")">@(item.LabelName ?? "未判定")</span>
                            <strong class="capture-speaker" title="@item.Speaker">
                                @if (item.Kind == CaptureKind.Dialogue || item.Kind is null)
                                {
                                    @if (item.Speaker is not null) { @item.Speaker }
                                    else { <span title="話者未確定" aria-label="話者未確定"><CaptureIcon Name="User" /></span> }
                                }
                            </strong>
                            <span class="capture-manual @(item.ManualLabel || item.ManualSpeaker || item.ManualBoundaries ? "" : "capture-hidden")" title="手動修正" aria-label="手動修正"><CaptureIcon Name="Edit" /></span>
                            @if (_pickingRange)
                            {
                                <button class="secondary-button capture-icon-button" title="ここから" aria-label="ここから" aria-pressed="@(item.StartPosition == _rangeFirst?.StartPosition ? "true" : "false")" @onclick="() => PickRangeStart(item)" disabled="@_busy"><CaptureIcon Name="Start" /></button>
                                <button class="secondary-button capture-icon-button" title="ここまで" aria-label="ここまで" aria-pressed="@(item.EndPosition == _rangeLast?.EndPosition ? "true" : "false")" @onclick="() => PickRangeEnd(item)" disabled="@_busy"><CaptureIcon Name="End" /></button>
                            }
                            else
                            {
                                <button class="secondary-button capture-icon-button" title="@(_rangeId != 0 ? "修正はゲーム全体で" : "修正")" aria-label="修正" @onclick="() => Edit(item)" disabled="@(_busy || !CanEdit)"><CaptureIcon Name="Edit" /></button>
                                <button class="secondary-button capture-icon-button" title="@(_rangeId != 0 ? "分割はゲーム全体で" : "原文・分割")" aria-label="原文・分割" @onclick="() => OpenPartitionAsync(item)" disabled="@(_busy || !CanEdit)"><CaptureIcon Name="Split" /></button>
                            }
                        </header>
                        <p>@item.Text</p>
                    </article>
                }
            </div>
        </section>
    }
</section>

@if (_message is not null || _error is not null)
{
    <div class="capture-feedback @(_error is null ? "capture-message" : "capture-error")">
        <span role="@(_error is null ? "status" : "alert")">@(_error ?? _message)</span>
        <button class="secondary-button capture-icon-button" title="閉じる" aria-label="通知を閉じる" @onclick="() => { _message = null; _error = null; }"><CaptureIcon Name="Close" /></button>
    </div>
}

@if (_rangeSelection is not null)
{
    <div class="modal-backdrop"><section id="capture-editor" class="capture-dialog" role="dialog" aria-modal="true" aria-labelledby="capture-range-title">
        <header class="capture-dialog-header"><h2 id="capture-range-title">区間</h2><button class="secondary-button capture-icon-button" title="キャンセル" aria-label="キャンセル" @onclick="CloseEditors" disabled="@_busy"><CaptureIcon Name="Close" /></button></header>
        <label>名前<input @bind="_rangeName" /></label>
        <div class="capture-dialog-actions"><button class="launch-button capture-icon-button" title="保存" aria-label="保存" @onclick="SaveRangeAsync" disabled="@_busy"><CaptureIcon Name="Check" /></button></div>
    </section></div>
}

@if (_settingsOpen)
{
    <div class="modal-backdrop"><section id="capture-editor" class="capture-dialog capture-settings-dialog" role="dialog" aria-modal="true" aria-labelledby="capture-settings-title">
        <header class="capture-dialog-header"><h2 id="capture-settings-title">抽出設定</h2><button class="secondary-button capture-icon-button" title="閉じる" aria-label="閉じる" @onclick="CloseEditors" disabled="@_busy"><CaptureIcon Name="Close" /></button></header>
        <div class="capture-settings capture-dialog-body">
            @if (_live)
            {
                <nav class="capture-settings-tabs" aria-label="設定切替">
                    <button class="secondary-button" aria-pressed="@(_settingsTab == 0 ? "true" : "false")" @onclick="() => SetSettingsTab(0)"><CaptureIcon Name="Link" />接続</button>
                    <button class="secondary-button" aria-pressed="@(_settingsTab == 1 ? "true" : "false")" @onclick="() => SetSettingsTab(1)"><CaptureIcon Name="Receive" />取得元</button>
                    <button class="secondary-button" aria-pressed="@(_settingsTab == 2 ? "true" : "false")" @onclick="() => SetSettingsTab(2)"><CaptureIcon Name="Check" />判定</button>
                </nav>
            }
            @if (_live && _settingsTab == 0)
            {
                    <section class="capture-process-panel"><h3>ゲーム本体</h3>
                        <div class="capture-window-picker">
                            <button class="secondary-button capture-text-button" title="3秒後に前面のゲーム画面を選択" @onclick="PickWindowAsync" disabled="@(_busy || _snapshot.Connecting || _windowCountdown > 0)"><CaptureIcon Name="Pick" />画面から選択</button>
                            <span class="capture-setting-status" role="status">@(_windowCountdown > 0 ? $"ゲームを前面に — {_windowCountdown}" : SelectedProcess?.WindowTitle)</span>
                            <button class="secondary-button capture-icon-button @(_windowCountdown == 0 ? "capture-hidden" : "")" title="画面選択を中止" aria-label="画面選択を中止" @onclick="CancelWindowPick"><CaptureIcon Name="Close" /></button>
                        </div>
                        <div class="capture-setting-row">
                            <select aria-label="探し方" value="@(_windowsOnly ? "window" : "all")" @onchange="ChangeProcessMode"><option value="window">ウィンドウ</option><option value="all">全プロセス</option></select>
                            <button class="secondary-button capture-icon-button" title="一覧を更新" aria-label="一覧を更新" @onclick="FindProcesses" disabled="@_busy"><CaptureIcon Name="Refresh" /></button>
                        </div>
                        <input type="search" placeholder="タイトル・プロセス名・PID・パス" aria-label="プロセスを検索" @bind="_processSearch" @bind:event="oninput" />
                        <div class="capture-process-list" aria-label="ゲーム本体プロセス" role="group">
                            @foreach (var process in VisibleProcesses)
                            {
                                <button class="capture-process secondary-button" aria-pressed="@(process.Id == _processId ? "true" : "false")" @onclick="() => SelectProcess(process.Id)" disabled="@(_busy || _snapshot.Connecting)">
                                    <strong>@(string.IsNullOrEmpty(process.WindowTitle) ? process.Name : process.WindowTitle)</strong>
                                    <span>@process.Name · PID @process.Id</span><small>@process.Path</small>
                                </button>
                            }
                            @if (!VisibleProcesses.Any()) { <p class="capture-empty">@(_windowsOnly ? "該当するウィンドウなし" : "該当するプロセスなし")</p> }
                        </div>
                        <div class="capture-process-action">
                            <span class="capture-setting-status">@(_snapshot.Connected && !_snapshot.Preview ? "切替は現在の記録を終了" : "")</span>
                            <button class="launch-button capture-text-button" @onclick="ConnectAsync" disabled="@(_busy || _snapshot.Connecting || _windowCountdown > 0 || SelectedProcess is null || _snapshot.Profile is null)"><CaptureIcon Name="Link" />テスト接続</button>
                        </div>
                    </section>
            }
            else if (_live && _settingsTab == 1)
            {
                <div class="capture-source-toolbar">
                    <input type="search" placeholder="画面の文章で検索" aria-label="受信した文章を検索" @bind="_sourceSearch" @bind:event="oninput" />
                    <button class="secondary-button capture-icon-button" title="@(_pausedCandidates is null ? "一覧の表示を停止（受信は継続）" : "一覧の表示を再開")" aria-label="@(_pausedCandidates is null ? "一覧の表示を停止" : "一覧の表示を再開")" aria-pressed="@(_pausedCandidates is not null ? "true" : "false")" @onclick="ToggleSourcePause"><CaptureIcon Name="@(_pausedCandidates is null ? "Pause" : "Play")" /></button>
                </div>
                <div class="capture-source-grid">
                    <div class="capture-candidate-list" role="group" aria-label="取得元の比較">
                        @foreach (var candidate in VisibleCandidates)
                        {
                            <button @key="candidate.Source.Key" class="secondary-button capture-candidate @(_updatedSources.Contains(candidate.Source.Key) && _pausedCandidates is null ? "capture-updated" : "")" aria-pressed="@(candidate.Source.Key == _candidateKey ? "true" : "false")" @onclick="() => _candidateKey = candidate.Source.Key">
                                <span class="capture-candidate-heading"><span>@CandidateUseName(candidate)</span><small>@candidate.Source.HookName</small></span>
                                <span class="capture-sample-summary">@string.Join("\n", candidate.Samples.TakeLast(3).Select(x => x.Text))</span>
                            </button>
                        }
                        @if (!VisibleCandidates.Any()) { <p class="capture-empty">@(!_snapshot.Connected ? "先にテスト接続" : _snapshot.Candidates.Length == 0 ? "ゲームの文章を進めてください" : "一致する文章なし")</p> }
                    </div>
                    <section class="capture-source-panel">
                        <label>用途<select aria-label="候補の用途" value="@CandidateUse(CurrentCandidate)" @onchange="ChangeCandidateUseAsync" disabled="@(_busy || CurrentCandidate is null || !_snapshot.Connected)">
                            <option value="none">取得しない</option><option value="body">本文（自動判定）</option><option value="name">名前</option><option value="dialogue">セリフ</option><option value="narration">地の文</option>
                        </select></label>
                        <div class="capture-samples" aria-label="選択した取得元の受信履歴">
                            @if (CurrentCandidate is { } current)
                            {
                                @foreach (var sample in current.Samples)
                                {
                                    <div class="capture-sample" @key="sample.Sequence">
                                        <p>@sample.Text</p>
                                        @if (sample.Truncated) { <small class="capture-warning">先頭1500文字</small> }
                                    </div>
                                }
                            }
                            else { <p class="capture-empty">取得元を選択</p> }
                        </div>
                        <details class="capture-source-details"><summary>取得元の詳細</summary><small class="capture-diagnostics">@(CurrentCandidate is { } detail ? $"{detail.Source.HookCode} / {detail.Source.Context:x} / {detail.Source.Context2:x}" : "—")</small></details>
                    </section>
                </div>
            }
            else if (_profile is not null)
            {
                <div class="@(_live ? "capture-result-grid" : "capture-rules-only")">
                    <section class="capture-rules"><h3>自動判定</h3>
                        <label><input type="checkbox" @bind="_split" @bind:after="PreviewRulesAsync" /> 「…」はセリフ</label>
                        <label><input type="checkbox" @bind="_outside" @bind:after="PreviewRulesAsync" disabled="@(!_split)" /> 括弧の外は地の文</label>
                    </section>
                    @if (_live)
                    {
                    <section class="capture-result-panel"><h3>仕上がり <small>直近の受信</small></h3>
                        <div class="capture-result-feed">
                            @foreach (var item in _snapshot.PreviewItems)
                            {
                                <article class="capture-preview-item"><header><span>@(item.LabelName ?? "未判定")</span><span>@(item.Kind == CaptureKind.Narration ? "" : item.Speaker ?? "話者未確定")</span></header><p>@item.Text</p></article>
                            }
                            @if (_snapshot.PreviewItems.Length == 0) { <p class="capture-empty">@(!_snapshot.Preview ? "テスト接続で確認" : !_snapshot.Candidates.Any(x => x.Role == CaptureRole.Body) ? "本文の取得元を選択" : "本文待ち")</p> }
                        </div>
                        <small class="capture-preview-limit capture-warning">@(_snapshot.Preview && _snapshot.Candidates.Any(x => x.Role != CaptureRole.None && x.Samples.Any(s => s.Truncated)) ? "1500文字を超える受信は判定プレビュー対象外" : "")</small>
                    </section>
                    }
                </div>
            }
        </div>
        <footer class="capture-settings-footer">
            <span class="capture-setting-status" role="status">@(_live ? _snapshot.Status : "保存済み本文は自動で変更しません")</span>
            @if (_live && _settingsTab < 2)
            {
                <button class="secondary-button capture-text-button" @onclick="() => SetSettingsTab(_settingsTab == 0 ? 1 : 2)" disabled="@(!_snapshot.Connected)"><CaptureIcon Name="Next" />@(_settingsTab == 0 ? "取得元" : "判定を確認")</button>
            }
            else if (_live && _snapshot.Preview)
            {
                <button class="launch-button capture-text-button" @onclick="ConfirmProcessAsync" disabled="@(_busy || !_snapshot.Connected || !_snapshot.Preview || !_snapshot.Candidates.Any(x => x.Role == CaptureRole.Body))"><CaptureIcon Name="Check" />確定して記録</button>
            }
            else
            {
                <button class="launch-button capture-text-button" @onclick="SaveRulesAsync" disabled="@_busy"><CaptureIcon Name="Check" />新着に適用</button>
            }
        </footer>
    </section></div>
}

@if (_bulkOpen)
{
    <div class="modal-backdrop"><section id="capture-editor" class="capture-dialog" role="dialog" aria-modal="true" aria-labelledby="capture-bulk-title">
        <header class="capture-dialog-header"><h2 id="capture-bulk-title">一括修正 · @_selected.Count</h2><button class="secondary-button capture-icon-button" title="キャンセル" aria-label="キャンセル" @onclick="CloseEditors" disabled="@_busy"><CaptureIcon Name="Close" /></button></header>
        <label>分類<select @bind="_bulkLabel"><option value="0">未判定</option>@foreach (var label in FixedLabels) { <option value="@label.Id">@ClassificationName(label.Kind)</option> }</select></label>
        <div class="capture-dialog-actions">
            <button class="secondary-button capture-icon-button" title="ルールを再適用（手動修正は保持）" aria-label="ルールを再適用" @onclick="ReapplyAsync" disabled="@_busy"><CaptureIcon Name="Refresh" /></button>
            <button class="launch-button capture-icon-button" title="分類を変更" aria-label="分類を変更" @onclick="BulkLabelAsync" disabled="@_busy"><CaptureIcon Name="Check" /></button>
        </div>
    </section></div>
}

@if (_edit is not null)
{
    <div class="modal-backdrop"><section id="capture-editor" class="capture-dialog" role="dialog" aria-modal="true" aria-labelledby="capture-edit-title">
        <header class="capture-dialog-header"><h2 id="capture-edit-title">修正</h2><button class="secondary-button capture-icon-button" title="キャンセル" aria-label="キャンセル" @onclick="CloseEditors" disabled="@_busy"><CaptureIcon Name="Close" /></button></header>
        <p class="capture-raw">@_edit.Text</p>
        <label>分類<select @bind="_editLabel"><option value="0">未判定</option>@foreach (var label in ClassificationChoices(_editLabel)) { <option value="@label.Id">@ClassificationChoiceName(label)</option> }</select></label>
        <label>話者<input @bind="_editSpeaker" placeholder="未確定" disabled="@IsNarration(_editLabel)" /></label>
        <div class="capture-dialog-actions"><button class="launch-button capture-icon-button" title="保存" aria-label="保存" @onclick="SaveEditAsync" disabled="@_busy"><CaptureIcon Name="Check" /></button></div>
    </section></div>
}
@if (_partition is not null)
{
    <div class="modal-backdrop"><section id="capture-editor" class="capture-dialog capture-partition-dialog" role="dialog" aria-modal="true" aria-labelledby="partition-title">
        <header class="capture-dialog-header"><h2 id="partition-title">原文・分割</h2><button class="secondary-button capture-icon-button" title="キャンセル" aria-label="キャンセル" @onclick="CloseEditors" disabled="@_busy"><CaptureIcon Name="Close" /></button></header>
        <textarea class="capture-raw" rows="5" readonly @ref="_rawInput" aria-label="受信原文">@_partition.RawText</textarea>
        <button class="secondary-button capture-icon-button" title="カーソル位置で分割" aria-label="カーソル位置で分割" @onclick="AddBoundaryAsync" disabled="@_busy"><CaptureIcon Name="Split" /></button>
        <div class="capture-parts" aria-label="分割後の本文">
        @for (var i = 0; i < _parts.Count; i++)
        {
            var index = i; var part = _parts[index];
            <div class="capture-part"><p>@part.Text</p>
                <select aria-label="分割範囲の分類" @bind="part.Label"><option value="0">未判定</option>@foreach (var label in ClassificationChoices(part.Label)) { <option value="@label.Id">@ClassificationChoiceName(label)</option> }</select>
                <input aria-label="分割範囲の話者" placeholder="話者未確定" @bind="part.Speaker" disabled="@IsNarration(part.Label)" />
                @if (index < _parts.Count - 1) { <button class="secondary-button capture-icon-button" title="次と結合" aria-label="次と結合" @onclick="() => RemoveBoundary(index)" disabled="@_busy"><CaptureIcon Name="Join" /></button> }
            </div>
        }
        </div>
        <div class="capture-dialog-actions">
            <span class="capture-warning">この原文の分類・話者を置換</span>
            <button class="launch-button capture-icon-button" title="この分割で保存" aria-label="この分割で保存" @onclick="SavePartitionAsync" disabled="@_busy"><CaptureIcon Name="Check" /></button>
        </div>
    </section></div>
}

