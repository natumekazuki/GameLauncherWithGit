    private async Task PersistRulesAsync(CaptureRules rules, CaptureSource? selectedSource = null, PlayRecordingTarget? expected = null)
    {
        if (_profile is null) return;
        if (expected is not null || _snapshot.Profile?.Id == _profile.Id)
        {
            var target = expected ?? _settingsTarget ?? PlayRecordingOperations.DesktopTarget(_snapshot, _profile.Id);
            if (target.ProfileId != _profile.Id) throw new InvalidOperationException("記録対象が変わりました。抽出設定を開き直してください。");
