        _restoreToolsFocus |= _exportOpen || _savedScenes is not null;
        _savedScenes = null;
        CancelWindowPick(); _rangeEditorOpen = _finishOpen = false; _finishTarget = null; _error = null; _independentFlowConfirm = false; _exportOpen = false; _screenshotSettingsOpen = false; _screenshotItem = null; _eventScreenshots = null; _galleryImage = null; _galleryError = null; _pausedCandidates = null; _edit = null; _partition = null; _settingsOpen = false; _bulkOpen = false; _historyDialog = HistoryDialog.None; _deletionTargets = []; _restoreFocus = true;
    }
    [JSInvokable] public void CloseEditorFromKeyboard(string? viewKey)
    {
