    private Task OpenScreenshotsAsync(CaptureTextItem item) => RunAsync(() => LoadOccurrenceGalleryAsync(item));

    /// <summary>Shows images only for a selected occurrence in the displayed record.</summary>
    private async Task LoadOccurrenceGalleryAsync(CaptureTextItem item)
    {
        _screenshotItem = item; _following = false; _focusEditor = true;
        _galleryIndex = 0;
        await LoadScreenshotGalleryAsync(item);
    }
    private Task ReloadScreenshotAsync() => RunAsync(() =>
        _screenshotItem is { } item ? LoadScreenshotGalleryAsync(item) : Task.CompletedTask);
    private async Task LoadScreenshotGalleryAsync(CaptureTextItem item)
    {
        _galleryImage = null;
        _galleryError = null;
        _eventScreenshots = null;
        try
        {
            _eventScreenshots = await ScreenshotStore.GetEventScreenshotsAsync(_recordId, new(item.SessionId, item.Sequence));
            _galleryIndex = Math.Clamp(_galleryIndex, 0, Math.Max(0, _eventScreenshots.Count - 1));
            await LoadScreenshotImageAsync();
        }
        catch (Exception ex) { _galleryError = $"画像を読み込めませんでした：{ex.Message}"; }
    }
    private bool CanMoveGallery(int direction) => _eventScreenshots is { } images &&
        _galleryIndex + direction >= 0 && _galleryIndex + direction < images.Count;
    private Task ChangeScreenshotAsync(int direction) => !CanMoveGallery(direction) ? Task.CompletedTask : RunAsync(async () =>
    {
        _galleryIndex += direction;
        await LoadScreenshotImageAsync();
    });
    private async Task LoadScreenshotImageAsync()
    {
        var expected = _displayedScope;
        _galleryImage = null;
        _galleryError = null;
        if (_eventScreenshots is not { Count: > 0 } images) return;
        try
        {
            var bytes = await File.ReadAllBytesAsync(images[_galleryIndex].FilePath, _stop.Token);
            if (await CanPublishAsync(expected)) _galleryImage = new("data:image/png;base64," + Convert.ToBase64String(bytes));
        }
        catch (Exception ex) { _galleryError = $"画像を読み込めませんでした：{ex.Message}"; }
    }
    private void ScreenshotDecodeFailed(GalleryImage image)
    {
        if (!ReferenceEquals(_galleryImage, image)) return;
