@page "/capture"
@using GameLauncherWithGit.Application.Models
@using GameLauncherWithGit.Application.Services
@using GameLauncherWithGit.Infrastructure.Abstractions
@using GameLauncherWithGit.Components
@using System.Text
@implements IAsyncDisposable
@inject IScenarioCaptureStore Store
@inject IScenarioScreenshotStore ScreenshotStore
@inject ScenarioScreenshotService Screenshots
@inject ScenarioCaptureService CaptureService
@inject IPathPickerService Picker
@inject IJSRuntime JS

<PageTitle>シナリオ抽出</PageTitle>
<section class="capture-page">
    <header class="capture-header">
        <div class="capture-heading">
            <a class="secondary-button capture-icon-button" href="/" title="ゲーム一覧" aria-label="ゲーム一覧"><CaptureIcon Name="Back" /></a>
            <h1>シナリオ</h1>
        </div>
        <div class="capture-tabs" aria-label="表示切替">
            <button class="secondary-button capture-icon-button" title="取得中" aria-label="取得中のゲーム" aria-pressed="@(_live ? "true" : "false")" @onclick="ShowLiveAsync"><CaptureIcon Name="Live" /></button>
            <button class="secondary-button capture-icon-button" title="履歴" aria-label="保存履歴" aria-pressed="@(!_live ? "true" : "false")" @onclick="ShowHistoryAsync"><CaptureIcon Name="History" /></button>
        </div>
    </header>
    @if (_loading) { <p role="status">読込中…</p> }
    else
    {
        @if (_live)
        {
            <div class="capture-livebar">
                <strong class="capture-game-title">@(_snapshot.Profile?.Title ?? "ゲームなし")</strong>
                <div class="capture-play-range" aria-label="プレイ中の区間指定">
                    <span class="capture-range-caption">区間</span>
                    <button class="launch-button capture-icon-button" title="区間を開始" aria-label="ここから開始" @onclick="StartLiveRangeAsync" disabled="@(_busy || !_snapshot.Connected || _snapshot.Preview || _snapshot.RangeStart is not null)"><CaptureIcon Name="Play" /></button>
                    <button class="launch-button capture-icon-button" title="区間を終了" aria-label="ここまでで終了" @onclick="EndLiveRangeAsync" disabled="@(_busy || _snapshot.RangeStart is null)"><CaptureIcon Name="Stop" /></button>
                    <button class="secondary-button capture-icon-button" title="区間指定を取消" aria-label="区間指定を取消" @onclick="CancelLiveRange" disabled="@(_busy || _snapshot.RangeStart is null)"><CaptureIcon Name="Close" /></button>
                </div>
                <div class="capture-live-details">
                    <span class="capture-connection" role="status" title="@_snapshot.Status">@_snapshot.Status</span>
                    <span class="capture-count" title="今回の受信" aria-label="@($"今回の受信 {_snapshot.Received}件")"><CaptureIcon Name="Receive" />@_snapshot.Received</span>
                    <span class="capture-count" title="今回の保存" aria-label="@($"今回の保存 {_snapshot.Saved}件")"><CaptureIcon Name="Save" />@_snapshot.Saved</span>
                    <span class="capture-loss @(_snapshot.Lost == 0 ? "capture-hidden" : "")" title="未保存・破棄（未選択候補を含む）" aria-label="@($"未保存・破棄 {_snapshot.Lost}件、未選択候補を含む")"><CaptureIcon Name="Warning" />@_snapshot.Lost</span>
                    <span class="capture-range-active @(_snapshot.RangeStart is null ? "capture-hidden" : "")" role="status">区間指定中</span>
                </div>
            </div>
        }
        <section class="capture-content" aria-busy="@(_busy ? "true" : "false")">
            <div class="capture-filters @(_live ? "capture-filters-live" : "")">
                @if (!_live)
                {
                    <label class="capture-filter" title="ゲーム"><CaptureIcon Name="Game" /><select aria-label="ゲーム" value="@_profileId" @onchange="ChangeProfileAsync" disabled="@_busy">
                        <option value="0">ゲームを選択</option>
                        @foreach (var profile in _profiles) { <option value="@profile.Id">@profile.Title@(profile.GameId is null ? "（登録なし）" : "")</option> }
                    </select></label>
                }
                <label class="capture-filter" title="区間"><CaptureIcon Name="Range" /><select aria-label="区間" @bind="_rangeId" @bind:after="ChangeRangeAsync" disabled="@_busy">
                    <option value="0">ゲーム全体</option>
                    @foreach (var range in _ranges) { <option value="@range.Id">@RangeName(range)</option> }
                </select></label>
                <label class="capture-filter" title="分類"><CaptureIcon Name="Tag" /><select aria-label="分類" @bind="_filter" @bind:after="FilterAsync" disabled="@_busy">
                    <option value="all">すべて</option><option value="none">未判定</option>
                    <option value="dialogue">セリフ</option><option value="narration">地の文</option>
                </select></label>
            </div>
            @if (!_live)
            {
                <div class="capture-history-toolbar">
                    <form class="capture-search" @onsubmit="SearchHistoryAsync" @onsubmit:preventDefault>
                        <label>名前（部分一致）<input type="search" placeholder="例：美咲" @bind="_speakerSearchInput" @bind:event="oninput" disabled="@(_busy || _profileId == 0)" /></label>
                        <label>本文（部分一致）<input type="search" placeholder="例：約束" @bind="_textSearchInput" @bind:event="oninput" disabled="@(_busy || _profileId == 0)" /></label>
                        <button type="submit" class="secondary-button capture-icon-button" title="検索" aria-label="検索" disabled="@(_busy || _profileId == 0)"><CaptureIcon Name="Search" /></button>
                        <button type="button" class="secondary-button capture-icon-button" title="名前・本文の検索を解除（区間・分類は保持）" aria-label="名前・本文の検索を解除" @onclick="ClearHistorySearchAsync" disabled="@(_busy || !HasHistorySearch && _textSearchInput.Length == 0 && _speakerSearchInput.Length == 0)"><CaptureIcon Name="Close" /></button>
                    </form>
                    <button class="secondary-button capture-text-button" @onclick="OpenHistoryManagementAsync" disabled="@(_busy || _profileId == 0)"><CaptureIcon Name="History" />履歴管理</button>
                </div>
                <p class="capture-search-status" role="status">@(_busy ? "読込中…" : HistorySearchPending ? "検索ボタンで入力した名前・本文を適用します。" : "")</p>
            }
            <div class="capture-tools">
                <div class="capture-tool-group capture-view-tools">
                    @if (LatestOrder)
                    {
                        <button class="secondary-button capture-icon-button" title="@(_following ? "末尾に追従中" : "末尾へ戻る")" aria-label="末尾を表示" aria-pressed="@(_following ? "true" : "false")" @onclick="FollowAsync" disabled="@(_busy || _following || _selected.Count > 0 || _pickingRange)"><CaptureIcon Name="Follow" /></button>
                    }
                    else
                    {
                        <button class="secondary-button capture-icon-button" title="前の200件" aria-label="前の200件" @onclick="PreviousAsync" disabled="@(_busy || _offset == 0)"><CaptureIcon Name="Previous" /></button>
                        <span class="capture-page-count">@(_items.Count == 0 ? "0" : $"{_offset + 1}–{_offset + _items.Count}")</span>
                        <button class="secondary-button capture-icon-button" title="次の200件" aria-label="次の200件" @onclick="NextAsync" disabled="@(_busy || !_hasMore)"><CaptureIcon Name="Next" /></button>
                        <button class="secondary-button capture-icon-button" title="更新" aria-label="更新" @onclick="RefreshAsync" disabled="@_busy"><CaptureIcon Name="Refresh" /></button>
                    }
                </div>
                <div class="capture-tool-group" aria-label="本文で区間指定">
                    <button class="secondary-button capture-icon-button" title="本文から区間を指定" aria-label="本文で区間指定" aria-pressed="@(_pickingRange ? "true" : "false")" @onclick="ToggleTextRange" disabled="@(_busy || _profileId == 0)"><CaptureIcon Name="Pick" /></button>
                    <button class="secondary-button capture-icon-button" title="区間を保存" aria-label="区間を保存" @onclick="OpenTextRange" disabled="@(_busy || !TextRangeValid)"><CaptureIcon Name="Save" /></button>
                    <button class="secondary-button capture-icon-button" title="本文の区間指定を解除" aria-label="本文の区間指定を解除" @onclick="ClearTextRangeAsync" disabled="@(_busy || !_pickingRange)"><CaptureIcon Name="Close" /></button>
                </div>
                <div class="capture-tool-group capture-bulk" aria-label="本文の修正" title="@(_rangeId != 0 ? "修正はゲーム全体で" : "本文の修正")">
                    <input type="checkbox" aria-label="表示分を選択" title="表示分を選択" checked="@(_items.Count > 0 && _selected.Count == _items.Count)" @onchange="SelectPage" disabled="@(_busy || _items.Count == 0 || !CanEdit)" />
                    <span class="capture-selection-count" aria-label="@($"{_selected.Count}件選択")">@_selected.Count</span>
                    <button class="secondary-button capture-icon-button" title="一括修正" aria-label="一括修正" @onclick="OpenBulk" disabled="@(_busy || _selected.Count == 0)"><CaptureIcon Name="BulkEdit" /></button>
                    <button class="secondary-button capture-icon-button" title="選択解除" aria-label="選択解除" @onclick="ClearSelection" disabled="@(_busy || _selected.Count == 0)"><CaptureIcon Name="ClearSelection" /></button>
                    @if (!_live)
                    {
                        <button class="secondary-button capture-icon-button" title="選択した本文の原文を削除" aria-label="選択した本文の原文を削除" @onclick="OpenSelectedDeletionAsync" disabled="@(_busy || _selected.Count == 0)"><CaptureIcon Name="Trash" /></button>
                    }
                </div>
                <div class="capture-tool-group capture-utilities">
                    <button class="secondary-button capture-icon-button" title="スクリーンショット設定" aria-label="スクリーンショット設定" @onclick="OpenScreenshotSettings" disabled="@_busy"><CaptureIcon Name="Camera" /></button>
                    <button class="secondary-button capture-icon-button" title="抽出設定" aria-label="抽出設定" @onclick="OpenSettings" disabled="@_busy"><CaptureIcon Name="Settings" /></button>
                    <button class="secondary-button capture-icon-button" title="TXT出力（条件の全件）" aria-label="条件の全件をTXT出力" @onclick="() => OpenExportAsync(false)" disabled="@(_busy || _profileId == 0)"><CaptureIcon Name="Export" /></button>
                    <button class="secondary-button capture-icon-button" title="ZIP出力（条件の全件・画像付き）" aria-label="条件の全件を画像付きZIP出力" @onclick="() => OpenExportAsync(true)" disabled="@(_busy || _profileId == 0)"><CaptureIcon Name="Archive" /></button>
                </div>
            </div>
            <div class="capture-screenshot-status" role="status" aria-busy="@(Screenshots.Snapshot.Busy ? "true" : "false")"><CaptureIcon Name="Camera" /><span title="@Screenshots.Snapshot.Status">@Screenshots.Snapshot.Status</span><span class="capture-screenshot-count" title="アプリ起動中の撮影保存の成功回数（同一画像の再利用を含む）" aria-label="@($"アプリ起動中の撮影保存の成功回数 {Screenshots.Snapshot.SavedCount}回、同一画像の再利用を含む")">@Screenshots.Snapshot.SavedCount</span></div>
            @if (Screenshots.Snapshot.LastFailure is { } failure)
            {
                <button class="capture-failure-link" @onclick="OpenScreenshotSettings" disabled="@_busy">直近の撮影失敗 @failure.OccurredAt.ToLocalTime().ToString("HH:mm:ss") · 設定で詳細・再設定</button>
            }
            @if (_screenshotCountsError is not null)
            {
                <p class="capture-inline-warning" role="status">@_screenshotCountsError</p>
            }
            @if (_screenshotCleanup is { RemainingImageCount: > 0 } cleanup)
            {
                <div class="capture-cleanup-warning" role="status"><span>本文の削除は完了しています。不要画像 @cleanup.RemainingImageCount 件の後片付けが残っています。</span><button class="secondary-button" @onclick="RetryScreenshotCleanupAsync" disabled="@_busy">後片付けを再試行</button></div>
            }
            <div class="capture-range-summary" role="status" aria-label="@TextRangeSummary" title="@TextRangeSummary">
                @if (_pickingRange)
                {
                    <span><CaptureIcon Name="Start" />@(_rangeFirst is null ? "—" : CandidatePreview(_rangeFirst.Text))</span>
                    <span><CaptureIcon Name="End" />@(_rangeLast is null ? "—" : CandidatePreview(_rangeLast.Text))</span>
                }
            </div>
            <div class="capture-feed" @ref="_feed" tabindex="0" aria-label="抽出本文">
                @if (_items.Count == 0) { <p class="capture-empty">@EmptyMessage</p> }
                @foreach (var item in _items)
                {
                    <article class="capture-item @(IsRangeEdge(item) ? "capture-range-edge" : "")" @key="item.Id">
                        <header>
                            <input type="checkbox" aria-label="この本文を選択" title="選択" checked="@_selected.Contains(item.Id)" @onchange="e => SelectItem(item.Id, e.Value is true)" disabled="@(_busy || !CanEdit)" />
                            <span class="capture-label" title="@(item.LabelName ?? "未判定")">@(item.LabelName ?? "未判定")</span>
                            <strong class="capture-speaker" title="@item.Speaker">
                                @if (item.Kind == CaptureKind.Dialogue || item.Kind is null)
                                {
                                    @if (item.Speaker is not null) { @item.Speaker }
                                    else { <span title="話者未確定" aria-label="話者未確定"><CaptureIcon Name="User" /></span> }
                                }
                            </strong>
                            <span class="capture-manual @(item.ManualLabel || item.ManualSpeaker || item.ManualBoundaries ? "" : "capture-hidden")" title="手動修正" aria-label="手動修正"><CaptureIcon Name="Edit" /></span>
                            <button class="secondary-button capture-icon-button capture-image-button" title="@ScreenshotLabel(item)" aria-label="@ScreenshotLabel(item)" @onclick="() => OpenScreenshotsAsync(item)" disabled="@(_busy || ScreenshotCount(item) is not > 0)"><CaptureIcon Name="Image" /><span class="capture-image-badge" aria-hidden="true">@(ScreenshotCount(item)?.ToString() ?? "?")</span></button>
                            @if (_pickingRange)
                            {
                                <button class="secondary-button capture-icon-button" title="ここから" aria-label="ここから" aria-pressed="@(item.StartPosition == _rangeFirst?.StartPosition ? "true" : "false")" @onclick="() => PickRangeStart(item)" disabled="@_busy"><CaptureIcon Name="Start" /></button>
                                <button class="secondary-button capture-icon-button" title="ここまで" aria-label="ここまで" aria-pressed="@(item.EndPosition == _rangeLast?.EndPosition ? "true" : "false")" @onclick="() => PickRangeEnd(item)" disabled="@_busy"><CaptureIcon Name="End" /></button>
                            }
                            else
                            {
                                <button class="secondary-button capture-icon-button" title="@(_rangeId != 0 ? "修正はゲーム全体で" : "修正")" aria-label="修正" @onclick="() => Edit(item)" disabled="@(_busy || !CanEdit)"><CaptureIcon Name="Edit" /></button>
                                <button class="secondary-button capture-icon-button" title="@(_rangeId != 0 ? "分割はゲーム全体で" : "原文・分割")" aria-label="原文・分割" @onclick="() => OpenPartitionAsync(item)" disabled="@(_busy || !CanEdit)"><CaptureIcon Name="Split" /></button>
                            }
                        </header>
                        <p>@item.Text</p>
                    </article>
                }
            </div>
        </section>
    }
</section>

@if (_screenshotSettingsOpen)
{
    <div class="modal-backdrop"><section id="capture-editor" class="capture-dialog" role="dialog" aria-modal="true" aria-labelledby="capture-screenshot-settings-title">
        <header class="capture-dialog-header"><h2 id="capture-screenshot-settings-title">スクリーンショット設定</h2><button class="secondary-button capture-icon-button" title="閉じる" aria-label="閉じる" @onclick="CloseEditors"><CaptureIcon Name="Close" /></button></header>
        <div class="capture-dialog-body"><ScenarioScreenshotSettings LastFailure="Screenshots.Snapshot.LastFailure" /></div>
    </section></div>
}
@if (_screenshotItem is not null)
{
    <div class="modal-backdrop"><section id="capture-editor" class="capture-dialog capture-gallery-dialog" role="dialog" aria-modal="true" aria-labelledby="capture-gallery-title" aria-busy="@(_busy ? "true" : "false")">
        <header class="capture-dialog-header"><h2 id="capture-gallery-title">この本文を受信した頃のシーン</h2><button class="secondary-button capture-icon-button" title="閉じる" aria-label="閉じる" @onclick="CloseEditors" disabled="@_busy"><CaptureIcon Name="Close" /></button></header>
        <p class="capture-gallery-text">@_screenshotItem.Text</p>
        <div class="capture-gallery-stage" tabindex="0" aria-label="撮影したシーン">
            @if (_busy) { <p role="status">画像を読込中…</p> }
            else if (_galleryError is not null) { <p role="alert" class="capture-error">@_galleryError</p> }
            else if (_eventScreenshots.Count == 0) { <p class="capture-muted">この本文に関連付けられた画像はありません。</p> }
            else if (_galleryImage is not null) { <img src="@_galleryImage" alt="この本文を受信した頃に撮影したゲーム画面" @onerror="ScreenshotDecodeFailed" /> }
        </div>
        <div class="capture-gallery-navigation">
            <button class="secondary-button capture-icon-button" title="前の画像" aria-label="前の画像" @onclick="() => ChangeScreenshotAsync(-1)" disabled="@(_busy || _galleryIndex == 0)"><CaptureIcon Name="Previous" /></button>
            <span>@(_eventScreenshots.Count == 0 ? "0枚" : $"{_galleryIndex + 1} / {_eventScreenshots.Count}枚")</span>
            <button class="secondary-button capture-icon-button" title="次の画像" aria-label="次の画像" @onclick="() => ChangeScreenshotAsync(1)" disabled="@(_busy || _galleryIndex + 1 >= _eventScreenshots.Count)"><CaptureIcon Name="Next" /></button>
        </div>
    </section></div>
}

@if (_historyDialog != HistoryDialog.None)
{
    <div class="modal-backdrop"><section id="capture-editor" class="capture-dialog capture-history-dialog" role="dialog" aria-modal="true" aria-labelledby="capture-history-title">
        <header class="capture-dialog-header"><h2 id="capture-history-title">@HistoryDialogTitle</h2><button class="secondary-button capture-icon-button" title="閉じる" aria-label="閉じる" @onclick="CloseEditors" disabled="@_busy"><CaptureIcon Name="Close" /></button></header>
        <div class="capture-dialog-body capture-history-body">
            <strong class="capture-history-title">@_profile?.Title</strong>
            @if (_historyDialog == HistoryDialog.Manage)
            {
                <p class="capture-history-counts">本文 @_historyCounts.Items 件 · 原文 @_historyCounts.Events 件 · 区間 @_historyCounts.Ranges 件</p>
                <section class="capture-history-section">
                    <h3>区間</h3>
                    @if (_ranges.Count == 0) { <p class="capture-muted">保存した区間はありません。</p> }
                    else
                    {
                        <select aria-label="管理する区間" @bind="_managedRangeId" @bind:after="LoadManagedRangeName" disabled="@_busy">
                            @foreach (var range in _ranges) { <option value="@range.Id">@RangeName(range)</option> }
                        </select>
                        <label>区間名<input @bind="_managedRangeName" disabled="@_busy" /></label>
                        <CaptureTagsEditor Label="区間タグ" @bind-Tags="_managedRangeTags" AvailableTags="AvailableRangeTags" Disabled="_busy" />
                        <div class="capture-history-actions">
                            <button class="secondary-button capture-text-button" @onclick="SaveManagedRangeAsync" disabled="@_busy"><CaptureIcon Name="Check" />名前とタグを保存</button>
                            <button class="secondary-button capture-text-button" @onclick="() => SetHistoryDialog(HistoryDialog.DeleteRange)" disabled="@_busy"><CaptureIcon Name="Trash" />区間を削除</button>
                        </div>
                    }
                </section>
                <section class="capture-history-section">
                    <h3>ゲームの全履歴</h3>
                    <p class="capture-muted">本文・名前の原文・区間を消去します。ゲーム登録と抽出設定は残ります。</p>
                    <button class="secondary-button capture-text-button capture-danger" @onclick="PrepareClearHistoryAsync" disabled="@(_busy || (_historyCounts.Events == 0 && _historyCounts.Ranges == 0))"><CaptureIcon Name="Trash" />全履歴を消去…</button>
                </section>
                <section class="capture-history-section">
                    <h3>不要画像の後片付け</h3>
                    <p class="capture-muted">すべてのゲームの未参照画像だけを整理します。本文や参照中の画像は削除しません。</p>
                    <button class="secondary-button capture-text-button" @onclick="RetryScreenshotCleanupAsync" disabled="@_busy"><CaptureIcon Name="Refresh" />不要画像の後片付けを再試行</button>
                    @if (_screenshotCleanup is { RemainingImageCount: > 0 } pending)
                    {
                        <p class="capture-warning">後片付けが残っている画像：@pending.RemainingImageCount 件</p>
                        @foreach (var reason in pending.FailureReasons) { <p class="capture-muted">@reason</p> }
                    }
                </section>
            }
            else if (_historyDialog == HistoryDialog.DeleteSelected)
            {
                <p>選択した本文を含む @_deletionTargets.Count 件の原文（本文 @(_deletionTargets.Sum(x => x.ItemCount)) 件）を削除します。</p>
                <p class="capture-warning">同じ原文から分割された本文も、検索・分類の条件に関係なく削除します。元に戻せません。</p>
                <div class="capture-deletion-preview" aria-label="削除する原文">
                    @foreach (var target in _deletionTargets) { <article><small>本文 @target.ItemCount 件</small><p>@target.RawText</p></article> }
                </div>
                <p class="capture-muted">区間の位置は残り、削除した本文だけが区間表示から除かれます。</p>
            }
            else if (_historyDialog == HistoryDialog.Clear)
            {
                <p>このゲームの本文 @_historyCounts.Items 件、原文 @_historyCounts.Events 件（名前の受信を含む）、区間 @_historyCounts.Ranges 件をすべて消去します。</p>
                <p class="capture-warning">検索・分類・選択中の区間に関係なく、このゲームの全履歴が対象です。元に戻せません。</p>
                <p>ゲーム登録・セーブデータ・抽出設定・他のゲームの履歴は変更しません。</p>
            }
            else if (_historyDialog == HistoryDialog.DeleteRange)
            {
                <p>区間「@ManagedRangeDisplayName」を削除します。</p>
                <p>区間の名前と範囲だけを削除し、本文は残ります。区間の削除は元に戻せません。</p>
            }
            @if (_historyDialog is HistoryDialog.DeleteSelected or HistoryDialog.Clear && HistoryCaptureActive)
            {
                <div class="capture-history-section" role="status">
                    <p>このゲームは取得中です。削除するには取得を停止してください。ゲーム自体は終了しません。</p>
                    <button class="secondary-button capture-text-button" @onclick="StopHistoryCaptureAsync" disabled="@_busy"><CaptureIcon Name="Stop" />取得を停止</button>
                </div>
            }
        </div>
        <footer class="capture-dialog-actions">
            <button class="secondary-button" @onclick="CloseEditors" disabled="@_busy">@(_historyDialog == HistoryDialog.Manage ? "閉じる" : "キャンセル")</button>
            @if (_historyDialog != HistoryDialog.Manage)
            {
                <button class="secondary-button capture-text-button capture-danger" @onclick="ConfirmHistoryDeletionAsync" disabled="@(_busy || (_historyDialog != HistoryDialog.DeleteRange && HistoryCaptureActive))"><CaptureIcon Name="Trash" />@(_historyDialog == HistoryDialog.Clear ? "全履歴を消去" : "削除する")</button>
            }
        </footer>
    </section></div>
}

@if (_message is not null || _error is not null)
{
    <div class="capture-feedback @(_error is null ? "capture-message" : "capture-error")">
        <span role="@(_error is null ? "status" : "alert")">@(_error ?? _message)</span>
        <button class="secondary-button capture-icon-button" title="閉じる" aria-label="通知を閉じる" @onclick="() => { _message = null; _error = null; }"><CaptureIcon Name="Close" /></button>
    </div>
}

@if (_rangeSelection is not null)
{
    <div class="modal-backdrop"><section id="capture-editor" class="capture-dialog" role="dialog" aria-modal="true" aria-labelledby="capture-range-title">
        <header class="capture-dialog-header"><h2 id="capture-range-title">区間</h2><button class="secondary-button capture-icon-button" title="キャンセル" aria-label="キャンセル" @onclick="CloseEditors" disabled="@_busy"><CaptureIcon Name="Close" /></button></header>
        <label>名前<input @bind="_rangeName" /></label>
        <CaptureTagsEditor Label="区間タグ" @bind-Tags="_rangeTags" AvailableTags="AvailableRangeTags" Disabled="_busy" />
