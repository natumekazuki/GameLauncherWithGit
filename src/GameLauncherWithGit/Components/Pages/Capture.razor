            _scrollToEnd = _live;
        }
        if (_scrollToEnd is { } end) { _scrollToEnd = null; await _module.InvokeVoidAsync("scrollFeed", _feed, end); }
        if (_focusEditor) { _focusEditor = false; await _module.InvokeVoidAsync("focusEditor", _self); }
        if (_restoreFocus) { _restoreFocus = false; await _module.InvokeVoidAsync("restoreFocus"); }
    }
    private async Task PollAsync()
    {
        try
        {
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
            while (await timer.WaitForNextTickAsync(_stop.Token)) await InvokeAsync(async () =>
            {
                _snapshot = CaptureService.Snapshot;
                if (_live && (_snapshot.Profile?.Id ?? 0) != _profileId && !_busy && !EditorOpen)
                {
                    _profileId = _snapshot.Profile?.Id ?? 0; _profiles = await Store.GetCaptureProfilesAsync(); await LoadProfileAsync();
                }
                if (FollowingView && _following && !_busy && !EditorOpen && _selected.Count == 0)
                { await LoadItemsAsync(); _scrollToEnd = true; }
                StateHasChanged();
            });
        }
        catch (OperationCanceledException) { }
        catch (Exception ex) { if (!_stop.IsCancellationRequested) await InvokeAsync(() => { _error = ex.Message; StateHasChanged(); }); }
    }
    [JSInvokable] public void FeedFollowing(bool following) { if (!FollowingView || EditorOpen || _selected.Count > 0) return; _following = following; StateHasChanged(); }
    private async Task RunAsync(Func<Task> action, string? success = null)
    {
        if (_busy) return; _busy = true; _error = null; _message = null;
        try { await action(); if (success is not null) _message = success; }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }
    private async Task LoadProfileAsync()
    {
        _profile = _profiles.FirstOrDefault(x => x.Id == _profileId);
        _labels = _profile is null ? [] : await Store.GetCaptureLabelsAsync(_profile.Id);
        _ranges = _profile is null ? [] : await Store.GetCaptureRangesAsync(_profile.Id);
        _rangeId = 0; _rangeFirst = _rangeLast = null; _pickingRange = false;
        _offset = 0; _selected.Clear(); _filter = "all"; _labelEditId = 0; _labelName = ""; _labelKind = CaptureKind.Dialogue;
        if (_profile is not null) { _split = _profile.Rules.SplitDialogue; _outside = _profile.Rules.OutsideIsNarration; _names = string.Join(Environment.NewLine, _profile.Rules.Names); }
        await LoadItemsAsync();
    }
    private async Task LoadItemsAsync()
    {
        long? label = long.TryParse(_filter, out var id) ? id : null;
        _items = _profileId == 0 ? [] : await Store.GetGameCaptureItemsAsync(_profileId, 200, FollowingView ? 0 : _offset, label, _filter == "none", LatestOrder, _rangeId == 0 ? null : _rangeId);
    }
    private Task ChangeProfileAsync(ChangeEventArgs e) => RunAsync(async () => { _profileId = long.Parse(e.Value!.ToString()!); await LoadProfileAsync(); _scrollToEnd = false; });
    private Task ChangeRangeAsync() => RunAsync(async () => { _offset = 0; _selected.Clear(); await LoadItemsAsync(); _scrollToEnd = FollowingView && _following; });
    private Task FilterAsync() => RunAsync(async () => { _offset = 0; _selected.Clear(); await LoadItemsAsync(); _scrollToEnd = FollowingView && _following; });
    private Task PreviousAsync() => RunAsync(async () => { _offset = Math.Max(0, _offset - 200); _selected.Clear(); await LoadItemsAsync(); _scrollToEnd = false; });
    private Task NextAsync() => RunAsync(async () => { _offset += 200; _selected.Clear(); await LoadItemsAsync(); _scrollToEnd = false; });
    private Task RefreshAsync() => RunAsync(LoadItemsAsync);
    private Task ShowHistoryAsync() => RunAsync(async () => { _live = false; _profiles = await Store.GetCaptureProfilesAsync(); await LoadProfileAsync(); _scrollToEnd = false; });
    private Task ShowLiveAsync() => RunAsync(async () => { _snapshot = CaptureService.Snapshot; _live = true; _following = true; _profileId = _snapshot.Profile?.Id ?? 0; _profiles = await Store.GetCaptureProfilesAsync(); await LoadProfileAsync(); _scrollToEnd = true; });
    private Task FollowAsync() => RunAsync(async () => { _following = true; await LoadItemsAsync(); _scrollToEnd = true; });
    private Task StartLiveRangeAsync() => RunAsync(() => { CaptureService.StartRange(); _snapshot = CaptureService.Snapshot; return Task.CompletedTask; });
    private Task EndLiveRangeAsync() => RunAsync(() => { _rangeSelection = CaptureService.EndRange(); _snapshot = CaptureService.Snapshot; _rangeName = ""; _focusEditor = true; return Task.CompletedTask; });
    private void CancelLiveRange() { CaptureService.CancelRange(); _snapshot = CaptureService.Snapshot; }
    private Task ToggleTextRange() => RunAsync(async () =>
    {
        _pickingRange = !_pickingRange; _selected.Clear(); _following = false;
        if (LatestOrder) _offset = 0;
        if (!_pickingRange) _rangeFirst = _rangeLast = null;
        await LoadItemsAsync();
    });
    private void ClearTextRange() { _rangeFirst = _rangeLast = null; _pickingRange = false; }
    private Task ClearTextRangeAsync() => RunAsync(async () => { ClearTextRange(); _offset = 0; await LoadItemsAsync(); });
    private void PickRangeStart(CaptureTextItem item) { _rangeFirst = item; _following = false; ValidateTextRange(); }
    private void PickRangeEnd(CaptureTextItem item)
    {
        _rangeLast = item; _following = false;
        ValidateTextRange();
    }
    private void ValidateTextRange() => _error = _rangeFirst is not null && _rangeLast is not null && !TextRangeValid
        ? "開始より後の終了位置を選んでください。" : null;
    private void OpenTextRange()
    {
