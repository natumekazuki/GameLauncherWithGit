        var items = await Store.GetGameCaptureItemsAsync(recordId, limit: 1, latest: true, before: ceiling);
        if (items.FirstOrDefault() is not { } item || item.SessionId != position.SessionId
            || item.Sequence != position.Sequence || item.EndPosition.CompareTo(position) <= 0)
            throw new InvalidOperationException("本文が更新されています。対象の本文を確認してください。");
        return item;
    }
