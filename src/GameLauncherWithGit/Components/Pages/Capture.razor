@if (_edit is { } editedItem)
{
    <div class="modal-backdrop"><section id="capture-editor" class="capture-dialog" role="dialog" aria-modal="true" aria-labelledby="capture-edit-title">
        <header class="capture-dialog-header"><h2 id="capture-edit-title">話者・分類の訂正</h2>@DialogFailure("訂正失敗")<button class="secondary-button capture-icon-button" title="キャンセル" aria-label="キャンセル" @onclick="CloseEditors" disabled="@_busy"><CaptureIcon Name="Close" /></button></header>
        <p class="capture-raw">@editedItem.Text</p>
        <label>分類<select @bind="_editLabel" disabled="@_busy"><option value="0">未判定</option>@foreach (var label in ClassificationChoices(_editLabel)) { <option value="@label.Id">@ClassificationChoiceName(label)</option> }</select></label>
        <label>話者<input @bind="_editSpeaker" @bind:event="oninput" placeholder="未確定" disabled="@(_busy || IsNarration(_editLabel))" /></label>
        <div class="capture-dialog-actions"><button class="launch-button capture-text-button" aria-label="訂正を保存" @onclick="() => AtScopeAsync(displayedScope, () => SaveEditAsync(displayedProfile))" disabled="@(_busy || !(EditLabelChanged(editedItem) || EditSpeakerChanged(editedItem)))"><CaptureIcon Name="Save" />保存</button></div>
    </section></div>
}
@if (_partition is not null)
{
    <div class="modal-backdrop"><section id="capture-editor" class="capture-dialog capture-partition-dialog" role="dialog" aria-modal="true" aria-labelledby="partition-title">
        <header class="capture-dialog-header"><h2 id="partition-title">原文・分割</h2>@DialogFailure("分割操作失敗")<button class="secondary-button capture-icon-button" title="キャンセル" aria-label="キャンセル" @onclick="CloseEditors" disabled="@_busy"><CaptureIcon Name="Close" /></button></header>
        <textarea class="capture-raw" rows="5" readonly @ref="_rawInput" aria-label="受信原文">@_partition.RawText</textarea>
        <button class="secondary-button capture-icon-button" title="カーソル位置で分割" aria-label="カーソル位置で分割" @onclick="() => AtScopeAsync(displayedScope, AddBoundaryAsync)" disabled="@_busy"><CaptureIcon Name="Split" /></button>
        <div class="capture-parts" aria-label="分割後の本文">
        @for (var i = 0; i < _parts.Count; i++)
        {
            var index = i; var part = _parts[index];
            <div class="capture-part"><p>@part.Text</p>
                <select aria-label="分割範囲の分類" @bind="part.Label"><option value="0">未判定</option>@foreach (var label in ClassificationChoices(part.Label)) { <option value="@label.Id">@ClassificationChoiceName(label)</option> }</select>
                <input aria-label="分割範囲の話者" placeholder="話者未確定" @bind="part.Speaker" disabled="@IsNarration(part.Label)" />
                @if (index < _parts.Count - 1) { <button class="secondary-button capture-icon-button" title="次と結合" aria-label="次と結合" @onclick="() => RemoveBoundary(index)" disabled="@_busy"><CaptureIcon Name="Join" /></button> }
            </div>
        }
        </div>
        <div class="capture-dialog-actions">
            <span class="capture-warning">この原文の分類・話者を置換</span>
            <button class="launch-button capture-icon-button" title="この分割で保存" aria-label="この分割で保存" @onclick="() => AtScopeAsync(displayedScope, () => SavePartitionAsync(displayedProfile))" disabled="@_busy"><CaptureIcon Name="Check" /></button>
        </div>
    </section></div>
}

@if (_exportOpen)
{
    <div class="modal-backdrop"><section id="capture-editor" class="capture-dialog" role="dialog" aria-modal="true" aria-labelledby="capture-export-title">
        <header class="capture-dialog-header"><h2 id="capture-export-title">書き出し</h2><div class="capture-dialog-feedback">@if (_error is { } exportError) { <CaptureFailureDetails Label="出力失敗" Detail="@exportError" /> }</div><button class="secondary-button capture-icon-button" title="キャンセル" aria-label="キャンセル" @onclick="CloseEditors" disabled="@_busy"><CaptureIcon Name="Close" /></button></header>
        <p class="capture-export-scope">@ExportScope</p>
        <fieldset class="capture-export-mode" disabled="@_busy">
            <legend>書き出し形式</legend>
            <label><input type="radio" name="capture-export-content" value="txt" checked="@(_exportFormat == ExportFormat.Text)" @onchange="() => _exportFormat = ExportFormat.Text" /><span>本文TXT</span></label>
            <label><input type="radio" name="capture-export-content" value="structure" checked="@(_exportFormat == ExportFormat.Structure)" @onchange="() => _exportFormat = ExportFormat.Structure" /><span>構造情報ZIP（本文・画像本体なし）</span></label>
            <label><input type="radio" name="capture-export-content" value="full" checked="@(_exportFormat == ExportFormat.Full)" @onchange="() => _exportFormat = ExportFormat.Full" /><span>完全版ZIP（本文・画像を含む）</span></label>
        </fieldset>
        @if (AvailableRangeTags.Length > 0)
        {
            <CaptureTagsEditor Label="このタグの区間だけ含める" @bind-Tags="_exportIncludeTags" AvailableTags="AvailableRangeTags" AllowCreate="false" Disabled="_busy" />
            <CaptureTagsEditor Label="このタグの区間を除外" @bind-Tags="_exportExcludeTags" AvailableTags="AvailableRangeTags" AllowCreate="false" Disabled="_busy" />
            <p class="capture-muted">各欄はいずれかのタグに一致する区間が対象。重なる部分は除外を優先します。</p>
        }
        <div class="capture-dialog-actions" aria-busy="@(_busy ? "true" : "false")"><button @ref="_exportSaveButton" class="launch-button capture-text-button" @onclick="() => AtScopeAsync(displayedScope, SaveExportAsync)" disabled="@_busy"><CaptureIcon Name="@(_exportFormat == ExportFormat.Text ? "Export" : "Archive")" />@(_exportFormat == ExportFormat.Text ? "TXTを保存" : "ZIPを保存")</button></div>
    </section></div>
}

