    private string CaptureStatusLabel => ShortCaptureStatus(_snapshot.Status);
    private static string ShortCaptureStatus(string status) => status switch
    {
        "抽出の開始に失敗しました。ログを確認してください。" => "取得開始失敗",
        "接続失敗・選び直して再試行できます" => "取得接続失敗",
        "保存失敗（一部の受信は未保存です）" => "本文の保存失敗",
        _ => status,
    };
    private IEnumerable<(string Label, string Detail)> PageFailures()
    {
        if (_launchMessage is { } launch) yield return ("起動後警告", launch);
        if (_initialError is { } initial) yield return ("シナリオの取得失敗", initial);
        if (_pollError is { } poll) yield return ("取得状態の更新失敗", poll);
        if (!EditorOpen && _error is { } error)
            yield return (_errorLabel ?? (_flowOpen ? "経路の操作失敗" : _pickingRange ? "区間指定エラー" : "シナリオの操作失敗"), error);
        if (ViewingLiveRecord && _snapshot.Profile?.Id == _profileId && CaptureStatusLabel != _snapshot.Status) yield return (CaptureStatusLabel, _snapshot.Status);
        if (ViewingLiveRecord && Screenshots.Snapshot is { LastFailure: { } shot } screenshotStatus)
            yield return ("撮影失敗", ScreenshotFailureDetails(shot, screenshotStatus));
        if (_screenshotCountsError is { } counts) yield return ("画像件数の取得失敗", counts);
        if (_screenshotCleanup is { RemainingImageCount: > 0 } cleanup) yield return ("後片付け未完了", CleanupDetails(cleanup));
    }
    private static string CleanupDetails(ScreenshotCleanupResult result) =>
        string.Join("\n", new[] { $"後片付けが残っている画像：{result.RemainingImageCount} 件" }.Concat(result.FailureReasons));
    private static string ScreenshotFailureDetails(ScreenshotFailure failure, ScreenshotStatus current) =>
        $"直近の失敗（{failure.OccurredAt.ToLocalTime():M/d HH:mm:ss}）\n{failure.Message}\n\n現在の撮影状態：{current.Status}\n撮影キー：{(current.Registered ? "登録済み" : "未登録")}";
    private bool _windowsOnly = true;
    private int _settingsTab, _windowCountdown;
    private CancellationTokenSource? _windowPick;
    private string _sourceSearch = "";
    private CaptureCandidate[]? _pausedCandidates;
    private readonly HashSet<string> _updatedSources = [];
    private readonly HashSet<long> _selected = [];
    private readonly CancellationTokenSource _stop = new();
    private TaskCompletionSource? _pollComplete;
    private ElementReference _feed, _observedFeed, _rawInput, _initialRetry;
    private (long? Record, long? Session, long Saved) _feedSnapshot;
    private bool _focusAfterInitialRetry, _focusFeed;
    private IJSObjectReference? _module;
    private DotNetObjectReference<Capture>? _self;
    private CaptureTextItem? _edit, _partition;
    private bool _focusEditor, _focusSettingsTab, _restoreFocus, _focusRangeFilter, _settingsOpen, _settingsForConnection, _bulkOpen;
    private ElementReference _rangeFilter;
    private string _candidateKey = "";
    private bool? _scrollToEnd;
    private long _editLabel;
    private string _editSpeaker = "";
    private readonly List<int> _boundaries = [];
    private List<PartDraft> _parts = [];
    private bool _pickingRange;
    private CaptureTextItem? _rangeFirst, _rangeLast;
    private PlayRecordingRangeSelection? _rangeSelection, _pendingLiveRange;
    private PlayRecordingTarget? _rangeDraftTarget;
    private PlayRecordingTarget? _settingsTarget;
    private PlayRecordingTarget? _screenshotSettingsTarget;
    private long _rangeListsVersion = -1;
    private string _rangeName = "";
    private bool EditorOpen => _savedScenes is not null || _independentFlowConfirm || _exportOpen || _screenshotSettingsOpen || _screenshotItem is not null || _settingsOpen || _bulkOpen || _edit is not null || _partition is not null || _rangeEditorOpen || _finishOpen || _historyDialog != HistoryDialog.None;
    private bool FollowingView => !_flowOpen && _offset == 0 && !_pickingRange;
    private CapturePosition? _pageCeiling;
    private bool CanEdit => _rangeId == 0 && !_pickingRange;
    private bool TextRangeValid => _rangeFirst is not null && _rangeLast is not null && _rangeFirst.StartPosition.CompareTo(_rangeLast.EndPosition) < 0;
    private string TextRangeSummary => !_pickingRange ? ""
        : $"開始：{(_rangeFirst is null ? "未指定" : CandidatePreview(_rangeFirst.Text))} ／ 終了：{(_rangeLast is null ? "未指定" : CandidatePreview(_rangeLast.Text))}";
    private bool IsRangeEdge(CaptureTextItem item) => _pickingRange && (item.StartPosition == _rangeFirst?.StartPosition || item.EndPosition == _rangeLast?.EndPosition);
    private string RangeName(CaptureRange range)
    {
        var same = _ranges.Where(x => x.Name == range.Name).ToList();
        return same.Count == 1 ? range.Name : $"{range.Name}（同名の{same.IndexOf(range) + 1}/{same.Count}件目）";
    }
    private IEnumerable<CaptureCandidate> DisplayCandidates => (_pausedCandidates ?? _snapshot.Candidates).Select(candidate =>
        _snapshot.Candidates.FirstOrDefault(x => x.Source.Key == candidate.Source.Key) is { } live
            ? candidate with { Role = live.Role, LabelId = live.LabelId } : candidate);
    private IEnumerable<CaptureCandidate> VisibleCandidates => DisplayCandidates.Where(x => string.IsNullOrWhiteSpace(_sourceSearch)
        || x.Samples.Any(s => s.Text.Contains(_sourceSearch.Trim(), StringComparison.OrdinalIgnoreCase)));
    private CaptureCandidate? CurrentCandidate => DisplayCandidates.FirstOrDefault(x => x.Source.Key == _candidateKey);
    private IEnumerable<CaptureProcess> VisibleProcesses => _processes.Where(x => (!_windowsOnly || !string.IsNullOrEmpty(x.WindowTitle)) && x.Matches(_processSearch));
    private CaptureProcess? SelectedProcess => VisibleProcesses.FirstOrDefault(x => x.Id == _processId);
    private IEnumerable<CaptureLabel> FixedLabels => _labels.Where(x => x.Kind is CaptureKind.Dialogue or CaptureKind.Narration).GroupBy(x => x.Kind).Select(x => x.First());
    private CaptureKind? FilterKind => _filter switch { "dialogue" => CaptureKind.Dialogue, "narration" => CaptureKind.Narration, _ => null };
    private static string ClassificationName(CaptureKind kind) => kind == CaptureKind.Dialogue ? "セリフ" : "地の文";
    private IEnumerable<CaptureLabel> ClassificationChoices(long current) => FixedLabels.Concat(_labels.Where(x => x.Id == current && !FixedLabels.Any(y => y.Id == current)));
    private static string ClassificationChoiceName(CaptureLabel label) => label.Kind is CaptureKind.Dialogue or CaptureKind.Narration ? ClassificationName(label.Kind) : label.Name;
    private string EmptyMessage => SelectedGameTitle is null ? "ゲーム未選択"
        : HasHistorySearch || _filter != "all" || _rangeId != 0 ? "条件に一致する本文はありません" : "保存された本文はありません";
    private static string CandidatePreview(string text) => string.Concat(text.Take(60)).ReplaceLineEndings(" ");
    private sealed class PartDraft { public string Text { get; set; } = ""; public long Label { get; set; } public string Speaker { get; set; } = ""; }
    protected override void OnInitialized() => _ = PollAsync();
    private async Task RetryInitialAsync()
    {
        if (_loading) return;
        await LoadInitialAsync();
        _focusAfterInitialRetry = true;
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_loading) return;
        if (_initialError is not null)
        {
            if (_focusAfterInitialRetry && _initialRetry.Id is not null)
            {
                _focusAfterInitialRetry = false;
                await _initialRetry.FocusAsync(preventScroll: true);
            }
            return;
        }
        if (InvalidGameId || _feed.Id is null) return;
        if (_module is null)
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./capture-view.js");
            _self = DotNetObjectReference.Create(this);
        }
        if (_observedFeed.Id != _feed.Id)
        {
            if (_observedFeed.Id is not null) await _module.InvokeVoidAsync("unobserveFeed", _observedFeed);
            _observedFeed = _feed;
            await _module.InvokeVoidAsync("observeFeed", _feed, _self);
            _scrollToEnd ??= _following;
        }
        if (_scrollToEnd is { } end) { _scrollToEnd = null; await _module.InvokeVoidAsync("scrollFeed", _feed, end); }
        if (_focusAfterInitialRetry || _focusFeed)
        {
            _focusAfterInitialRetry = _focusFeed = false;
            await _feed.FocusAsync(preventScroll: true);
        }
        if (_focusEditor) { _focusEditor = false; await _module.InvokeVoidAsync("focusEditor", _self, _displayedScope?.ViewKey); }
        if (_focusSettingsTab) { _focusSettingsTab = false; if (_settingsOpen) await _module.InvokeVoidAsync("focusSettingsTab"); }
        if (_focusHistoryContent) { _focusHistoryContent = false; await _module.InvokeVoidAsync("focusEditorContent"); }
        if (_restoreFocus) { _restoreFocus = false; await _module.InvokeVoidAsync("restoreFocus"); }
        if (_restoreToolsFocus && !_busy)
        {
            _restoreToolsFocus = false;
            if (!EditorOpen && _toolsButton.Id is not null) await _toolsButton.FocusAsync(preventScroll: true);
        }
        if (_focusExportSave && !_busy)
        {
            _focusExportSave = false;
            if (_exportOpen) await _exportSaveButton.FocusAsync();
        }
        if (_focusRangeFilter && !_busy)
        {
            _focusRangeFilter = false;
            if (!_flowOpen && !EditorOpen) await _rangeFilter.FocusAsync(preventScroll: true);
        }
    }
    private async Task PollAsync()
    {
        try
        {
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
            while (await timer.WaitForNextTickAsync(_stop.Token))
            {
                await InvokeAsync(async () =>
                {
                    if (_loading || _initialError is not null || _busy) return;
                    var complete = new TaskCompletionSource(TaskCreationOptions.RunContinuationsAsynchronously);
                    _pollComplete = complete;
                    try { await PollSnapshotAsync(); _pollError = null; }
                    catch (Exception ex) when (!_stop.IsCancellationRequested) { _pollError = ex.Message; }
                    finally { _pollComplete = null; complete.SetResult(); }
                    if (!_stop.IsCancellationRequested) StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException) { }
        catch (ObjectDisposedException) when (_stop.IsCancellationRequested) { }
    }
    private async Task PollSnapshotAsync()
    {
        var prior = _snapshot;
        await ReadRecordingStateAsync();
        var next = _snapshot;
        _updatedSources.Clear();
        foreach (var candidate in next.Candidates)
            if (candidate.Samples.LastOrDefault()?.Sequence != prior.Candidates.FirstOrDefault(x => x.Source.Key == candidate.Source.Key)?.Samples.LastOrDefault()?.Sequence)
                _updatedSources.Add(candidate.Source.Key);
        if (next.Process?.Id != prior.Process?.Id || !next.Connected) _pausedCandidates = null;
        await SynchronizeViewAsync();
        try { await RefreshRangeStateAsync(next); }
        catch (InvalidOperationException) when (CaptureService.Snapshot.OperationVersion != next.OperationVersion) { }
        if (FollowingView && _following && !_busy && !EditorOpen && _selected.Count == 0 && ViewingLiveRecord &&
            _feedSnapshot != (next.RecordId, next.SessionId, next.Saved))
        { await LoadItemsAsync(); _scrollToEnd = true; }
        else if (!_busy && Screenshots.Snapshot.SavedCount != _countsSavedCount)
            await LoadScreenshotCountsAsync();
    }
    [JSInvokable] public void FeedFollowing(string viewKey, bool following) { if (_displayedScope?.ViewKey != viewKey || !FollowingView || EditorOpen || _selected.Count > 0) return; _following = following; StateHasChanged(); }
    private async Task ReadRecordingStateAsync()
    {
        var play = await RecordingOperations.GetCurrentStateAsync();
        var previous = _snapshot;
        _snapshot = CaptureService.Snapshot;
        _playState = play?.GameId == _snapshot.PlayGameId && play?.Target.ScopeVersion == _snapshot.PlayScopeVersion ? play : null;
        ObserveResume(previous, _snapshot, _playState);
    }
    private async Task SynchronizeViewAsync()
    {
        var play = CaptureService.CurrentPlayTarget;
        if (_followPlaySelection && _following && TracksCurrentScope && !EditorOpen && play.Profile is { } active && active.Id != _profileId)
        {
            _profileId = active.Id;
            _profiles = await Store.GetCaptureProfilesAsync();
            await LoadProfileAsync();
        }
        else await RefreshScopeAsync();
    }
    private async Task RunAsync(Func<Task> action, string? success = null, string? failureLabel = null, bool refreshScope = true)
    {
        if (_busy || _stop.IsCancellationRequested) return;
        var expected = _displayedScope;
        _busy = true; _error = _errorLabel = _message = null;
        try
        {
            if (_pollComplete is { } poll) await poll.Task;
            if (_stop.IsCancellationRequested) return;
            if (refreshScope)
            {
                await ReadRecordingStateAsync();
                await SynchronizeViewAsync();
                if (!ReferenceEquals(expected, _displayedScope)) throw ScopeChanged();
            }
            await action();
            if (refreshScope && expected is not null && !await CanPublishAsync(expected))
            {
                await ReadRecordingStateAsync();
                await SynchronizeViewAsync();
            }
            if (success is not null) _message = success;
        }
        catch (Exception ex) { _errorLabel = failureLabel; _error = ex.Message; }
        finally { _busy = false; }
    }
    private async Task LoadProfileAsync()
    {
        ReleaseHistoryObservation();
        ResetScopeContent();
        _displayedScope = null;
        _historyScopes = [];
        _currentRecordId = null;
        _scopeLabel = _scopeError = null;
        _profile = _profiles.FirstOrDefault(x => x.Id == _profileId);
        _historyChoice = _profile?.GameId is null ? _profileId : 0;
        _labels = _profile is null ? [] : await Store.GetCaptureLabelsAsync(_profile.Id);
        if (_profile is not null) { _split = _profile.Rules.SplitDialogue; _outside = _profile.Rules.OutsideIsNarration; }
        await RefreshScopeAsync(reload: true);
    }
    private async Task RefreshRangeStateAsync(CaptureSnapshot displayed)
    {
        _pendingLiveRange = ViewingLiveRecord && displayed.Profile?.Id == _profileId
            ? await RecordingOperations.GetDesktopPendingRangeAsync(PlayRecordingOperations.DesktopTarget(displayed, _profileId)) : null;
        if (_rangeSelection is { Live: true } draft && !ReferenceEquals(draft, _pendingLiveRange))
        {
            ClearRangeDraft();
            _finishOpen = false;
            _finishTarget = null;
            _error = _errorLabel = null;
            _focusEditor = false;
            _restoreFocus = true;
        }
        if (_recordId == 0 || _rangeListsVersion == displayed.OperationVersion) return;
        await LoadScopeListsAsync();
        _rangeListsVersion = displayed.OperationVersion;
    }
    private async Task LoadItemsAsync()
    {
        var expected = _displayedScope;
        IReadOnlyList<CaptureTextItem> items;
        try
        {
            items = expected is null ? [] : await QueryItemsAsync(201, _offset, _following && _offset == 0 ? null : _pageCeiling);
            if (!await CanPublishAsync(expected)) return;
            _itemsError = null;
        }
        catch (Exception ex)
        {
            _itemsError = ex.Message;
            _items = [];
            _hasMore = false;
            _screenshotCountsError = null;
            return;
        }
        _hasMore = items.Count > 200;
        _items = _hasMore ? items.Skip(1).ToArray() : items;
        _feedSnapshot = (_snapshot.RecordId, _snapshot.SessionId, _snapshot.Saved);
        if (_items.LastOrDefault() is { } last && (_offset == 0 && (_following || _pageCeiling is null)))
            _pageCeiling = last.EndPosition;
        if (_selected.Count > 0) _selected.IntersectWith(_items.Select(x => x.Id));
        await LoadScreenshotCountsAsync();
    }
    private int? ScreenshotCount(CaptureTextItem item) => _screenshotCounts is null ? null
        : _screenshotCounts.GetValueOrDefault(new(item.SessionId, item.Sequence));
    private string ScreenshotLabel(CaptureTextItem item) => ScreenshotCount(item) is { } count
        ? count == 0 ? "関連画像なし（0枚）" : $"この本文を受信した頃のシーンを見る（{count}枚）"
        : "関連画像の件数を取得できません。更新して再試行してください。";
    private async Task LoadScreenshotCountsAsync()
    {
        var expected = _displayedScope;
        if (expected is null) return;
        try
        {
            var savedCount = Screenshots.Snapshot.SavedCount;
            var counts = await ScreenshotStore.GetScreenshotCountsAsync(expected.RecordId, _items.Select(x => new CaptureEventKey(x.SessionId, x.Sequence)).Distinct().ToArray());
            if (!await CanPublishAsync(expected)) return;
            _screenshotCounts = counts;
            _countsSavedCount = savedCount; _screenshotCountsError = null;
        }
        catch (Exception ex) { if (IsDisplayed(expected)) { _screenshotCounts = null; _screenshotCountsError = $"画像件数を取得できませんでした。更新して再試行してください：{ex.Message}"; } }
    }
    private Task<IReadOnlyList<CaptureTextItem>> QueryItemsAsync(int limit, int offset, CapturePosition? before)
    {
        // SQLite reads and substring matching must not block the UI while browsing large histories.
        var recordId = _recordId; var rangeId = _rangeId; var kind = FilterKind; var unclassified = _filter == "none";
        var text = _textSearch; var speaker = _speakerSearch;
        return Task.Run(() => Store.GetGameCaptureItemsAsync(recordId, limit, offset,
            unclassifiedOnly: unclassified, latest: true, rangeId: rangeId == 0 ? null : rangeId, kind: kind,
            textSearch: text, speakerSearch: speaker, before: before));
    }
