    private void ClearSelection() => _selected.Clear();
    private void OpenBulk() { _bulkOpen = true; _focusEditor = true; }
    private void OpenSettings() { _settingsOpen = true; _focusEditor = true; _candidateKey = _snapshot.Candidates.FirstOrDefault()?.Source.Key ?? ""; FindProcesses(); }
    private void SelectItem(long id, bool selected) { if (selected) _selected.Add(id); else _selected.Remove(id); _following = false; }
    private void SelectPage(ChangeEventArgs e) { _selected.Clear(); if (e.Value is true) _selected.UnionWith(_items.Select(x => x.Id)); _following = false; }
    private Task BulkLabelAsync() { var groups = _items.Where(x => _selected.Contains(x.Id)).GroupBy(x => x.SessionId).ToArray(); var count = _selected.Count; return RunAsync(async () => { foreach (var group in groups) await Store.SetCaptureLabelsAsync(group.Key, group.Select(x => x.Id).ToArray(), _bulkLabel == 0 ? null : _bulkLabel); _selected.Clear(); CloseEditors(); await LoadItemsAsync(); }, $"{count}件のラベルを変更しました。"); }
    private Task ReapplyAsync() { var groups = _items.Where(x => _selected.Contains(x.Id)).GroupBy(x => x.SessionId).ToArray(); var count = _selected.Count; return RunAsync(async () => { if (_profile is null) return; foreach (var group in groups) await Store.ReapplyCaptureRulesAsync(group.Key, group.Select(x => x.Id).ToArray(), _profile.Rules); _selected.Clear(); CloseEditors(); await LoadItemsAsync(); }, $"選択した{count}件へルールを再適用しました。"); }
    private void FindProcesses() => _processes = CaptureService.GetProcesses();
    private Task ConnectAsync() => RunAsync(async () => { await CaptureService.SelectProcessAsync(_processId); _snapshot = CaptureService.Snapshot; });
    private static string RoleName(CaptureRole role) => role switch { CaptureRole.Body => "本文", CaptureRole.Name => "キャラ名", _ => "未選択" };
    private Task ChangeCandidateAsync(CaptureCandidate candidate, ChangeEventArgs e) => SetCandidateAsync(candidate, (CaptureRole)int.Parse(e.Value!.ToString()!), candidate.LabelId);
    private Task ChangeCandidateLabelAsync(CaptureCandidate candidate, ChangeEventArgs e) => SetCandidateAsync(candidate, candidate.Role, long.Parse(e.Value!.ToString()!) is var id && id != 0 ? id : null);
    private Task SetCandidateAsync(CaptureCandidate candidate, CaptureRole role, long? label) => RunAsync(async () =>
    {
        if (_profile is null) return;
        var selections = _profile.Rules.Selections.Where(x => !x.Matches(candidate.Source)).Append(new(candidate.Source.HookCode, candidate.Source.HookName, candidate.Source.Context, candidate.Source.Context2, role, label)).ToArray();
        await PersistRulesAsync(_profile.Rules with { Selections = selections }, candidate.Source); _snapshot = CaptureService.Snapshot;
    });
    private Task SaveRulesAsync() => RunAsync(async () =>
    {
        if (_profile is null) return;
        await PersistRulesAsync(_profile.Rules with { SplitDialogue = _split, OutsideIsNarration = _outside,
            Names = _names.Split(['\r', '\n'], StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries).Distinct().ToArray() });
    }, "新着に適用しました。");
    private async Task PersistRulesAsync(CaptureRules rules, CaptureSource? selectedSource = null)
    {
        if (_profile is null) return;
        if (CaptureService.Snapshot.Profile?.Id == _profile.Id) await CaptureService.SaveRulesAsync(rules, selectedSource);
        else await Store.SaveCaptureProfileAsync(_profile with { Rules = rules });
        _profile = _profile with { Rules = rules };
        _profiles = _profiles.Select(x => x.Id == _profile.Id ? _profile : x).ToArray();
    }
    private void LoadLabelName() { var label = _labels.FirstOrDefault(x => x.Id == _labelEditId); _labelName = label?.Name ?? ""; _labelKind = label?.Kind ?? CaptureKind.Dialogue; }
    private Task SaveLabelAsync() => RunAsync(async () => { if (_profile is null) return; await Store.SaveCaptureLabelAsync(_profile.Id, _labelName, _labelKind, _labelEditId == 0 ? null : _labelEditId); _labels = await Store.GetCaptureLabelsAsync(_profile.Id); await LoadItemsAsync(); }, "ラベルを保存しました。");
    private bool IsNarration(long id) => _labels.FirstOrDefault(x => x.Id == id)?.Kind == CaptureKind.Narration;
    private void Edit(CaptureTextItem item) { _edit = item; _editLabel = item.LabelId ?? 0; _editSpeaker = item.Speaker ?? ""; _following = false; _focusEditor = true; }
    private Task SaveEditAsync() => RunAsync(async () => { if (_edit is null) return; await Store.SetCaptureLabelsAsync(_edit.SessionId, [_edit.Id], _editLabel == 0 ? null : _editLabel); await Store.SetCaptureSpeakerAsync(_edit.SessionId, _edit.Id, IsNarration(_editLabel) ? null : _editSpeaker); CloseEditors(); await LoadItemsAsync(); }, "修正を保存しました。");
    private Task OpenPartitionAsync(CaptureTextItem item) => RunAsync(async () =>
    {
        _partition = item; _following = false;
        _focusEditor = true;
        var original = (await Store.GetCaptureItemsAsync(item.SessionId, 0)).Where(x => x.Sequence == item.Sequence).ToArray();
        _boundaries.Clear(); _boundaries.AddRange(original.SkipLast(1).Select(x => x.Start + x.Length));
