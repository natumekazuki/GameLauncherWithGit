    /// <summary>Saves the bound range without replacing the displayed text page or scroll position.</summary>
    private Task SaveRangeAsync(PlayRecordingTarget expected, PlayRecordingRangeSelection draft) => RunAsync(async () =>
    {
        RequireRangeDraft(expected, draft);
        var finish = _finishTarget;
        if (finish is not null) RequireFinishTarget(finish);
        var name = _rangeName.Trim();
        await RecordingOperations.SaveDesktopRangeAsync(expected, draft, name, _rangeTags);
        _snapshot = CaptureService.Snapshot;
        ClearRangeDraft();
        ClearTextRange();
        _pendingLiveRange = null;
        _restoreFocus = true;
        _message = $"区間「{name}」を保存しました。";
        if (finish is not null)
        {
            // Accept only the token advance from this save, not a concurrent session or operation change.
            var current = PlayRecordingOperations.DesktopTarget(_snapshot, _profileId);
            BackFromFinish();
            if (current.ProfileId != finish.ProfileId || current.RecordId != finish.RecordId || current.SessionId != finish.SessionId ||
                current.ScopeVersion != finish.ScopeVersion || current.Version != finish.Version + 1)
                throw ScopeChanged();
            await RecordingOperations.FinishDesktopAsync(current);
            await ReadRecordingStateAsync();
            _message = $"区間「{name}」を保存し、記録を終了しました。";
        }
        await LoadScopeListsAsync();
    }, failureLabel: "区間の保存・終了失敗");

