        <div class="capture-dialog-actions">
            <button class="secondary-button capture-icon-button" title="ルールを再適用（手動修正は保持）" aria-label="ルールを再適用" @onclick="() => AtScopeAsync(displayedScope, () => ReapplyAsync(displayedProfile))" disabled="@_busy"><CaptureIcon Name="Refresh" /></button>
            <button class="launch-button capture-icon-button" title="分類を変更" aria-label="分類を変更" @onclick="() => AtScopeAsync(displayedScope, () => BulkLabelAsync(displayedProfile))" disabled="@_busy"><CaptureIcon Name="Check" /></button>
        </div>
