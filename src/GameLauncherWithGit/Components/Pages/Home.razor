@page "/"
@implements IDisposable
@inject IGameLibraryService GameLibraryService
@inject ILauncherService LauncherService
@inject IPathPickerService PathPickerService
@inject IGitService GitService
@inject IAutoStartService AutoStartService
@inject ILogAccessService LogAccessService
@inject IRepositoryWatcherService RepositoryWatcherService
@inject ISyncOrchestrator SyncOrchestrator
@inject IRepositoryStateStore RepositoryStateStore
@inject ISettingsPanelService SettingsPanelService

<PageTitle>GameLauncherWithGit</PageTitle>

@if (!_isStartupChecking)
{
    <section class="utility-bar">
        <button type="button"
                class="secondary-button utility-button"
                @onclick="OpenSettingsAsync">
            環境設定
        </button>
    </section>
}

@if (_isStartupChecking)
{
    <section class="library-page startup-check-panel">
        <p>起動要件を確認しています...</p>
    </section>
}
else if (!_isGitReady)
{
    <section class="startup-error-panel">
        <h1>Git が利用できません</h1>
        <p>Git のインストールまたは PATH 設定を確認してから、アプリを再起動してください。</p>
        @if (!string.IsNullOrWhiteSpace(_startupError))
        {
            <p class="startup-error-detail">@_startupError</p>
        }
    </section>
}
else
{
    <section class="library-page">
        <div class="game-grid">
            <button type="button" class="game-card add-card" @onclick="OpenCreateEditor">
                <span class="add-icon">+</span>
                <span class="add-label">新規追加</span>
            </button>

            @if (_games is null)
            {
                <div class="game-card loading-card">読み込み中...</div>
            }
            else
            {
                @foreach (var game in _games)
                {
                    var effectiveStatus = GetEffectiveStatus(game);
                    var hasThumbnail = HasThumbnail(game);
                    var thumbnailDataUri = hasThumbnail ? GetThumbnailDataUri(game) : null;
                    <article class="game-card @(hasThumbnail ? "thumbnail-mode-card" : string.Empty)">
                        @if (hasThumbnail)
                        {
                            <div class="game-thumbnail-panel">
                                @if (string.IsNullOrWhiteSpace(thumbnailDataUri))
                                {
                                    <div class="game-thumbnail-missing" title="@game.Title"></div>
                                }
                                else
                                {
                                    <img class="game-thumbnail-image"
                                         src="@thumbnailDataUri"
                                         alt="@($"{game.Title} サムネイル")" />
                                }
                            </div>
                        }
                        else
                        {
                            <div class="game-card-header">
                                <h2>@game.Title</h2>
                                <span class="status-badge @GetStatusClass(effectiveStatus)">@GetStatusLabel(effectiveStatus)</span>
                            </div>

                            <div class="game-card-body">
                                <p class="meta-label">実行ファイル</p>
                                <p class="meta-value">@game.ExecutablePath</p>
                                <p class="meta-label">関連リポジトリ</p>
                                @if (string.IsNullOrWhiteSpace(game.RelatedRepositoryPath))
                                {
                                    <p class="meta-value">未設定</p>
                                }
                                else
                                {
                                    <p class="meta-value">@game.RelatedRepositoryPath</p>
                                }
                                <p class="meta-label">最終プレイ</p>
                                <p class="meta-value">@FormatLastPlayed(game.LastPlayedAt)</p>
                            </div>
                        }

                        <div class="game-card-actions">
                            <button type="button" class="launch-button" @onclick="() => LaunchAsync(game.Id)">▶ 起動</button>
                            @if (CanResumeRepositorySync(game))
                            {
                                <button type="button"
                                        class="secondary-button"
                                        @onclick="() => ResumeRepositorySyncAsync(game)"
                                        disabled="@IsRepositoryBusy(game)">
                                    再開
                                </button>
                            }
                            <button type="button" class="secondary-button" @onclick="() => OpenEditEditor(game)">設定</button>
                        </div>
                    </article>
                }
            }
        </div>
    </section>
}

<div class="notification-dock" aria-live="polite" aria-atomic="true">
    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <p class="notification-message @GetMessageClass()">@_message</p>
    }
</div>

@if (_isSettingsOpen)
{
    <div class="editor-overlay" @onclick="() => CloseSettings()">
        <section class="settings-modal" @onclick:stopPropagation="true">
            <h2>環境設定</h2>

            <div class="settings-section">
                <label class="settings-toggle-row">
                    <span>Windows起動時に自動起動</span>
                    <input type="checkbox"
                           checked="@_autoStartEnabled"
                           @onchange="OnAutoStartChangedAsync"
                           disabled="@(_isSettingsLoading || _isAutoStartSaving)" />
                </label>
                @if (_isSettingsLoading)
                {
                    <p class="settings-note">設定を読み込み中...</p>
                }
            </div>

            <div class="settings-section settings-actions-row">
                <button type="button"
                        class="secondary-button"
                        @onclick="OpenLatestErrorLogAsync"
                        disabled="@_isSettingsLoading">
                    最新エラーログを開く
                </button>
                <button type="button"
                        class="secondary-button"
                        @onclick="OpenLogDirectoryAsync"
                        disabled="@_isSettingsLoading">
                    ログフォルダを開く
                </button>
            </div>

            <div class="editor-actions">
                <button type="button"
                        class="secondary-button"
                        @onclick="() => CloseSettings()"
                        disabled="@(_isSettingsLoading || _isAutoStartSaving)">
                    閉じる
                </button>
            </div>
        </section>
    </div>
}

@if (_isGitReady && _isEditorOpen)
{
    <div class="editor-overlay" @onclick="() => CloseEditor()">
        <section class="editor-modal" @onclick:stopPropagation="true">
            <h2>@(_isEditMode ? "ゲーム編集" : "ゲーム追加")</h2>

            <div class="editor-field">
                <label for="editor-title">タイトル</label>
                <input id="editor-title" @bind="_editorTitle" @bind:event="oninput" />
            </div>

            <div class="editor-field">
                <label for="editor-executable-path">実行ファイルパス</label>
                <div class="editor-inline-input">
                    <input id="editor-executable-path" @bind="_editorExecutablePath" @bind:event="oninput" />
                    <button type="button" class="secondary-button picker-button" @onclick="PickExecutablePathAsync" disabled="@_isSaving">
                        参照
                    </button>
                </div>
            </div>

            <div class="editor-field">
                <label>サムネイル画像</label>
                <div class="single-repo-picker">
                    <p class="single-repo-value">@GetThumbnailEditorLabel()</p>
                    <div class="single-repo-actions">
                        <button type="button"
                                class="secondary-button picker-button"
                                @onclick="PickThumbnailPathAsync"
                                disabled="@_isSaving">
                            参照
                        </button>
                        <button type="button"
                                class="secondary-button picker-button"
                                @onclick="ClearThumbnailSelection"
                                disabled="@(!CanClearThumbnailSelection() || _isSaving)">
                            解除
                        </button>
                    </div>
                </div>
            </div>

            <div class="editor-field">
                <label>関連リポジトリ（1件のみ）</label>
                <div class="single-repo-picker">
                    <p class="single-repo-value">
                        @(string.IsNullOrWhiteSpace(_editorRepositoryPath) ? "未設定" : _editorRepositoryPath)
                    </p>
                    <div class="single-repo-actions">
                        <button type="button"
                                class="secondary-button picker-button"
                                @onclick="PickRepositoryDirectoryPathAsync"
                                disabled="@_isSaving">
                            フォルダ選択
                        </button>
                        <button type="button"
                                class="secondary-button picker-button"
                                @onclick="ClearRepositoryPath"
                                disabled="@(_isSaving || string.IsNullOrWhiteSpace(_editorRepositoryPath))">
                            解除
                        </button>
                    </div>
                </div>
            </div>

            <div class="editor-actions">
                <button type="button" class="launch-button" @onclick="SaveEditorAsync" disabled="@_isSaving">
                    @(_isSaving ? "保存中..." : "保存")
                </button>
                <button type="button" class="secondary-button" @onclick="() => CloseEditor()" disabled="@_isSaving">キャンセル</button>
            </div>
        </section>
    </div>
}

@code {
    private IReadOnlyList<GameCardItem>? _games;
    private string? _message;
    private bool? _isLastActionSuccess;
    private bool _isEditorOpen;
    private bool _isEditMode;
    private bool _isSaving;
    private string? _editingGameId;
    private string _editorTitle = string.Empty;
    private string _editorExecutablePath = string.Empty;
    private string? _editorRepositoryPath;
    private string? _editorThumbnailSourcePath;
    private bool _editorHasThumbnail;
    private bool _editorClearThumbnail;
    private bool _isSettingsOpen;
    private bool _isSettingsLoading;
    private bool _isAutoStartSaving;
    private bool _autoStartEnabled;
    private bool _isStartupChecking = true;
    private bool _isGitReady = true;
    private string? _startupError;
    private readonly HashSet<string> _registeredWatcherRepositoryIds = new(StringComparer.OrdinalIgnoreCase);
    private readonly Dictionary<string, string> _thumbnailDataUriCache = new(StringComparer.OrdinalIgnoreCase);
    private readonly CancellationTokenSource _stateRefreshCts = new();
    private Task? _stateRefreshTask;

    protected override void OnInitialized()
    {
        SettingsPanelService.OpenRequested += OnSettingsOpenRequested;
    }

    protected override async Task OnInitializedAsync()
    {
        _isStartupChecking = true;
        _isGitReady = true;
        _startupError = null;

        try
        {
            var gitCheckResult = await GitService.RunAsync(AppContext.BaseDirectory, "--version");
            if (!gitCheckResult.IsSuccess)
            {
                _isGitReady = false;
                _startupError = BuildGitStartupError(gitCheckResult);
                UnregisterAllWatchers();
                return;
            }

            _ = SyncOrchestrator;
            await ReloadGamesAsync();
            await RefreshRepositoryWatchersAsync();
            StartStateRefreshLoop();
        }
        finally
        {
            _isStartupChecking = false;
        }
    }

    private async Task LaunchAsync(string gameId)
    {
        SetNotification("起動前同期を実行中です...", null);
        StateHasChanged();

        var result = await LauncherService.LaunchAsync(gameId);
        await ReloadGamesAsync();
        SetNotification(result.Message, result.IsSuccess);
    }

    private async Task OpenSettingsAsync()
    {
        _isSettingsOpen = true;
        await LoadSettingsAsync();
    }

    private void CloseSettings(bool force = false)
    {
        if ((_isSettingsLoading || _isAutoStartSaving) && !force)
        {
            return;
        }

        _isSettingsOpen = false;
    }

    private async Task LoadSettingsAsync()
    {
        _isSettingsLoading = true;
        try
        {
            _autoStartEnabled = await AutoStartService.IsEnabledAsync();
        }
        catch (Exception ex)
        {
            SetNotification($"設定の読み込みに失敗しました: {ex.Message}", false);
        }
        finally
        {
            _isSettingsLoading = false;
        }
    }

    private async Task OnAutoStartChangedAsync(ChangeEventArgs args)
    {
        var enabled = ParseCheckboxValue(args);
        _isAutoStartSaving = true;

        try
        {
            await AutoStartService.SetEnabledAsync(enabled);
            _autoStartEnabled = enabled;
            SetNotification(enabled ? "自動起動を有効化しました。" : "自動起動を無効化しました。", true);
        }
        catch (Exception ex)
        {
            SetNotification($"自動起動設定の更新に失敗しました: {ex.Message}", false);
            try
            {
                _autoStartEnabled = await AutoStartService.IsEnabledAsync();
            }
            catch
            {
                _autoStartEnabled = false;
            }
        }
        finally
        {
            _isAutoStartSaving = false;
        }
    }

    private async Task OpenLatestErrorLogAsync()
    {
        try
        {
            await LogAccessService.OpenLatestErrorLogAsync();
            SetNotification("最新エラーログを開きました。", true);
        }
        catch (Exception ex)
        {
            SetNotification(ex.Message, false);
        }
    }

    private async Task OpenLogDirectoryAsync()
    {
        try
        {
            await LogAccessService.OpenLogDirectoryAsync();
            SetNotification("ログフォルダを開きました。", true);
        }
        catch (Exception ex)
        {
            SetNotification(ex.Message, false);
        }
    }

    private void OpenCreateEditor()
    {
        _isEditMode = false;
        _editingGameId = null;
        _editorTitle = string.Empty;
        _editorExecutablePath = string.Empty;
        _editorRepositoryPath = null;
        _editorThumbnailSourcePath = null;
        _editorHasThumbnail = false;
        _editorClearThumbnail = false;
        _isEditorOpen = true;
    }

    private void OpenEditEditor(GameCardItem game)
    {
        _isEditMode = true;
        _editingGameId = game.Id;
        _editorTitle = game.Title;
        _editorExecutablePath = game.ExecutablePath;
        _editorRepositoryPath = game.RelatedRepositoryPath;
        _editorThumbnailSourcePath = null;
        _editorHasThumbnail = HasThumbnail(game);
        _editorClearThumbnail = false;
        _isEditorOpen = true;
    }

    private void CloseEditor(bool force = false)
    {
        if (_isSaving && !force)
        {
            return;
        }

        _isEditorOpen = false;
    }

    private async Task SaveEditorAsync()
    {
        var shouldCloseEditor = false;

        if (string.IsNullOrWhiteSpace(_editorTitle))
        {
            SetNotification("タイトルは必須です。", false);
            return;
        }

        if (string.IsNullOrWhiteSpace(_editorExecutablePath))
        {
            SetNotification("実行ファイルパスは必須です。", false);
            return;
        }

        var input = new GameEditInput(
            Title: _editorTitle,
            ExecutablePath: _editorExecutablePath,
            RelatedRepositoryPath: _editorRepositoryPath,
            ThumbnailSourcePath: _editorThumbnailSourcePath,
            ClearThumbnail: _editorClearThumbnail);

        _isSaving = true;
        try
        {
            if (_isEditMode)
            {
                if (string.IsNullOrWhiteSpace(_editingGameId))
                {
                    SetNotification("編集対象が不正です。", false);
                    return;
                }

                var updated = await GameLibraryService.UpdateAsync(_editingGameId, input);
                if (updated is null)
                {
                    SetNotification("編集対象のゲームが見つかりません。", false);
                    return;
                }

                SetNotification($"ゲーム設定を更新しました: {updated.Title}", true);
            }
            else
            {
                var created = await GameLibraryService.CreateAsync(input);
                SetNotification($"ゲームを登録しました: {created.Title}", true);
            }

            await ReloadGamesAsync();
            await RefreshRepositoryWatchersAsync();
            shouldCloseEditor = true;
        }
        catch (Exception ex)
        {
            SetNotification($"保存に失敗しました: {ex.Message}", false);
        }
        finally
        {
            _isSaving = false;
            if (shouldCloseEditor)
            {
                CloseEditor(force: true);
            }
        }
    }

    private async Task PickExecutablePathAsync()
    {
        try
        {
            var selectedPath = await PathPickerService.PickExecutablePathAsync();
            if (!string.IsNullOrWhiteSpace(selectedPath))
            {
                _editorExecutablePath = selectedPath;
                return;
            }

            SetNotification("実行ファイルが選択されませんでした。", false);
        }
        catch (Exception ex)
        {
            SetNotification(ex.Message, false);
        }
    }

    private async Task PickThumbnailPathAsync()
    {
        try
        {
            var selectedPath = await PathPickerService.PickThumbnailPathAsync();
            if (!string.IsNullOrWhiteSpace(selectedPath))
            {
                _editorThumbnailSourcePath = selectedPath;
                _editorClearThumbnail = false;
                return;
            }

            SetNotification("サムネイル画像が選択されませんでした。", false);
        }
        catch (Exception ex)
        {
            SetNotification(ex.Message, false);
        }
    }

    private void ClearThumbnailSelection()
    {
        _editorThumbnailSourcePath = null;
        _editorHasThumbnail = false;
        _editorClearThumbnail = true;
    }

    private bool CanClearThumbnailSelection()
    {
        return _editorHasThumbnail || !string.IsNullOrWhiteSpace(_editorThumbnailSourcePath);
    }

    private string GetThumbnailEditorLabel()
    {
        if (!string.IsNullOrWhiteSpace(_editorThumbnailSourcePath))
        {
            return _editorThumbnailSourcePath;
        }

        if (_editorHasThumbnail && !_editorClearThumbnail)
        {
            return "登録済み（変更なし）";
        }

        return "未設定";
    }

    private async Task PickRepositoryDirectoryPathAsync()
    {
        try
        {
            var selectedPath = await PathPickerService.PickRepositoryDirectoryPathAsync();
            if (!string.IsNullOrWhiteSpace(selectedPath))
            {
                _editorRepositoryPath = selectedPath;
                return;
            }

            SetNotification("リポジトリフォルダが選択されませんでした。", false);
        }
        catch (Exception ex)
        {
            SetNotification(ex.Message, false);
        }
    }

    private void ClearRepositoryPath()
    {
        _editorRepositoryPath = null;
    }

    private async Task ReloadGamesAsync()
    {
        _games = await GameLibraryService.GetGamesAsync();
        SyncThumbnailCache();
    }

    private Task RefreshRepositoryWatchersAsync()
    {
        if (_games is null)
        {
            return Task.CompletedTask;
        }

        var activeRepositoryIds = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        foreach (var game in _games)
        {
            if (string.IsNullOrWhiteSpace(game.RelatedRepositoryPath))
            {
                continue;
            }

            var repositoryKey = NormalizeRepositoryKey(game.RelatedRepositoryPath);
            if (repositoryKey is null)
            {
                continue;
            }

            RepositoryWatcherService.Register(repositoryKey, repositoryKey);
            activeRepositoryIds.Add(repositoryKey);
        }

        var staleRepositoryIds = _registeredWatcherRepositoryIds
            .Where(id => !activeRepositoryIds.Contains(id))
            .ToArray();
        foreach (var repositoryId in staleRepositoryIds)
        {
            RepositoryWatcherService.Unregister(repositoryId);
        }

        _registeredWatcherRepositoryIds.Clear();
        foreach (var repositoryId in activeRepositoryIds)
        {
            _registeredWatcherRepositoryIds.Add(repositoryId);
        }

        return Task.CompletedTask;
    }

    private void UnregisterAllWatchers()
    {
        foreach (var repositoryId in _registeredWatcherRepositoryIds.ToArray())
        {
            RepositoryWatcherService.Unregister(repositoryId);
        }

        _registeredWatcherRepositoryIds.Clear();
    }

    private static string? NormalizeRepositoryKey(string? repositoryPath)
    {
        if (string.IsNullOrWhiteSpace(repositoryPath))
        {
            return null;
        }

        try
        {
            var normalized = Path.GetFullPath(repositoryPath.Trim());
            return Directory.Exists(normalized) ? normalized : null;
        }
        catch
        {
            return null;
        }
    }

    public void Dispose()
    {
        SettingsPanelService.OpenRequested -= OnSettingsOpenRequested;
        _stateRefreshCts.Cancel();
        _stateRefreshCts.Dispose();
        UnregisterAllWatchers();
        _thumbnailDataUriCache.Clear();
    }

    private void StartStateRefreshLoop()
    {
        if (_stateRefreshTask is not null)
        {
            return;
        }

        _stateRefreshTask = Task.Run(async () =>
        {
            while (!_stateRefreshCts.IsCancellationRequested)
            {
                try
                {
                    await Task.Delay(TimeSpan.FromSeconds(1), _stateRefreshCts.Token);
                    await InvokeAsync(StateHasChanged);
                }
                catch (OperationCanceledException)
                {
                    break;
                }
                catch (ObjectDisposedException)
                {
                    break;
                }
            }
        });
    }

    private RepositorySyncState GetRepositorySyncState(GameCardItem game)
    {
        var repositoryKey = NormalizeRepositoryKey(game.RelatedRepositoryPath);
        if (repositoryKey is null)
        {
            return RepositorySyncState.Idle;
        }

        return RepositoryStateStore.GetStateOrDefault(repositoryKey);
    }

    private GameCardStatus GetEffectiveStatus(GameCardItem game)
    {
        return GetRepositorySyncState(game) switch
        {
            RepositorySyncState.Syncing => GameCardStatus.Syncing,
            RepositorySyncState.Debouncing => GameCardStatus.Syncing,
            RepositorySyncState.ErrorPaused => GameCardStatus.Error,
            _ => game.Status
        };
    }

    private bool CanResumeRepositorySync(GameCardItem game)
    {
        return !string.IsNullOrWhiteSpace(game.RelatedRepositoryPath)
            && GetRepositorySyncState(game) == RepositorySyncState.ErrorPaused;
    }

    private bool IsRepositoryBusy(GameCardItem game)
    {
        var state = GetRepositorySyncState(game);
        return state is RepositorySyncState.Debouncing or RepositorySyncState.Syncing;
    }

    private static bool HasThumbnail(GameCardItem game)
    {
        return !string.IsNullOrWhiteSpace(game.ThumbnailPath);
    }

    private string? GetThumbnailDataUri(GameCardItem game)
    {
        var path = NormalizeThumbnailPath(game.ThumbnailPath);
        if (path is null)
        {
            return null;
        }

        if (_thumbnailDataUriCache.TryGetValue(path, out var cached))
        {
            return cached;
        }

        try
        {
            if (!File.Exists(path))
            {
                return null;
            }

            var bytes = File.ReadAllBytes(path);
            if (bytes.Length == 0)
            {
                return null;
            }

            var dataUri = $"data:image/png;base64,{Convert.ToBase64String(bytes)}";
            _thumbnailDataUriCache[path] = dataUri;
            return dataUri;
        }
        catch
        {
            return null;
        }
    }

    private void SyncThumbnailCache()
    {
        if (_games is null)
        {
            _thumbnailDataUriCache.Clear();
            return;
        }

        var activePaths = _games
            .Select(game => NormalizeThumbnailPath(game.ThumbnailPath))
            .Where(static path => !string.IsNullOrWhiteSpace(path))
            .Select(static path => path!)
            .ToHashSet(StringComparer.OrdinalIgnoreCase);

        var stalePaths = _thumbnailDataUriCache.Keys
            .Where(path => !activePaths.Contains(path))
            .ToArray();

        foreach (var stalePath in stalePaths)
        {
            _thumbnailDataUriCache.Remove(stalePath);
        }
    }

    private static string? NormalizeThumbnailPath(string? path)
    {
        if (string.IsNullOrWhiteSpace(path))
        {
            return null;
        }

        try
        {
            return Path.GetFullPath(path.Trim());
        }
        catch
        {
            return null;
        }
    }

    private async Task ResumeRepositorySyncAsync(GameCardItem game)
    {
        var repositoryKey = NormalizeRepositoryKey(game.RelatedRepositoryPath);
        if (repositoryKey is null)
        {
            SetNotification("関連リポジトリのパスが無効です。", false);
            return;
        }

        try
        {
            await SyncOrchestrator.ResumeRepositorySyncAsync(repositoryKey);
            SetNotification($"同期を再開しました: {game.Title}", true);
        }
        catch (Exception ex)
        {
            SetNotification($"同期再開に失敗しました: {ex.Message}", false);
        }
    }

    private static string FormatLastPlayed(DateTimeOffset? value)
    {
        return value?.LocalDateTime.ToString("yyyy-MM-dd HH:mm") ?? "未プレイ";
    }

    private static string GetStatusLabel(GameCardStatus status)
    {
        return status switch
        {
            GameCardStatus.Syncing => "同期中",
            GameCardStatus.Synced => "同期OK",
            GameCardStatus.Error => "エラー",
            _ => "未同期"
        };
    }

    private static string GetStatusClass(GameCardStatus status)
    {
        return status switch
        {
            GameCardStatus.Syncing => "status-syncing",
            GameCardStatus.Synced => "status-synced",
            GameCardStatus.Error => "status-error",
            _ => "status-unknown"
        };
    }

    private string GetMessageClass()
    {
        return _isLastActionSuccess switch
        {
            true => "notification-success",
            false => "notification-error",
            _ => "notification-info"
        };
    }

    private void SetNotification(string message, bool? isSuccess)
    {
        _message = message;
        _isLastActionSuccess = isSuccess;

        if (isSuccess == false)
        {
            _ = WriteErrorLogSafeAsync(message);
        }
    }

    private async Task WriteErrorLogSafeAsync(string message)
    {
        if (string.IsNullOrWhiteSpace(message))
        {
            return;
        }

        try
        {
            await LogAccessService.AppendErrorAsync(message);
        }
        catch
        {
            // エラーログ書き込み失敗は通知ループを防ぐため握りつぶす。
        }
    }

    private static bool ParseCheckboxValue(ChangeEventArgs args)
    {
        if (args.Value is bool boolValue)
        {
            return boolValue;
        }

        var value = args.Value?.ToString();
        return string.Equals(value, "true", StringComparison.OrdinalIgnoreCase)
            || string.Equals(value, "on", StringComparison.OrdinalIgnoreCase);
    }

    private static string BuildGitStartupError(GitCommandResult result)
    {
        var reason = FirstNonEmptyLine(result.StandardError)
            ?? FirstNonEmptyLine(result.StandardOutput)
            ?? $"exit code: {result.ExitCode}";
        return $"Git の起動確認に失敗しました。reason={reason}";
    }

    private static string? FirstNonEmptyLine(string value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return null;
        }

        return value
            .Split(['\r', '\n'], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .FirstOrDefault(static line => !string.IsNullOrWhiteSpace(line));
    }

    private void OnSettingsOpenRequested(object? sender, EventArgs e)
    {
        _ = InvokeAsync(async () =>
        {
            if (_isStartupChecking || !_isGitReady)
            {
                return;
            }

            if (_isSettingsOpen)
            {
                StateHasChanged();
                return;
            }

            await OpenSettingsAsync();
            StateHasChanged();
        });
    }
}
