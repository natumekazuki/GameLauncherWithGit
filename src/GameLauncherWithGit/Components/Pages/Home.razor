    private IReadOnlyList<GameSaveLinkEditInput> BuildEditorSaveLinkInputs()
    {
        if (_editorSaveLinks.Count == 0)
        {
            return Array.Empty<GameSaveLinkEditInput>();
        }

        var result = new List<GameSaveLinkEditInput>(_editorSaveLinks.Count);
        for (var index = 0; index < _editorSaveLinks.Count; index++)
        {
            var entry = _editorSaveLinks[index];
            var localPath = entry.LocalPath?.Trim();
            var targetPath = entry.TargetPath?.Trim();
            if (string.IsNullOrWhiteSpace(localPath) && string.IsNullOrWhiteSpace(targetPath))
            {
                continue;
            }

            if (string.IsNullOrWhiteSpace(localPath) || string.IsNullOrWhiteSpace(targetPath))
            {
                throw new InvalidOperationException($"セーブリンク {index + 1} はローカルと同期先の両方を設定してください。");
            }

            result.Add(
                new GameSaveLinkEditInput(
                    Id: entry.Id,
                    DisplayName: string.Empty,
                    LocalPath: localPath,
                    TargetPath: targetPath,
                    EnsureOnLaunch: entry.EnsureOnLaunch));
        }

        return result;
    }

