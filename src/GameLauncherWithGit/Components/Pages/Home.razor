    private IReadOnlyList<GameCardItem>? _games;
    private string? _message;
    private bool? _isLastActionSuccess;
    private CancellationTokenSource? _notificationDismissCts;
    private bool _isEditorOpen;
    private bool _isEditMode;
    private bool _isSaving;
    private bool _isDeleteConfirmOpen;
    private bool _isDeleting;
    private string? _editingGameId;
    private string? _deleteTargetGameId;
    private string _deleteTargetGameTitle = string.Empty;
    private string _editorTitle = string.Empty;
    private string _editorSavedTitle = string.Empty;
    private string _editorExecutablePath = string.Empty;
    private string? _editorRepositoryPath;
    private string? _editorCurrentBranch;
    private string? _editorSelectedBranch;
    private string _editorNewBranchName = string.Empty;
    private readonly List<string> _editorBranches = [];
    private readonly HashSet<string> _editorLocalBranches = new(StringComparer.OrdinalIgnoreCase);
    private readonly HashSet<string> _editorRemoteBranches = new(StringComparer.OrdinalIgnoreCase);
    private readonly Dictionary<string, string> _editorRemoteBranchLocalNames = new(StringComparer.OrdinalIgnoreCase);
    private readonly List<EditorSaveLinkEntry> _editorSaveLinks = [];
    private string? _editorThumbnailSourcePath;
    private bool _editorHasThumbnail;
    private bool _editorClearThumbnail;
    private string _editorSnapshot = string.Empty;
    private CapturePreference? _capturePreference;
    private bool _isBranchLoading;
    private bool _isBranchSwitching;
    private bool _isBranchCreating;
    private bool _isHelpOpen;
    private bool _isSettingsOpen;
    private bool _isSettingsLoading;
    private bool _isAutoStartSaving;
    private bool _isAppSettingsSaving;
    private bool _isCardSizeSaving;
    private bool _autoStartEnabled;
    private int _syncDebounceSeconds = AppSettings.Default.SyncDebounceSeconds;
    private int _syncRetryInitialSeconds = AppSettings.Default.SyncRetryInitialSeconds;
    private int _syncRetryMaxSeconds = AppSettings.Default.SyncRetryMaxSeconds;
    private int _notificationSuppressSeconds = AppSettings.Default.NotificationSuppressSeconds;
    private int _logRetentionDays = AppSettings.Default.LogRetentionDays;
    private int _logMaxFileSizeMb = AppSettings.Default.LogMaxFileSizeMb;
    private int _gameCardSizePercent = AppSettings.Default.GameCardSizePercent;
    private bool _showCardTitle = AppSettings.Default.ShowCardTitle;
    private bool _showCardSyncStatus = AppSettings.Default.ShowCardSyncStatus;
    private AppSettings? _settingsSnapshot;
    private int _logViewerLimit = 100;
    private string _logViewerSeverityFilter = "all";
    private string _logViewerKeyword = string.Empty;
    private string _gameSearchText = string.Empty;
    private bool _isLogLoading;
    private string? _logViewerError;
    private IReadOnlyList<LogViewerEntry> _logViewerEntries = Array.Empty<LogViewerEntry>();
    private bool _isStartupChecking = true;
    private bool _isGitReady = true;
    private string? _startupError;
    private string? _libraryLoadError;
    private bool _syncHistoryLoadFailed;
    private DraftKind? _discardChanges;
    private ElementReference _libraryHeading;
    private ElementReference _notificationHeading;
    private ElementReference _logHeading;
    private bool _focusLibraryHeading;
    private readonly HashSet<string> _registeredWatcherRepositoryIds = new(StringComparer.OrdinalIgnoreCase);
    private readonly HashSet<string> _pinningGameIds = new(StringComparer.OrdinalIgnoreCase);
    private readonly Dictionary<string, ThumbnailSource> _thumbnailCache = new(StringComparer.OrdinalIgnoreCase);
    private readonly Dictionary<string, IReadOnlyList<GameSaveLinkItem>> _saveLinksByGame = new(StringComparer.OrdinalIgnoreCase);
    private readonly HashSet<string> _saveLinkLoadFailedGameIds = new(StringComparer.OrdinalIgnoreCase);
    private readonly Dictionary<string, IReadOnlyList<RepositorySyncHistoryItem>> _syncHistoryByRepository = new(StringComparer.OrdinalIgnoreCase);
    private readonly Dictionary<string, GitRepositoryVisualState> _gitVisualStateByRepository = new(StringComparer.OrdinalIgnoreCase);
    private readonly List<NotificationHistoryEntry> _notificationHistoryEntries = [];
    private bool _showSuccessNotifications = true;
    private bool _showFailedNotifications = true;
    private bool _isGitStatusRefreshing;
    private readonly CancellationTokenSource _stateRefreshCts = new();
    private Task? _stateRefreshTask;
    private readonly Stack<string> _userOperationLoadingMessages = new();

    protected override void OnInitialized()
    {
        SettingsPanelService.OpenRequested += OnSettingsOpenRequested;
    }

    protected override Task OnInitializedAsync() => InitializeLibraryAsync();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusLibraryHeading)
        {
            _focusLibraryHeading = false;
            await _libraryHeading.FocusAsync();
        }
    }

    private async Task InitializeLibraryAsync()
    {
        _isStartupChecking = true;
        _isGitReady = true;
        _startupError = null;

        try
        {
            try
            {
                var gitCheckResult = await GitService.CheckAvailabilityAsync();
                _startupError = gitCheckResult.IsSuccess ? null : BuildGitStartupError(gitCheckResult);
            }
            catch (Exception ex)
            {
                _startupError = ex.Message;
            }

            if (_startupError is not null)
            {
                _isGitReady = false;
                UnregisterAllWatchers();
                return;
            }

            ApplyAppSettings(AppSettingsService.Get());
            await RunStartupLogMaintenanceAsync();
            _ = SyncOrchestrator;
            if (await ReloadGamesAsync())
            {
                RefreshRepositoryWatchers();
            }
            StartStateRefreshLoop();
        }
        finally
        {
            _isStartupChecking = false;
        }
    }

    private async Task RetryStartupAsync()
    {
        if (_isStartupChecking) return;
        await InitializeLibraryAsync();
        _focusLibraryHeading = true;
    }

    private async Task LaunchAsync(string gameId)
    {
        await RunWithUserOperationLoadingAsync(
            "起動前同期を実行しています...",
            async () =>
            {
                SetNotification("起動前同期を実行中です...", null);
                var result = await LauncherService.LaunchAsync(gameId);
                if (result.ShowCapture)
                {
                    Navigation.NavigateTo("capture", new NavigationOptions { HistoryEntryState = result.Message });
                    return;
                }

                SetNotification(result.Message, result.IsSuccess);
                try
                {
                    if (await ReloadGamesAsync())
                    {
                        return;
                    }
                }
                catch (Exception ex)
                {
                    _libraryLoadError = ex.Message;
                }

                SetNotification($"{result.Message} 一覧の再読込に失敗しました。", false, addToHistory: false);
            });
    }

    private Task LaunchFromThumbnailAsync(GameCardItem game)
    {
        return IsLaunchDisabled(game) ? Task.CompletedTask : LaunchAsync(game.Id);
    }

    private async Task OpenSettingsAsync()
    {
        if (_isCardSizeSaving)
        {
            return;
        }

        DismissNotification();
        _settingsSnapshot = GetSettingsDraft();
        _isSettingsOpen = true;
        await RunWithUserOperationLoadingAsync("設定を読み込んでいます...", LoadSettingsAsync);
    }

    private Task FocusNotificationHeadingAsync() => JS.InvokeVoidAsync("gameLauncherDialogFocusSection", _notificationHeading).AsTask();

    private Task FocusLogHeadingAsync() => JS.InvokeVoidAsync("gameLauncherDialogFocusSection", _logHeading).AsTask();

    private void OpenHelp()
    {
        DismissNotification();
        _isHelpOpen = true;
    }

    private void CloseHelp()
    {
        _isHelpOpen = false;
    }

    private void RequestCloseSettings()
    {
        if (_isSettingsLoading || _isAutoStartSaving || _isAppSettingsSaving || _isCardSizeSaving)
        {
            return;
        }

        if (_settingsSnapshot != GetSettingsDraft())
        {
            _discardChanges = DraftKind.Settings;
            return;
        }

        _isSettingsOpen = false;
    }

    private void CancelDiscardChanges() => _discardChanges = null;

    private void ConfirmDiscardChanges()
    {
        if (_discardChanges == DraftKind.Game)
        {
            CloseEditor();
        }
        else if (_discardChanges == DraftKind.Settings)
        {
            if (_settingsSnapshot is not null)
            {
                ApplyAppSettings(_settingsSnapshot with { GameCardSizePercent = _gameCardSizePercent });
            }
            _isSettingsOpen = false;
        }

        _discardChanges = null;
    }

    private async Task RunWithUserOperationLoadingAsync(string message, Func<Task> action)
    {
        BeginUserOperationLoading(message);
        try
        {
            await action();
        }
        finally
        {
            EndUserOperationLoading();
        }
    }

    private void BeginUserOperationLoading(string message)
    {
        var normalizedMessage = string.IsNullOrWhiteSpace(message) ? "処理中..." : message.Trim();
        _userOperationLoadingMessages.Push(normalizedMessage);
        if (!_stateRefreshCts.IsCancellationRequested)
        {
            StateHasChanged();
        }
    }

    private void EndUserOperationLoading()
    {
        if (_userOperationLoadingMessages.Count > 0)
        {
            _userOperationLoadingMessages.Pop();
        }

        if (!_stateRefreshCts.IsCancellationRequested)
        {
            StateHasChanged();
        }
    }

    private bool IsUserOperationLoading => _userOperationLoadingMessages.Count > 0;

    private string GetUserOperationLoadingMessage()
    {
        return _userOperationLoadingMessages.Count == 0
            ? "処理中..."
            : _userOperationLoadingMessages.Peek();
    }

    private async Task LoadSettingsAsync()
    {
        _isSettingsLoading = true;
        try
        {
            _autoStartEnabled = await AutoStartService.IsEnabledAsync();
            ApplyAppSettings(AppSettingsService.Get());
            _settingsSnapshot = GetSettingsDraft();
            await LoadLogEntriesCoreAsync();
        }
        catch (Exception ex)
        {
            SetNotification($"設定の読み込みに失敗しました: {ex.Message}", false);
        }
        finally
        {
            _isSettingsLoading = false;
        }
    }

    private async Task OnAutoStartChangedAsync(ChangeEventArgs args)
    {
        var enabled = ParseCheckboxValue(args);
        await RunWithUserOperationLoadingAsync(
            "自動起動設定を更新しています...",
            async () =>
            {
                _isAutoStartSaving = true;

                try
                {
                    await AutoStartService.SetEnabledAsync(enabled);
                    _autoStartEnabled = enabled;
                    SetNotification(enabled ? "自動起動を有効化しました。" : "自動起動を無効化しました。", true);
                }
                catch (Exception ex)
                {
