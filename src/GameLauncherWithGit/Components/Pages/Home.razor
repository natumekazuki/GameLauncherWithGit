    private async Task<bool> RefreshGitStatusesAsync(CancellationToken cancellationToken = default)
    {
        if (_isGitStatusRefreshing)
        {
            return true;
        }

        _isGitStatusRefreshing = true;
        var isSuccess = true;
        try
        {
            var nextStates = new Dictionary<string, GitRepositoryVisualState>(StringComparer.OrdinalIgnoreCase);
            var repositoryPaths = _games?
                .Select(game => NormalizeRepositoryPath(game.RelatedRepositoryPath))
                .Where(static path => !string.IsNullOrWhiteSpace(path))
                .Select(static path => path!)
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .ToArray()
                ?? [];

            foreach (var repositoryPath in repositoryPaths)
            {
                cancellationToken.ThrowIfCancellationRequested();
                try
                {
                    nextStates[repositoryPath] = await EvaluateGitVisualStateAsync(repositoryPath, cancellationToken);
                }
                catch (OperationCanceledException)
                {
                    throw;
                }
                catch
                {
                    nextStates[repositoryPath] = GitRepositoryVisualState.Error;
                    isSuccess = false;
                }
            }

            _gitVisualStateByRepository.Clear();
            foreach (var pair in nextStates)
            {
                _gitVisualStateByRepository[pair.Key] = pair.Value;
            }
        }
        finally
        {
            _isGitStatusRefreshing = false;
        }

        return isSuccess;
    }

    private async Task<GitRepositoryVisualState> EvaluateGitVisualStateAsync(
        string repositoryPath,
        CancellationToken cancellationToken)
    {
        if (!Directory.Exists(repositoryPath))
        {
            return GitRepositoryVisualState.Error;
        }

        var result = await GitService.RunAsync(
            repositoryPath,
            "status --porcelain --branch",
            cancellationToken);
        if (!result.IsSuccess)
        {
            return GitRepositoryVisualState.Error;
        }

        return ParseGitVisualState(result.StandardOutput);
    }

    private static GitRepositoryVisualState ParseGitVisualState(string output)
    {
        if (string.IsNullOrWhiteSpace(output))
        {
            return GitRepositoryVisualState.Clean;
        }

        var lines = output
            .Split(['\r', '\n'], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        if (lines.Length == 0)
        {
            return GitRepositoryVisualState.Clean;
        }

        var headerLine = lines[0];
        var hasWorkingTreeChanges = lines.Length > 1;
        ParseAheadBehind(headerLine, out var aheadCount, out var behindCount);

        if (aheadCount > 0 && behindCount > 0)
        {
            return GitRepositoryVisualState.Diverged;
        }

        if (behindCount > 0)
        {
            return GitRepositoryVisualState.Behind;
        }

        if (aheadCount > 0)
        {
            return GitRepositoryVisualState.Ahead;
        }

        return hasWorkingTreeChanges
            ? GitRepositoryVisualState.Dirty
            : GitRepositoryVisualState.Clean;
    }

    private static void ParseAheadBehind(string headerLine, out int aheadCount, out int behindCount)
    {
        aheadCount = 0;
        behindCount = 0;

        if (string.IsNullOrWhiteSpace(headerLine))
        {
            return;
        }

        var leftBracketIndex = headerLine.IndexOf('[');
        if (leftBracketIndex < 0)
        {
            return;
        }

        var rightBracketIndex = headerLine.IndexOf(']', leftBracketIndex + 1);
        if (rightBracketIndex <= leftBracketIndex)
        {
            return;
        }

        var summary = headerLine.Substring(leftBracketIndex + 1, rightBracketIndex - leftBracketIndex - 1);
        var segments = summary
            .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        foreach (var segment in segments)
        {
            if (segment.StartsWith("ahead ", StringComparison.OrdinalIgnoreCase)
                && int.TryParse(segment["ahead ".Length..], out var ahead))
            {
                aheadCount = ahead;
            }
            else if (segment.StartsWith("behind ", StringComparison.OrdinalIgnoreCase)
                && int.TryParse(segment["behind ".Length..], out var behind))
            {
                behindCount = behind;
            }
        }
    }

    private GitRepositoryVisualState GetGitVisualState(GameCardItem game)
