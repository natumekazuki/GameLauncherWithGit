@page "/"
@implements IDisposable
@inject IGameLibraryService GameLibraryService
@inject ILauncherService LauncherService
@inject IPathPickerService PathPickerService
@inject IGitService GitService
@inject IAutoStartService AutoStartService
@inject IAppSettingsService AppSettingsService
@inject ILogAccessService LogAccessService
@inject IRepositoryWatcherService RepositoryWatcherService
@inject ISyncOrchestrator SyncOrchestrator
@inject IRepositoryStateStore RepositoryStateStore
@inject ISettingsPanelService SettingsPanelService
@inject IRepositorySyncHistoryStore RepositorySyncHistoryStore
@inject ISaveLinkService SaveLinkService

<PageTitle>GameLauncherWithGit</PageTitle>

@if (!_isStartupChecking)
{
    <section class="utility-bar">
        <div class="search-control">
            <input type="search"
                   class="search-input"
                   @bind="_gameSearchText"
                   @bind:event="oninput"
                   placeholder="ゲームを検索"
                   aria-label="ゲーム検索" />
        </div>
        <div class="card-size-control">
            <button type="button"
                    class="secondary-button utility-icon-button"
                    title="カードサイズを小さくする"
                    @onclick="DecreaseGameCardSizeAsync"
                    disabled="@(!_isGitReady || _isCardSizeSaving || _gameCardSizePercent <= AppSettings.GameCardSizePercentMin)">
                -
            </button>
            <span class="card-size-label">@_gameCardSizePercent%</span>
            <button type="button"
                    class="secondary-button utility-icon-button"
                    title="カードサイズを大きくする"
                    @onclick="IncreaseGameCardSizeAsync"
                    disabled="@(!_isGitReady || _isCardSizeSaving || _gameCardSizePercent >= AppSettings.GameCardSizePercentMax)">
                +
            </button>
        </div>
        <button type="button"
                class="secondary-button utility-button"
                @onclick="OpenCreateEditor"
                disabled="@(!_isGitReady)">
            + 新規追加
        </button>
        <button type="button"
                class="secondary-button utility-button"
                @onclick="RefreshGitStatusesManuallyAsync"
                disabled="@(!_isGitReady || _isGitStatusRefreshing || _games is null)">
            @(_isGitStatusRefreshing ? "更新中..." : "Gitステータス更新")
        </button>
        <button type="button"
                class="secondary-button utility-button"
                @onclick="OpenSettingsAsync">
            環境設定
        </button>
        <button type="button"
                class="secondary-button utility-button"
                @onclick="OpenHelp">
            Help
        </button>
    </section>
}

@if (_isStartupChecking)
{
    <section class="library-page startup-check-panel">
        <p>起動要件を確認しています...</p>
    </section>
}
else if (!_isGitReady)
{
    <section class="startup-error-panel">
        <h1>Git が利用できません</h1>
        <p>Git のインストールまたは PATH 設定を確認してから、アプリを再起動してください。</p>
        @if (!string.IsNullOrWhiteSpace(_startupError))
        {
            <p class="startup-error-detail">@_startupError</p>
        }
    </section>
}
else
{
    <section class="library-page">
        <div class="game-grid" style="@GetGameGridStyle()">
            @if (_games is null)
            {
                <div class="game-card loading-card">読み込み中...</div>
            }
            else
            {
                var filteredGames = GetFilteredGames();
                if (filteredGames.Count == 0)
                {
                    <div class="game-card loading-card">検索条件に一致するゲームがありません。</div>
                }
                else
                {
                    @foreach (var game in filteredGames)
                    {
                        var effectiveStatus = GetEffectiveStatus(game);
                        var gitVisualState = GetGitVisualState(game);
                        var syncHistory = GetSyncHistoryTimeline(game);
                        var hasThumbnail = HasThumbnail(game);
                        var thumbnailDataUri = hasThumbnail ? GetThumbnailDataUri(game) : null;
                        var showCardTitle = _showCardTitle;
                        var showCardSyncStatus = _showCardSyncStatus;
                        var hasCardHeader = showCardTitle || showCardSyncStatus;
                        <article class="@GetGameCardClass(hasThumbnail, gitVisualState)">
                            @if (hasThumbnail)
                            {
                                <div class="game-thumbnail-panel">
                                    @if (string.IsNullOrWhiteSpace(thumbnailDataUri))
                                    {
                                        <div class="game-thumbnail-missing" title="@game.Title"></div>
                                    }
                                    else
                                    {
                                        <img class="game-thumbnail-image"
                                             src="@thumbnailDataUri"
                                             alt="@($"{game.Title} サムネイル")" />
                                    }
                                </div>

                                @if (hasCardHeader)
                                {
                                    <div class="thumbnail-card-meta">
                                        @if (showCardTitle)
                                        {
                                            <h2 class="thumbnail-card-title">@game.Title</h2>
                                        }
                                        @if (showCardSyncStatus)
                                        {
                                            <span class="status-badge @GetStatusClass(effectiveStatus)">@GetStatusLabel(effectiveStatus)</span>
                                        }
                                    </div>
                                }
                            }
                            else
                            {
                                @if (hasCardHeader)
                                {
                                    <div class="game-card-header @(!showCardTitle && showCardSyncStatus ? "game-card-header-status-only" : string.Empty)">
                                        @if (showCardTitle)
                                        {
                                            <h2>@game.Title</h2>
                                        }
                                        @if (showCardSyncStatus)
                                        {
                                            <span class="status-badge @GetStatusClass(effectiveStatus)">@GetStatusLabel(effectiveStatus)</span>
                                        }
                                    </div>
                                }

                                <div class="game-card-body @(hasCardHeader ? string.Empty : "game-card-body-no-header")">
                                    <p class="meta-label">実行ファイル</p>
                                    @if (string.IsNullOrWhiteSpace(game.ExecutablePath))
                                    {
                                        <p class="meta-value">未設定</p>
                                    }
                                    else
                                    {
                                        <p class="meta-value">@game.ExecutablePath</p>
                                    }
                                    <p class="meta-label">関連リポジトリ</p>
                                    @if (string.IsNullOrWhiteSpace(game.RelatedRepositoryPath))
                                    {
                                        <p class="meta-value">未設定</p>
                                    }
                                    else
                                    {
                                        <p class="meta-value">@game.RelatedRepositoryPath</p>
                                    }
                                    <p class="meta-label">セーブリンク</p>
                                    <p class="meta-value">@GetSaveLinkSummary(game)</p>
                                    <p class="meta-label">最終プレイ</p>
                                    <p class="meta-value">@FormatLastPlayed(game.LastPlayedAt)</p>

                                    <p class="meta-label">同期履歴</p>
                                    @if (syncHistory.Count == 0)
                                    {
                                        <p class="meta-value">履歴なし</p>
                                    }
                                    else
                                    {
                                        <ul class="sync-timeline-list">
                                            @foreach (var history in syncHistory)
                                            {
                                                <li class="sync-timeline-item @GetSyncHistoryStatusClass(history.Status)">
                                                    <div class="sync-timeline-head">
                                                        <span>@GetSyncHistoryStatusLabel(history.Status)</span>
                                                        <span>@FormatSyncHistoryTimestamp(history.FinishedAt)</span>
                                                    </div>
                                                    <p class="sync-timeline-meta">所要時間: @FormatSyncHistoryDuration(history.DurationMs)</p>
                                                    @if (!string.IsNullOrWhiteSpace(history.Command))
                                                    {
                                                        <p class="sync-timeline-meta">command: @history.Command</p>
                                                    }
                                                    @if (!string.IsNullOrWhiteSpace(history.Reason))
                                                    {
                                                        <p class="sync-timeline-reason">@history.Reason</p>
                                                    }
                                                </li>
                                            }
                                        </ul>
                                    }
                                </div>
                            }

                            <div class="game-card-actions">
                                <button type="button"
                                        class="launch-button action-icon-button"
                                        @onclick="() => LaunchAsync(game.Id)"
                                        title="@GetLaunchButtonTitle(game)"
                                        aria-label="@GetLaunchButtonTitle(game)"
                                        disabled="@IsLaunchDisabled(game)">
                                    <span class="launch-icon" aria-hidden="true"></span>
                                </button>
                                <button type="button"
                                        class="secondary-button action-icon-button"
                                        @onclick="() => OpenEditEditorAsync(game)"
                                        title="設定"
                                        aria-label="設定">
                                    <span class="settings-icon" aria-hidden="true"></span>
                                </button>
                                <button type="button"
                                        class="secondary-button pin-toggle-button @(game.IsPinned ? "pin-toggle-active" : string.Empty)"
                                        @onclick="() => TogglePinnedAsync(game)"
                                        title="@(game.IsPinned ? "ピン留めを解除" : "ピン留め")"
                                        aria-label="@(game.IsPinned ? "ピン留めを解除" : "ピン留め")"
                                        disabled="@IsPinToggleBusy(game)">
                                    <span class="pin-toggle-icon" aria-hidden="true"></span>
                                </button>
                                @if (CanResumeRepositorySync(game))
                                {
                                    <button type="button"
                                            class="secondary-button"
                                            @onclick="() => ResumeRepositorySyncAsync(game)"
                                            disabled="@IsRepositoryBusy(game)">
                                        再開
                                    </button>
                                }
                            </div>
                        </article>
                    }
                }
            }
        </div>
    </section>
}

<div class="notification-dock" aria-live="polite" aria-atomic="true">
    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <p class="notification-message @GetMessageClass()">@_message</p>
    }
</div>

@if (IsUserOperationLoading)
{
    <div class="operation-loading-overlay" aria-live="polite" aria-busy="true">
        <div class="operation-loading-modal">
            <div class="operation-loading-spinner" aria-hidden="true"></div>
            <p class="operation-loading-message">@GetUserOperationLoadingMessage()</p>
        </div>
    </div>
}

@if (_isHelpOpen)
{
    <div class="editor-overlay help-overlay" @onclick="CloseHelp">
        <section class="help-modal" @onclick:stopPropagation="true">
            <h2>Help / 使い方ガイド</h2>

            <div class="help-section">
                <h3>基本操作</h3>
                <ul>
                    <li>`+ 新規追加`: ゲームを登録します。</li>
                    <li>`▶`: 起動前に同期チェックしてからゲームを起動します。</li>
                    <li>`Gitステータス更新`: カード枠色の元になる Git 状態を再取得します。</li>
                    <li>`環境設定`: 同期設定・通知・ログ・カード表示設定を変更します。</li>
                </ul>
            </div>

            <div class="help-section">
                <h3>カードの見方</h3>
                <ul>
                    <li>カード枠色: リポジトリの Git 状態（clean/dirty/ahead など）</li>
                    <li>同期ステータス: `同期中 / 同期OK / エラー / 未同期`</li>
                    <li>同期履歴: 直近3件の結果・時刻・所要時間（必要に応じて command/reason）</li>
                </ul>
            </div>

            <div class="help-section">
                <h3>Git状態の意味</h3>
                <table class="help-git-table">
                    <thead>
                        <tr>
                            <th>状態</th>
                            <th>枠色</th>
                            <th>意味</th>
                            <th>推奨アクション</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>Clean</td>
                            <td><span class="help-git-swatch help-git-swatch-clean" aria-label="Cleanの枠色"></span></td>
                            <td>作業ツリーに変更なし</td>
                            <td>そのまま利用</td>
                        </tr>
                        <tr>
                            <td>Dirty</td>
                            <td><span class="help-git-swatch help-git-swatch-dirty" aria-label="Dirtyの枠色"></span></td>
                            <td>未コミット変更あり</td>
                            <td>差分を確認してコミット方針を決める</td>
                        </tr>
                        <tr>
                            <td>Ahead</td>
                            <td><span class="help-git-swatch help-git-swatch-ahead" aria-label="Aheadの枠色"></span></td>
                            <td>ローカルがリモートより先行</td>
                            <td>必要なら push</td>
                        </tr>
                        <tr>
                            <td>Behind</td>
                            <td><span class="help-git-swatch help-git-swatch-behind" aria-label="Behindの枠色"></span></td>
                            <td>リモートが先行</td>
                            <td>pull して追従</td>
                        </tr>
                        <tr>
                            <td>Diverged</td>
                            <td><span class="help-git-swatch help-git-swatch-diverged" aria-label="Divergedの枠色"></span></td>
                            <td>ローカルとリモートが分岐</td>
                            <td>履歴を確認して統合方針を決める</td>
                        </tr>
                        <tr>
                            <td>Error</td>
                            <td><span class="help-git-swatch help-git-swatch-error" aria-label="Errorの枠色"></span></td>
                            <td>状態判定でエラー</td>
                            <td>ログビューアで詳細確認</td>
                        </tr>
                        <tr>
                            <td>NotConfigured</td>
                            <td><span class="help-git-swatch help-git-swatch-not-configured" aria-label="NotConfiguredの枠色"></span></td>
                            <td>関連リポジトリ未設定</td>
                            <td>ゲーム編集で設定</td>
                        </tr>
                        <tr>
                            <td>Unknown</td>
                            <td><span class="help-git-swatch help-git-swatch-unknown" aria-label="Unknownの枠色"></span></td>
                            <td>判定前/判定不可</td>
                            <td>Gitステータス更新を実行</td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <div class="help-section">
                <h3>トラブル時の導線</h3>
                <ul>
                    <li>右下通知ドックで直近メッセージを確認</li>
                    <li>環境設定 → ログビューア でエラー詳細を確認</li>
                    <li>必要なら `最新エラーログを開く` / `ログフォルダを開く` を利用</li>
                </ul>
            </div>

            <div class="editor-actions">
                <button type="button"
                        class="secondary-button"
                        @onclick="CloseHelp">
                    閉じる
                </button>
            </div>
        </section>
    </div>
}

@if (_isSettingsOpen)
{
    <div class="editor-overlay settings-overlay" @onclick="() => CloseSettings()">
        <section class="settings-modal" @onclick:stopPropagation="true">
            <h2>環境設定</h2>

            <div class="settings-section">
                <label class="settings-toggle-row">
                    <span>Windows起動時に自動起動</span>
                    <input type="checkbox"
                           checked="@_autoStartEnabled"
                           @onchange="OnAutoStartChangedAsync"
                           disabled="@(_isSettingsLoading || _isAutoStartSaving)" />
                </label>
                @if (_isSettingsLoading)
                {
                    <p class="settings-note">設定を読み込み中...</p>
                }
            </div>

            <div class="settings-section settings-sync-section">
                <h3>同期・通知設定</h3>
                <div class="settings-sync-grid">
                    <label class="settings-value-row">
                        <span class="settings-value-label">変更検知デバウンス秒</span>
                        <input type="number"
                               min="1"
                               max="300"
                               @bind="_syncDebounceSeconds"
                               disabled="@(_isSettingsLoading || _isAppSettingsSaving)" />
                    </label>
                    <label class="settings-value-row">
                        <span class="settings-value-label">再試行 初期待機秒</span>
                        <input type="number"
                               min="1"
                               max="600"
                               @bind="_syncRetryInitialSeconds"
                               disabled="@(_isSettingsLoading || _isAppSettingsSaving)" />
                    </label>
                    <label class="settings-value-row">
                        <span class="settings-value-label">再試行 最大待機秒</span>
                        <input type="number"
                               min="1"
                               max="3600"
                               @bind="_syncRetryMaxSeconds"
                               disabled="@(_isSettingsLoading || _isAppSettingsSaving)" />
                    </label>
                    <label class="settings-value-row">
                        <span class="settings-value-label">通知抑制秒（0で無効）</span>
                        <input type="number"
                               min="0"
                               max="600"
                               @bind="_notificationSuppressSeconds"
                               disabled="@(_isSettingsLoading || _isAppSettingsSaving)" />
                    </label>
                    <label class="settings-value-row">
                        <span class="settings-value-label">ログ保持日数</span>
                        <input type="number"
                               min="1"
                               max="365"
                               @bind="_logRetentionDays"
                               disabled="@(_isSettingsLoading || _isAppSettingsSaving)" />
                    </label>
                    <label class="settings-value-row">
                        <span class="settings-value-label">ログ最大サイズMB</span>
                        <input type="number"
                               min="1"
                               max="1024"
                               @bind="_logMaxFileSizeMb"
                               disabled="@(_isSettingsLoading || _isAppSettingsSaving)" />
                    </label>
                </div>
            </div>

            <div class="settings-section">
                <h3>カード表示設定</h3>
                <label class="settings-toggle-row">
                    <span>タイトルを表示</span>
                    <input type="checkbox"
                           @bind="_showCardTitle"
                           disabled="@(_isSettingsLoading || _isAppSettingsSaving)" />
                </label>
                <label class="settings-toggle-row">
                    <span>同期ステータスを表示</span>
                    <input type="checkbox"
                           @bind="_showCardSyncStatus"
                           disabled="@(_isSettingsLoading || _isAppSettingsSaving)" />
                </label>
                <p class="settings-note">表示項目に応じてサムネイルカードの高さを自動調整します。</p>
                <div class="editor-actions">
                    <button type="button"
                            class="launch-button"
                            @onclick="SaveAppSettingsAsync"
                            disabled="@(_isSettingsLoading || _isAppSettingsSaving)">
                        @(_isAppSettingsSaving ? "保存中..." : "設定を保存")
                    </button>
                </div>
            </div>

            <div class="settings-section settings-actions-row">
                <button type="button"
                        class="secondary-button"
                        @onclick="OpenLatestErrorLogAsync"
                        disabled="@_isSettingsLoading">
                    最新エラーログを開く
                </button>
                <button type="button"
                        class="secondary-button"
                        @onclick="OpenLogDirectoryAsync"
                        disabled="@_isSettingsLoading">
                    ログフォルダを開く
                </button>
            </div>

            <div class="settings-section">
                <h3>通知センター</h3>
                <div class="editor-actions">
                    <button type="button"
                            class="launch-button"
                            @onclick="CopyNotificationHistoryAsync"
                            disabled="@(_isSettingsLoading || _notificationHistoryEntries.Count == 0)">
                        全件コピー
                    </button>
                    <button type="button"
                            class="secondary-button"
                            @onclick="ClearNotificationHistory"
                            disabled="@(_isSettingsLoading || _notificationHistoryEntries.Count == 0)">
                        履歴クリア
                    </button>
                </div>
                <div class="notification-center-filters">
                    <label>
                        <input type="checkbox"
                               @bind="_showSuccessNotifications"
                               disabled="@_isSettingsLoading" />
                        成功を表示
                    </label>
                    <label>
                        <input type="checkbox"
                               @bind="_showFailedNotifications"
                               disabled="@_isSettingsLoading" />
                        失敗を表示
                    </label>
                </div>
                <div class="notification-center-list" role="log">
                    @{
                        var filteredNotificationEntries = GetFilteredNotificationHistoryEntries();
                    }
                    @if (_notificationHistoryEntries.Count == 0)
                    {
                        <p class="notification-center-empty">通知履歴はありません。</p>
                    }
                    else if (filteredNotificationEntries.Count == 0)
                    {
                        <p class="notification-center-empty">フィルタ条件に一致する通知はありません。</p>
                    }
                    else
                    {
                        @foreach (var entry in filteredNotificationEntries)
                        {
                            <article class="notification-center-item">
                                <div class="notification-center-item-header">
                                    <span class="notification-center-time">@FormatNotificationHistoryTimestamp(entry.Timestamp)</span>
                                    <span class="notification-center-type @GetNotificationHistoryTypeClass(entry.IsSuccess)">
                                        @GetNotificationHistoryTypeLabel(entry.IsSuccess)
                                    </span>
                                </div>
                                <p class="notification-center-message">@entry.Message</p>
                            </article>
                        }
                    }
                </div>
            </div>

            <div class="settings-section">
                <h3>ログビューア</h3>
                <div class="settings-log-controls">
                    <label class="settings-log-control">
                        <span>表示件数</span>
                        <input type="number"
                               min="10"
                               max="500"
                               @bind="_logViewerLimit"
                               disabled="@(_isSettingsLoading || _isLogLoading)" />
                    </label>
                    <label class="settings-log-control">
                        <span>レベル</span>
                        <select @bind="_logViewerSeverityFilter"
                                disabled="@(_isSettingsLoading || _isLogLoading)">
                            <option value="all">すべて</option>
                            <option value="Critical">Critical</option>
                            <option value="Error">Error</option>
                            <option value="Warning">Warning</option>
                            <option value="Information">Information</option>
                            <option value="Debug">Debug</option>
                            <option value="Trace">Trace</option>
                        </select>
                    </label>
                </div>
                <label class="settings-log-keyword">
                    <span>キーワード</span>
                    <input type="text"
                           @bind="_logViewerKeyword"
                           @bind:event="oninput"
                           placeholder="メッセージ / TraceId / repo / command"
                           disabled="@(_isSettingsLoading || _isLogLoading)" />
                </label>
                <div class="editor-actions">
                    <button type="button"
                            class="launch-button"
                            @onclick="LoadLogEntriesAsync"
                            disabled="@(_isSettingsLoading || _isLogLoading)">
                        @(_isLogLoading ? "読み込み中..." : "更新")
                    </button>
                    <button type="button"
                            class="secondary-button"
                            @onclick="CopyLogEntriesAsync"
                            disabled="@(_isSettingsLoading || _isLogLoading || _logViewerEntries.Count == 0)">
                        コピー
                    </button>
                </div>
                @if (!string.IsNullOrWhiteSpace(_logViewerError))
                {
                    <p class="settings-log-error">@_logViewerError</p>
                }
                <div class="settings-log-list" role="log">
                    @if (_isLogLoading && _logViewerEntries.Count == 0)
                    {
                        <p class="settings-log-empty">ログを読み込み中です...</p>
                    }
                    else if (_logViewerEntries.Count == 0)
                    {
                        <p class="settings-log-empty">表示できるログがありません。</p>
                    }
                    else
                    {
                        @foreach (var entry in _logViewerEntries)
                        {
                            <article class="settings-log-item">
                                <div class="settings-log-item-header">
                                    <span class="settings-log-time">@FormatLogTimestamp(entry.Timestamp)</span>
                                    <span class="settings-log-level @GetLogLevelClass(entry.Severity)">
                                        @entry.Severity
                                    </span>
                                </div>
                                <p class="settings-log-message">@entry.Message</p>
                                <p class="settings-log-meta">
                                    <span class="settings-log-meta-item">name: @entry.Name</span>
                                    @if (!string.IsNullOrWhiteSpace(entry.TraceId))
                                    {
                                        <span class="settings-log-meta-item">traceId: @entry.TraceId</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(entry.RepositoryId))
                                    {
                                        <span class="settings-log-meta-item">repo: @entry.RepositoryId</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(entry.Command))
                                    {
                                        <span class="settings-log-meta-item">command: @entry.Command</span>
                                    }
                                    @if (entry.ExitCode.HasValue)
                                    {
                                        <span class="settings-log-meta-item">exitCode: @entry.ExitCode.Value</span>
                                    }
                                </p>
                                @if (!string.IsNullOrWhiteSpace(entry.Detail)
                                     || !string.IsNullOrWhiteSpace(entry.StandardOutput)
                                     || !string.IsNullOrWhiteSpace(entry.StandardError))
                                {
                                    <div class="settings-log-details">
                                        @if (!string.IsNullOrWhiteSpace(entry.Detail))
                                        {
                                            <details class="settings-log-detail-block">
                                                <summary>detail</summary>
