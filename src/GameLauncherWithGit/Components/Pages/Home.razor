                <button type="button" class="secondary-button" @onclick="RequestCloseEditor" disabled="@_isSaving" data-dialog-dismiss>キャンセル</button>
                @if (_isEditMode && !string.IsNullOrWhiteSpace(_editingGameId))
                {
                    <button type="button"
                            class="danger-button home-delete-action home-labeled-action"
                            @onclick="OpenDeleteConfirmForEditingGame"
                            disabled="@(_isSaving || _isDeleting)">
                        <CaptureIcon Name="Trash" /> 登録を削除
                    </button>
                }
            </div>
        </section>
    </div>
}

@code {
    private const int SyncHistoryTimelineLimit = 3;
    private const int SyncHistoryRefreshIntervalSeconds = 5;
