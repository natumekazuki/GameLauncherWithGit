    private IReadOnlyList<NotificationHistoryEntry> GetFilteredNotificationHistoryEntries()
    {
        return _notificationHistoryEntries
            .Where(entry => entry.IsSuccess is null
                || (entry.IsSuccess == true && _showSuccessNotifications)
                || (entry.IsSuccess == false && _showFailedNotifications))
            .ToArray();
    }

    private NotificationHistoryEntry SetNotification(string message, bool? isSuccess, bool addToHistory = true, string? summary = null,
        string? launchGameId = null, string? targetId = null, string? repositoryPath = null, bool retainWarning = false,
        NotificationHistoryEntry? replaceHistory = null, [CallerMemberName] string operation = "")
    {
        var entry = new NotificationHistoryEntry(DateTimeOffset.Now, isSuccess,
            summary ?? (isSuccess == false ? "操作エラー" : "操作結果"), message.Trim());
        var resultKey = (operation, launchGameId ?? targetId, repositoryPath?.ToUpperInvariant());
        var needsAttention = isSuccess == false || retainWarning;
        if (needsAttention || _notificationFailure is null || _notificationFailure == resultKey)
        {
            _notification = isSuccess == true ? null : entry;
            _notificationFailure = needsAttention ? resultKey : null;
        }
        _announcedOperation = null;
        _operationAnnouncement = isSuccess == true ? null : entry.Summary;

        if (addToHistory && !string.IsNullOrWhiteSpace(message))
        {
            if (replaceHistory is not null)
            {
                _notificationHistoryEntries.Remove(replaceHistory);
            }
            _notificationHistoryEntries.Insert(0, entry);
            if (_notificationHistoryEntries.Count > NotificationHistoryMaxEntries)
            {
                _notificationHistoryEntries.RemoveAt(_notificationHistoryEntries.Count - 1);
            }
        }

        if (isSuccess == false)
        {
            _ = WriteErrorLogSafeAsync(message);
        }
        return entry;
    }

    private void DismissNotification()
    {
        if (_notificationFailure is null) _notification = null;
    }

    private void ClearRecoveredNotification(string operation, string? targetId = null)
    {
        if (_notificationFailure is { } failure
            && failure.Operation == operation && failure.Target == targetId && failure.Repository is null)
        {
            if (_operationAnnouncement == _notification?.Summary)
            {
                _operationAnnouncement = _announcedOperation?.Message;
            }
            _notification = null;
            _notificationFailure = null;
        }
    }

