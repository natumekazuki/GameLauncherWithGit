                                            <details class="settings-log-detail-block">
                                                <summary>stdout</summary>
                                                <pre class="settings-log-detail">@entry.StandardOutput</pre>
                                            </details>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(entry.StandardError))
                                        {
                                            <details class="settings-log-detail-block">
                                                <summary>stderr</summary>
                                                <pre class="settings-log-detail">@entry.StandardError</pre>
