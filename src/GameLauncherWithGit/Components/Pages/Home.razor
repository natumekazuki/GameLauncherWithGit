        };
    }

    private IReadOnlyList<NotificationHistoryEntry> GetFilteredNotificationHistoryEntries()
    {
        if (_showSuccessNotifications && _showFailedNotifications)
        {
            return _notificationHistoryEntries;
        }

        if (_showSuccessNotifications)
        {
            return _notificationHistoryEntries
                .Where(static entry => entry.IsSuccess == true)
                .ToArray();
        }

        if (_showFailedNotifications)
        {
            return _notificationHistoryEntries
                .Where(static entry => entry.IsSuccess == false)
                .ToArray();
        }

        return _notificationHistoryEntries;
    }

    private void SetNotification(string message, bool? isSuccess, bool addToHistory = true)
    {
        _message = message;
        _isLastActionSuccess = isSuccess;

        if (addToHistory)
        {
            AddNotificationHistory(message, isSuccess);
        }

        if (isSuccess == false)
        {
            _ = WriteErrorLogSafeAsync(message);
        }
    }

    private void AddNotificationHistory(string message, bool? isSuccess)
    {
        if (string.IsNullOrWhiteSpace(message))
        {
            return;
        }

        _notificationHistoryEntries.Insert(0, new NotificationHistoryEntry(DateTimeOffset.Now, isSuccess, message.Trim()));
        if (_notificationHistoryEntries.Count <= NotificationHistoryMaxEntries)
        {
            return;
        }

        _notificationHistoryEntries.RemoveRange(
            NotificationHistoryMaxEntries,
            _notificationHistoryEntries.Count - NotificationHistoryMaxEntries);
    }

    private async Task WriteErrorLogSafeAsync(string message)
    {
        if (string.IsNullOrWhiteSpace(message))
        {
            return;
        }

        try
        {
            await LogAccessService.AppendErrorAsync(message);
        }
        catch
        {
            // エラーログ書き込み失敗は通知ループを防ぐため握りつぶす。
        }
    }

    private static bool ParseCheckboxValue(ChangeEventArgs args)
    {
        if (args.Value is bool boolValue)
        {
            return boolValue;
        }

        var value = args.Value?.ToString();
        return string.Equals(value, "true", StringComparison.OrdinalIgnoreCase)
            || string.Equals(value, "on", StringComparison.OrdinalIgnoreCase);
    }

    private static string BuildGitStartupError(GitCommandResult result)
    {
        var reason = FirstNonEmptyLine(result.StandardError)
            ?? FirstNonEmptyLine(result.StandardOutput)
            ?? $"exit code: {result.ExitCode}";
        return $"Git の起動確認に失敗しました。reason={reason}";
    }

    private static string? FirstNonEmptyLine(string value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return null;
        }

        return value
            .Split(['\r', '\n'], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .FirstOrDefault(static line => !string.IsNullOrWhiteSpace(line));
    }

