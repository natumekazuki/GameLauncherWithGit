    private void StartStateRefreshLoop()
    {
        if (_stateRefreshTask is not null)
        {
            return;
        }

        _stateRefreshTask = Task.Run(async () =>
        {
            var syncHistoryElapsedSeconds = 0;
            var gitStatusElapsedSeconds = 0;
            while (!_stateRefreshCts.IsCancellationRequested)
            {
                try
                {
                    await Task.Delay(TimeSpan.FromSeconds(1), _stateRefreshCts.Token);
                    syncHistoryElapsedSeconds++;
                    gitStatusElapsedSeconds++;

                    if (syncHistoryElapsedSeconds >= SyncHistoryRefreshIntervalSeconds)
                    {
                        syncHistoryElapsedSeconds = 0;
                        await InvokeAsync(async () => await RefreshRepositorySyncHistoriesAsync(_stateRefreshCts.Token));
                    }

                    var gitStatusRefreshIntervalSeconds = Math.Max(1, _syncDebounceSeconds);
                    if (gitStatusElapsedSeconds >= gitStatusRefreshIntervalSeconds)
                    {
                        gitStatusElapsedSeconds = 0;
                        await InvokeAsync(async () => await RefreshGitStatusesAsync(_stateRefreshCts.Token));
                    }

                    await InvokeAsync(StateHasChanged);
                }
                catch (OperationCanceledException)
                {
                    break;
                }
                catch (ObjectDisposedException)
                {
                    break;
                }
            }
        });
    }

    private async Task RefreshRepositorySyncHistoriesAsync(CancellationToken cancellationToken = default)
    {
        _syncHistoryByRepository.Clear();

        if (_games is null || _games.Count == 0)
        {
            return;
        }

        var repositoryIds = _games
            .Select(game => NormalizeRepositoryKey(game.RelatedRepositoryPath))
            .Where(static repositoryId => !string.IsNullOrWhiteSpace(repositoryId))
            .Select(static repositoryId => repositoryId!)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToArray();
        if (repositoryIds.Length == 0)
        {
            return;
        }

        try
        {
            var histories = await RepositorySyncHistoryStore.GetLatestByRepositoryIdsAsync(
                repositoryIds,
                SyncHistoryTimelineLimit,
                cancellationToken);
            foreach (var pair in histories)
            {
                _syncHistoryByRepository[pair.Key] = pair.Value;
            }
        }
        catch (OperationCanceledException)
        {
            throw;
        }
        catch
        {
            // 履歴取得失敗時はカード描画を継続する。
        }
    }

