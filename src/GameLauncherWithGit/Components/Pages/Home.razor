    private bool IsBranchSelectionDisabled()
    {
        return GetBranchRepositoryPath() is null
            || IsBranchWriting
            || _isBranchLoading
            || _branches.Count == 0;
    }

    private bool IsBranchReloadDisabled()
    {
        return GetBranchRepositoryPath() is null
            || IsBranchWriting
            || _isBranchLoading;
    }

    private bool IsBranchSwitchDisabled()
    {
        if (IsBranchSelectionDisabled())
        {
            return true;
        }

        var selectedBranch = NormalizeBranchName(_branchSelection);
        if (string.IsNullOrWhiteSpace(selectedBranch))
        {
            return true;
        }

        if (_localBranches.Contains(selectedBranch))
        {
            return string.Equals(selectedBranch, _branchCurrent, StringComparison.OrdinalIgnoreCase);
        }

        if (_remoteBranches.Contains(selectedBranch))
        {
            if (!_remoteBranchLocalNames.TryGetValue(selectedBranch, out var localBranchName)
                || string.IsNullOrWhiteSpace(localBranchName))
            {
                return true;
            }

            return string.Equals(localBranchName, _branchCurrent, StringComparison.OrdinalIgnoreCase);
        }

        return true;
    }

    private bool IsBranchCreateInputDisabled()
    {
        return IsBranchReloadDisabled();
    }

    private bool IsBranchCreateDisabled()
    {
        return IsBranchCreateInputDisabled()
            || string.IsNullOrWhiteSpace(NormalizeBranchName(_branchNewName));
    }

