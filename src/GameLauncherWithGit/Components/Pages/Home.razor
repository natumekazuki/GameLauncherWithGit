    private async Task RefreshSaveLinksAsync()
    {
        _saveLinkLoadFailedGameIds.Clear();

        if (_games is null || _games.Count == 0)
        {
            _saveLinksByGame.Clear();
            return;
        }

        var activeGameIds = _games
            .Select(static game => game.Id)
            .ToHashSet(StringComparer.OrdinalIgnoreCase);
        var staleGameIds = _saveLinksByGame.Keys
            .Where(gameId => !activeGameIds.Contains(gameId))
            .ToArray();
        foreach (var staleGameId in staleGameIds)
        {
            _saveLinksByGame.Remove(staleGameId);
        }

        foreach (var game in _games)
        {
            try
            {
                var saveLinks = await SaveLinkService.GetByGameIdAsync(game.Id);
                _saveLinksByGame[game.Id] = saveLinks;
            }
            catch
            {
                _saveLinkLoadFailedGameIds.Add(game.Id);
            }
        }
    }

