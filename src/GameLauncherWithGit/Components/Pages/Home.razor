    private void OpenCreateEditor()
    {
        _isEditMode = false;
        _editingGameId = null;
        _editorTitle = string.Empty;
        _editorExecutablePath = string.Empty;
        _editorRepositoryPath = null;
        _editorThumbnailSourcePath = null;
        _editorHasThumbnail = false;
        _editorClearThumbnail = false;
        _isEditorOpen = true;
    }

    private void OpenEditEditor(GameCardItem game)
    {
        _isEditMode = true;
        _editingGameId = game.Id;
        _editorTitle = game.Title;
        _editorExecutablePath = game.ExecutablePath;
        _editorRepositoryPath = game.RelatedRepositoryPath;
        _editorThumbnailSourcePath = null;
        _editorHasThumbnail = HasThumbnail(game);
        _editorClearThumbnail = false;
        _isEditorOpen = true;
    }

    private void CloseEditor(bool force = false)
    {
        if (_isSaving && !force)
        {
            return;
        }

        _isEditorOpen = false;
    }

    private async Task SaveEditorAsync()
    {
        var shouldCloseEditor = false;

        if (string.IsNullOrWhiteSpace(_editorTitle))
        {
            SetNotification("タイトルは必須です。", false);
            return;
        }

        if (string.IsNullOrWhiteSpace(_editorExecutablePath))
        {
            SetNotification("実行ファイルパスは必須です。", false);
            return;
        }

        var input = new GameEditInput(
            Title: _editorTitle,
            ExecutablePath: _editorExecutablePath,
            RelatedRepositoryPath: _editorRepositoryPath,
            ThumbnailSourcePath: _editorThumbnailSourcePath,
            ClearThumbnail: _editorClearThumbnail);

        _isSaving = true;
        try
        {
            if (_isEditMode)
            {
                if (string.IsNullOrWhiteSpace(_editingGameId))
                {
                    SetNotification("編集対象が不正です。", false);
                    return;
                }

                var updated = await GameLibraryService.UpdateAsync(_editingGameId, input);
                if (updated is null)
                {
                    SetNotification("編集対象のゲームが見つかりません。", false);
                    return;
                }

                SetNotification($"ゲーム設定を更新しました: {updated.Title}", true);
            }
            else
            {
                var created = await GameLibraryService.CreateAsync(input);
                SetNotification($"ゲームを登録しました: {created.Title}", true);
            }

            await ReloadGamesAsync();
            await RefreshRepositoryWatchersAsync();
            shouldCloseEditor = true;
        }
        catch (Exception ex)
        {
            SetNotification($"保存に失敗しました: {ex.Message}", false);
        }
        finally
        {
            _isSaving = false;
            if (shouldCloseEditor)
            {
                CloseEditor(force: true);
            }
        }
    }

