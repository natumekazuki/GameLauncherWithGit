            : capture.Recording ? "記録中"
            : capture.Paused ? "一時停止"
            : "記録していません";

    private GameCardItem? GetSelectedGame() => _selectedGameId is null
        ? null
        : _games?.FirstOrDefault(game => game.Id == _selectedGameId);

    private void CloseGameDetails()
    {
        if (_libraryLoadError is not null)
        {
            _focusLibraryRegion = true;
        }
        else if (_selectedFromProblem && GetSelectedGame() is { } game
            && GetCardProblem(game, HasThumbnail(game) && GetThumbnailSource(game) is not { DecodeFailed: false }) is null)
        {
            _focusCardId = game.Id;
        }
        _selectedGameId = null;
    }

    private string? GetCardProblem(GameCardItem game, bool imageFailed)
    {
        var gitFailed = GetGitVisualState(game) == GitRepositoryVisualState.Error;
        var requiresReview = !CanResumeRepositorySync(game) && GetEffectiveStatus(game) == GameCardStatus.Error;
        var linksFailed = _saveLinkLoadFailedGameIds.Contains(game.Id);
        var count = (imageFailed ? 1 : 0) + (gitFailed ? 1 : 0) + (requiresReview ? 1 : 0) + (linksFailed ? 1 : 0);
        return count > 1 ? "要確認"
            : imageFailed ? "画像エラー"
            : gitFailed ? "Gitエラー"
            : requiresReview ? "要確認"
            : linksFailed ? "リンクエラー"
            : null;
    }

    private async Task WriteErrorLogSafeAsync(string message)
    {
        if (string.IsNullOrWhiteSpace(message))
        {
            return;
        }

        try
        {
            await LogAccessService.AppendErrorAsync(message);
        }
        catch
        {
            // エラーログ書き込み失敗は通知ループを防ぐため握りつぶす。
        }
    }

