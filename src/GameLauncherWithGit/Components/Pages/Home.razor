    private ThumbnailSource? GetThumbnailSource(GameCardItem game)
    {
        var path = NormalizeThumbnailPath(game.ThumbnailPath);
        if (path is null)
        {
            return null;
        }

        if (_thumbnailCache.TryGetValue(path, out var cached))
        {
            return cached;
        }

        try
        {
            if (!File.Exists(path))
            {
                return null;
            }

            var bytes = File.ReadAllBytes(path);
            if (bytes.Length == 0)
            {
                return null;
            }

            var source = new ThumbnailSource($"data:image/png;base64,{Convert.ToBase64String(bytes)}");
            _thumbnailCache[path] = source;
            return source;
        }
        catch
        {
            return null;
        }
    }

    private void MarkThumbnailDecodeFailed(string gameId, ThumbnailSource source)
    {
        var game = _games?.FirstOrDefault(game => game.Id == gameId);
        var path = NormalizeThumbnailPath(game?.ThumbnailPath);
        if (path is not null && _thumbnailCache.TryGetValue(path, out var current) && ReferenceEquals(current, source))
        {
            source.DecodeFailed = true;
        }
    }

    private sealed class ThumbnailSource(string dataUri)
    {
        public string DataUri { get; } = dataUri;
        public bool DecodeFailed { get; set; }
    }

    private void SyncThumbnailCache()
    {
        if (_games is null)
        {
            _thumbnailCache.Clear();
            return;
        }

        var activePaths = _games
            .Select(game => NormalizeThumbnailPath(game.ThumbnailPath))
            .Where(static path => !string.IsNullOrWhiteSpace(path))
            .Select(static path => path!)
            .ToHashSet(StringComparer.OrdinalIgnoreCase);

        var stalePaths = _thumbnailCache.Keys
            .Where(path => !activePaths.Contains(path))
            .ToArray();

        foreach (var stalePath in stalePaths)
        {
            _thumbnailCache.Remove(stalePath);
        }
    }

    private static string? NormalizeThumbnailPath(string? path)
    {
        if (string.IsNullOrWhiteSpace(path))
        {
            return null;
        }

        try
        {
            return Path.GetFullPath(path.Trim());
        }
        catch
        {
            return null;
        }
    }

    private async Task ResumeRepositorySyncAsync(GameCardItem game)
    {
        var repositoryKey = NormalizeRepositoryKey(game.RelatedRepositoryPath);
        if (repositoryKey is null)
        {
            SetNotification("関連リポジトリのパスが無効です。", false);
            return;
        }

        await RunWithUserOperationLoadingAsync(
            "同期を再開しています...",
            async () =>
            {
                try
                {
                    await SyncOrchestrator.ResumeRepositorySyncAsync(repositoryKey);
                    SetNotification($"同期再開を受け付けました: {game.Title}", null);
                }
                catch (Exception ex)
                {
                    SetNotification($"同期再開に失敗しました: {ex.Message}", false);
                }
            });
    }

