    private async Task RunWithUserOperationLoadingAsync(string message, Func<Task> action)
    {
        var operation = new UserOperation(message);
        _userOperations.Add(operation);
        _announcedOperation = operation;
        _operationAnnouncement = message;
        RenderUserOperation();
        try
        {
            await action();
        }
        finally
        {
            _userOperations.Remove(operation);
            if (ReferenceEquals(_announcedOperation, operation))
            {
                _announcedOperation = _userOperations.LastOrDefault();
                _operationAnnouncement = _announcedOperation?.Message;
            }
            RenderUserOperation();
        }
    }

    private void RenderUserOperation()
    {
        if (!_stateRefreshCts.IsCancellationRequested)
        {
            StateHasChanged();
        }
    }

    private bool IsUserOperationLoading => _userOperations.Count > 0;
    private bool HasFeedback => IsUserOperationLoading || _notification is not null;

