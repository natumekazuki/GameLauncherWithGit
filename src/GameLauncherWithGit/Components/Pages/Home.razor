    private async Task InitializeLibraryAsync()
    {
        _isStartupChecking = true;
        _isGitReady = true;
        _startupError = null;

        try
        {
            try
            {
                var gitCheckResult = await GitService.CheckAvailabilityAsync();
                _startupError = gitCheckResult.IsSuccess ? null : BuildGitStartupError(gitCheckResult);
            }
            catch (Exception ex)
            {
                _startupError = ex.Message;
            }

            if (_startupError is not null)
            {
                _isGitReady = false;
                UnregisterAllWatchers();
                return;
            }

            ApplyAppSettings(AppSettingsService.Get());
            await RunStartupLogMaintenanceAsync();
            _ = SyncOrchestrator;
            if (await ReloadGamesAsync())
            {
                RefreshRepositoryWatchers();
            }
            StartStateRefreshLoop();
        }
        finally
        {
            _isStartupChecking = false;
        }
    }

    private async Task RetryStartupAsync()
    {
        if (_isStartupChecking) return;
        await InitializeLibraryAsync();
        _focusLibraryRegion = true;
    }

    private async Task LaunchAsync(GameCardItem game)
    {
        if (_isLaunching || IsLaunchDisabled(game)) return;
        _isLaunching = true;
        try
        {
            await RunWithUserOperationLoadingAsync(
                "起動前同期を実行しています...",
                async () =>
                {
                    var result = await LauncherService.LaunchAsync(game.Id);
                    if (result.ShowCapture)
                    {
                        Navigation.NavigateTo(GetScenarioUrl(game.Id), new NavigationOptions
                        {
                            HistoryEntryState = result.HasWarnings ? result.Message : null
                        });
                        return;
                    }

                    var message = $"「{game.Title}」: {result.Message}";
                    var launchEntry = !result.IsSuccess
                        ? SetNotification(message, false, summary: "起動エラー", launchGameId: game.Id)
                        : result.HasWarnings
                            ? SetNotification(message, null, summary: "起動済み・警告", launchGameId: game.Id, retainWarning: true)
                            : SetNotification(result.Message, true, summary: "起動済み", launchGameId: game.Id);
                    StateHasChanged();
                    try
                    {
                        if (await ReloadGamesAsync())
                        {
                            return;
                        }
                    }
                    catch (Exception ex)
                    {
                        _libraryLoadError = ex.Message;
                    }

                    SetNotification($"{message} 一覧の再読込に失敗しました。", false,
                        summary: result.IsSuccess ? "起動済み・一覧エラー" : "起動・一覧エラー",
                        launchGameId: game.Id, replaceHistory: launchEntry);
                });
        }
        finally
        {
            _isLaunching = false;
        }
    }

