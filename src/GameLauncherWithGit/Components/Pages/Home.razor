    private async Task SwitchEditorBranchAsync()
    {
        var repositoryPath = NormalizeRepositoryPath(_editorRepositoryPath);
        if (repositoryPath is null)
        {
            SetNotification("関連リポジトリが未設定または不正です。", false);
            return;
        }

        var selectedBranch = NormalizeBranchName(_editorSelectedBranch);
        if (string.IsNullOrWhiteSpace(selectedBranch))
        {
            SetNotification("切り替え先ブランチを選択してください。", false);
            return;
        }

        string switchCommand;
        string switchTargetLabel;
        var switchedFromRemote = false;
        if (_editorLocalBranches.Contains(selectedBranch))
        {
            if (string.Equals(selectedBranch, _editorCurrentBranch, StringComparison.OrdinalIgnoreCase))
            {
                SetNotification($"既に選択ブランチです: {selectedBranch}", true);
                return;
            }

            switchCommand = $"checkout {EscapeGitArgument(selectedBranch)}";
            switchTargetLabel = selectedBranch;
        }
        else if (_editorRemoteBranches.Contains(selectedBranch))
        {
            if (!_editorRemoteBranchLocalNames.TryGetValue(selectedBranch, out var localBranchName)
                || string.IsNullOrWhiteSpace(localBranchName))
            {
                SetNotification($"リモートブランチ名の形式が不正です: {selectedBranch}", false);
                return;
            }

            if (string.Equals(localBranchName, _editorCurrentBranch, StringComparison.OrdinalIgnoreCase))
            {
                SetNotification($"既に選択ブランチです: {localBranchName}", true);
                return;
            }

            switchCommand =
                $"checkout -b {EscapeGitArgument(localBranchName)} --track {EscapeGitArgument(selectedBranch)}";
            switchTargetLabel = $"{localBranchName} <- {selectedBranch}";
            switchedFromRemote = true;
        }
        else
        {
            SetNotification($"切り替え対象ブランチが見つかりません: {selectedBranch}", false);
            return;
        }

        await RunWithUserOperationLoadingAsync(
            "ブランチを切り替えています...",
            async () =>
            {
                _isBranchSwitching = true;
                try
                {
                    var result = await GitService.RunAsync(
                        repositoryPath,
                        switchCommand);
                    if (!result.IsSuccess)
                    {
                        SetNotification(
                            $"ブランチ切り替えに失敗しました: {BuildGitFailureReason(result)}",
                            false);
                        return;
                    }

                    await LoadEditorBranchesAsync(showNotificationOnFailure: false, preserveSelection: false);
                    var currentBranchResult = await GitService.RunAsync(repositoryPath, "branch --show-current");
                    if (currentBranchResult.IsSuccess)
                    {
                        var actualBranch = NormalizeBranchName(FirstNonEmptyLine(currentBranchResult.StandardOutput));
                        if (!string.IsNullOrWhiteSpace(actualBranch))
                        {
                            _editorCurrentBranch = actualBranch;
                            _editorSelectedBranch = actualBranch;
                        }
                    }

                    await RefreshGitStatusesAsync();
                    SetNotification(
                        switchedFromRemote
                            ? $"リモート追跡ブランチを作成して切り替えました: {switchTargetLabel}"
                            : $"ブランチを切り替えました: {switchTargetLabel}",
                        true);
                }
                catch (Exception ex)
                {
                    SetNotification($"ブランチ切り替えに失敗しました: {ex.Message}", false);
                }
                finally
                {
                    _isBranchSwitching = false;
                }
            });
    }

    private async Task CreateEditorBranchAsync()
    {
        var repositoryPath = NormalizeRepositoryPath(_editorRepositoryPath);
        if (repositoryPath is null)
        {
            SetNotification("関連リポジトリが未設定または不正です。", false);
            return;
        }

        var newBranchName = NormalizeBranchName(_editorNewBranchName);
        if (string.IsNullOrWhiteSpace(newBranchName))
        {
            SetNotification("新規ブランチ名を入力してください。", false);
            return;
        }

        if (_editorLocalBranches.Contains(newBranchName))
        {
            SetNotification($"既に存在するブランチ名です: {newBranchName}", false);
            return;
        }

        await RunWithUserOperationLoadingAsync(
            "新規ブランチを作成しています...",
            async () =>
            {
                _isBranchCreating = true;
                try
                {
                    var validateResult = await GitService.RunAsync(
                        repositoryPath,
                        $"check-ref-format --branch {EscapeGitArgument(newBranchName)}");
                    if (!validateResult.IsSuccess)
                    {
                        SetNotification(
                            $"ブランチ名が不正です: {BuildGitFailureReason(validateResult)}",
                            false);
                        return;
                    }

                    var createResult = await GitService.RunAsync(
                        repositoryPath,
                        $"checkout -b {EscapeGitArgument(newBranchName)}");
                    if (!createResult.IsSuccess)
                    {
                        SetNotification(
                            $"ブランチ作成に失敗しました: {BuildGitFailureReason(createResult)}",
                            false);
                        return;
                    }

                    _editorNewBranchName = string.Empty;
                    await LoadEditorBranchesAsync(showNotificationOnFailure: false, preserveSelection: false);
                    await RefreshGitStatusesAsync();
                    SetNotification($"ブランチを作成して切り替えました: {newBranchName}", true);
                }
                catch (Exception ex)
                {
                    SetNotification($"ブランチ作成に失敗しました: {ex.Message}", false);
                }
                finally
                {
                    _isBranchCreating = false;
                }
            });
    }

    private async Task<bool> LoadEditorBranchesAsync(bool showNotificationOnFailure, bool preserveSelection)
    {
        var repositoryPath = NormalizeRepositoryPath(_editorRepositoryPath);
        if (repositoryPath is null)
        {
            ResetEditorBranchState(clearNewBranchName: false);
            return false;
        }

        _isBranchLoading = true;
        try
        {
            var gitCheck = await GitService.RunAsync(repositoryPath, "rev-parse --is-inside-work-tree");
            if (!gitCheck.IsSuccess)
            {
                if (showNotificationOnFailure)
                {
                    SetNotification(
                        $"ブランチ一覧取得に失敗しました: {BuildGitFailureReason(gitCheck)}",
                        false);
                }

                ResetEditorBranchState(clearNewBranchName: false);
                return false;
            }

            var fetchResult = await GitService.RunAsync(repositoryPath, "fetch --all --prune");
            if (!fetchResult.IsSuccess && showNotificationOnFailure)
            {
                SetNotification(
                    $"リモートブランチ取得前の更新に失敗しました: {BuildGitFailureReason(fetchResult)}",
                    false);
            }

            var currentBranchResult = await GitService.RunAsync(repositoryPath, "branch --show-current");
            if (!currentBranchResult.IsSuccess)
            {
                if (showNotificationOnFailure)
                {
                    SetNotification(
                        $"現在ブランチ取得に失敗しました: {BuildGitFailureReason(currentBranchResult)}",
                        false);
                }

                ResetEditorBranchState(clearNewBranchName: false);
                return false;
            }

            var localBranchesResult = await GitService.RunAsync(
                repositoryPath,
                "for-each-ref --format=\"%(refname:short)\" refs/heads");
            if (!localBranchesResult.IsSuccess)
            {
                if (showNotificationOnFailure)
                {
                    SetNotification(
                        $"ブランチ一覧取得に失敗しました: {BuildGitFailureReason(localBranchesResult)}",
                        false);
                }

                ResetEditorBranchState(clearNewBranchName: false);
                return false;
            }

            var remoteBranchesResult = await GitService.RunAsync(
                repositoryPath,
                "for-each-ref --format=\"%(refname:short)\" refs/remotes");
            if (!remoteBranchesResult.IsSuccess)
            {
                if (showNotificationOnFailure)
                {
                    SetNotification(
                        $"リモートブランチ一覧取得に失敗しました: {BuildGitFailureReason(remoteBranchesResult)}",
                        false);
                }

                ResetEditorBranchState(clearNewBranchName: false);
                return false;
            }

            var remoteNamesResult = await GitService.RunAsync(repositoryPath, "remote");
            if (!remoteNamesResult.IsSuccess)
            {
                if (showNotificationOnFailure)
                {
                    SetNotification(
                        $"リモート名一覧取得に失敗しました: {BuildGitFailureReason(remoteNamesResult)}",
                        false);
                }

                ResetEditorBranchState(clearNewBranchName: false);
                return false;
            }

            if (!string.Equals(repositoryPath, NormalizeRepositoryPath(_editorRepositoryPath), StringComparison.OrdinalIgnoreCase))
            {
                return false;
            }

            var currentBranch = NormalizeBranchName(FirstNonEmptyLine(currentBranchResult.StandardOutput));
            var previousSelectedBranch = NormalizeBranchName(_editorSelectedBranch);
            var localBranchNames = localBranchesResult.StandardOutput
                .Split(['\r', '\n'], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                .Where(static name => !string.IsNullOrWhiteSpace(name))
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .OrderBy(static name => name, StringComparer.OrdinalIgnoreCase)
                .ToList();
            var branchNames = localBranchNames.ToList();
            if (!string.IsNullOrWhiteSpace(currentBranch)
                && branchNames.All(name => !string.Equals(name, currentBranch, StringComparison.OrdinalIgnoreCase)))
            {
                branchNames.Insert(0, currentBranch);
            }
            else if (!string.IsNullOrWhiteSpace(currentBranch))
            {
                branchNames = branchNames
                    .OrderBy(name => string.Equals(name, currentBranch, StringComparison.OrdinalIgnoreCase) ? 0 : 1)
                    .ThenBy(static name => name, StringComparer.OrdinalIgnoreCase)
                    .ToList();
            }

            var remoteBranchNames = remoteBranchesResult.StandardOutput
                .Split(['\r', '\n'], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                .Where(static name => !string.IsNullOrWhiteSpace(name))
                .Where(static name => !name.EndsWith("/HEAD", StringComparison.OrdinalIgnoreCase))
                .Where(static name => !name.Contains("->", StringComparison.Ordinal))
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .OrderBy(static name => name, StringComparer.OrdinalIgnoreCase)
                .ToList();
            var remoteNames = remoteNamesResult.StandardOutput
                .Split(['\r', '\n'], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                .Where(static name => !string.IsNullOrWhiteSpace(name))
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .OrderByDescending(static name => name.Length)
                .ThenBy(static name => name, StringComparer.OrdinalIgnoreCase)
                .ToList();
            var remoteBranchLocalNames = remoteBranchNames
                .Select(remoteBranch => new
                {
                    RemoteBranch = remoteBranch,
                    LocalBranch = ExtractLocalBranchNameFromRemote(remoteBranch, remoteNames)
                })
                .Where(static x => !string.IsNullOrWhiteSpace(x.LocalBranch))
                .ToDictionary(
                    static x => x.RemoteBranch,
                    static x => x.LocalBranch!,
                    StringComparer.OrdinalIgnoreCase);
            var remoteOnlyBranchNames = remoteBranchNames
                .Where(remoteBranch =>
                {
                    return remoteBranchLocalNames.TryGetValue(remoteBranch, out var localBranchName)
                        && localBranchNames.All(local => !string.Equals(local, localBranchName, StringComparison.OrdinalIgnoreCase));
                })
                .ToList();

            _editorBranches.Clear();
            _editorBranches.AddRange(branchNames);
            _editorBranches.AddRange(remoteOnlyBranchNames);
            _editorLocalBranches.Clear();
            foreach (var branchName in localBranchNames)
            {
                _editorLocalBranches.Add(branchName);
            }

            if (!string.IsNullOrWhiteSpace(currentBranch))
            {
                _editorLocalBranches.Add(currentBranch);
            }

            _editorRemoteBranches.Clear();
            _editorRemoteBranchLocalNames.Clear();
            foreach (var remoteBranchName in remoteOnlyBranchNames)
            {
                _editorRemoteBranches.Add(remoteBranchName);
                _editorRemoteBranchLocalNames[remoteBranchName] = remoteBranchLocalNames[remoteBranchName];
            }

            _editorCurrentBranch = currentBranch;

            if (preserveSelection
                && !string.IsNullOrWhiteSpace(previousSelectedBranch)
                && _editorBranches.Any(name => string.Equals(name, previousSelectedBranch, StringComparison.OrdinalIgnoreCase)))
            {
                _editorSelectedBranch = previousSelectedBranch;
            }
            else if (!string.IsNullOrWhiteSpace(currentBranch))
            {
                _editorSelectedBranch = currentBranch;
            }
            else
            {
                _editorSelectedBranch = _editorBranches.FirstOrDefault();
            }

            return true;
        }
        catch (Exception ex)
        {
            if (showNotificationOnFailure)
            {
                SetNotification($"ブランチ一覧取得に失敗しました: {ex.Message}", false);
            }

            ResetEditorBranchState(clearNewBranchName: false);
            return false;
        }
        finally
        {
            _isBranchLoading = false;
        }
    }

    private static string? NormalizeBranchName(string? branchName)
    {
        return string.IsNullOrWhiteSpace(branchName)
            ? null
            : branchName.Trim();
    }

    private string GetEditorBranchOptionLabel(string branchName)
    {
        return _editorRemoteBranches.Contains(branchName)
            ? $"{branchName} (remote)"
            : branchName;
    }

    private static string? ExtractLocalBranchNameFromRemote(string remoteBranchName, IReadOnlyList<string> remoteNames)
    {
        var normalized = NormalizeBranchName(remoteBranchName);
        if (string.IsNullOrWhiteSpace(normalized)
            || remoteNames is null
            || remoteNames.Count == 0)
        {
            return null;
        }

        foreach (var remoteName in remoteNames)
        {
            var normalizedRemoteName = NormalizeBranchName(remoteName);
            if (string.IsNullOrWhiteSpace(normalizedRemoteName))
            {
                continue;
            }

            var prefix = $"{normalizedRemoteName}/";
            if (!normalized.StartsWith(prefix, StringComparison.Ordinal))
            {
                continue;
            }

            if (normalized.Length <= prefix.Length)
            {
                return null;
            }

            return normalized[prefix.Length..];
        }

        return null;
    }

    private static string BuildGitFailureReason(GitCommandResult result)
    {
        return FirstNonEmptyLine(result.StandardError)
            ?? FirstNonEmptyLine(result.StandardOutput)
            ?? $"exit code: {result.ExitCode}";
    }

    private static string EscapeGitArgument(string value)
    {
        if (string.IsNullOrEmpty(value))
        {
            return "\"\"";
        }

        var escaped = value
            .Replace("\\", "\\\\", StringComparison.Ordinal)
            .Replace("\"", "\\\"", StringComparison.Ordinal);
        return $"\"{escaped}\"";
    }

