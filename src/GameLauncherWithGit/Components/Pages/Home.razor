    private IReadOnlyList<GameSaveLinkEditInput> BuildEditorSaveLinkInputs()
    {
        if (_editorSaveLinks.Count == 0)
        {
            return Array.Empty<GameSaveLinkEditInput>();
        }

        var result = new List<GameSaveLinkEditInput>(_editorSaveLinks.Count);
        for (var index = 0; index < _editorSaveLinks.Count; index++)
        {
            var entry = _editorSaveLinks[index];
            var localPath = entry.LocalPath?.Trim();
            var targetPath = entry.TargetPath?.Trim();
            if (string.IsNullOrWhiteSpace(localPath) && string.IsNullOrWhiteSpace(targetPath))
            {
                continue;
            }

            if (string.IsNullOrWhiteSpace(localPath) || string.IsNullOrWhiteSpace(targetPath))
            {
                throw new InvalidOperationException($"セーブリンク {index + 1} はローカルと同期先の両方を設定してください。");
            }

            result.Add(
                new GameSaveLinkEditInput(
                    Id: entry.Id,
                    DisplayName: string.Empty,
                    LocalPath: localPath,
                    TargetPath: targetPath,
                    EnsureOnLaunch: entry.EnsureOnLaunch));
        }

        return result;
    }

    private async Task RetryLibraryAsync()
    {
        if (_isLibraryRetrying) return;
        _isLibraryRetrying = true;
        try
        {
            await RunWithUserOperationLoadingAsync("ゲーム一覧を読込中…", async () =>
            {
                if (await ReloadGamesAsync())
                {
                    var watcherError = TryRefreshRepositoryWatchers();
                    var linkError = _saveLinkLoadFailedGameIds.Count == 0
                        ? null : "読み込めないセーブリンクがあります。対象ゲームの編集はできません。";
                    var error = watcherError is not null ? AppendError(watcherError, linkError) : linkError;
                    SetNotification(error ?? "ゲーム一覧を読み込みました。", error is null,
                        summary: error is null ? "一覧更新" : "一覧更新エラー");
                }
                _focusLibraryRegion = GetSelectedGame() is null;
            });
        }
        finally
        {
            _isLibraryRetrying = false;
        }
    }

    private async Task<bool> ReloadGamesAsync()
    {
        while (true)
        {
            var registrationVersion = _gitRegistrationVersion;
            try
            {
                var games = await GameLibraryService.GetGamesAsync();
                if (registrationVersion != _gitRegistrationVersion) continue;
                _games = games;
                RebuildRegisteredGitIdentities();
                _libraryLoadError = null;
                break;
            }
            catch (Exception ex)
            {
                if (registrationVersion != _gitRegistrationVersion) continue;
                _libraryLoadError = ex.Message;
                return false;
            }
        }

        await RefreshSaveLinksAsync();
        SyncThumbnailCache();
        await RefreshGitStatusesAsync();
        return true;
    }

    private async Task RefreshSaveLinksAsync()
    {
        var loadVersion = ++_saveLinkLoadVersion;
        var games = _games ?? [];
        var activeGameIds = games
            .Select(static game => game.Id)
            .ToHashSet(StringComparer.OrdinalIgnoreCase);
        var staleGameIds = _saveLinksByGame.Keys
            .Where(gameId => !activeGameIds.Contains(gameId))
            .ToArray();
        foreach (var staleGameId in staleGameIds)
        {
            _saveLinksByGame.Remove(staleGameId);
        }
        _saveLinkLoadFailedGameIds.RemoveWhere(gameId => !activeGameIds.Contains(gameId));

        foreach (var game in games)
        {
            // Only a completed read (including zero links) can seed an editor draft.
            _saveLinksByGame.Remove(game.Id);
            try
            {
                var saveLinks = await SaveLinkService.GetByGameIdAsync(game.Id);
                if (loadVersion != _saveLinkLoadVersion) return;
                _saveLinksByGame[game.Id] = saveLinks;
                _saveLinkLoadFailedGameIds.Remove(game.Id);
            }
            catch
            {
                if (loadVersion != _saveLinkLoadVersion) return;
                _saveLinkLoadFailedGameIds.Add(game.Id);
            }
        }
    }

    private bool HasLoadedSaveLinks(string gameId) => _saveLinksByGame.ContainsKey(gameId);

    private string GetSaveLinkSummary(GameCardItem game)
    {
        if (_saveLinkLoadFailedGameIds.Contains(game.Id))
        {
            return "取得失敗";
        }

        if (!_saveLinksByGame.TryGetValue(game.Id, out var saveLinks))
        {
            return "取得中…";
        }

        if (saveLinks.Count == 0)
        {
            return "未設定";
        }

        var ensureOnLaunchCount = saveLinks.Count(static link => link.EnsureOnLaunch);
        return $"{saveLinks.Count}件（起動前チェック: {ensureOnLaunchCount}件）";
    }

