    private async Task SwitchEditorBranchAsync()
    {
        var repositoryPath = NormalizeRepositoryPath(_editorRepositoryPath);
        if (repositoryPath is null)
        {
            SetNotification("関連リポジトリが未設定または不正です。", false);
            return;
        }

        var selectedBranch = NormalizeBranchName(_editorSelectedBranch);
        if (string.IsNullOrWhiteSpace(selectedBranch))
        {
            SetNotification("切り替え先ブランチを選択してください。", false);
            return;
        }

        IReadOnlyList<string> switchCommand;
        string switchTargetLabel;
        var switchedFromRemote = false;
        if (_editorLocalBranches.Contains(selectedBranch))
        {
            if (string.Equals(selectedBranch, _editorCurrentBranch, StringComparison.OrdinalIgnoreCase))
            {
                SetNotification($"既に選択ブランチです: {selectedBranch}", true);
                return;
            }

            switchCommand = ["checkout", selectedBranch];
            switchTargetLabel = selectedBranch;
        }
        else if (_editorRemoteBranches.Contains(selectedBranch))
        {
            if (!_editorRemoteBranchLocalNames.TryGetValue(selectedBranch, out var localBranchName)
                || string.IsNullOrWhiteSpace(localBranchName))
            {
                SetNotification($"リモートブランチ名の形式が不正です: {selectedBranch}", false);
                return;
            }

            if (string.Equals(localBranchName, _editorCurrentBranch, StringComparison.OrdinalIgnoreCase))
            {
                SetNotification($"既に選択ブランチです: {localBranchName}", true);
                return;
            }

            switchCommand = ["checkout", "-b", localBranchName, "--track", selectedBranch];
            switchTargetLabel = $"{localBranchName} <- {selectedBranch}";
            switchedFromRemote = true;
        }
        else
        {
            SetNotification($"切り替え対象ブランチが見つかりません: {selectedBranch}", false);
            return;
        }

        await RunWithUserOperationLoadingAsync(
            "ブランチを切り替えています...",
            async () =>
            {
                _isBranchSwitching = true;
                try
                {
                    var result = await GitService.RunAsync(
                        repositoryPath,
                        switchCommand);
                    if (!result.IsSuccess)
                    {
                        SetNotification(
                            $"ブランチ切り替えに失敗しました: {BuildGitFailureReason(result)}",
                            false);
                        return;
                    }

                    await LoadEditorBranchesAsync(showNotificationOnFailure: false, preserveSelection: false);
                    var currentBranchResult = await GitService.RunAsync(repositoryPath, ["branch", "--show-current"]);
                    if (currentBranchResult.IsSuccess)
                    {
                        var actualBranch = NormalizeBranchName(FirstNonEmptyLine(currentBranchResult.StandardOutput));
                        if (!string.IsNullOrWhiteSpace(actualBranch))
                        {
                            _editorCurrentBranch = actualBranch;
                            _editorSelectedBranch = actualBranch;
                        }
                    }

                    await RefreshGitStatusesAsync();
                    SetNotification(
                        switchedFromRemote
                            ? $"リモート追跡ブランチを作成して切り替えました: {switchTargetLabel}"
                            : $"ブランチを切り替えました: {switchTargetLabel}",
                        true);
                }
                catch (Exception ex)
                {
                    SetNotification($"ブランチ切り替えに失敗しました: {ex.Message}", false);
                }
                finally
                {
                    _isBranchSwitching = false;
                }
            });
    }

    private async Task CreateEditorBranchAsync()
    {
        var repositoryPath = NormalizeRepositoryPath(_editorRepositoryPath);
        if (repositoryPath is null)
        {
            SetNotification("関連リポジトリが未設定または不正です。", false);
            return;
        }

        var newBranchName = NormalizeBranchName(_editorNewBranchName);
        if (string.IsNullOrWhiteSpace(newBranchName))
        {
            SetNotification("新規ブランチ名を入力してください。", false);
            return;
        }

        if (_editorLocalBranches.Contains(newBranchName))
        {
            SetNotification($"既に存在するブランチ名です: {newBranchName}", false);
            return;
        }

        await RunWithUserOperationLoadingAsync(
            "新規ブランチを作成しています...",
            async () =>
            {
                _isBranchCreating = true;
                try
                {
                    var validateResult = await GitService.RunAsync(
                        repositoryPath,
                        ["check-ref-format", "--branch", newBranchName]);
                    if (!validateResult.IsSuccess)
                    {
                        SetNotification(
                            $"ブランチ名が不正です: {BuildGitFailureReason(validateResult)}",
                            false);
                        return;
                    }

                    var createResult = await GitService.RunAsync(
                        repositoryPath,
                        ["checkout", "-b", newBranchName]);
                    if (!createResult.IsSuccess)
                    {
                        SetNotification(
                            $"ブランチ作成に失敗しました: {BuildGitFailureReason(createResult)}",
                            false);
                        return;
                    }

                    _editorNewBranchName = string.Empty;
                    await LoadEditorBranchesAsync(showNotificationOnFailure: false, preserveSelection: false);
                    await RefreshGitStatusesAsync();
                    SetNotification($"ブランチを作成して切り替えました: {newBranchName}", true);
                }
                catch (Exception ex)
                {
                    SetNotification($"ブランチ作成に失敗しました: {ex.Message}", false);
                }
                finally
                {
                    _isBranchCreating = false;
                }
            });
    }

    private async Task<bool> LoadEditorBranchesAsync(bool showNotificationOnFailure, bool preserveSelection, bool fetchRemote = false)
    {
        var repositoryPath = NormalizeRepositoryPath(_editorRepositoryPath);
        if (repositoryPath is null)
        {
            ResetEditorBranchState(clearNewBranchName: false);
            return false;
        }

        _isBranchLoading = true;
        try
        {
            var gitCheck = await GitService.RunAsync(repositoryPath, ["rev-parse", "--is-inside-work-tree"]);
            if (!gitCheck.IsSuccess)
            {
                if (showNotificationOnFailure)
                {
                    SetNotification(
                        $"ブランチ一覧取得に失敗しました: {BuildGitFailureReason(gitCheck)}",
                        false);
                }

                ResetEditorBranchState(clearNewBranchName: false);
                return false;
            }

            var remoteUpdateSucceeded = true;
            if (fetchRemote)
            {
                var fetchResult = await GitService.RunAsync(repositoryPath, ["fetch", "--all", "--prune"]);
                remoteUpdateSucceeded = fetchResult.IsSuccess;
                if (!remoteUpdateSucceeded && showNotificationOnFailure)
                {
                    SetNotification(
                        $"リモートブランチの更新に失敗しました。以前の情報を表示します: {BuildGitFailureReason(fetchResult)}",
                        false);
                }
            }

            var currentBranchResult = await GitService.RunAsync(repositoryPath, ["branch", "--show-current"]);
            if (!currentBranchResult.IsSuccess)
            {
                if (showNotificationOnFailure)
                {
                    SetNotification(
                        $"現在ブランチ取得に失敗しました: {BuildGitFailureReason(currentBranchResult)}",
                        false);
                }

                ResetEditorBranchState(clearNewBranchName: false);
                return false;
            }

            var localBranchesResult = await GitService.RunAsync(
                repositoryPath,
                ["for-each-ref", "--format=%(refname:short)", "refs/heads"]);
            if (!localBranchesResult.IsSuccess)
            {
                if (showNotificationOnFailure)
                {
                    SetNotification(
                        $"ブランチ一覧取得に失敗しました: {BuildGitFailureReason(localBranchesResult)}",
                        false);
                }

                ResetEditorBranchState(clearNewBranchName: false);
                return false;
            }

            var remoteBranchesResult = await GitService.RunAsync(
                repositoryPath,
                ["for-each-ref", "--format=%(refname:short)", "refs/remotes"]);
            if (!remoteBranchesResult.IsSuccess)
            {
                if (showNotificationOnFailure)
                {
                    SetNotification(
                        $"リモートブランチ一覧取得に失敗しました: {BuildGitFailureReason(remoteBranchesResult)}",
                        false);
                }

                ResetEditorBranchState(clearNewBranchName: false);
                return false;
            }

            var remoteNamesResult = await GitService.RunAsync(repositoryPath, ["remote"]);
            if (!remoteNamesResult.IsSuccess)
            {
                if (showNotificationOnFailure)
                {
                    SetNotification(
                        $"リモート名一覧取得に失敗しました: {BuildGitFailureReason(remoteNamesResult)}",
                        false);
                }

                ResetEditorBranchState(clearNewBranchName: false);
                return false;
            }

            if (!string.Equals(repositoryPath, NormalizeRepositoryPath(_editorRepositoryPath), StringComparison.OrdinalIgnoreCase))
            {
                return false;
            }

            var currentBranch = NormalizeBranchName(FirstNonEmptyLine(currentBranchResult.StandardOutput));
            var previousSelectedBranch = NormalizeBranchName(_editorSelectedBranch);
            var localBranchNames = localBranchesResult.StandardOutput
                .Split(['\r', '\n'], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                .Where(static name => !string.IsNullOrWhiteSpace(name))
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .OrderBy(static name => name, StringComparer.OrdinalIgnoreCase)
                .ToList();
            var branchNames = localBranchNames.ToList();
            if (!string.IsNullOrWhiteSpace(currentBranch)
                && branchNames.All(name => !string.Equals(name, currentBranch, StringComparison.OrdinalIgnoreCase)))
            {
                branchNames.Insert(0, currentBranch);
            }
            else if (!string.IsNullOrWhiteSpace(currentBranch))
            {
                branchNames = branchNames
                    .OrderBy(name => string.Equals(name, currentBranch, StringComparison.OrdinalIgnoreCase) ? 0 : 1)
                    .ThenBy(static name => name, StringComparer.OrdinalIgnoreCase)
                    .ToList();
            }

            var remoteNames = remoteNamesResult.StandardOutput
                .Split(['\r', '\n'], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                .Where(static name => !string.IsNullOrWhiteSpace(name))
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .OrderByDescending(static name => name.Length)
                .ThenBy(static name => name, StringComparer.OrdinalIgnoreCase)
                .ToList();
            var remoteBranchNames = remoteBranchesResult.StandardOutput
                .Split(['\r', '\n'], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                .Where(static name => !string.IsNullOrWhiteSpace(name))
                .Where(name => !IsRemoteHeadSymbolicRef(name, remoteNames))
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .OrderBy(static name => name, StringComparer.OrdinalIgnoreCase)
                .ToList();
            var remoteBranchLocalNames = remoteBranchNames
                .Select(remoteBranch => new
                {
                    RemoteBranch = remoteBranch,
                    LocalBranch = ExtractLocalBranchNameFromRemote(remoteBranch, remoteNames)
                })
                .Where(static x => !string.IsNullOrWhiteSpace(x.LocalBranch))
                .ToDictionary(
                    static x => x.RemoteBranch,
                    static x => x.LocalBranch!,
                    StringComparer.OrdinalIgnoreCase);
            var displayedLocalBranchNames = new HashSet<string>(branchNames, StringComparer.OrdinalIgnoreCase);
            var remoteOnlyBranchNames = remoteBranchNames
                .Where(remoteBranch =>
                {
                    return remoteBranchLocalNames.TryGetValue(remoteBranch, out var localBranchName)
                        && !displayedLocalBranchNames.Contains(remoteBranch)
                        && !displayedLocalBranchNames.Contains(localBranchName);
                })
                .ToList();

            _editorBranches.Clear();
            _editorBranches.AddRange(branchNames);
            _editorBranches.AddRange(remoteOnlyBranchNames);
            _editorLocalBranches.Clear();
            foreach (var branchName in localBranchNames)
            {
                _editorLocalBranches.Add(branchName);
            }

            if (!string.IsNullOrWhiteSpace(currentBranch))
            {
                _editorLocalBranches.Add(currentBranch);
            }

            _editorRemoteBranches.Clear();
            _editorRemoteBranchLocalNames.Clear();
            foreach (var remoteBranchName in remoteOnlyBranchNames)
            {
                _editorRemoteBranches.Add(remoteBranchName);
                _editorRemoteBranchLocalNames[remoteBranchName] = remoteBranchLocalNames[remoteBranchName];
            }

            _editorCurrentBranch = currentBranch;

            if (preserveSelection
                && !string.IsNullOrWhiteSpace(previousSelectedBranch)
                && _editorBranches.Any(name => string.Equals(name, previousSelectedBranch, StringComparison.OrdinalIgnoreCase)))
            {
                _editorSelectedBranch = previousSelectedBranch;
            }
            else if (!string.IsNullOrWhiteSpace(currentBranch))
            {
                _editorSelectedBranch = currentBranch;
            }
            else
            {
                _editorSelectedBranch = _editorBranches.FirstOrDefault();
            }

            return remoteUpdateSucceeded;
        }
        catch (Exception ex)
        {
            if (showNotificationOnFailure)
            {
                SetNotification($"ブランチ一覧取得に失敗しました: {ex.Message}", false);
            }

            ResetEditorBranchState(clearNewBranchName: false);
            return false;
        }
        finally
        {
            _isBranchLoading = false;
        }
    }

    private static string? NormalizeBranchName(string? branchName)
    {
        return string.IsNullOrWhiteSpace(branchName)
            ? null
            : branchName.Trim();
    }

    private string GetEditorBranchOptionLabel(string branchName)
    {
        return _editorRemoteBranches.Contains(branchName)
            ? $"{branchName} (remote)"
            : branchName;
    }

    private static string? ExtractLocalBranchNameFromRemote(string remoteBranchName, IReadOnlyList<string> remoteNames)
    {
        var normalized = NormalizeBranchName(remoteBranchName);
        if (string.IsNullOrWhiteSpace(normalized)
            || remoteNames is null
            || remoteNames.Count == 0)
        {
            return null;
        }

        foreach (var remoteName in remoteNames)
        {
            var normalizedRemoteName = NormalizeBranchName(remoteName);
            if (string.IsNullOrWhiteSpace(normalizedRemoteName))
            {
                continue;
            }

            var prefix = $"{normalizedRemoteName}/";
            if (!normalized.StartsWith(prefix, StringComparison.Ordinal))
            {
                continue;
            }

            if (normalized.Length <= prefix.Length)
            {
                return null;
            }

            return normalized[prefix.Length..];
        }

        return null;
    }

    private static bool IsRemoteHeadSymbolicRef(string remoteBranchName, IReadOnlyList<string> remoteNames)
    {
        var normalizedBranch = NormalizeBranchName(remoteBranchName);
        if (string.IsNullOrWhiteSpace(normalizedBranch)
            || remoteNames is null
            || remoteNames.Count == 0)
        {
            return false;
        }

        foreach (var remoteName in remoteNames)
        {
            var normalizedRemoteName = NormalizeBranchName(remoteName);
            if (string.IsNullOrWhiteSpace(normalizedRemoteName))
            {
                continue;
            }

            if (string.Equals(normalizedBranch, $"{normalizedRemoteName}/HEAD", StringComparison.Ordinal))
            {
                return true;
            }
        }

        return false;
    }

    private static string BuildGitFailureReason(GitCommandResult result)
    {
        return result.GetFailureReason();
    }

    private void ResetEditorBranchState(bool clearNewBranchName)
    {
        _isBranchLoading = false;
        _isBranchSwitching = false;
        _isBranchCreating = false;
        _editorCurrentBranch = null;
        _editorSelectedBranch = null;
        _editorBranches.Clear();
        _editorLocalBranches.Clear();
        _editorRemoteBranches.Clear();
        _editorRemoteBranchLocalNames.Clear();

        if (clearNewBranchName)
        {
            _editorNewBranchName = string.Empty;
        }
    }

    private string GetEditorCurrentBranchLabel()
    {
        if (NormalizeRepositoryPath(_editorRepositoryPath) is null)
        {
            return "関連リポジトリ未設定";
        }

        if (_isBranchLoading)
        {
            return "取得中...";
        }

        return string.IsNullOrWhiteSpace(_editorCurrentBranch)
            ? "detached HEAD / 不明"
            : _editorCurrentBranch;
    }

    private bool IsBranchSelectionDisabled()
    {
        return NormalizeRepositoryPath(_editorRepositoryPath) is null
            || _isSaving
            || _isBranchLoading
            || _isBranchSwitching
            || _isBranchCreating
            || _editorBranches.Count == 0;
    }

    private bool IsBranchReloadDisabled()
    {
        return NormalizeRepositoryPath(_editorRepositoryPath) is null
            || _isSaving
            || _isBranchLoading
            || _isBranchSwitching
            || _isBranchCreating;
    }

    private bool IsBranchSwitchDisabled()
    {
        if (IsBranchSelectionDisabled())
        {
            return true;
        }

        var selectedBranch = NormalizeBranchName(_editorSelectedBranch);
        if (string.IsNullOrWhiteSpace(selectedBranch))
        {
            return true;
        }

        if (_editorLocalBranches.Contains(selectedBranch))
        {
            return string.Equals(selectedBranch, _editorCurrentBranch, StringComparison.OrdinalIgnoreCase);
        }

        if (_editorRemoteBranches.Contains(selectedBranch))
        {
            if (!_editorRemoteBranchLocalNames.TryGetValue(selectedBranch, out var localBranchName)
                || string.IsNullOrWhiteSpace(localBranchName))
            {
                return true;
            }

            return string.Equals(localBranchName, _editorCurrentBranch, StringComparison.OrdinalIgnoreCase);
        }

        return true;
    }

    private bool IsBranchCreateInputDisabled()
    {
        return NormalizeRepositoryPath(_editorRepositoryPath) is null
            || _isSaving
            || _isBranchLoading
            || _isBranchSwitching
            || _isBranchCreating;
    }

    private bool IsBranchCreateDisabled()
    {
        return IsBranchCreateInputDisabled()
            || string.IsNullOrWhiteSpace(NormalizeBranchName(_editorNewBranchName));
    }

    private void AddEditorSaveLink()
    {
        _editorSaveLinks.Add(new EditorSaveLinkEntry
        {
            Id = null,
            LocalPath = null,
            TargetPath = null,
            EnsureOnLaunch = true
        });
    }

    private void RemoveEditorSaveLink(int index)
    {
        if (!IsEditorSaveLinkIndexValid(index))
        {
            return;
        }

        _editorSaveLinks.RemoveAt(index);
    }

    private void MoveEditorSaveLink(int index, int direction)
    {
        if (!IsEditorSaveLinkIndexValid(index))
        {
            return;
        }

        var destinationIndex = index + direction;
        if (destinationIndex < 0 || destinationIndex >= _editorSaveLinks.Count)
        {
            return;
        }

        (_editorSaveLinks[index], _editorSaveLinks[destinationIndex]) =
            (_editorSaveLinks[destinationIndex], _editorSaveLinks[index]);
    }

    private void SetEditorSaveLinkEnsureOnLaunch(int index, bool ensureOnLaunch)
    {
        if (!TryGetEditorSaveLink(index, out var entry))
        {
            return;
        }

        entry.EnsureOnLaunch = ensureOnLaunch;
    }

    private async Task PickEditorSaveLocalPathAsync(int index)
    {
        await PickEditorSavePathAsync(
            index,
            "ローカルセーブフォルダを選択",
            "ローカルセーブフォルダが選択されませんでした。",
            static (entry, selectedPath) => entry.LocalPath = selectedPath);
    }

    private async Task PickEditorSaveTargetPathAsync(int index)
    {
        await PickEditorSavePathAsync(
            index,
            "同期先フォルダを選択",
            "同期先フォルダが選択されませんでした。",
            static (entry, selectedPath) => entry.TargetPath = selectedPath);
    }

    private async Task PickEditorSavePathAsync(
        int index,
        string pickerTitle,
        string emptySelectionMessage,
        Action<EditorSaveLinkEntry, string> applySelectedPath)
    {
        if (!TryGetEditorSaveLink(index, out var entry))
        {
            return;
        }

        await RunWithUserOperationLoadingAsync(
            "セーブリンクのフォルダを選択しています...",
            async () =>
            {
                try
                {
                    var selectedPath = await PathPickerService.PickFolderPathAsync(pickerTitle);
                    if (!string.IsNullOrWhiteSpace(selectedPath))
                    {
                        applySelectedPath(entry, selectedPath);
                        return;
                    }

                    SetNotification(emptySelectionMessage, false);
                }
                catch (Exception ex)
                {
                    SetNotification(ex.Message, false);
                }
            });
    }

    private bool IsEditorSaveLinkIndexValid(int index)
    {
        return index >= 0 && index < _editorSaveLinks.Count;
    }

    private bool TryGetEditorSaveLink(int index, out EditorSaveLinkEntry entry)
    {
        if (!IsEditorSaveLinkIndexValid(index))
        {
            entry = null!;
            return false;
        }

        entry = _editorSaveLinks[index];
        return true;
    }

    private static string GetEditorSaveLinkPathLabel(string? path)
    {
        return string.IsNullOrWhiteSpace(path) ? "未設定" : path;
    }

    private IReadOnlyList<GameSaveLinkEditInput> BuildEditorSaveLinkInputs()
    {
        if (_editorSaveLinks.Count == 0)
        {
            return Array.Empty<GameSaveLinkEditInput>();
        }

        var result = new List<GameSaveLinkEditInput>(_editorSaveLinks.Count);
        for (var index = 0; index < _editorSaveLinks.Count; index++)
        {
            var entry = _editorSaveLinks[index];
            var localPath = entry.LocalPath?.Trim();
            var targetPath = entry.TargetPath?.Trim();
            if (string.IsNullOrWhiteSpace(localPath) && string.IsNullOrWhiteSpace(targetPath))
            {
                continue;
            }

            if (string.IsNullOrWhiteSpace(localPath) || string.IsNullOrWhiteSpace(targetPath))
            {
                throw new InvalidOperationException($"セーブリンク {index + 1} はローカルと同期先の両方を設定してください。");
            }

            result.Add(
                new GameSaveLinkEditInput(
                    Id: entry.Id,
                    DisplayName: string.Empty,
                    LocalPath: localPath,
                    TargetPath: targetPath,
                    EnsureOnLaunch: entry.EnsureOnLaunch));
        }

        return result;
    }

    private async Task RetryLibraryAsync()
    {
        await RunWithUserOperationLoadingAsync("ゲーム一覧を読込中…", async () =>
        {
            if (await ReloadGamesAsync())
            {
                var watcherError = TryRefreshRepositoryWatchers();
                SetNotification(watcherError ?? (_saveLinkLoadFailedGameIds.Count == 0
                    ? "ゲーム一覧を読み込みました。"
                    : "読み込めないセーブリンクがあります。対象ゲームの編集はできません。"),
                    watcherError is null && _saveLinkLoadFailedGameIds.Count == 0);
            }
            _focusLibraryHeading = true;
        });
    }

    private async Task<bool> ReloadGamesAsync()
    {
        try
        {
            _games = await GameLibraryService.GetGamesAsync();
            _libraryLoadError = null;
        }
        catch (Exception ex)
        {
            _libraryLoadError = ex.Message;
            return false;
        }

        await RefreshSaveLinksAsync();
        SyncThumbnailCache();
        await RefreshRepositorySyncHistoriesAsync();
        await RefreshGitStatusesAsync();
        return true;
    }

    private async Task RefreshSaveLinksAsync()
    {
        _saveLinkLoadFailedGameIds.Clear();

        if (_games is null || _games.Count == 0)
        {
            _saveLinksByGame.Clear();
            return;
        }

        var activeGameIds = _games
            .Select(static game => game.Id)
            .ToHashSet(StringComparer.OrdinalIgnoreCase);
        var staleGameIds = _saveLinksByGame.Keys
            .Where(gameId => !activeGameIds.Contains(gameId))
            .ToArray();
        foreach (var staleGameId in staleGameIds)
        {
            _saveLinksByGame.Remove(staleGameId);
        }

        foreach (var game in _games)
        {
            try
            {
                var saveLinks = await SaveLinkService.GetByGameIdAsync(game.Id);
                _saveLinksByGame[game.Id] = saveLinks;
            }
            catch
            {
                _saveLinkLoadFailedGameIds.Add(game.Id);
            }
        }
    }

    private string GetSaveLinkSummary(GameCardItem game)
    {
        if (_saveLinkLoadFailedGameIds.Contains(game.Id))
        {
            return "取得失敗";
        }

        if (!_saveLinksByGame.TryGetValue(game.Id, out var saveLinks) || saveLinks.Count == 0)
        {
            return "未設定";
        }

        var ensureOnLaunchCount = saveLinks.Count(static link => link.EnsureOnLaunch);
        return $"{saveLinks.Count}件（起動前チェック: {ensureOnLaunchCount}件）";
    }

    private IReadOnlyList<GameCardItem> GetFilteredGames()
    {
        if (_games is null || _games.Count == 0)
        {
            return Array.Empty<GameCardItem>();
        }

        if (string.IsNullOrWhiteSpace(_gameSearchText))
        {
            return _games;
        }

        var keyword = _gameSearchText.Trim();
        return _games
            .Where(game => game.Title.Contains(keyword, StringComparison.OrdinalIgnoreCase))
            .ToArray();
    }

    private static string AppendError(string message, string? error) => error is null ? message : $"{message} {error}";

    private string? TryRefreshRepositoryWatchers(bool removeOnly = false)
    {
        try
        {
            RefreshRepositoryWatchers(removeOnly);
            return null;
        }
        catch (Exception ex)
        {
            return $"監視の更新に失敗しました: {ex.Message}";
        }
    }

    private void RefreshRepositoryWatchers(bool removeOnly = false)
    {
        if (_games is null)
        {
            return;
        }

        var activeRepositoryIds = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        foreach (var game in _games)
        {
            if (string.IsNullOrWhiteSpace(game.RelatedRepositoryPath))
            {
                continue;
            }

            var repositoryKey = NormalizeRepositoryKey(game.RelatedRepositoryPath);
            if (repositoryKey is null)
            {
                continue;
            }

            activeRepositoryIds.Add(repositoryKey);
        }

        var staleRepositoryIds = _registeredWatcherRepositoryIds
            .Where(id => !activeRepositoryIds.Contains(id))
            .ToArray();
        foreach (var repositoryId in staleRepositoryIds)
        {
            RepositoryWatcherService.Unregister(repositoryId);
            _registeredWatcherRepositoryIds.Remove(repositoryId);
        }

        if (removeOnly)
        {
            return;
        }

        foreach (var repositoryId in activeRepositoryIds)
        {
            RepositoryWatcherService.Register(repositoryId, repositoryId);
            _registeredWatcherRepositoryIds.Add(repositoryId);
        }
    }

    private void UnregisterAllWatchers()
    {
        foreach (var repositoryId in _registeredWatcherRepositoryIds.ToArray())
        {
            RepositoryWatcherService.Unregister(repositoryId);
        }

        _registeredWatcherRepositoryIds.Clear();
    }

    private bool IsPinToggleBusy(GameCardItem game)
    {
        return _pinningGameIds.Contains(game.Id);
    }

    private static bool IsLaunchDisabled(GameCardItem game)
    {
        return string.IsNullOrWhiteSpace(game.ExecutablePath);
    }

    private static string GetLaunchButtonTitle(GameCardItem game)
    {
        return IsLaunchDisabled(game)
            ? "実行ファイル未設定のため起動できません"
            : "起動";
    }

    private async Task TogglePinnedAsync(GameCardItem game)
    {
        if (string.IsNullOrWhiteSpace(game.Id) || !_pinningGameIds.Add(game.Id))
        {
            return;
        }

        var nextPinned = !game.IsPinned;
        await RunWithUserOperationLoadingAsync(
            nextPinned ? "ピン留めを更新しています..." : "ピン留め解除を更新しています...",
            async () =>
            {
                try
                {
                    await GameLibraryService.SetPinnedAsync(game.Id, nextPinned);
                    var loaded = await ReloadGamesAsync();
                    SetNotification(
                        !loaded ? $"「{game.Title}」のピン留め設定は保存しました。一覧の再読込に失敗しました。" : nextPinned
                            ? $"ピン留めしました: {game.Title}"
                            : $"ピン留めを解除しました: {game.Title}",
                        loaded);
                }
                catch (Exception ex)
                {
                    SetNotification($"ピン留め更新に失敗しました: {ex.Message}", false);
                }
                finally
                {
                    _pinningGameIds.Remove(game.Id);
                }
            });
    }

    private static string? NormalizeRepositoryKey(string? repositoryPath)
    {
        if (string.IsNullOrWhiteSpace(repositoryPath))
        {
            return null;
        }

        try
        {
            var normalized = Path.GetFullPath(repositoryPath.Trim());
            return Directory.Exists(normalized) ? normalized : null;
        }
        catch
        {
            return null;
        }
    }

    private static string? NormalizeRepositoryPath(string? repositoryPath)
    {
        if (string.IsNullOrWhiteSpace(repositoryPath))
        {
            return null;
        }

        try
        {
            return Path.GetFullPath(repositoryPath.Trim());
        }
        catch
        {
            return null;
        }
    }

    public void Dispose()
    {
        SettingsPanelService.OpenRequested -= OnSettingsOpenRequested;
        _notificationDismissCts?.Cancel();
        _notificationDismissCts?.Dispose();
        _stateRefreshCts.Cancel();
        _stateRefreshCts.Dispose();
        UnregisterAllWatchers();
