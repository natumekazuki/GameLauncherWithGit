    }

    private bool IsBranchSwitchDisabled()
    {
        if (IsBranchSelectionDisabled())
        {
            return true;
        }

        var selectedBranch = NormalizeBranchName(_editorSelectedBranch);
        if (string.IsNullOrWhiteSpace(selectedBranch))
        {
            return true;
        }

        if (_editorLocalBranches.Contains(selectedBranch))
        {
            return string.Equals(selectedBranch, _editorCurrentBranch, StringComparison.OrdinalIgnoreCase);
        }

        if (_editorRemoteBranches.Contains(selectedBranch))
        {
            if (!_editorRemoteBranchLocalNames.TryGetValue(selectedBranch, out var localBranchName)
                || string.IsNullOrWhiteSpace(localBranchName))
            {
                return true;
            }

            return string.Equals(localBranchName, _editorCurrentBranch, StringComparison.OrdinalIgnoreCase);
        }

        return true;
    }

