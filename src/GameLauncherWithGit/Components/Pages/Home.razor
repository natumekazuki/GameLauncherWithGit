@page "/"
@implements IDisposable
@inject IGameLibraryService GameLibraryService
@inject ILauncherService LauncherService
@inject IPathPickerService PathPickerService
@inject IGitService GitService
@inject IAutoStartService AutoStartService
@inject IAppSettingsService AppSettingsService
@inject ILogAccessService LogAccessService
@inject IRepositoryWatcherService RepositoryWatcherService
@inject ISyncOrchestrator SyncOrchestrator
@inject IRepositoryStateStore RepositoryStateStore
@inject ISettingsPanelService SettingsPanelService
@inject IRepositorySyncHistoryStore RepositorySyncHistoryStore
@inject ISaveLinkService SaveLinkService
@inject IJSRuntime JS
@inject NavigationManager Navigation

<PageTitle>GameLauncherWithGit</PageTitle>

@{
    RenderFragment notificationContent = @<div class="notification-message @GetMessageClass()">
        <span>@_message</span>
        <button type="button" class="notification-dismiss" @onclick="DismissNotification" aria-label="通知を閉じる"><CaptureIcon Name="Close" /></button>
    </div>;
}

<header class="home-header">
    <h1 tabindex="-1" @ref="_libraryHeading">ゲーム一覧</h1>
    <nav class="home-navigation" aria-label="ランチャー">
        <a class="secondary-button home-labeled-action" href="capture"><CaptureIcon Name="History" /> シナリオ</a>
        @if (OperatingSystem.IsWindows())
        {
            <a class="secondary-button home-labeled-action" href="play-recording-web" aria-label="記録Webの接続許可"><CaptureIcon Name="Link" /> 記録Web</a>
        }
        <button type="button" class="secondary-button utility-icon-button" title="設定" aria-label="設定" @onclick="OpenSettingsAsync" disabled="@(_isStartupChecking || _isCardSizeSaving)"><CaptureIcon Name="Settings" /></button>
        <button type="button" class="secondary-button utility-icon-button" title="ヘルプ" aria-label="ヘルプ" @onclick="OpenHelp"><span aria-hidden="true" class="home-help-icon">?</span></button>
    </nav>
</header>

@if (!_isStartupChecking && _isGitReady)
{
    <section class="utility-bar" aria-label="ゲーム一覧の操作">
        <div class="search-control">
            <input type="search"
                   class="search-input"
                   @bind="_gameSearchText"
                   @bind:event="oninput"
                   placeholder="ゲームを検索"
                   aria-label="ゲーム検索" />
        </div>
        <div class="card-size-control" role="group" aria-label="カードサイズ">
            <button type="button"
                    class="secondary-button utility-icon-button"
                    title="カードサイズを小さくする"
                    aria-label="カードサイズを小さくする"
                    @onclick="DecreaseGameCardSizeAsync"
                    disabled="@(_isCardSizeSaving || _gameCardSizePercent <= AppSettings.GameCardSizePercentMin)">
                <span aria-hidden="true">−</span>
            </button>
            <output class="card-size-label">@_gameCardSizePercent%</output>
            <button type="button"
                    class="secondary-button utility-icon-button"
                    title="カードサイズを大きくする"
                    aria-label="カードサイズを大きくする"
                    @onclick="IncreaseGameCardSizeAsync"
                    disabled="@(_isCardSizeSaving || _gameCardSizePercent >= AppSettings.GameCardSizePercentMax)">
                <CaptureIcon Name="Plus" />
            </button>
        </div>
        <button type="button"
                class="launch-button home-labeled-action"
                @onclick="OpenCreateEditor"
                disabled="@(_games is null || _libraryLoadError is not null)">
            <CaptureIcon Name="Plus" /> ゲーム追加
        </button>
        <button type="button"
                class="secondary-button home-labeled-action"
                @onclick="RefreshGitStatusesManuallyAsync"
                disabled="@(_isGitStatusRefreshing || _games is null || _libraryLoadError is not null)">
            <CaptureIcon Name="Refresh" /> @(_isGitStatusRefreshing ? "更新中…" : "Git状態を更新")
        </button>
        @if (_libraryLoadError is null && _saveLinkLoadFailedGameIds.Count > 0)
        {
            <button type="button" class="secondary-button home-labeled-action" @onclick="RetryLibraryAsync"><CaptureIcon Name="Refresh" /> ゲーム一覧を再読込</button>
        }
    </section>
}

@if (_isStartupChecking)
{
    <section class="library-page startup-check-panel" role="status">
        <p>Gitを確認中…</p>
    </section>
}
else if (!_isGitReady)
{
    <section class="startup-error-panel">
        <div role="alert">
            <h2>Git が利用できません</h2>
            <p class="startup-error-detail">@_startupError</p>
            <p>Gitの設定を確認して、再試行してください。</p>
        </div>
        <button type="button" class="secondary-button home-labeled-action" @onclick="RetryStartupAsync"><CaptureIcon Name="Refresh" /> 再試行</button>
    </section>
}
else if (_libraryLoadError is not null)
{
    <section class="startup-error-panel">
        <div role="alert">
            <h2>ゲーム一覧を読み込めません</h2>
            <p class="startup-error-detail">@_libraryLoadError</p>
        </div>
        <button type="button" class="secondary-button home-labeled-action" @onclick="RetryLibraryAsync"><CaptureIcon Name="Refresh" /> 再試行</button>
    </section>
}
else
{
    <section class="library-page">
        <div class="game-grid" style="@GetGameGridStyle()">
            @if (_games is null)
            {
                <p role="status">読み込み中…</p>
            }
            else
            {
                var filteredGames = GetFilteredGames();
                if (filteredGames.Count == 0)
                {
                    <p role="status">@(_games.Count == 0 ? "ゲーム未登録" : "一致するゲームなし")</p>
                }
                else
                {
                    @foreach (var game in filteredGames)
                    {
                        var effectiveStatus = GetEffectiveStatus(game);
                        var gitVisualState = GetGitVisualState(game);
                        var syncHistory = GetSyncHistoryTimeline(game);
                        var hasRepository = gitVisualState != GitRepositoryVisualState.NotConfigured;
                        var canResumeSync = CanResumeRepositorySync(game);
                        var hasThumbnail = HasThumbnail(game);
                        var thumbnail = hasThumbnail ? GetThumbnailSource(game) : null;
                        var hasDisplayImage = thumbnail is { DecodeFailed: false };
                        var showCardTitle = _showCardTitle || !hasDisplayImage;
                        <article @key="game.Id" class="@GetGameCardClass(gitVisualState)" aria-label="@game.Title">
                            @if (thumbnail is { DecodeFailed: false })
                            {
                                <div class="game-thumbnail-panel @(IsLaunchDisabled(game) ? string.Empty : "game-thumbnail-launchable")" @ondblclick="() => LaunchFromThumbnailAsync(game)" title="@(IsLaunchDisabled(game) ? GetLaunchButtonTitle(game) : "ダブルクリックで起動")">
                                    <img @key="thumbnail" class="game-thumbnail-image" src="@thumbnail.DataUri"
                                         alt="@(showCardTitle ? string.Empty : game.Title)"
                                         @onerror="() => MarkThumbnailDecodeFailed(game.Id, thumbnail)" />
                                </div>
                            }
                            <div class="home-card-content">
                                @if (showCardTitle)
                                {
                                    <h2>@game.Title</h2>
                                }
                                <div class="home-card-states">
                                    <span class="home-git-state">@GetGitCardLabel(gitVisualState)</span>
                                    @if (hasRepository && (_showCardSyncStatus || effectiveStatus == GameCardStatus.Error))
                                    {
                                        <span class="status-badge @GetStatusClass(effectiveStatus)">@(canResumeSync ? "同期停止" : GetStatusLabel(effectiveStatus))</span>
                                    }
                                    @if (hasThumbnail && !hasDisplayImage)
                                    {
                                        <span class="home-media-error">画像を読み込めません</span>
                                    }
                                </div>
                            </div>

                            <div class="game-card-actions" role="group" aria-label="@($"{game.Title}の操作")">
                                <button type="button"
                                        class="launch-button action-icon-button"
                                        @onclick="() => LaunchAsync(game.Id)"
                                        title="@GetLaunchButtonTitle(game)"
                                        aria-label="@($"{game.Title}：{GetLaunchButtonTitle(game)}")"
                                        disabled="@IsLaunchDisabled(game)">
                                    <CaptureIcon Name="Play" />
                                </button>
                                <button type="button"
                                        class="secondary-button action-icon-button"
                                        @onclick="() => OpenEditEditorAsync(game)"
                                        title="ゲーム編集"
                                        aria-label="@($"{game.Title}を編集")">
                                    <CaptureIcon Name="Edit" />
                                </button>
                                <button type="button"
                                        class="secondary-button pin-toggle-button @(game.IsPinned ? "pin-toggle-active" : string.Empty)"
                                        @onclick="() => TogglePinnedAsync(game)"
                                        title="@(game.IsPinned ? "ピン留めを解除" : "ピン留め")"
                                        aria-label="@($"{game.Title}のピン留め")"
                                        aria-pressed="@(game.IsPinned ? "true" : "false")"
                                        disabled="@IsPinToggleBusy(game)">
                                    <span class="pin-toggle-icon" aria-hidden="true"></span>
                                </button>
                                @if (canResumeSync)
                                {
                                    <button type="button"
                                            class="secondary-button home-labeled-action"
                                            @onclick="() => ResumeRepositorySyncAsync(game)"
                                            disabled="@IsRepositoryBusy(game)">
                                        同期を再開
                                    </button>
                                }
                            </div>

                            <details class="home-card-details">
                                <summary>詳細</summary>
                                <dl>
                                    @if (!showCardTitle)
                                    {
                                        <dt>タイトル</dt><dd>@game.Title</dd>
                                    }
                                    <dt>実行ファイル</dt><dd>@GetEditorSaveLinkPathLabel(game.ExecutablePath)</dd>
                                    <dt>関連リポジトリ</dt><dd>@GetEditorSaveLinkPathLabel(game.RelatedRepositoryPath)</dd>
                                    <dt>セーブリンク</dt><dd>@GetSaveLinkSummary(game)</dd>
                                    <dt>最終プレイ</dt><dd>@FormatLastPlayed(game.LastPlayedAt)</dd>
                                </dl>
                            </details>
                            @if (hasRepository)
                            {
                                <details class="game-sync-history">
                                    <summary>同期履歴</summary>
                                    @if (_syncHistoryLoadFailed)
                                    {
                                        <div class="home-history-error">
                                            <p>同期履歴を読み込めません</p>
                                            <button type="button" class="secondary-button" @onclick="() => RefreshRepositorySyncHistoriesAsync()">再試行</button>
                                        </div>
                                    }
                                    else if (syncHistory.Count == 0)
                                    {
                                        <p class="meta-value">履歴なし</p>
                                    }
                                    else
                                    {
                                        <ul class="sync-timeline-list">
                                            @foreach (var history in syncHistory)
                                            {
                                                <li class="sync-timeline-item @GetSyncHistoryStatusClass(history.Status)">
                                                    <div class="sync-timeline-head">
                                                        <span>@GetSyncHistoryStatusLabel(history.Status)</span>
                                                        <span>@FormatSyncHistoryTimestamp(history.FinishedAt)</span>
                                                    </div>
                                                    <p class="sync-timeline-meta">所要時間: @FormatSyncHistoryDuration(history.DurationMs)</p>
                                                    @if (!string.IsNullOrWhiteSpace(history.Command))
                                                    {
                                                        <p class="sync-timeline-meta">コマンド: @history.Command</p>
                                                    }
                                                    @if (!string.IsNullOrWhiteSpace(history.Reason))
                                                    {
                                                        <p class="sync-timeline-reason">@history.Reason</p>
                                                    }
                                                </li>
                                            }
                                        </ul>
                                    }
                                </details>
                            }
                        </article>
                    }
                }
            }
        </div>
    </section>
}

<div class="notification-dock" aria-live="polite" aria-atomic="true">
    @if (!string.IsNullOrWhiteSpace(_message) && !_isHelpOpen && !_isSettingsOpen && !_isDeleteConfirmOpen && !_isEditorOpen && _discardChanges is null)
    {
        @notificationContent
    }
</div>

@if (IsUserOperationLoading)
{
    <div class="operation-loading-overlay" aria-live="polite" aria-busy="true">
        <div class="operation-loading-modal">
            <div class="operation-loading-spinner" aria-hidden="true"></div>
            <p class="operation-loading-message">@GetUserOperationLoadingMessage()</p>
        </div>
    </div>
}

@if (_isHelpOpen)
{
    <div class="editor-overlay help-overlay" @onclick="CloseHelp">
        <section class="help-modal" role="dialog" aria-modal="true" aria-labelledby="help-title" tabindex="-1" @onclick:stopPropagation="true">
            <h2 id="help-title" tabindex="-1" data-dialog-initial>ヘルプ</h2>
            <div class="dialog-notification" aria-live="polite" aria-atomic="true">
                @if (!string.IsNullOrWhiteSpace(_message) && !_isSettingsOpen && !_isEditorOpen && !_isDeleteConfirmOpen)
                {
                    @notificationContent
                }
            </div>

            <div class="help-section">
                <h3>基本操作</h3>
                <ul>
                    <li><strong>ゲーム追加</strong>：タイトルだけでも登録できます。</li>
                    <li><strong>起動</strong>：起動前に同期を確認します。</li>
                    <li><strong>Git状態を更新</strong>：リポジトリの状態を再取得します。同期は実行しません。</li>
                </ul>
            </div>

            <div class="help-section">
                <h3>カードの見方</h3>
                <ul>
                    <li><strong>Git状態</strong>：リポジトリの変更や先行・遅れを表示します。</li>
                    <li><strong>同期履歴</strong>：直近3件の結果と時刻を確認できます。</li>
                </ul>
            </div>

            <div class="help-section">
                <h3>Git状態の意味</h3>
                <table class="help-git-table">
                    <thead>
                        <tr>
                            <th>状態</th>
                            <th>確認・対応</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>@GetGitCardLabel(GitRepositoryVisualState.Clean)</td>
                            <td>そのまま利用</td>
                        </tr>
                        <tr>
                            <td>@GetGitCardLabel(GitRepositoryVisualState.Dirty)</td>
                            <td>差分を確認してコミット方針を決める</td>
                        </tr>
                        <tr>
                            <td>@GetGitCardLabel(GitRepositoryVisualState.Ahead)</td>
                            <td>必要なら push</td>
                        </tr>
                        <tr>
                            <td>@GetGitCardLabel(GitRepositoryVisualState.Behind)</td>
                            <td>pull して追従</td>
                        </tr>
                        <tr>
                            <td>@GetGitCardLabel(GitRepositoryVisualState.Diverged)</td>
                            <td>履歴を確認して統合方針を決める</td>
                        </tr>
                        <tr>
                            <td>@GetGitCardLabel(GitRepositoryVisualState.Error)</td>
                            <td>設定のログで詳細を確認</td>
                        </tr>
                        <tr>
                            <td>@GetGitCardLabel(GitRepositoryVisualState.NotConfigured)</td>
                            <td>ゲーム編集で設定</td>
                        </tr>
                        <tr>
                            <td>@GetGitCardLabel(GitRepositoryVisualState.Unknown)</td>
                            <td>「Git状態を更新」で再取得</td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <div class="help-section">
                <h3>トラブル時の導線</h3>
                <ul>
                    <li>画面上の通知で直近メッセージを確認</li>
                    <li>エラーの詳細は <strong>設定 → ログ</strong> で確認</li>
                </ul>
            </div>

            <div class="editor-actions">
                <button type="button"
                        class="secondary-button"
                        @onclick="CloseHelp" data-dialog-dismiss>
                    閉じる
                </button>
            </div>
        </section>
    </div>
}

@if (_isSettingsOpen)
{
    <div class="editor-overlay settings-overlay" @onclick="RequestCloseSettings">
        <section class="settings-modal" role="dialog" aria-modal="true" aria-labelledby="settings-title" tabindex="-1" @onclick:stopPropagation="true">
            <h2 id="settings-title" class="dialog-heading" tabindex="-1" data-dialog-initial>設定</h2>
            <div class="dialog-notification" aria-live="polite" aria-atomic="true">
                @if (!string.IsNullOrWhiteSpace(_message) && !_isEditorOpen && !_isDeleteConfirmOpen)
                {
                    @notificationContent
                }
            </div>
            <nav class="settings-quick-links" aria-label="設定内の移動">
                <button type="button" class="secondary-button" @onclick="FocusNotificationHeadingAsync">通知</button>
                <button type="button" class="secondary-button" @onclick="FocusLogHeadingAsync">ログ</button>
            </nav>
            <div class="dialog-body">

                <div class="settings-section">
                    <label class="settings-toggle-row">
                        <span>Windows起動時に自動起動（即時反映）</span>
                        <input type="checkbox"
                               checked="@_autoStartEnabled"
                               @onchange="OnAutoStartChangedAsync"
                               disabled="@(_isSettingsLoading || _isAutoStartSaving)" />
                    </label>
                    @if (_isSettingsLoading)
                    {
                        <p class="settings-note">設定を読み込み中...</p>
                    }
                </div>

                <div class="settings-section settings-sync-section">
                    <h3>同期・通知</h3>
                    <div class="settings-sync-grid">
                        <label class="settings-value-row">
                            <span class="settings-value-label">変更検知の待機（秒）</span>
                            <input type="number"
                                   min="1"
                                   max="300"
                                   @bind="_syncDebounceSeconds"
                                   disabled="@(_isSettingsLoading || _isAppSettingsSaving)" />
                        </label>
                        <label class="settings-value-row">
                            <span class="settings-value-label">再試行の初期待機（秒）</span>
                            <input type="number"
                                   min="1"
                                   max="600"
                                   @bind="_syncRetryInitialSeconds"
                                   disabled="@(_isSettingsLoading || _isAppSettingsSaving)" />
                        </label>
                        <label class="settings-value-row">
                            <span class="settings-value-label">再試行の最大待機（秒）</span>
                            <input type="number"
                                   min="1"
                                   max="3600"
                                   @bind="_syncRetryMaxSeconds"
                                   disabled="@(_isSettingsLoading || _isAppSettingsSaving)" />
                        </label>
                        <label class="settings-value-row">
                            <span class="settings-value-label">通知抑制秒（0で無効）</span>
                            <input type="number"
                                   min="0"
                                   max="600"
                                   @bind="_notificationSuppressSeconds"
                                   disabled="@(_isSettingsLoading || _isAppSettingsSaving)" />
                        </label>
                        <label class="settings-value-row">
                            <span class="settings-value-label">ログ保持（日）</span>
                            <input type="number"
                                   min="1"
                                   max="365"
                                   @bind="_logRetentionDays"
                                   disabled="@(_isSettingsLoading || _isAppSettingsSaving)" />
                        </label>
                        <label class="settings-value-row">
                            <span class="settings-value-label">ログ上限（MB）</span>
                            <input type="number"
                                   min="1"
                                   max="1024"
                                   @bind="_logMaxFileSizeMb"
                                   disabled="@(_isSettingsLoading || _isAppSettingsSaving)" />
                        </label>
                    </div>
                </div>

                <div class="settings-section">
                    <h3>カード表示</h3>
                    <label class="settings-toggle-row">
                        <span>画像付きカードのタイトル</span>
                        <input type="checkbox"
                               @bind="_showCardTitle"
                               disabled="@(_isSettingsLoading || _isAppSettingsSaving)" />
                    </label>
                    <label class="settings-toggle-row">
                        <span>通常時の同期状態</span>
                        <input type="checkbox"
                               @bind="_showCardSyncStatus"
                               disabled="@(_isSettingsLoading || _isAppSettingsSaving)" />
                    </label>
                </div>

                <section class="settings-section" id="notification-center">
                    <h3 tabindex="-1" @ref="_notificationHeading">通知</h3>
                    <div class="editor-actions">
                        <button type="button"
                                class="launch-button"
                                @onclick="CopyNotificationHistoryAsync"
                                disabled="@(_isSettingsLoading || _notificationHistoryEntries.Count == 0)">
                            全件コピー
                        </button>
                        <button type="button"
                                class="secondary-button"
                                @onclick="ClearNotificationHistory"
                                disabled="@(_isSettingsLoading || _notificationHistoryEntries.Count == 0)">
                            履歴を消去
                        </button>
                    </div>
                    <div class="notification-center-filters">
                        <label>
                            <input type="checkbox"
                                   @bind="_showSuccessNotifications"
                                   disabled="@_isSettingsLoading" />
                            成功を表示
                        </label>
                        <label>
                            <input type="checkbox"
                                   @bind="_showFailedNotifications"
                                   disabled="@_isSettingsLoading" />
                            失敗を表示
                        </label>
                    </div>
                    <div class="notification-center-list" role="log">
                        @{
                            var filteredNotificationEntries = GetFilteredNotificationHistoryEntries();
                        }
                        @if (_notificationHistoryEntries.Count == 0)
                        {
                            <p class="notification-center-empty">通知履歴はありません。</p>
                        }
                        else if (filteredNotificationEntries.Count == 0)
                        {
                            <p class="notification-center-empty">フィルタ条件に一致する通知はありません。</p>
                        }
                        else
                        {
                            @foreach (var entry in filteredNotificationEntries)
                            {
                                <article class="notification-center-item">
                                    <div class="notification-center-item-header">
                                        <span class="notification-center-time">@FormatNotificationHistoryTimestamp(entry.Timestamp)</span>
                                        <span class="notification-center-type @GetNotificationHistoryTypeClass(entry.IsSuccess)">
                                            @GetNotificationHistoryTypeLabel(entry.IsSuccess)
                                        </span>
                                    </div>
                                    <p class="notification-center-message">@entry.Message</p>
                                </article>
                            }
                        }
                    </div>
                </section>

                <section class="settings-section" id="log-viewer">
                    <div class="home-section-heading">
                        <h3 tabindex="-1" @ref="_logHeading">ログ</h3>
                        <div class="settings-actions-row">
                            <button type="button" class="secondary-button" aria-label="最新エラーログを開く" @onclick="OpenLatestErrorLogAsync" disabled="@_isSettingsLoading">最新エラー</button>
                            <button type="button" class="secondary-button" aria-label="ログフォルダを開く" @onclick="OpenLogDirectoryAsync" disabled="@_isSettingsLoading">フォルダ</button>
                        </div>
                    </div>
                    <div class="settings-log-controls">
                        <label class="settings-log-control">
                            <span>表示件数</span>
                            <input type="number"
                                   min="10"
                                   max="500"
                                   @bind="_logViewerLimit"
                                   disabled="@(_isSettingsLoading || _isLogLoading)" />
                        </label>
                        <label class="settings-log-control">
                            <span>レベル</span>
                            <select @bind="_logViewerSeverityFilter"
                                    disabled="@(_isSettingsLoading || _isLogLoading)">
                                <option value="all">すべて</option>
                                <option value="Critical">Critical</option>
                                <option value="Error">Error</option>
                                <option value="Warning">Warning</option>
                                <option value="Information">Information</option>
                                <option value="Debug">Debug</option>
                                <option value="Trace">Trace</option>
                            </select>
                        </label>
                    </div>
                    <label class="settings-log-keyword">
                        <span>キーワード</span>
                        <input type="text"
                               @bind="_logViewerKeyword"
                               @bind:event="oninput"
                               placeholder="メッセージ / TraceId / repo / command"
                               disabled="@(_isSettingsLoading || _isLogLoading)" />
                    </label>
                    <div class="editor-actions">
                        <button type="button"
                                class="launch-button"
                                @onclick="LoadLogEntriesAsync"
                                disabled="@(_isSettingsLoading || _isLogLoading)">
                            @(_isLogLoading ? "読込中…" : _logViewerError is null ? "更新" : "再試行")
                        </button>
                        <button type="button"
                                class="secondary-button"
                                @onclick="CopyLogEntriesAsync"
                                disabled="@(_isSettingsLoading || _isLogLoading || _logViewerEntries.Count == 0)">
                            コピー
                        </button>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(_logViewerError))
                    {
                        <p class="settings-log-error" role="alert">@_logViewerError</p>
                    }
                    <div class="settings-log-list" role="log">
                        @if (_isLogLoading)
                        {
                            <p class="settings-log-empty">ログを読込中…</p>
                        }
                        else if (_logViewerError is null && _logViewerEntries.Count == 0)
                        {
                            <p class="settings-log-empty">表示できるログがありません。</p>
                        }
                        else
                        {
                            @foreach (var entry in _logViewerEntries)
                            {
                                <article class="settings-log-item">
                                    <div class="settings-log-item-header">
                                        <span class="settings-log-time">@FormatLogTimestamp(entry.Timestamp)</span>
                                        <span class="settings-log-level @GetLogLevelClass(entry.Severity)">
                                            @entry.Severity
                                        </span>
                                    </div>
                                    <p class="settings-log-message">@entry.Message</p>
                                    <p class="settings-log-meta">
                                        <span class="settings-log-meta-item">name: @entry.Name</span>
                                        @if (!string.IsNullOrWhiteSpace(entry.TraceId))
                                        {
                                            <span class="settings-log-meta-item">traceId: @entry.TraceId</span>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(entry.RepositoryId))
                                        {
                                            <span class="settings-log-meta-item">repo: @entry.RepositoryId</span>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(entry.Command))
                                        {
                                            <span class="settings-log-meta-item">command: @entry.Command</span>
                                        }
                                        @if (entry.ExitCode.HasValue)
                                        {
                                            <span class="settings-log-meta-item">exitCode: @entry.ExitCode.Value</span>
                                        }
                                    </p>
                                    @if (!string.IsNullOrWhiteSpace(entry.Detail)
                                         || !string.IsNullOrWhiteSpace(entry.StandardOutput)
                                         || !string.IsNullOrWhiteSpace(entry.StandardError))
                                    {
                                        <div class="settings-log-details">
                                            @if (!string.IsNullOrWhiteSpace(entry.Detail))
                                            {
                                                <details class="settings-log-detail-block">
                                                    <summary>detail</summary>
                                                    <pre class="settings-log-detail">@entry.Detail</pre>
                                                </details>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(entry.StandardOutput))
                                            {
                                                <details class="settings-log-detail-block">
                                                    <summary>stdout</summary>
                                                    <pre class="settings-log-detail">@entry.StandardOutput</pre>
                                                </details>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(entry.StandardError))
                                            {
                                                <details class="settings-log-detail-block">
                                                    <summary>stderr</summary>
                                                    <pre class="settings-log-detail">@entry.StandardError</pre>
                                                </details>
                                            }
                                        </div>
                                    }
                                </article>
                            }
                        }
                    </div>
                </section>

            </div>
            <div class="editor-actions dialog-footer">
                <button type="button"
                        class="launch-button"
                        @onclick="SaveAppSettingsAsync"
                        disabled="@(_isSettingsLoading || _isAppSettingsSaving)">
                    @(_isAppSettingsSaving ? "保存中…" : "保存")
                </button>
                <button type="button"
                        class="secondary-button"
                        @onclick="RequestCloseSettings" data-dialog-dismiss
                        disabled="@(_isSettingsLoading || _isAutoStartSaving || _isAppSettingsSaving || _isCardSizeSaving)">
                    閉じる
                </button>
            </div>
        </section>
    </div>
}

