    /// <summary>Opens the selected registration without launching it or creating capture data.</summary>
    private Task OpenGameDetails(GameCardItem game, bool fromProblem = false)
    {
        _selectedGameId = game.Id;
        _selectedFromProblem = fromProblem;
        return LoadSelectedCapturePreferenceAsync(game.Id);
    }

    /// <summary>Reads the saved next-launch preference without changing the live capture target.</summary>
    private async Task LoadSelectedCapturePreferenceAsync(string gameId)
    {
        var version = ++_selectedCaptureReadVersion;
        _selectedCaptureEnabled = null;
        _selectedCapturePreferenceError = null;
        try
        {
            // An unconfigured registration uses the same ON default as a newly created capture profile.
            var profile = await CaptureStore.FindCaptureProfileAsync(gameId);
            if (version == _selectedCaptureReadVersion && _selectedGameId == gameId)
            {
                _selectedCaptureEnabled = profile?.Enabled ?? true;
            }
        }
        catch (Exception ex)
        {
            // Keep a failed preference read separate from both OFF and the live recording state.
            if (version == _selectedCaptureReadVersion && _selectedGameId == gameId)
            {
                _selectedCapturePreferenceError = ex.Message;
            }
        }
    }

