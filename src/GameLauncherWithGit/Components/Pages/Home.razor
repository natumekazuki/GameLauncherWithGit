    private async Task OpenEditEditorAsync(GameCardItem game)
    {
        if (_saveLinkLoadFailedGameIds.Contains(game.Id))
        {
            SetNotification(
                "セーブリンクの取得に失敗しているため編集を開始できません。再読み込みしてから再試行してください。",
                false);
            return;
        }

        _isEditMode = true;
        _editingGameId = game.Id;
        _editorTitle = game.Title;
        _editorExecutablePath = game.ExecutablePath;
        _editorRepositoryPath = game.RelatedRepositoryPath;
        ResetEditorBranchState(clearNewBranchName: true);
        _editorSaveLinks.Clear();
        if (_saveLinksByGame.TryGetValue(game.Id, out var saveLinks))
        {
            _editorSaveLinks.AddRange(
                saveLinks
                    .OrderBy(static item => item.OrderNo)
                    .Select(static item => new EditorSaveLinkEntry
                    {
                        Id = item.Id,
                        LocalPath = item.LocalPath,
                        TargetPath = item.TargetPath,
                        EnsureOnLaunch = item.EnsureOnLaunch
                    }));
        }
        _editorThumbnailSourcePath = null;
        _editorHasThumbnail = HasThumbnail(game);
        _editorClearThumbnail = false;
        _isEditorOpen = true;
        await LoadEditorBranchesAsync(showNotificationOnFailure: false, preserveSelection: false);
    }

    private async Task DeleteGameAsync()
    {
        if (_isDeleting)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(_deleteTargetGameId))
        {
            SetNotification("削除対象が不正です。", false);
            return;
        }

        await RunWithUserOperationLoadingAsync(
            "ゲームを削除しています...",
            async () =>
            {
                _isDeleting = true;
                var targetGameId = _deleteTargetGameId;
                var targetTitle = _deleteTargetGameTitle;
                try
                {
                    var deleted = await GameLibraryService.DeleteAsync(targetGameId);
                    if (!deleted)
                    {
                        SetNotification("削除対象のゲームが見つかりません。", false);
                        return;
                    }

                    if (_isEditorOpen
                        && !string.IsNullOrWhiteSpace(_editingGameId)
                        && string.Equals(_editingGameId, targetGameId, StringComparison.OrdinalIgnoreCase))
                    {
                        CloseEditor(force: true);
                    }

                    await ReloadGamesAsync();
                    await RefreshRepositoryWatchersAsync();
                    SetNotification($"ゲームを削除しました: {targetTitle}", true);
                    CloseDeleteConfirm(force: true);
                }
                catch (Exception ex)
                {
                    SetNotification($"ゲーム削除に失敗しました: {ex.Message}", false);
                }
                finally
                {
                    _isDeleting = false;
                }
            });
    }

    private void CloseEditor(bool force = false)
    {
        if (_isSaving && !force)
        {
            return;
        }

        _isEditorOpen = false;
    }

    private async Task SaveEditorAsync()
    {
        var shouldCloseEditor = false;

        if (string.IsNullOrWhiteSpace(_editorTitle))
        {
            SetNotification("タイトルは必須です。", false);
            return;
        }

        var input = new GameEditInput(
            Title: _editorTitle,
            ExecutablePath: _editorExecutablePath,
            RelatedRepositoryPath: _editorRepositoryPath,
            ThumbnailSourcePath: _editorThumbnailSourcePath,
            ClearThumbnail: _editorClearThumbnail);

        await RunWithUserOperationLoadingAsync(
            "ゲーム設定を保存しています...",
            async () =>
            {
                _isSaving = true;
                try
                {
                    var saveLinkInputs = BuildEditorSaveLinkInputs();
                    if (_isEditMode)
                    {
                        if (string.IsNullOrWhiteSpace(_editingGameId))
                        {
                            SetNotification("編集対象が不正です。", false);
                            return;
                        }

                        if (_saveLinkLoadFailedGameIds.Contains(_editingGameId))
                        {
                            SetNotification(
                                "セーブリンク取得に失敗しているため保存できません。再読み込みしてから再試行してください。",
                                false);
                            return;
                        }

                        var updated = await GameLibraryService.UpdateWithSaveLinksAsync(_editingGameId, input, saveLinkInputs);
                        if (updated is null)
                        {
                            SetNotification("編集対象のゲームが見つかりません。", false);
                            return;
                        }

                        SetNotification($"ゲーム設定を更新しました: {updated.Title}", true);
                    }
                    else
                    {
                        var created = await GameLibraryService.CreateAsync(input);
                        await SaveLinksForCreatedGameAsync(created.Id, saveLinkInputs);
                        SetNotification($"ゲームを登録しました: {created.Title}", true);
                    }

                    await ReloadGamesAsync();
                    await RefreshRepositoryWatchersAsync();
                    shouldCloseEditor = true;
                }
                catch (Exception ex)
                {
                    SetNotification($"保存に失敗しました: {ex.Message}", false);
                }
                finally
                {
                    _isSaving = false;
                    if (shouldCloseEditor)
                    {
                        CloseEditor(force: true);
                    }
                }
            });
    }

    private async Task SaveLinksForCreatedGameAsync(string gameId, IReadOnlyList<GameSaveLinkEditInput> saveLinkInputs)
    {
        try
        {
            await SaveLinkService.ReplaceForGameAsync(gameId, saveLinkInputs);
        }
        catch (Exception ex)
        {
            var rollbackError = await TryRollbackCreatedGameAsync(gameId);
            if (string.IsNullOrWhiteSpace(rollbackError))
            {
                throw new InvalidOperationException(
                    $"セーブリンク保存に失敗したため、作成済みゲームをロールバックしました。reason={ex.Message}",
                    ex);
            }

            throw new InvalidOperationException(
                $"セーブリンク保存に失敗し、作成済みゲームのロールバックにも失敗しました。gameId={gameId}, rollbackReason={rollbackError}, reason={ex.Message}",
                ex);
        }
    }

    private async Task<string?> TryRollbackCreatedGameAsync(string gameId)
    {
        try
        {
            var isDeleted = await GameLibraryService.DeleteAsync(gameId);
            return isDeleted
                ? null
                : $"gameId={gameId} の削除結果が false でした。";
        }
        catch (Exception rollbackEx)
        {
            return rollbackEx.Message;
        }
    }

