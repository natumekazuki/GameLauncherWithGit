    private async Task RefreshSelectedGitStatusAsync(string gameId, string repositoryPath)
    {
        if (GetSelectedGame() is not { } game || game.Id != gameId
            || !string.Equals(GetConfiguredGitPath(game), repositoryPath, StringComparison.OrdinalIgnoreCase)) return;

        var identity = ResolveGitRepositoryIdentity(repositoryPath);
        SetRegisteredGitIdentity(repositoryPath, identity);
        if (identity.Root is not { } repositoryRoot)
        {
            ReportSelectedGitStatus(game.Title, repositoryPath, null, new(GitRepositoryVisualState.Error, identity.Error));
            return;
        }
        if (IsTargetedGitStatusReadPending(repositoryRoot)) return;
        RefreshGitAliases(repositoryRoot, discoverAliases: true);
        if (!HasSameGitRoot(GetRegisteredGitIdentity(game)?.Root, repositoryRoot)) return;

        await RunWithUserOperationLoadingAsync(
            "Git状態を更新しています…",
            async () =>
            {
                try
                {
                    var result = await RefreshRepositoryGitStatusAsync(repositoryRoot, targeted: true, _stateRefreshCts.Token);
                    if (result is not null
                        && _games?.Any(current => current.Id == game.Id
                            && string.Equals(GetConfiguredGitPath(current), repositoryPath, StringComparison.OrdinalIgnoreCase)
                            && HasSameGitRoot(GetRegisteredGitIdentity(current)?.Root, repositoryRoot)) == true)
                    {
                        ReportSelectedGitStatus(game.Title, repositoryPath, repositoryRoot, result);
                    }
                }
                catch (OperationCanceledException)
                {
                    // 画面終了時のキャンセルは通知しない。
                }
            });
    }

