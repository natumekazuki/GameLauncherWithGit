    private async Task DeleteGameAsync()
    {
        if (_isDeleting)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(_deleteTargetGameId))
        {
            SetNotification("削除対象が不正です。", false);
            return;
        }

        await RunWithUserOperationLoadingAsync(
            "ゲームを削除しています...",
            async () =>
            {
                _isDeleting = true;
                var targetGameId = _deleteTargetGameId;
                var targetTitle = _deleteTargetGameTitle;
                var registrationDeleted = false;
                try
                {
                    var deleted = await GameLibraryService.DeleteAsync(targetGameId);
                    if (!deleted)
                    {
                        SetNotification("削除対象のゲームが見つかりません。", false);
                        return;
                    }
                    registrationDeleted = true;

                    if (_isEditorOpen
                        && !string.IsNullOrWhiteSpace(_editingGameId)
                        && string.Equals(_editingGameId, targetGameId, StringComparison.OrdinalIgnoreCase))
                    {
                        CloseEditor(force: true);
                    }

                    CloseDeleteConfirm(force: true);
                    _focusLibraryHeading = true;
                    if (_games is not null)
                    {
                        _games = _games.Where(game => !string.Equals(game.Id, targetGameId, StringComparison.OrdinalIgnoreCase)).ToArray();
                    }

                    var removalError = TryRefreshRepositoryWatchers(removeOnly: true);
                    var reloadError = await ReloadGamesAsync()
                        ? TryRefreshRepositoryWatchers()
                        : AppendError("一覧の再読込に失敗しました。", removalError);
                    SetNotification(reloadError is null
                        ? $"ゲーム登録を削除しました: {targetTitle}"
                        : $"「{targetTitle}」の登録は削除しました。{reloadError}", reloadError is null);
                }
                catch (Exception ex)
                {
                    SetNotification(registrationDeleted
                        ? $"「{targetTitle}」の登録は削除しました。削除後の更新に失敗しました: {ex.Message}"
                        : $"ゲーム削除に失敗しました: {ex.Message}", false);
                }
                finally
                {
                    _isDeleting = false;
                }
            });
    }

