    private enum GitRepositoryVisualState
    {
        Unknown = 0,
        NotConfigured = 1,
        Clean = 2,
        Dirty = 3,
        Ahead = 4,
        Behind = 5,
        Diverged = 6,
        Error = 7
    }

    private static string GetGitCardLabel(GitRepositoryVisualState state)
    {
        return state switch
        {
            GitRepositoryVisualState.NotConfigured => "同期先なし",
            GitRepositoryVisualState.Clean => "Git：変更なし",
            GitRepositoryVisualState.Dirty => "Git：未コミット",
            GitRepositoryVisualState.Ahead => "Git：ローカル先行",
            GitRepositoryVisualState.Behind => "Git：リモート先行",
            GitRepositoryVisualState.Diverged => "Git：分岐",
            GitRepositoryVisualState.Error => "Git：取得失敗",
            _ => "Git：未確認"
        };
    }

    private void OnSettingsOpenRequested(object? sender, EventArgs e)
    {
        _ = InvokeAsync(async () =>
        {
            if (_isStartupChecking || !_isGitReady)
            {
                return;
            }

            if (_isSettingsOpen)
            {
                StateHasChanged();
                return;
            }

            await OpenSettingsAsync();
            StateHasChanged();
        });
    }
