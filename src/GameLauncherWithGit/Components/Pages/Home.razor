    private string? GetThumbnailDataUri(GameCardItem game)
    {
        var path = NormalizeThumbnailPath(game.ThumbnailPath);
        if (path is null)
        {
            return null;
        }

        if (_thumbnailDataUriCache.TryGetValue(path, out var cached))
        {
            return cached;
        }

        try
        {
            if (!File.Exists(path))
            {
                return null;
            }

            var bytes = File.ReadAllBytes(path);
            if (bytes.Length == 0)
            {
                return null;
            }

            var dataUri = $"data:image/png;base64,{Convert.ToBase64String(bytes)}";
            _thumbnailDataUriCache[path] = dataUri;
            return dataUri;
        }
        catch
        {
            return null;
        }
    }

    private void SyncThumbnailCache()
    {
        if (_games is null)
        {
            _thumbnailDataUriCache.Clear();
            return;
        }

        var activePaths = _games
            .Select(game => NormalizeThumbnailPath(game.ThumbnailPath))
            .Where(static path => !string.IsNullOrWhiteSpace(path))
            .Select(static path => path!)
            .ToHashSet(StringComparer.OrdinalIgnoreCase);

        var stalePaths = _thumbnailDataUriCache.Keys
            .Where(path => !activePaths.Contains(path))
            .ToArray();

        foreach (var stalePath in stalePaths)
        {
            _thumbnailDataUriCache.Remove(stalePath);
        }
    }

    private static string? NormalizeThumbnailPath(string? path)
    {
        if (string.IsNullOrWhiteSpace(path))
        {
            return null;
        }

        try
        {
            return Path.GetFullPath(path.Trim());
        }
        catch
        {
            return null;
        }
    }

