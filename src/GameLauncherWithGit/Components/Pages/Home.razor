    private GitRepositoryIdentity? GetRegisteredGitIdentity(GameCardItem game) =>
        GetConfiguredGitPath(game) is { } path ? _gitIdentitiesByConfiguredPath.GetValueOrDefault(path) : null;

    private void OnGitRegistrationsCommitted()
    {
        ++_gitRegistrationVersion;
        RebuildRegisteredGitIdentities();
    }

    private void RebuildRegisteredGitIdentities()
    {
        var previousRoots = _gitIdentitiesByConfiguredPath.Values.Select(identity => identity.Root).OfType<string>().ToArray();
        _gitIdentitiesByConfiguredPath = (_games ?? [])
            .Select(GetConfiguredGitPath)
            .OfType<string>()
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToDictionary(path => path, ResolveGitRepositoryIdentity, StringComparer.OrdinalIgnoreCase);
        foreach (var previousRoot in previousRoots)
        {
            ForgetUnregisteredGitRoot(previousRoot);
        }
    }

    private void SetRegisteredGitIdentity(string path, GitRepositoryIdentity identity)
    {
        if (!_gitIdentitiesByConfiguredPath.TryGetValue(path, out var previous)) return;
        _gitIdentitiesByConfiguredPath[path] = identity;
        if (previous.Root is { } previousRoot && !HasSameGitRoot(previousRoot, identity.Root))
        {
            ForgetUnregisteredGitRoot(previousRoot);
        }
    }

    private void ForgetUnregisteredGitRoot(string root)
    {
        if (IsRegisteredGitRepositoryRoot(root)) return;
        _gitStatusReads.Remove(root);
        _gitVisualStateByRepository.Remove(root);
    }

    private static bool HasSameGitRoot(string? left, string? right) =>
        string.Equals(left, right, StringComparison.OrdinalIgnoreCase);

    private void RefreshGitAliases(string repositoryRoot, bool discoverAliases = false)
    {
        foreach (var (path, identity) in _gitIdentitiesByConfiguredPath.ToArray())
        {
            var wasMember = HasSameGitRoot(identity.Root, repositoryRoot);
            if (!wasMember && !discoverAliases) continue;

            var latest = ResolveGitRepositoryIdentity(path);
            if (wasMember || HasSameGitRoot(latest.Root, repositoryRoot))
            {
                SetRegisteredGitIdentity(path, latest);
            }
        }
    }

    private static GitRepositoryIdentity ResolveGitRepositoryIdentity(string path)
    {
        try
        {
            // Match GitService's worktree directory resolution, not the location of its Git metadata.
            return new(GameLauncherWithGit.Infrastructure.Services.GitService.ResolveDirectoryPath(path), null);
        }
        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException or ArgumentException or NotSupportedException)
        {
            return new(null, ex.Message);
        }
    }

    private async Task RefreshGitStatusesAsync(CancellationToken cancellationToken = default)
    {
        if (_isGitStatusSweepRunning)
        {
            return;
        }

        _isGitStatusSweepRunning = true;
        try
        {
            var readRoots = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
            foreach (var path in _gitIdentitiesByConfiguredPath.Keys.ToArray())
            {
                cancellationToken.ThrowIfCancellationRequested();
                if (!_gitIdentitiesByConfiguredPath.ContainsKey(path)) continue;

                // Earlier status commands may have yielded while this configured path changed.
                var identity = ResolveGitRepositoryIdentity(path);
                SetRegisteredGitIdentity(path, identity);
                if (identity.Root is { } repositoryRoot && readRoots.Add(repositoryRoot))
                {
                    await RefreshRepositoryGitStatusAsync(repositoryRoot, targeted: false, cancellationToken);
                }
            }
        }
        finally
        {
            _isGitStatusSweepRunning = false;
        }
    }

    private bool IsTargetedGitStatusReadPending(string repositoryRoot) =>
        _gitStatusReads.TryGetValue(repositoryRoot, out var read) && read.Targeted;

    private bool IsRegisteredGitRepositoryRoot(string repositoryRoot) =>
        _gitIdentitiesByConfiguredPath.Values.Any(identity =>
            HasSameGitRoot(identity.Root, repositoryRoot));

    private async Task<GitStatusResult?> RefreshRepositoryGitStatusAsync(
        string repositoryRoot, bool targeted, CancellationToken cancellationToken)
    {
        if (!targeted && IsTargetedGitStatusReadPending(repositoryRoot)) return null;

        // An explicit read can supersede an older sweep read for the same repository.
        var read = new GitStatusRead(targeted);
        _gitStatusReads[repositoryRoot] = read;
        bool IsLatestRead() => _gitStatusReads.TryGetValue(repositoryRoot, out var latest) && ReferenceEquals(read, latest);

        try
        {
            GitStatusResult status;
            try
            {
                var result = await GitService.RunAsync(repositoryRoot, ["status", "--porcelain", "--branch"], cancellationToken);
                status = result.IsSuccess
                    ? new(ParseGitVisualState(result.StandardOutput), null)
                    : new(GitRepositoryVisualState.Error, BuildGitFailureReason(result));
            }
            catch (Exception ex) when (ex is not OperationCanceledException || !cancellationToken.IsCancellationRequested)
            {
                status = new(GitRepositoryVisualState.Error, ex.Message);
            }

            cancellationToken.ThrowIfCancellationRequested();
            if (!IsLatestRead()) return null;
            RefreshGitAliases(repositoryRoot);
            if (!IsLatestRead()) return null;
            if (IsRegisteredGitRepositoryRoot(repositoryRoot))
            {
                _gitVisualStateByRepository[repositoryRoot] = status.State;
            }
            return status;
        }
        finally
        {
            if (IsLatestRead()) _gitStatusReads.Remove(repositoryRoot);
        }
    }

    private async Task RefreshBranchGitStatusAsync(string repositoryPath, string? reportFailureForGame = null)
    {
        var identity = ResolveGitRepositoryIdentity(repositoryPath);
        SetRegisteredGitIdentity(repositoryPath, identity);
        var result = identity.Root is { } repositoryRoot
            ? await RefreshRepositoryGitStatusAsync(repositoryRoot, targeted: true, _stateRefreshCts.Token)
            : new GitStatusResult(GitRepositoryVisualState.Error, identity.Error);
        if (reportFailureForGame is not null && result is { State: GitRepositoryVisualState.Error })
        {
            ReportSelectedGitStatus(reportFailureForGame, repositoryPath, identity.Root, result);
        }
    }

    private void ReportSelectedGitStatus(string gameTitle, string repositoryPath, string? repositoryRoot, GitStatusResult result)
    {
        const string operation = nameof(RefreshSelectedGitStatusAsync);
        var isSuccess = result.State != GitRepositoryVisualState.Error;
        if (isSuccess && repositoryRoot is not null
            && _notificationFailure is { Operation: operation, Target: { } failedPath, Repository: null }
            && HasSameGitRoot(_gitIdentitiesByConfiguredPath.GetValueOrDefault(failedPath)?.Root, repositoryRoot))
        {
            // A failed directory resolution has only the configured path as its key.
            ClearRecoveredNotification(operation, failedPath);
        }
        SetNotification(
            isSuccess
                ? $"「{gameTitle}」のGit状態を更新しました。"
                : $"「{gameTitle}」のGit状態を取得できません。関連リポジトリとログを確認し、再試行してください。\n関連リポジトリ: {repositoryPath}\n{result.Error}",
            isSuccess, summary: isSuccess ? "Git状態を更新" : "Git状態エラー",
            targetId: repositoryRoot is null ? repositoryPath.ToUpperInvariant() : null,
            repositoryPath: repositoryRoot, operation: operation);
    }

    private sealed record GitRepositoryIdentity(string? Root, string? Error);
    private sealed record GitStatusRead(bool Targeted);
    private sealed record GitStatusResult(GitRepositoryVisualState State, string? Error);

    private static GitRepositoryVisualState ParseGitVisualState(string output)
    {
        if (string.IsNullOrWhiteSpace(output))
        {
            return GitRepositoryVisualState.Clean;
        }

        var lines = output
            .Split(['\r', '\n'], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        if (lines.Length == 0)
        {
            return GitRepositoryVisualState.Clean;
        }

        var headerLine = lines[0];
        var hasWorkingTreeChanges = lines.Length > 1;
        ParseAheadBehind(headerLine, out var aheadCount, out var behindCount);

        if (aheadCount > 0 && behindCount > 0)
        {
            return GitRepositoryVisualState.Diverged;
        }

        if (behindCount > 0)
        {
            return GitRepositoryVisualState.Behind;
        }

        if (aheadCount > 0)
        {
            return GitRepositoryVisualState.Ahead;
        }

        return hasWorkingTreeChanges
            ? GitRepositoryVisualState.Dirty
            : GitRepositoryVisualState.Clean;
    }

    private static void ParseAheadBehind(string headerLine, out int aheadCount, out int behindCount)
    {
        aheadCount = 0;
        behindCount = 0;

        if (string.IsNullOrWhiteSpace(headerLine))
        {
            return;
        }

        var leftBracketIndex = headerLine.IndexOf('[');
        if (leftBracketIndex < 0)
        {
            return;
        }

        var rightBracketIndex = headerLine.IndexOf(']', leftBracketIndex + 1);
        if (rightBracketIndex <= leftBracketIndex)
        {
            return;
        }

        var summary = headerLine.Substring(leftBracketIndex + 1, rightBracketIndex - leftBracketIndex - 1);
        var segments = summary
            .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        foreach (var segment in segments)
        {
            if (segment.StartsWith("ahead ", StringComparison.OrdinalIgnoreCase)
                && int.TryParse(segment["ahead ".Length..], out var ahead))
            {
                aheadCount = ahead;
            }
            else if (segment.StartsWith("behind ", StringComparison.OrdinalIgnoreCase)
                && int.TryParse(segment["behind ".Length..], out var behind))
            {
                behindCount = behind;
            }
        }
    }

    private GitRepositoryVisualState GetGitVisualState(GameCardItem game)
    {
        if (string.IsNullOrWhiteSpace(game.RelatedRepositoryPath))
        {
            return GitRepositoryVisualState.NotConfigured;
        }

        if (GetRegisteredGitIdentity(game)?.Root is not { } repositoryRoot)
        {
            return GitRepositoryVisualState.Error;
        }

        return _gitVisualStateByRepository.GetValueOrDefault(repositoryRoot, GitRepositoryVisualState.Unknown);
    }

    private static bool HasThumbnail(GameCardItem game)
    {
        return !string.IsNullOrWhiteSpace(game.ThumbnailPath);
    }

    private ThumbnailSource? GetThumbnailSource(GameCardItem game)
    {
        var path = NormalizeThumbnailPath(game.ThumbnailPath);
        if (path is null)
        {
            return null;
        }

        if (_thumbnailCache.TryGetValue(path, out var cached))
        {
            return cached;
        }

        try
        {
            if (!File.Exists(path))
            {
                return null;
            }

            var bytes = File.ReadAllBytes(path);
            if (bytes.Length == 0)
            {
                return null;
            }

            var source = new ThumbnailSource($"data:image/png;base64,{Convert.ToBase64String(bytes)}");
            _thumbnailCache[path] = source;
            return source;
        }
        catch
        {
            return null;
        }
    }

    private void MarkThumbnailDecodeFailed(string gameId, ThumbnailSource source)
    {
        var game = _games?.FirstOrDefault(game => game.Id == gameId);
        var path = NormalizeThumbnailPath(game?.ThumbnailPath);
        if (path is not null && _thumbnailCache.TryGetValue(path, out var current) && ReferenceEquals(current, source))
        {
            source.DecodeFailed = true;
        }
    }

    private sealed class ThumbnailSource(string dataUri)
    {
        public string DataUri { get; } = dataUri;
        public bool DecodeFailed { get; set; }
    }

    private void SyncThumbnailCache()
    {
        if (_games is null)
        {
            _thumbnailCache.Clear();
            return;
        }

        var activePaths = _games
            .Select(game => NormalizeThumbnailPath(game.ThumbnailPath))
            .Where(static path => !string.IsNullOrWhiteSpace(path))
            .Select(static path => path!)
            .ToHashSet(StringComparer.OrdinalIgnoreCase);

        var stalePaths = _thumbnailCache.Keys
            .Where(path => !activePaths.Contains(path))
            .ToArray();

        foreach (var stalePath in stalePaths)
        {
            _thumbnailCache.Remove(stalePath);
        }
    }

    private static string? NormalizeThumbnailPath(string? path)
    {
        if (string.IsNullOrWhiteSpace(path))
        {
            return null;
        }

        try
        {
            return Path.GetFullPath(path.Trim());
        }
        catch
        {
            return null;
        }
    }

    private async Task ResumeRepositorySyncAsync(GameCardItem game)
    {
        var originalKey = GetSyncRepositoryKey(game);
        if (_games?.FirstOrDefault(current => current.Id == game.Id) is not { } registered
            || GetConfiguredGitPath(registered) is not { } configuredPath
            || !HasSameGitRoot(configuredPath, GetConfiguredGitPath(game))) return;

        SetRegisteredGitIdentity(configuredPath, ResolveGitRepositoryIdentity(configuredPath));
        var repositoryKey = GetSyncRepositoryKey(registered);
        if (!HasSameGitRoot(originalKey, repositoryKey)) return;
        if (repositoryKey is null)
        {
            SetNotification("関連リポジトリのパスが無効です。", false, summary: "同期再開エラー");
            return;
        }

        if (!CanResumeRepositorySync(registered) || !_resumingRepositoryIds.Add(repositoryKey)) return;
        await RunWithUserOperationLoadingAsync(
            "同期を再開しています...",
            async () =>
            {
                try
                {
                    await SyncOrchestrator.ResumeRepositorySyncAsync(repositoryKey);
                    SetNotification($"同期再開を受け付けました: {registered.Title}", null, summary: "同期再開受付", targetId: repositoryKey);
                }
                catch (Exception ex)
                {
                    SetNotification($"同期再開に失敗しました: {ex.Message}", false, summary: "同期再開エラー", targetId: repositoryKey);
                }
                finally
                {
                    _resumingRepositoryIds.Remove(repositoryKey);
                }
            });
    }

