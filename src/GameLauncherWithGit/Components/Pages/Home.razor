    private async Task LoadLogEntriesCoreAsync()
    {
        if (_isLogLoading)
        {
            return;
        }

        _isLogLoading = true;
        _logViewerError = null;

        try
        {
            var severity = ParseLogSeverityFilter(_logViewerSeverityFilter);
            _logViewerEntries = await LogAccessService.GetLatestEntriesAsync(
                _logViewerLimit,
                severity,
                _logViewerKeyword);
            ClearRecoveredNotification(nameof(LoadLogEntriesCoreAsync));
        }
        catch (Exception ex)
        {
            _logViewerEntries = Array.Empty<LogViewerEntry>();
            _logViewerError = $"ログ読み込みに失敗しました。詳細: {ex.Message}";
            SetNotification(_logViewerError, false, summary: "ログ読込エラー");
        }
        finally
        {
            _isLogLoading = false;
        }
    }

    private async Task CopyLogEntriesAsync()
    {
        if (_logViewerEntries.Count == 0)
        {
            SetNotification("コピー対象のログがありません。", false, summary: "ログコピー");
            return;
        }

        await RunWithUserOperationLoadingAsync(
            "ログをコピーしています...",
            async () =>
            {
                var lines = new List<string>(_logViewerEntries.Count * 3);
                foreach (var entry in _logViewerEntries)
                {
                    lines.Add($"{FormatLogTimestamp(entry.Timestamp)} [{entry.Severity}] {entry.Message}");
                    lines.Add(
                        $"name={entry.Name}, traceId={entry.TraceId ?? "n/a"}, repo={entry.RepositoryId ?? "n/a"}, command={entry.Command ?? "n/a"}, exitCode={(entry.ExitCode?.ToString() ?? "n/a")}");
                    if (!string.IsNullOrWhiteSpace(entry.Detail))
                    {
                        lines.Add($"detail: {entry.Detail}");
                    }

                    if (!string.IsNullOrWhiteSpace(entry.StandardOutput))
                    {
                        lines.Add($"stdout: {entry.StandardOutput}");
                    }

                    if (!string.IsNullOrWhiteSpace(entry.StandardError))
                    {
                        lines.Add($"stderr: {entry.StandardError}");
                    }

                    lines.Add(string.Empty);
                }

                try
                {
                    await Clipboard.Default.SetTextAsync(string.Join(Environment.NewLine, lines));
                    SetNotification("ログをクリップボードにコピーしました。", true, summary: "ログコピー");
                }
                catch (Exception ex)
                {
                    SetNotification($"ログコピーに失敗しました: {ex.Message}", false, summary: "ログコピー");
                }
            });
    }

    private static Microsoft.Extensions.Logging.LogLevel? ParseLogSeverityFilter(string? filter)
    {
        if (string.IsNullOrWhiteSpace(filter)
            || string.Equals(filter, "all", StringComparison.OrdinalIgnoreCase))
        {
            return null;
        }

        return Enum.TryParse<Microsoft.Extensions.Logging.LogLevel>(filter, ignoreCase: true, out var severity)
            ? severity
            : null;
    }

    private static string FormatLogTimestamp(DateTimeOffset value)
    {
        return value.LocalDateTime.ToString("yyyy-MM-dd HH:mm:ss");
    }

    private static string GetLogLevelClass(Microsoft.Extensions.Logging.LogLevel level)
    {
        return level switch
        {
            Microsoft.Extensions.Logging.LogLevel.Critical => "settings-log-level-critical",
            Microsoft.Extensions.Logging.LogLevel.Error => "settings-log-level-error",
            Microsoft.Extensions.Logging.LogLevel.Warning => "settings-log-level-warning",
            Microsoft.Extensions.Logging.LogLevel.Information => "settings-log-level-information",
            Microsoft.Extensions.Logging.LogLevel.Debug => "settings-log-level-debug",
            Microsoft.Extensions.Logging.LogLevel.Trace => "settings-log-level-trace",
            _ => "settings-log-level-none"
        };
    }

