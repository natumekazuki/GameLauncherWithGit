    /// <summary>Opens immediate branch controls for the selected work's saved repository.</summary>
    private async Task OpenBranchOperationsAsync(GameCardItem game)
    {
        if (_branchGame is not null || GetSelectedGame()?.Id != game.Id || GetConfiguredGitPath(game) is null) return;
        DismissNotification();
        ResetBranchOperations(clearNewBranchName: true);
        _branchGame = game;
        await LoadBranchesAsync(showNotificationOnFailure: true, preserveSelection: false);
    }

    /// <summary>Closes branch controls without treating completed Git operations as draft changes.</summary>
    private void CloseBranchOperations()
    {
        if (IsBranchWriting) return;
        _branchGame = null;
        ResetBranchOperations(clearNewBranchName: true);
    }

    private bool IsBranchWriting => _isBranchSwitching || _isBranchCreating;
    private string? GetBranchRepositoryPath() => NormalizeRepositoryPath(_branchGame?.RelatedRepositoryPath);

    private async Task ReloadBranchesAsync()
    {
        if (_branchGame is not { } game || IsBranchReloadDisabled() || GetBranchRepositoryPath() is not { } repositoryPath) return;
        await RunWithUserOperationLoadingAsync(
            "ブランチ一覧を取得しています...",
            async () =>
            {
                if (await LoadBranchesAsync(showNotificationOnFailure: true, preserveSelection: true, fetchRemote: true))
                {
                    await RefreshBranchGitStatusAsync(repositoryPath, game.Title);
                }
            });
    }

    private async Task SwitchBranchAsync()
    {
        if (_branchGame is not { } game || IsBranchWriting || _isBranchLoading) return;
        var gameId = game.Id;
        var repositoryPath = GetBranchRepositoryPath();
        void ReportResult(string message, bool isSuccess) => SetNotification(message, isSuccess, summary: "ブランチ切替",
            targetId: gameId, repositoryPath: repositoryPath, operation: nameof(SwitchBranchAsync));

        if (repositoryPath is null)
        {
            ReportResult("関連リポジトリが未設定または不正です。", false);
            return;
        }

        var selectedBranch = NormalizeBranchName(_branchSelection);
        if (string.IsNullOrWhiteSpace(selectedBranch))
        {
            ReportResult("切り替え先ブランチを選択してください。", false);
            return;
        }

        IReadOnlyList<string> switchCommand;
        string switchTargetLabel;
        var switchedFromRemote = false;
        if (_localBranches.Contains(selectedBranch))
        {
            if (string.Equals(selectedBranch, _branchCurrent, StringComparison.OrdinalIgnoreCase))
            {
                ReportResult($"既に選択ブランチです: {selectedBranch}", true);
                return;
            }

            switchCommand = ["checkout", selectedBranch];
            switchTargetLabel = selectedBranch;
        }
        else if (_remoteBranches.Contains(selectedBranch))
        {
            if (!_remoteBranchLocalNames.TryGetValue(selectedBranch, out var localBranchName)
                || string.IsNullOrWhiteSpace(localBranchName))
            {
                ReportResult($"リモートブランチ名の形式が不正です: {selectedBranch}", false);
                return;
            }

            if (string.Equals(localBranchName, _branchCurrent, StringComparison.OrdinalIgnoreCase))
            {
                ReportResult($"既に選択ブランチです: {localBranchName}", true);
                return;
            }

            switchCommand = ["checkout", "-b", localBranchName, "--track", selectedBranch];
            switchTargetLabel = $"{localBranchName} <- {selectedBranch}";
            switchedFromRemote = true;
        }
        else
        {
            ReportResult($"切り替え対象ブランチが見つかりません: {selectedBranch}", false);
            return;
        }

        await RunWithUserOperationLoadingAsync(
            "ブランチを切り替えています...",
            async () =>
            {
                _isBranchSwitching = true;
                try
                {
                    var syncRoot = GetBranchChangeSyncRoot(repositoryPath);
                    var result = await GitService.RunAsync(
                        syncRoot ?? repositoryPath,
                        switchCommand);
                    if (!result.IsSuccess)
                    {
                        ReportResult($"ブランチ切り替えに失敗しました: {BuildGitFailureReason(result)}", false);
                        return;
                    }

                    await NotifyBranchChangedForSyncAsync(repositoryPath, syncRoot);
                    await LoadBranchesAsync(showNotificationOnFailure: false, preserveSelection: false);
                    var currentBranchResult = await GitService.RunAsync(repositoryPath, ["branch", "--show-current"]);
                    if (currentBranchResult.IsSuccess)
                    {
                        var actualBranch = NormalizeBranchName(FirstNonEmptyLine(currentBranchResult.StandardOutput));
                        if (!string.IsNullOrWhiteSpace(actualBranch))
                        {
                            _branchCurrent = actualBranch;
                            _branchSelection = actualBranch;
                        }
                    }

                    await RefreshBranchGitStatusAsync(repositoryPath);
                    ReportResult(
                        switchedFromRemote
                            ? $"リモート追跡ブランチを作成して切り替えました: {switchTargetLabel}"
                            : $"ブランチを切り替えました: {switchTargetLabel}",
                        true);
                }
                catch (Exception ex)
                {
                    ReportResult($"ブランチ切り替えに失敗しました: {ex.Message}", false);
                }
                finally
                {
                    _isBranchSwitching = false;
                }
            });
    }

    private async Task CreateBranchAsync()
    {
        if (_branchGame is not { } game || IsBranchWriting || _isBranchLoading) return;
        var gameId = game.Id;
        var repositoryPath = GetBranchRepositoryPath();
        void ReportResult(string message, bool isSuccess) => SetNotification(message, isSuccess, summary: "ブランチ作成",
            targetId: gameId, repositoryPath: repositoryPath, operation: nameof(CreateBranchAsync));

        if (repositoryPath is null)
        {
            ReportResult("関連リポジトリが未設定または不正です。", false);
            return;
        }

        var newBranchName = NormalizeBranchName(_branchNewName);
        if (string.IsNullOrWhiteSpace(newBranchName))
        {
            ReportResult("新規ブランチ名を入力してください。", false);
            return;
        }

        if (_localBranches.Contains(newBranchName))
        {
            ReportResult($"既に存在するブランチ名です: {newBranchName}", false);
            return;
        }

        await RunWithUserOperationLoadingAsync(
            "新規ブランチを作成しています...",
            async () =>
            {
                _isBranchCreating = true;
                try
                {
                    var validateResult = await GitService.RunAsync(
                        repositoryPath,
                        ["check-ref-format", "--branch", newBranchName]);
                    if (!validateResult.IsSuccess)
                    {
                        ReportResult($"ブランチ名が不正です: {BuildGitFailureReason(validateResult)}", false);
                        return;
                    }

                    var syncRoot = GetBranchChangeSyncRoot(repositoryPath);
                    var createResult = await GitService.RunAsync(
                        syncRoot ?? repositoryPath,
                        ["checkout", "-b", newBranchName]);
                    if (!createResult.IsSuccess)
                    {
                        ReportResult($"ブランチ作成に失敗しました: {BuildGitFailureReason(createResult)}", false);
                        return;
                    }

                    await NotifyBranchChangedForSyncAsync(repositoryPath, syncRoot);
                    _branchNewName = string.Empty;
                    await LoadBranchesAsync(showNotificationOnFailure: false, preserveSelection: false);
                    await RefreshBranchGitStatusAsync(repositoryPath);
                    ReportResult($"ブランチを作成して切り替えました: {newBranchName}", true);
                }
                catch (Exception ex)
                {
                    ReportResult($"ブランチ作成に失敗しました: {ex.Message}", false);
                }
                finally
                {
                    _isBranchCreating = false;
                }
            });
    }

    private string? GetBranchChangeSyncRoot(string repositoryPath) =>
        _usesSavedSyncCadence ? ResolveGitRepositoryIdentity(repositoryPath).Root : null;

    private async Task NotifyBranchChangedForSyncAsync(string repositoryPath, string? originalRoot)
    {
        if (originalRoot is null || !HasSameGitRoot(originalRoot, GetBranchChangeSyncRoot(repositoryPath))) return;

        try
        {
            await SyncOrchestrator.NotifyRepositoryBranchChangedAsync(originalRoot, _stateRefreshCts.Token);
            ClearRecoveredNotification(nameof(NotifyBranchChangedForSyncAsync), originalRoot);
        }
        catch (OperationCanceledException) when (_stateRefreshCts.IsCancellationRequested)
        {
        }
        catch (Exception)
        {
            SetNotification("ブランチは切り替わりましたが、自動同期の再確認を予約できませんでした。",
                false, summary: "同期の再確認エラー", targetId: originalRoot,
                operation: nameof(NotifyBranchChangedForSyncAsync));
        }
    }

    private async Task<bool> LoadBranchesAsync(bool showNotificationOnFailure, bool preserveSelection, bool fetchRemote = false)
    {
        var repositoryPath = GetBranchRepositoryPath();
        if (repositoryPath is null)
        {
            ResetBranchOperations(clearNewBranchName: false);
            return false;
        }

        _isBranchLoading = true;
        var loadVersion = ++_branchLoadVersion;
        bool IsCurrentLoad() => loadVersion == _branchLoadVersion;
        var operation = fetchRemote ? nameof(ReloadBranchesAsync) : nameof(LoadBranchesAsync);
        void ReportFailure(string message)
        {
            if (showNotificationOnFailure)
            {
                SetNotification(message, false, summary: "ブランチ読込エラー", targetId: repositoryPath, operation: operation);
            }
        }

        try
        {
            var gitCheck = await GitService.RunAsync(repositoryPath, ["rev-parse", "--is-inside-work-tree"]);
            if (!IsCurrentLoad()) return false;
            if (!gitCheck.IsSuccess)
            {
                ReportFailure($"ブランチ一覧取得に失敗しました: {BuildGitFailureReason(gitCheck)}");
                ResetBranchOperations(clearNewBranchName: false);
                return false;
            }

            var remoteUpdateSucceeded = true;
            if (fetchRemote)
            {
                var fetchResult = await GitService.RunAsync(repositoryPath, ["fetch", "--all", "--prune"]);
                if (!IsCurrentLoad()) return false;
                remoteUpdateSucceeded = fetchResult.IsSuccess;
                if (!remoteUpdateSucceeded)
                {
                    ReportFailure($"リモートブランチの更新に失敗しました。以前の情報を表示します: {BuildGitFailureReason(fetchResult)}");
                }
            }

            var currentBranchResult = await GitService.RunAsync(repositoryPath, ["branch", "--show-current"]);
            if (!IsCurrentLoad()) return false;
            if (!currentBranchResult.IsSuccess)
            {
                ReportFailure($"現在ブランチ取得に失敗しました: {BuildGitFailureReason(currentBranchResult)}");
                ResetBranchOperations(clearNewBranchName: false);
                return false;
            }

            var localBranchesResult = await GitService.RunAsync(
                repositoryPath,
                ["for-each-ref", "--format=%(refname:short)", "refs/heads"]);
            if (!IsCurrentLoad()) return false;
            if (!localBranchesResult.IsSuccess)
            {
                ReportFailure($"ブランチ一覧取得に失敗しました: {BuildGitFailureReason(localBranchesResult)}");
                ResetBranchOperations(clearNewBranchName: false);
                return false;
            }

            var remoteBranchesResult = await GitService.RunAsync(
                repositoryPath,
                ["for-each-ref", "--format=%(refname:short)", "refs/remotes"]);
            if (!IsCurrentLoad()) return false;
            if (!remoteBranchesResult.IsSuccess)
            {
                ReportFailure($"リモートブランチ一覧取得に失敗しました: {BuildGitFailureReason(remoteBranchesResult)}");
                ResetBranchOperations(clearNewBranchName: false);
                return false;
            }

            var remoteNamesResult = await GitService.RunAsync(repositoryPath, ["remote"]);
            if (!IsCurrentLoad()) return false;
            if (!remoteNamesResult.IsSuccess)
            {
                ReportFailure($"リモート名一覧取得に失敗しました: {BuildGitFailureReason(remoteNamesResult)}");
                ResetBranchOperations(clearNewBranchName: false);
                return false;
            }

            if (!string.Equals(repositoryPath, GetBranchRepositoryPath(), StringComparison.OrdinalIgnoreCase))
            {
                return false;
            }

            var currentBranch = NormalizeBranchName(FirstNonEmptyLine(currentBranchResult.StandardOutput));
            var previousSelectedBranch = NormalizeBranchName(_branchSelection);
            var localBranchNames = localBranchesResult.StandardOutput
                .Split(['\r', '\n'], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                .Where(static name => !string.IsNullOrWhiteSpace(name))
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .OrderBy(static name => name, StringComparer.OrdinalIgnoreCase)
                .ToList();
            var branchNames = localBranchNames.ToList();
            if (!string.IsNullOrWhiteSpace(currentBranch)
                && branchNames.All(name => !string.Equals(name, currentBranch, StringComparison.OrdinalIgnoreCase)))
            {
                branchNames.Insert(0, currentBranch);
            }
            else if (!string.IsNullOrWhiteSpace(currentBranch))
            {
                branchNames = branchNames
                    .OrderBy(name => string.Equals(name, currentBranch, StringComparison.OrdinalIgnoreCase) ? 0 : 1)
                    .ThenBy(static name => name, StringComparer.OrdinalIgnoreCase)
                    .ToList();
            }

            var remoteNames = remoteNamesResult.StandardOutput
                .Split(['\r', '\n'], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                .Where(static name => !string.IsNullOrWhiteSpace(name))
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .OrderByDescending(static name => name.Length)
                .ThenBy(static name => name, StringComparer.OrdinalIgnoreCase)
                .ToList();
            var remoteBranchNames = remoteBranchesResult.StandardOutput
                .Split(['\r', '\n'], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                .Where(static name => !string.IsNullOrWhiteSpace(name))
                .Where(name => !IsRemoteHeadSymbolicRef(name, remoteNames))
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .OrderBy(static name => name, StringComparer.OrdinalIgnoreCase)
                .ToList();
            var remoteBranchLocalNames = remoteBranchNames
                .Select(remoteBranch => new
                {
                    RemoteBranch = remoteBranch,
                    LocalBranch = ExtractLocalBranchNameFromRemote(remoteBranch, remoteNames)
                })
                .Where(static x => !string.IsNullOrWhiteSpace(x.LocalBranch))
                .ToDictionary(
                    static x => x.RemoteBranch,
                    static x => x.LocalBranch!,
                    StringComparer.OrdinalIgnoreCase);
            var displayedLocalBranchNames = new HashSet<string>(branchNames, StringComparer.OrdinalIgnoreCase);
            var remoteOnlyBranchNames = remoteBranchNames
                .Where(remoteBranch =>
                {
                    return remoteBranchLocalNames.TryGetValue(remoteBranch, out var localBranchName)
                        && !displayedLocalBranchNames.Contains(remoteBranch)
                        && !displayedLocalBranchNames.Contains(localBranchName);
                })
                .ToList();

            _branches.Clear();
            _branches.AddRange(branchNames);
            _branches.AddRange(remoteOnlyBranchNames);
            _localBranches.Clear();
            foreach (var branchName in localBranchNames)
            {
                _localBranches.Add(branchName);
            }

            if (!string.IsNullOrWhiteSpace(currentBranch))
            {
                _localBranches.Add(currentBranch);
            }

            _remoteBranches.Clear();
            _remoteBranchLocalNames.Clear();
            foreach (var remoteBranchName in remoteOnlyBranchNames)
            {
                _remoteBranches.Add(remoteBranchName);
                _remoteBranchLocalNames[remoteBranchName] = remoteBranchLocalNames[remoteBranchName];
            }

            _branchCurrent = currentBranch;

            if (preserveSelection
                && !string.IsNullOrWhiteSpace(previousSelectedBranch)
                && _branches.Any(name => string.Equals(name, previousSelectedBranch, StringComparison.OrdinalIgnoreCase)))
            {
                _branchSelection = previousSelectedBranch;
            }
            else if (!string.IsNullOrWhiteSpace(currentBranch))
            {
                _branchSelection = currentBranch;
            }
            else
            {
                _branchSelection = _branches.FirstOrDefault();
            }

            if (remoteUpdateSucceeded)
            {
                ClearRecoveredNotification(operation, repositoryPath);
                if (fetchRemote)
                {
                    ClearRecoveredNotification(nameof(LoadBranchesAsync), repositoryPath);
                }
            }

            return remoteUpdateSucceeded;
        }
        catch (Exception ex)
        {
            if (!IsCurrentLoad()) return false;
            ReportFailure($"ブランチ一覧取得に失敗しました: {ex.Message}");
            ResetBranchOperations(clearNewBranchName: false);
            return false;
        }
        finally
        {
            if (IsCurrentLoad()) _isBranchLoading = false;
        }
    }

    private static string? NormalizeBranchName(string? branchName)
    {
        return string.IsNullOrWhiteSpace(branchName)
            ? null
            : branchName.Trim();
    }

    private string GetBranchOptionLabel(string branchName)
    {
        return _remoteBranches.Contains(branchName)
            ? $"{branchName} (remote)"
            : branchName;
    }

    private static string? ExtractLocalBranchNameFromRemote(string remoteBranchName, IReadOnlyList<string> remoteNames)
    {
        var normalized = NormalizeBranchName(remoteBranchName);
        if (string.IsNullOrWhiteSpace(normalized)
            || remoteNames is null
            || remoteNames.Count == 0)
        {
            return null;
        }

        foreach (var remoteName in remoteNames)
        {
            var normalizedRemoteName = NormalizeBranchName(remoteName);
            if (string.IsNullOrWhiteSpace(normalizedRemoteName))
            {
                continue;
            }

            var prefix = $"{normalizedRemoteName}/";
            if (!normalized.StartsWith(prefix, StringComparison.Ordinal))
            {
                continue;
            }

            if (normalized.Length <= prefix.Length)
            {
                return null;
            }

            return normalized[prefix.Length..];
        }

        return null;
    }

    private static bool IsRemoteHeadSymbolicRef(string remoteBranchName, IReadOnlyList<string> remoteNames)
    {
        var normalizedBranch = NormalizeBranchName(remoteBranchName);
        if (string.IsNullOrWhiteSpace(normalizedBranch)
            || remoteNames is null
            || remoteNames.Count == 0)
        {
            return false;
        }

        foreach (var remoteName in remoteNames)
        {
            var normalizedRemoteName = NormalizeBranchName(remoteName);
            if (string.IsNullOrWhiteSpace(normalizedRemoteName))
            {
                continue;
            }

            if (string.Equals(normalizedBranch, $"{normalizedRemoteName}/HEAD", StringComparison.Ordinal))
            {
                return true;
            }
        }

        return false;
    }

    private static string BuildGitFailureReason(GitCommandResult result)
