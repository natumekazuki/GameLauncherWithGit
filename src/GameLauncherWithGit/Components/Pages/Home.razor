    private async Task DeleteGameAsync()
    {
        if (_isDeleting)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(_deleteTargetGameId))
        {
            SetNotification("削除対象が不正です。", false, summary: "登録削除エラー");
            return;
        }

        await RunWithUserOperationLoadingAsync(
            "ゲームを削除しています...",
            async () =>
            {
                _isDeleting = true;
                var targetGameId = _deleteTargetGameId;
                var targetTitle = _deleteTargetGameTitle;
                var registrationDeleted = false;
                try
                {
                    var deleted = await GameLibraryService.DeleteAsync(targetGameId);
                    if (!deleted)
                    {
                        SetNotification("削除対象のゲームが見つかりません。", false, summary: "登録削除エラー", targetId: targetGameId);
                        return;
                    }
                    registrationDeleted = true;

                    if (_isEditorOpen
                        && !string.IsNullOrWhiteSpace(_editingGameId)
                        && string.Equals(_editingGameId, targetGameId, StringComparison.OrdinalIgnoreCase))
                    {
                        CloseEditor(force: true);
                    }

                    CloseDeleteConfirm(force: true);
                    if (string.Equals(_selectedGameId, targetGameId, StringComparison.OrdinalIgnoreCase))
                    {
                        _selectedGameId = null;
                    }
                    _focusLibraryRegion = true;
                    if (_games is not null)
                    {
                        _games = _games.Where(game => !string.Equals(game.Id, targetGameId, StringComparison.OrdinalIgnoreCase)).ToArray();
                        _pinButtons.Remove(targetGameId);
                    }
                    OnGitRegistrationsCommitted();

                    var removalError = TryRefreshRepositoryWatchers(removeOnly: true);
                    var reloadError = await ReloadGamesAsync()
                        ? TryRefreshRepositoryWatchers()
                        : AppendError("一覧の再読込に失敗しました。", removalError);
                    SetNotification(reloadError is null
                        ? $"ゲーム登録を削除しました: {targetTitle}"
                        : $"「{targetTitle}」の登録は削除しました。{reloadError}", reloadError is null,
                        summary: reloadError is null ? "登録削除" : "削除済み・更新エラー", targetId: targetGameId);
                }
                catch (Exception ex)
                {
                    SetNotification(registrationDeleted
                        ? $"「{targetTitle}」の登録は削除しました。削除後の更新に失敗しました: {ex.Message}"
                        : $"ゲーム削除に失敗しました: {ex.Message}", false,
                        summary: registrationDeleted ? "削除済み・更新エラー" : "登録削除エラー", targetId: targetGameId);
                }
                finally
                {
                    _isDeleting = false;
                }
            });
    }

    private string GetEditorDraft()
    {
        return System.Text.Json.JsonSerializer.Serialize(new
        {
            _editorTitle,
            _editorExecutablePath,
            _editorRepositoryPath,
            _editorThumbnailSourcePath,
            _editorClearThumbnail,
            SaveLinks = _editorSaveLinks.Select(static entry => new
            {
                entry.Id,
                entry.LocalPath,
                entry.TargetPath,
                entry.EnsureOnLaunch
            })
        });
    }

    private bool HasEditorChanges() => _editorSnapshot != GetEditorDraft() || (_isEditMode && _capturePreference?.HasChanges is true);

    private void RequestCloseEditor()
    {
        if (IsEditorOperationBusy)
        {
            return;
        }

        if (HasEditorChanges())
        {
            _discardChanges = DraftKind.Game;
            return;
        }

        CloseEditor();
    }

    private void CloseEditor(bool force = false)
    {
        if (IsEditorOperationBusy && !force)
        {
            return;
        }

        _isEditorOpen = false;
    }

    private enum DraftKind { Game, Settings }

    private bool IsEditorOperationBusy =>
        _isSaving || _isEditorPickingPath;

    private async Task SaveEditorAsync()
    {
        if (!_isEditorOpen || IsEditorOperationBusy || _isDeleteConfirmOpen || _discardChanges is not null) return;
        var shouldCloseEditor = false;
        var draftTargetId = _editingGameId;

        if (string.IsNullOrWhiteSpace(_editorTitle))
        {
            SetNotification("タイトルは必須です。", false, summary: "タイトル未入力", targetId: draftTargetId);
            return;
        }

        var input = new GameEditInput(
            Title: _editorTitle,
            ExecutablePath: _editorExecutablePath,
            RelatedRepositoryPath: _editorRepositoryPath,
            ThumbnailSourcePath: _editorThumbnailSourcePath,
            ClearThumbnail: _editorClearThumbnail);

        await RunWithUserOperationLoadingAsync(
            "ゲーム設定を保存しています...",
            async () =>
            {
                _isSaving = true;
                string? savedTitle = null;
                try
                {
                    var saveLinkInputs = BuildEditorSaveLinkInputs();
                    if (_isEditMode)
                    {
                        if (string.IsNullOrWhiteSpace(_editingGameId))
                        {
                            SetNotification("編集対象が不正です。", false, summary: "編集保存エラー", targetId: draftTargetId);
                            return;
                        }

                        if (!HasLoadedSaveLinks(_editingGameId))
                        {
                            SetNotification(
                                "セーブリンクを読み込めないため保存できません。ゲーム一覧を再読込してから編集してください。",
                                false, summary: "リンク読込エラー", targetId: draftTargetId);
                            return;
                        }

                        var updated = await GameLibraryService.UpdateWithSaveLinksAsync(_editingGameId, input, saveLinkInputs);
                        if (updated is null)
                        {
                            SetNotification("編集対象のゲームが見つかりません。", false, summary: "編集保存エラー", targetId: draftTargetId);
                            return;
                        }

                        _games = (_games ?? []).Select(game => game.Id == updated.Id ? updated : game).ToArray();
                        OnGitRegistrationsCommitted();
                        savedTitle = updated.Title;
                        _editorSavedTitle = updated.Title;
                        _editorTitle = updated.Title;
                        _editorHasThumbnail = HasThumbnail(updated);
                        _editorThumbnailSourcePath = null;
                        _editorClearThumbnail = false;
                        _editorSnapshot = GetEditorDraft();
                        if (_capturePreference is not null)
                        {
                            try
                            {
                                await _capturePreference.SaveAsync();
                                // Refresh the selected work's read-only summary after the editor commits its draft.
                                if (_selectedGameId == updated.Id)
                                {
                                    await LoadSelectedCapturePreferenceAsync(updated.Id);
                                }
                            }
                            catch (Exception ex)
                            {
                                var refreshError = await ReloadGamesAsync()
                                    ? TryRefreshRepositoryWatchers()
                                    : "一覧の再読込に失敗しました。";
                                SetNotification(AppendError(
                                    $"ゲーム設定は保存しました。シナリオ抽出設定は保存できませんでした。開き直して確認してください: {ex.Message}",
                                    refreshError), false, summary: "保存済み・抽出設定エラー");
                                return;
                            }
                        }
                    }
                    else
                    {
                        var created = await GameLibraryService.CreateWithSaveLinksAsync(input, saveLinkInputs);
                        _games = (_games ?? []).Append(created).ToArray();
                        OnGitRegistrationsCommitted();
                        savedTitle = created.Title;
                    }

                    shouldCloseEditor = true;
                    if (await ReloadGamesAsync())
                    {
                        RefreshRepositoryWatchers();
                        SetNotification($"{(_isEditMode ? "ゲーム設定を更新しました" : "ゲームを登録しました")}: {savedTitle}", true,
                            summary: _isEditMode ? "編集保存" : "ゲーム登録", targetId: draftTargetId);
                    }
                    else
                    {
                        _focusLibraryRegion = true;
                        SetNotification($"「{savedTitle}」は保存しました。一覧の再読込に失敗しました。", false,
                            summary: "保存済み・一覧エラー", operation: nameof(RetryLibraryAsync));
                    }
                }
                catch (Exception ex)
                {
                    SetNotification(savedTitle is null
                        ? $"保存に失敗しました: {ex.Message}"
                        : $"「{savedTitle}」は保存しました。監視の更新に失敗しました: {ex.Message}", false,
                        summary: savedTitle is null ? (_isEditMode ? "編集保存エラー" : "登録エラー") : "保存済み・監視エラー",
                        targetId: savedTitle is null ? draftTargetId : null,
                        operation: savedTitle is null ? nameof(SaveEditorAsync) : nameof(RetryLibraryAsync));
                }
                finally
                {
                    _isSaving = false;
                    if (shouldCloseEditor)
                    {
                        CloseEditor(force: true);
                    }
                }
            });
    }

