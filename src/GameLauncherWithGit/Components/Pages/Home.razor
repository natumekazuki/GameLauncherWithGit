@page "/"
@inject IGameLibraryService GameLibraryService
@inject ILauncherService LauncherService
@inject IPathPickerService PathPickerService

<PageTitle>ゲーム一覧</PageTitle>

<section class="library-page">
    <header class="library-header">
        <h1>ゲーム一覧</h1>
        <p>ゲーム起動時に関連リポジトリの同期を実行します。</p>
    </header>

    <div class="game-grid">
        <button type="button" class="game-card add-card" @onclick="OpenCreateEditor">
            <span class="add-icon">+</span>
            <span class="add-label">新規追加</span>
        </button>

        @if (_games is null)
        {
            <div class="game-card loading-card">読み込み中...</div>
        }
        else
        {
            @foreach (var game in _games)
            {
                <article class="game-card">
                    <div class="game-card-header">
                        <h2>@game.Title</h2>
                        <span class="status-badge @GetStatusClass(game.Status)">@GetStatusLabel(game.Status)</span>
                    </div>

                    <div class="game-card-body">
                        <p class="meta-label">実行ファイル</p>
                        <p class="meta-value">@game.ExecutablePath</p>
                        <p class="meta-label">関連リポジトリ</p>
                        @if (game.RelatedRepositoryPaths.Count == 0)
                        {
                            <p class="meta-value">未設定</p>
                        }
                        else
                        {
                            <ul class="repo-list">
                                @foreach (var repositoryPath in game.RelatedRepositoryPaths)
                                {
                                    <li>@repositoryPath</li>
                                }
                            </ul>
                        }
                        <p class="meta-label">最終プレイ</p>
                        <p class="meta-value">@FormatLastPlayed(game.LastPlayedAt)</p>
                    </div>

                    <div class="game-card-actions">
                        <button type="button" class="launch-button" @onclick="() => LaunchAsync(game.Id)">▶ 起動</button>
                        <button type="button" class="secondary-button" @onclick="() => OpenEditEditor(game)">設定</button>
                    </div>
                </article>
            }
        }
    </div>

    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <p class="action-message @GetMessageClass()">@_message</p>
    }
</section>

@if (_isEditorOpen)
{
    <div class="editor-overlay" @onclick="() => CloseEditor()">
        <section class="editor-modal" @onclick:stopPropagation="true">
            <h2>@(_isEditMode ? "ゲーム編集" : "ゲーム追加")</h2>

            <div class="editor-field">
                <label for="editor-title">タイトル</label>
                <input id="editor-title" @bind="_editorTitle" @bind:event="oninput" />
            </div>

            <div class="editor-field">
                <label for="editor-executable-path">実行ファイルパス</label>
                <div class="editor-inline-input">
                    <input id="editor-executable-path" @bind="_editorExecutablePath" @bind:event="oninput" />
                    <button type="button" class="secondary-button picker-button" @onclick="PickExecutablePathAsync" disabled="_isSaving">
                        参照
                    </button>
                </div>
            </div>

            <div class="editor-field">
                <label>関連リポジトリ</label>
                @if (_editorRepositoryPaths.Count == 0)
                {
                    <p class="repo-editor-empty">関連リポジトリが未設定です。</p>
                }
                else
                {
                    <ul class="repo-editor-list">
                        @for (var index = 0; index < _editorRepositoryPaths.Count; index++)
                        {
                            var currentIndex = index;
                            <li class="repo-editor-item">
                                <span class="repo-editor-path">@_editorRepositoryPaths[currentIndex]</span>
                                <div class="repo-editor-item-actions">
                                    <button type="button"
                                            class="secondary-button repo-op-button"
                                            @onclick="() => MoveRepositoryPathUp(currentIndex)"
                                            disabled="_isSaving || currentIndex == 0">
                                        ↑
                                    </button>
                                    <button type="button"
                                            class="secondary-button repo-op-button"
                                            @onclick="() => MoveRepositoryPathDown(currentIndex)"
                                            disabled="_isSaving || currentIndex == _editorRepositoryPaths.Count - 1">
                                        ↓
                                    </button>
                                    <button type="button"
                                            class="secondary-button repo-op-button repo-remove-button"
                                            @onclick="() => RemoveRepositoryPath(currentIndex)"
                                            disabled="_isSaving">
                                        削除
                                    </button>
                                </div>
                            </li>
                        }
                    </ul>
                }

                <div class="editor-repo-actions">
                    <button type="button"
                            class="secondary-button picker-button"
                            @onclick="PickRepositoryDirectoryPathAsync"
                            disabled="_isSaving">
                        フォルダ追加
                    </button>
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(_editorError))
            {
                <p class="editor-error">@_editorError</p>
            }

            <div class="editor-actions">
                <button type="button" class="launch-button" @onclick="SaveEditorAsync" disabled="_isSaving">
                    @(_isSaving ? "保存中..." : "保存")
                </button>
                <button type="button" class="secondary-button" @onclick="() => CloseEditor()" disabled="_isSaving">キャンセル</button>
            </div>
        </section>
    </div>
}

@code {
    private IReadOnlyList<GameCardItem>? _games;
    private string? _message;
    private bool? _isLastActionSuccess;
    private bool _isEditorOpen;
    private bool _isEditMode;
    private bool _isSaving;
    private string? _editingGameId;
    private string _editorTitle = string.Empty;
    private string _editorExecutablePath = string.Empty;
    private List<string> _editorRepositoryPaths = [];
    private string? _editorError;

    protected override async Task OnInitializedAsync()
    {
        await ReloadGamesAsync();
    }

    private async Task LaunchAsync(string gameId)
    {
        _message = "起動前同期を実行中です...";
        _isLastActionSuccess = null;
        StateHasChanged();

        var result = await LauncherService.LaunchAsync(gameId);
        await ReloadGamesAsync();
        _message = result.Message;
        _isLastActionSuccess = result.IsSuccess;
    }

    private void OpenCreateEditor()
    {
        _isEditMode = false;
        _editingGameId = null;
        _editorTitle = string.Empty;
        _editorExecutablePath = string.Empty;
        _editorRepositoryPaths = [];
        _editorError = null;
        _isEditorOpen = true;
    }

    private void OpenEditEditor(GameCardItem game)
    {
        _isEditMode = true;
        _editingGameId = game.Id;
        _editorTitle = game.Title;
        _editorExecutablePath = game.ExecutablePath;
        _editorRepositoryPaths = game.RelatedRepositoryPaths.ToList();
        _editorError = null;
        _isEditorOpen = true;
    }

    private void CloseEditor(bool force = false)
    {
        if (_isSaving && !force)
        {
            return;
        }

        _isEditorOpen = false;
        _editorError = null;
    }

    private async Task SaveEditorAsync()
    {
        var shouldCloseEditor = false;
        _editorError = null;

        if (string.IsNullOrWhiteSpace(_editorTitle))
        {
            _editorError = "タイトルは必須です。";
            return;
        }

        if (string.IsNullOrWhiteSpace(_editorExecutablePath))
        {
            _editorError = "実行ファイルパスは必須です。";
            return;
        }

        var input = new GameEditInput(
            Title: _editorTitle,
            ExecutablePath: _editorExecutablePath,
            RelatedRepositoryPaths: _editorRepositoryPaths);

        _isSaving = true;
        try
        {
            if (_isEditMode)
            {
                if (string.IsNullOrWhiteSpace(_editingGameId))
                {
                    _editorError = "編集対象が不正です。";
                    return;
                }

                var updated = await GameLibraryService.UpdateAsync(_editingGameId, input);
                if (updated is null)
                {
                    _editorError = "編集対象のゲームが見つかりません。";
                    return;
                }

                _message = $"ゲーム設定を更新しました: {updated.Title}";
            }
            else
            {
                var created = await GameLibraryService.CreateAsync(input);
                _message = $"ゲームを登録しました: {created.Title}";
            }

            _isLastActionSuccess = true;
            await ReloadGamesAsync();
            shouldCloseEditor = true;
        }
        catch (Exception ex)
        {
            _isLastActionSuccess = false;
            _editorError = ex.Message;
            _message = "保存に失敗しました。";
        }
        finally
        {
            _isSaving = false;
            if (shouldCloseEditor)
            {
                CloseEditor(force: true);
            }
        }
    }

    private async Task PickExecutablePathAsync()
    {
        var selectedPath = await PathPickerService.PickExecutablePathAsync();
        if (!string.IsNullOrWhiteSpace(selectedPath))
        {
            _editorExecutablePath = selectedPath;
        }
    }

    private async Task PickRepositoryDirectoryPathAsync()
    {
        var selectedPath = await PathPickerService.PickRepositoryDirectoryPathAsync();
        if (string.IsNullOrWhiteSpace(selectedPath))
        {
            return;
        }

        if (_editorRepositoryPaths.Any(existing => string.Equals(existing, selectedPath, StringComparison.OrdinalIgnoreCase)))
        {
            return;
        }

        _editorRepositoryPaths.Add(selectedPath);
    }

    private void RemoveRepositoryPath(int index)
    {
        if (index < 0 || index >= _editorRepositoryPaths.Count)
        {
            return;
        }

        _editorRepositoryPaths.RemoveAt(index);
    }

    private void MoveRepositoryPathUp(int index)
    {
        if (index <= 0 || index >= _editorRepositoryPaths.Count)
        {
            return;
        }

        (_editorRepositoryPaths[index - 1], _editorRepositoryPaths[index]) =
            (_editorRepositoryPaths[index], _editorRepositoryPaths[index - 1]);
    }

    private void MoveRepositoryPathDown(int index)
    {
        if (index < 0 || index >= _editorRepositoryPaths.Count - 1)
        {
            return;
        }

        (_editorRepositoryPaths[index], _editorRepositoryPaths[index + 1]) =
            (_editorRepositoryPaths[index + 1], _editorRepositoryPaths[index]);
    }

    private async Task ReloadGamesAsync()
    {
        _games = await GameLibraryService.GetGamesAsync();
    }

    private static string FormatLastPlayed(DateTimeOffset? value)
    {
        return value?.LocalDateTime.ToString("yyyy-MM-dd HH:mm") ?? "未プレイ";
    }

    private static string GetStatusLabel(GameCardStatus status)
    {
        return status switch
        {
            GameCardStatus.Syncing => "同期中",
            GameCardStatus.Synced => "同期OK",
            GameCardStatus.Error => "エラー",
            _ => "未同期"
        };
    }

    private static string GetStatusClass(GameCardStatus status)
    {
        return status switch
        {
            GameCardStatus.Syncing => "status-syncing",
            GameCardStatus.Synced => "status-synced",
            GameCardStatus.Error => "status-error",
            _ => "status-unknown"
        };
    }

    private string GetMessageClass()
    {
        return _isLastActionSuccess switch
        {
            true => "action-message-success",
            false => "action-message-error",
            _ => string.Empty
        };
    }
}
