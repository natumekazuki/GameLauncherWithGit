                                    <p class="save-link-item-label">同期先フォルダ</p>
                                    <p class="save-link-item-value">@GetEditorSaveLinkPathLabel(entry.TargetPath)</p>
                                    <label class="save-link-item-checkbox">
                                        <input type="checkbox"
