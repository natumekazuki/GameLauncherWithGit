@page "/"
@implements IDisposable
@using System.Runtime.CompilerServices
@using GameLauncherWithGit.Application.Services
@inject IGameLibraryService GameLibraryService
@inject ILauncherService LauncherService
@inject IPathPickerService PathPickerService
@inject IGitService GitService
@inject IAutoStartService AutoStartService
@inject IAppSettingsService AppSettingsService
@inject ILogAccessService LogAccessService
@inject IRepositoryWatcherService RepositoryWatcherService
@inject ISyncOrchestrator SyncOrchestrator
@inject IRepositoryStateStore RepositoryStateStore
@inject ISettingsPanelService SettingsPanelService
@inject ISaveLinkService SaveLinkService
@inject IScenarioCaptureStore CaptureStore
@inject ScenarioCaptureService CaptureService
@inject IJSRuntime JS
@inject NavigationManager Navigation

<PageTitle>GameLauncherWithGit</PageTitle>

@{
    var capture = _games is null ? new CaptureSnapshot() : CaptureService.Snapshot;
    RenderFragment notificationContent = @<div class="home-feedback">
        @if (_notification is { } feedback)
        {
            <button type="button" class="home-feedback-trigger @(feedback.IsSuccess == false ? "home-feedback-error" : null)"
                    aria-haspopup="dialog" aria-label="@($"{feedback.Summary}の詳細")"
                    @onclick="() => OpenResultDetails(feedback.Summary, feedback.Message)">@feedback.Summary</button>
        }
        else if (IsUserOperationLoading)
        {
            <span class="home-feedback-trigger" aria-hidden="true">処理中</span>
        }
    </div>;
}

<header class="home-header">
    <section class="utility-bar" aria-label="ゲーム一覧の操作">
        <div class="search-control">
            <input type="search"
                   class="search-input"
                   @bind="_gameSearchText"
                   @bind:event="oninput"
                   placeholder="ゲームを検索"
                   aria-label="ゲーム検索" />
        </div>
        <div class="card-size-control" role="group" aria-label="カードサイズ">
            <button type="button"
                    class="secondary-button utility-icon-button"
                    title="カードサイズを小さくする"
                    aria-label="カードサイズを小さくする"
                    @onclick="DecreaseGameCardSizeAsync"
                    disabled="@(_isStartupChecking || !_isGitReady || _isCardSizeSaving || _gameCardSizePercent <= AppSettings.GameCardSizePercentMin)">
                <span aria-hidden="true">−</span>
            </button>
            <output class="card-size-label">@_gameCardSizePercent%</output>
            <button type="button"
                    class="secondary-button utility-icon-button"
                    title="カードサイズを大きくする"
                    aria-label="カードサイズを大きくする"
                    @onclick="IncreaseGameCardSizeAsync"
                    disabled="@(_isStartupChecking || !_isGitReady || _isCardSizeSaving || _gameCardSizePercent >= AppSettings.GameCardSizePercentMax)">
                <CaptureIcon Name="Plus" />
            </button>
        </div>
        <button type="button"
                class="launch-button home-labeled-action"
                @onclick="OpenCreateEditor"
                disabled="@(_isStartupChecking || !_isGitReady || _games is null || _libraryLoadError is not null)">
            <CaptureIcon Name="Plus" /> ゲーム追加
        </button>
    </section>
    @if (HasFeedback && !_isHelpOpen && !_isSettingsOpen && !_isDeleteConfirmOpen && !_isEditorOpen && GetSelectedGame() is null)
    {
        @notificationContent
    }
    <nav class="home-navigation" aria-label="ランチャー">
        <button type="button" id="home-settings-button" class="secondary-button utility-icon-button" title="設定" aria-label="設定" @onclick="OpenSettingsAsync" disabled="@(_isStartupChecking || _isCardSizeSaving)"><CaptureIcon Name="Settings" /></button>
        <button type="button" class="secondary-button utility-icon-button" title="ヘルプ" aria-label="ヘルプ" @onclick="OpenHelp"><span aria-hidden="true" class="home-help-icon">?</span></button>
    </nav>
</header>

<section class="library-page" aria-label="ゲーム一覧" tabindex="-1" @ref="_libraryRegion">
    @if (_isStartupChecking || (_isGitReady && _games is null && _libraryLoadError is null))
    {
        <div class="library-loading">
            <ScenarioLoading Label="ゲーム一覧を読み込み中" ShowLabel="false" />
        </div>
    }
    else if (!_isGitReady)
    {
        <section class="startup-error-panel">
            <div role="alert"><h2>Git が利用できません</h2></div>
            <button type="button" class="secondary-button home-labeled-action" @onclick="RetryStartupAsync"><CaptureIcon Name="Refresh" /> 再試行</button>
            <button type="button" class="secondary-button home-labeled-action" aria-haspopup="dialog" aria-label="Git起動エラーの詳細"
                    @onclick='() => OpenResultDetails("Git起動エラー", $"{_startupError} Gitの設定を確認して、再試行してください。")'>詳細</button>
        </section>
    }
    else if (_libraryLoadError is not null)
    {
        <section class="startup-error-panel">
            <div role="alert"><h2>ゲーム一覧を読み込めません</h2></div>
            <button type="button" class="secondary-button home-labeled-action" @onclick="RetryLibraryAsync" disabled="@_isLibraryRetrying"><CaptureIcon Name="Refresh" /> 再試行</button>
            <button type="button" class="secondary-button home-labeled-action" aria-haspopup="dialog" aria-label="一覧エラーの詳細"
                    @onclick='() => OpenResultDetails("一覧エラー", _libraryLoadError)'>詳細</button>
        </section>
    }
    else
    {
        var filteredGames = GetFilteredGames();
        <div class="game-grid" style="@GetGameGridStyle()">
            @if (filteredGames.Count == 0)
            {
                <p role="status">@(_games is { Count: 0 } ? "ゲーム未登録" : "一致するゲームなし")</p>
            }
            else
            {
                @foreach (var game in filteredGames)
                {
                    var canResumeSync = CanResumeRepositorySync(game);
                    var hasThumbnail = HasThumbnail(game);
                    var thumbnail = hasThumbnail ? GetThumbnailSource(game) : null;
                    var hasDisplayImage = thumbnail is { DecodeFailed: false };
                    var problem = GetCardProblem(game, hasThumbnail && !hasDisplayImage);
                    <article @key="game.Id" class="game-card" aria-label="@game.Title">
                        <h2 class="home-card-heading">
                            <button type="button" class="home-card-selection" aria-haspopup="dialog"
                                    data-home-game="@game.Id" aria-label="@($"{game.Title}の詳細")" @onclick="() => OpenGameDetails(game)">
                                <span class="game-thumbnail-panel">
                                    @if (thumbnail is { DecodeFailed: false })
                                    {
                                        <img @key="thumbnail" class="game-thumbnail-image" src="@thumbnail.DataUri" alt=""
                                             @onerror="() => MarkThumbnailDecodeFailed(game.Id, thumbnail)" />
                                    }
                                    else if (hasThumbnail && !_appliedSettings.ShowCardTitle)
                                    {
                                        <span class="home-thumbnail-title">@game.Title</span>
                                    }
                                    else
                                    {
                                        <span class="home-thumbnail-placeholder"><CaptureIcon Name="Image" /></span>
                                    }
                                </span>
                                @if (_appliedSettings.ShowCardTitle || !hasThumbnail)
                                {
                                    <span class="home-card-title">@game.Title</span>
                                }
                            </button>
                        </h2>
                        <div class="game-card-actions" role="group" aria-label="@($"{game.Title}の操作")">
                            <button type="button" class="launch-button action-icon-button"
                                    @onclick="() => LaunchAsync(game)" title="@GetLaunchButtonTitle(game)"
                                    aria-label="@($"{game.Title}：{GetLaunchButtonTitle(game)}")" disabled="@IsLaunchDisabled(game)"
                                    aria-disabled="@(_isLaunching ? "true" : null)">
                                <CaptureIcon Name="Play" />
                            </button>
                            <div class="game-card-status">
                                @if (string.Equals(capture.PlayGameId, game.Id, StringComparison.OrdinalIgnoreCase))
                                {
                                    <span class="home-playing">プレイ中</span>
                                }
                                @if (problem is not null)
                                {
                                    <button type="button" class="secondary-button home-card-problem" aria-haspopup="dialog"
                                            aria-label="@($"{problem}：{game.Title}")" @onclick="() => OpenGameDetails(game, fromProblem: true)">@problem</button>
                                }
                                @if (canResumeSync)
                                {
                                    <button type="button" class="secondary-button home-card-resume" data-home-resume="@game.Id"
                                            @onclick="() => ResumeRepositorySyncAsync(game)"
                                            aria-label="@($"同期を再開：{game.Title}")" aria-disabled="@(IsResumePending(game) ? "true" : null)">同期を再開</button>
                                }
                            </div>
                            <button type="button" class="secondary-button pin-toggle-button @(game.IsPinned ? "pin-toggle-active" : null)"
                                    @ref="_pinButtons[game.Id]"
                                    @onclick="() => TogglePinnedAsync(game)" title="@(game.IsPinned ? "ピン留め解除" : "ピン留め")"
                                    aria-label="@($"{game.Title}：ピン留め")" aria-pressed="@(game.IsPinned ? "true" : "false")"
                                    disabled="@IsPinToggleBusy(game)">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                     stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                                    <path d="M9 3h6l-1 6 4 4v2H6v-2l4-4-1-6Zm3 12v6" />
                                </svg>
                            </button>
                        </div>
                    </article>
                }
            }
        </div>
    }
</section>

<span class="visually-hidden" role="status" aria-atomic="true">@(_operationAnnouncement)</span>

@if (GetSelectedGame() is { } selected)
{
    var gitStatus = GetGitVisualState(selected);
    var repositoryPath = GetConfiguredGitPath(selected);
    var repositoryRoot = GetRegisteredGitIdentity(selected)?.Root;
    var syncStatus = GetEffectiveStatus(selected);
    var paused = CanResumeRepositorySync(selected);
    var showSyncProgressInGitRow = _usesSavedSyncCadence && _appliedSettings.ShowCardSyncStatus && repositoryPath is not null;
    <div class="editor-overlay home-selected-overlay" @onclick="CloseGameDetails">
        <section class="editor-modal" role="dialog" aria-modal="true" aria-labelledby="home-game-title" tabindex="-1" @onclick:stopPropagation="true">
            <div class="dialog-heading home-dialog-heading">
                <h2 id="home-game-title" tabindex="-1" data-dialog-initial>@selected.Title</h2>
                @if (HasFeedback && !_isEditorOpen && !_isDeleteConfirmOpen && !_isSettingsOpen && _branchGame is null)
                {
                    @notificationContent
                }
            </div>
            <div class="dialog-body home-game-details">
                <dl>
                    <dt>Git状態</dt>
                    <dd class="@(showSyncProgressInGitRow ? "home-git-with-sync" : null)">
                        <span>@GetGitCardLabel(gitStatus)</span>
                        @if (showSyncProgressInGitRow)
                        {
                            <span role="status" aria-atomic="true">@(GetRepositorySyncState(selected) is RepositorySyncState.Syncing or RepositorySyncState.Debouncing ? "同期中" : null)</span>
                        }
                    </dd>
                    @if (paused)
                    {
                        <dt>同期状態</dt><dd>同期停止</dd>
                    }
                    else if (syncStatus == GameCardStatus.Error)
                    {
                        <dt>状態</dt><dd>要確認</dd>
                    }
                    else if (gitStatus != GitRepositoryVisualState.NotConfigured && _appliedSettings.ShowCardSyncStatus && !_usesSavedSyncCadence)
                    {
                        <dt>同期状態</dt><dd>@GetStatusLabel(syncStatus)</dd>
                    }
                    <dt>実行ファイル</dt><dd>@GetEditorSaveLinkPathLabel(selected.ExecutablePath)</dd>
                    <dt>関連リポジトリ</dt><dd>@GetEditorSaveLinkPathLabel(selected.RelatedRepositoryPath)</dd>
                    <dt>セーブリンク</dt><dd>@GetSaveLinkSummary(selected)</dd>
                    <dt>最終プレイ</dt><dd>@FormatLastPlayed(selected.LastPlayedAt)</dd>
                    <dt>現在の記録</dt><dd>@GetCurrentRecordingLabel(capture, selected.Id)</dd>
                    <dt>次回起動時に記録</dt>
                    <dd>
                        @if (_selectedCapturePreferenceError is { } preferenceError)
                        {
                            <button type="button" class="secondary-button" aria-haspopup="dialog"
                                    @onclick="() => OpenCapturePreferenceError(preferenceError)">設定を読み込めません</button>
                        }
                        else
                        {
                            @(_selectedCaptureEnabled is { } enabled ? enabled ? "ON" : "OFF" : "確認中…")
                        }
                    </dd>
                </dl>
                @if (HasThumbnail(selected) && GetThumbnailSource(selected) is not { DecodeFailed: false })
                {
                    <p class="home-media-error">画像を読み込めません。編集でサムネイルを選び直してください。</p>
                }
                @if (repositoryPath is not null)
                {
                    <button type="button" class="secondary-button home-labeled-action" aria-haspopup="dialog"
                            @onclick="() => OpenBranchOperationsAsync(selected)">ブランチ操作</button>
                    <button type="button" class="secondary-button home-labeled-action"
                            @onclick="() => RefreshSelectedGitStatusAsync(selected.Id, repositoryPath)"
                            aria-disabled="@(repositoryRoot is not null && IsTargetedGitStatusReadPending(repositoryRoot) ? "true" : null)">Git状態を更新</button>
                }
                @if (_saveLinkLoadFailedGameIds.Contains(selected.Id))
                {
                    <button type="button" class="secondary-button home-labeled-action" @onclick="RetryLibraryAsync" disabled="@_isLibraryRetrying">一覧を再読込</button>
                }
                @if (paused)
                {
                    <button type="button" class="secondary-button home-labeled-action" @onclick="() => ResumeRepositorySyncAsync(selected)"
                            aria-disabled="@(IsResumePending(selected) ? "true" : null)">同期を再開</button>
                }
                @if (repositoryPath is not null || paused || syncStatus == GameCardStatus.Error || gitStatus == GitRepositoryVisualState.Error)
                {
                    <button type="button" class="secondary-button home-labeled-action" @onclick="OpenSettingsLogAsync" disabled="@_isCardSizeSaving">ログ</button>
                }
            </div>
            <div class="editor-actions dialog-footer">
                <button type="button" class="launch-button home-labeled-action" @onclick="() => LaunchAsync(selected)"
                        title="@GetLaunchButtonTitle(selected)" disabled="@IsLaunchDisabled(selected)"
                        aria-disabled="@(_isLaunching ? "true" : null)"><CaptureIcon Name="Play" /> 起動する</button>
                <a class="secondary-button home-labeled-action" href="@GetScenarioUrl(selected.Id)"><CaptureIcon Name="History" /> シナリオを見る</a>
                <button type="button" class="secondary-button" @onclick="() => OpenEditEditor(selected)"
                        disabled="@(!HasLoadedSaveLinks(selected.Id))">ゲーム設定</button>
                <button type="button" class="secondary-button" data-dialog-dismiss @onclick="CloseGameDetails">閉じる</button>
            </div>
        </section>
    </div>
}

@if (_branchGame is { } branchGame)
{
    <div class="editor-overlay home-branch-overlay" @onclick="CloseBranchOperations">
        <section class="editor-modal" role="dialog" aria-modal="true" aria-labelledby="home-branch-title" tabindex="-1" @onclick:stopPropagation="true">
            <div class="dialog-heading home-dialog-heading">
                <h2 id="home-branch-title" tabindex="-1" data-dialog-initial>ブランチ操作（即時反映）：@branchGame.Title</h2>
                @if (HasFeedback && !_isSettingsOpen)
                {
                    @notificationContent
                }
            </div>
            <div class="dialog-body">
                <div class="branch-picker editor-field">
                    <p class="branch-current-value" aria-live="polite">現在: @GetCurrentBranchLabel()</p>
                    <div class="branch-switch-row">
                        <select aria-label="切り替え先のブランチ" @bind="_branchSelection"
                                @bind:event="oninput"
                                disabled="@IsBranchSelectionDisabled()">
                            @if (_branches.Count == 0)
                            {
                                <option value="">ブランチなし</option>
                            }
                            else
                            {
                                @foreach (var branch in _branches)
                                {
                                    <option value="@branch">@GetBranchOptionLabel(branch)</option>
                                }
                            }
                        </select>
                        <button type="button"
                                class="secondary-button picker-button"
                                @onclick="ReloadBranchesAsync"
                                disabled="@IsBranchReloadDisabled()">
                            @(_isBranchLoading ? "取得中..." : "リモート更新")
                        </button>
                        <button type="button"
                                class="secondary-button picker-button"
                                @onclick="SwitchBranchAsync"
                                disabled="@IsBranchSwitchDisabled()">
                            切り替え
                        </button>
                    </div>
                    <div class="branch-create-row">
                        <input aria-label="新規ブランチ名" placeholder="新規ブランチ名"
                               @bind="_branchNewName"
                               @bind:event="oninput"
                               disabled="@IsBranchCreateInputDisabled()" />
                        <button type="button"
                                class="secondary-button picker-button"
                                @onclick="CreateBranchAsync"
                                disabled="@IsBranchCreateDisabled()">
                            作成して切り替え
                        </button>
                    </div>
                    <p class="settings-note">リモートの一覧は前回取得した情報です。</p>
                </div>
            </div>
            <div class="editor-actions dialog-footer">
                <button type="button" class="secondary-button" @onclick="CloseBranchOperations"
                        data-dialog-dismiss disabled="@IsBranchWriting">閉じる</button>
            </div>
        </section>
    </div>
}

@if (_openResult is { } resultDetails)
{
    <div class="editor-overlay home-result-overlay" @onclick="CloseResultDetails">
        <section class="editor-modal home-result-modal" role="dialog" aria-modal="true" aria-labelledby="home-result-title" tabindex="-1" @onclick:stopPropagation="true">
            <h2 id="home-result-title" class="dialog-heading" tabindex="-1" data-dialog-initial>@resultDetails.Summary</h2>
            <div class="dialog-body home-result-body"><p>@resultDetails.Detail</p></div>
            <div class="editor-actions dialog-footer">
                <button type="button" class="secondary-button" data-dialog-dismiss @onclick="CloseResultDetails">閉じる</button>
            </div>
        </section>
    </div>
}

@if (_isHelpOpen)
{
    <div class="editor-overlay help-overlay" @onclick="CloseHelp">
        <section class="help-modal" role="dialog" aria-modal="true" aria-labelledby="help-title" tabindex="-1" @onclick:stopPropagation="true">
            <div class="dialog-heading home-dialog-heading">
                <h2 id="help-title" tabindex="-1" data-dialog-initial>ヘルプ</h2>
                @if (HasFeedback && !_isSettingsOpen && !_isEditorOpen && !_isDeleteConfirmOpen)
                {
                    @notificationContent
                }
            </div>

            <div class="help-section">
                <h3>基本操作</h3>
                <ul>
                    <li><strong>ゲーム追加</strong>：タイトルだけでも登録できます。</li>
                    <li><strong>起動</strong>：起動前に同期を確認します。</li>
                    <li><strong>Git状態を更新</strong>：作品の詳細から、その作品の関連リポジトリの状態を再取得します。同期は実行しません。</li>
                </ul>
            </div>

            <div class="help-section">
                <h3>カードの見方</h3>
                <ul>
                    <li><strong>作品の詳細</strong>：表紙やタイトルから開きます。Git状態、ゲーム設定、ピン留めを確認できます。</li>
                </ul>
            </div>

            <div class="help-section">
                <h3>Git状態の意味</h3>
                <table class="help-git-table">
                    <thead>
                        <tr>
                            <th>状態</th>
                            <th>確認・対応</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>@GetGitCardLabel(GitRepositoryVisualState.Clean)</td>
                            <td>そのまま利用</td>
                        </tr>
                        <tr>
                            <td>@GetGitCardLabel(GitRepositoryVisualState.Dirty)</td>
                            <td>差分を確認してコミット方針を決める</td>
                        </tr>
                        <tr>
                            <td>@GetGitCardLabel(GitRepositoryVisualState.Ahead)</td>
                            <td>手元で保持している追跡ブランチとの差分を確認</td>
                        </tr>
                        <tr>
                            <td>@GetGitCardLabel(GitRepositoryVisualState.Behind)</td>
                            <td>pull して追従</td>
                        </tr>
                        <tr>
                            <td>@GetGitCardLabel(GitRepositoryVisualState.Diverged)</td>
                            <td>履歴を確認して統合方針を決める</td>
                        </tr>
                        <tr>
                            <td>@GetGitCardLabel(GitRepositoryVisualState.Error)</td>
                            <td>設定のログで詳細を確認</td>
                        </tr>
                        <tr>
                            <td>@GetGitCardLabel(GitRepositoryVisualState.NotConfigured)</td>
                            <td>作品の詳細から「ゲーム設定」で設定</td>
                        </tr>
                        <tr>
                            <td>@GetGitCardLabel(GitRepositoryVisualState.Unknown)</td>
                            <td>「Git状態を更新」で再取得</td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <div class="help-section">
                <h3>トラブル時の導線</h3>
                <ul>
                    <li>状態や通知を選ぶと詳細を確認できます。</li>
                    <li>エラーの詳細は <strong>設定 → ログ</strong> で確認</li>
                </ul>
            </div>

            <div class="editor-actions">
                <button type="button"
                        class="secondary-button"
                        @onclick="CloseHelp" data-dialog-dismiss>
                    閉じる
                </button>
            </div>
        </section>
    </div>
}

@if (_isSettingsOpen)
{
    <div class="editor-overlay settings-overlay" @onclick="RequestCloseSettings">
        <section class="settings-modal" role="dialog" aria-modal="true" aria-labelledby="settings-title"
                 data-dialog-return="home-settings-button" tabindex="-1" @onclick:stopPropagation="true">
            <div class="dialog-heading home-dialog-heading">
                <h2 id="settings-title" tabindex="-1" data-dialog-initial>設定</h2>
                @if (_isSettingsLoading)
                {
                    <div class="home-feedback settings-loading">
                        <ScenarioLoading Label="設定を読込中…" />
                    </div>
                }
                else if (HasFeedback && !_isEditorOpen && !_isDeleteConfirmOpen && (!_isLogLoading || _notification is not null))
                {
                    @notificationContent
                }
            </div>
            <div class="dialog-body">

                <div class="settings-section">
                    <label class="settings-toggle-row">
                        <span>Windows起動時に自動起動（即時反映）</span>
                        <input type="checkbox"
                               checked="@_autoStartEnabled"
                               @onchange="OnAutoStartChangedAsync"
                               disabled="@(_isSettingsLoading || _isAutoStartSaving)" />
                    </label>
                </div>

                @if (OperatingSystem.IsWindows())
                {
                    <div class="settings-section">
                        <PlayRecordingWebSettings />
                    </div>
                }

                <div class="settings-section settings-sync-section">
                    <h3>同期</h3>
                    <div class="settings-sync-grid">
                        <label class="settings-value-row">
                            <span class="settings-value-label">自動コミット間隔（分、0＝追加待ちなし）</span>
                            <input type="number"
                                   min="0"
                                   max="@AppSettings.AutoSyncIntervalMinutesMax"
                                   @bind="_autoCommitIntervalMinutes"
                                   disabled="@(_isSettingsLoading || _isAppSettingsSaving)" />
                        </label>
                        <label class="settings-value-row">
                            <span class="settings-value-label">自動プッシュ間隔（分、0＝追加待ちなし）</span>
                            <input type="number"
                                   min="0"
                                   max="@AppSettings.AutoSyncIntervalMinutesMax"
                                   @bind="_autoPushIntervalMinutes"
                                   disabled="@(_isSettingsLoading || _isAppSettingsSaving)" />
                        </label>
                    </div>
                </div>

                <div class="settings-section">
                    <h3>カード表示</h3>
                    <label class="settings-toggle-row">
                        <span>画像付きカードのタイトルを表示</span>
                        <input type="checkbox"
                               @bind="_showCardTitle"
                               disabled="@(_isSettingsLoading || _isAppSettingsSaving)" />
                    </label>
                    <label class="settings-toggle-row">
                        <span>作品詳細に通常時の同期状態を表示</span>
                        <input type="checkbox"
                               @bind="_showCardSyncStatus"
                               disabled="@(_isSettingsLoading || _isAppSettingsSaving)" />
                    </label>
                </div>

                <div class="settings-section">
                    <button type="button" class="secondary-button home-settings-disclosure"
                            aria-expanded="@(_settingsDetailsOpen ? "true" : "false")" aria-controls="home-settings-details"
                            @onclick="ToggleSettingsDetailsAsync">
                        <CaptureIcon Name="Next" /> 詳細
                    </button>
                </div>
                <div id="home-settings-details" hidden="@(!_settingsDetailsOpen)">
                    <nav class="settings-quick-links" aria-label="設定詳細内の移動">
                        <button type="button" class="secondary-button" @onclick="FocusNotificationHeadingAsync">通知</button>
                        <button type="button" class="secondary-button" @onclick="FocusLogHeadingAsync">ログ</button>
                    </nav>
                    <section class="settings-section settings-sync-section">
                        <h3>同期・ログの調整</h3>
                        <div class="settings-sync-grid">
                            <label class="settings-value-row">
                                <span class="settings-value-label">変更検知の待機（秒）</span>
                                <input type="number"
                                       min="1"
                                       max="300"
                                       @bind="_syncDebounceSeconds"
                                       disabled="@(_isSettingsLoading || _isAppSettingsSaving)" />
                            </label>
                            <label class="settings-value-row">
                                <span class="settings-value-label">再試行の初期待機（秒）</span>
                                <input type="number"
                                       min="1"
                                       max="600"
                                       @bind="_syncRetryInitialSeconds"
                                       disabled="@(_isSettingsLoading || _isAppSettingsSaving)" />
                            </label>
                            <label class="settings-value-row">
                                <span class="settings-value-label">再試行の最大待機（秒）</span>
                                <input type="number"
                                       min="1"
                                       max="3600"
                                       @bind="_syncRetryMaxSeconds"
                                       disabled="@(_isSettingsLoading || _isAppSettingsSaving)" />
                            </label>
                            <label class="settings-value-row">
                                <span class="settings-value-label">通知抑制秒（0で無効）</span>
                                <input type="number"
                                       min="0"
                                       max="600"
                                       @bind="_notificationSuppressSeconds"
                                       disabled="@(_isSettingsLoading || _isAppSettingsSaving)" />
                            </label>
                            <label class="settings-value-row">
                                <span class="settings-value-label">ログ保持（日）</span>
                                <input type="number"
                                       min="1"
                                       max="365"
                                       @bind="_logRetentionDays"
                                       disabled="@(_isSettingsLoading || _isAppSettingsSaving)" />
                            </label>
                            <label class="settings-value-row">
                                <span class="settings-value-label">ログ上限（MB）</span>
                                <input type="number"
                                       min="1"
                                       max="1024"
                                       @bind="_logMaxFileSizeMb"
                                       disabled="@(_isSettingsLoading || _isAppSettingsSaving)" />
                            </label>
                        </div>
                    </section>
                    <section class="settings-section" id="notification-center">
                        <h3 tabindex="-1" @ref="_notificationHeading">通知</h3>
                        <div class="editor-actions">
                            <button type="button"
                                    class="launch-button"
                                    @onclick="CopyNotificationHistoryAsync"
                                    disabled="@(_isSettingsLoading || _notificationHistoryEntries.Count == 0)">
                                全件コピー
                            </button>
                            <button type="button"
                                    class="secondary-button"
                                    @onclick="ClearNotificationHistory"
                                    disabled="@(_isSettingsLoading || _notificationHistoryEntries.Count == 0)">
                                履歴を消去
                            </button>
                        </div>
                        <div class="notification-center-filters">
                            <label>
                                <input type="checkbox"
                                       @bind="_showSuccessNotifications"
                                       disabled="@_isSettingsLoading" />
                                成功を表示
                            </label>
                            <label>
                                <input type="checkbox"
                                       @bind="_showFailedNotifications"
                                       disabled="@_isSettingsLoading" />
                                失敗を表示
                            </label>
                        </div>
                        <div class="notification-center-list" role="log">
                            @{
                                var filteredNotificationEntries = GetFilteredNotificationHistoryEntries();
                            }
                            @if (_notificationHistoryEntries.Count == 0)
                            {
                                <p class="notification-center-empty">通知履歴はありません。</p>
                            }
                            else if (filteredNotificationEntries.Count == 0)
                            {
                                <p class="notification-center-empty">フィルタ条件に一致する通知はありません。</p>
                            }
                            else
                            {
                                @foreach (var entry in filteredNotificationEntries)
                                {
                                    <article class="notification-center-item">
                                        <div class="notification-center-item-header">
                                            <span class="notification-center-time">@FormatNotificationHistoryTimestamp(entry.Timestamp)</span>
                                            <span class="notification-center-type @GetNotificationHistoryTypeClass(entry.IsSuccess)">
                                                @GetNotificationHistoryTypeLabel(entry.IsSuccess)
                                            </span>
                                        </div>
                                        <button type="button" class="home-history-result" aria-haspopup="dialog"
                                                @onclick="() => OpenResultDetails(entry.Summary, entry.Message)">@entry.Summary</button>
                                    </article>
                                }
                            }
                        </div>
                    </section>

                    <section class="settings-section" id="log-viewer">
                        <div class="home-section-heading">
                            <h3 tabindex="-1" @ref="_logHeading">ログ</h3>
                            <div class="settings-actions-row">
                                <button type="button" class="secondary-button" aria-label="最新エラーログを開く" @onclick="OpenLatestErrorLogAsync" disabled="@_isSettingsLoading">最新エラー</button>
                                <button type="button" class="secondary-button" aria-label="ログフォルダを開く" @onclick="OpenLogDirectoryAsync" disabled="@_isSettingsLoading">フォルダ</button>
                            </div>
                        </div>
                        <div class="settings-log-controls">
                            <label class="settings-log-control">
                                <span>表示件数</span>
                                <input type="number"
                                       min="10"
                                       max="500"
                                       @bind="_logViewerLimit"
                                       disabled="@(_isSettingsLoading || _isLogLoading)" />
                            </label>
                            <label class="settings-log-control">
                                <span>レベル</span>
                                <select @bind="_logViewerSeverityFilter"
                                        disabled="@(_isSettingsLoading || _isLogLoading)">
                                    <option value="all">すべて</option>
                                    <option value="Critical">Critical</option>
                                    <option value="Error">Error</option>
                                    <option value="Warning">Warning</option>
                                    <option value="Information">Information</option>
                                    <option value="Debug">Debug</option>
                                    <option value="Trace">Trace</option>
                                </select>
                            </label>
                        </div>
                        <label class="settings-log-keyword">
                            <span>キーワード</span>
                            <input type="text"
                                   @bind="_logViewerKeyword"
                                   @bind:event="oninput"
                                   placeholder="メッセージ / TraceId / repo / command"
                                   disabled="@(_isSettingsLoading || _isLogLoading)" />
                        </label>
                        <div class="editor-actions">
                            <button type="button"
                                    class="launch-button"
                                    @onclick="LoadLogEntriesAsync"
                                    disabled="@(_isSettingsLoading || _isLogLoading)">
                                @(_logViewerError is null ? "更新" : "再試行")
                            </button>
                            <button type="button"
                                    class="secondary-button"
                                    @onclick="CopyLogEntriesAsync"
                                    disabled="@(_isSettingsLoading || _isLogLoading || _logViewerEntries.Count == 0)">
                                コピー
                            </button>
                        </div>
                        <div class="settings-log-list" role="log">
                            @if (_isLogLoading)
                            {
                                <ScenarioLoading Label="ログを読込中…" />
                            }
                            else if (_logViewerError is null && _logViewerEntries.Count == 0)
                            {
                                <p class="settings-log-empty">表示できるログがありません。</p>
                            }
                            else
                            {
                                @foreach (var entry in _logViewerEntries)
                                {
                                    <article class="settings-log-item">
                                        <div class="settings-log-item-header">
                                            <span class="settings-log-time">@FormatLogTimestamp(entry.Timestamp)</span>
                                            <span class="settings-log-level @GetLogLevelClass(entry.Severity)">
                                                @entry.Severity
                                            </span>
                                        </div>
                                        <p class="settings-log-message">@entry.Message</p>
                                        <p class="settings-log-meta">
                                            <span class="settings-log-meta-item">name: @entry.Name</span>
                                            @if (!string.IsNullOrWhiteSpace(entry.TraceId))
                                            {
                                                <span class="settings-log-meta-item">traceId: @entry.TraceId</span>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(entry.RepositoryId))
                                            {
                                                <span class="settings-log-meta-item">repo: @entry.RepositoryId</span>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(entry.Command))
                                            {
                                                <span class="settings-log-meta-item">command: @entry.Command</span>
                                            }
                                            @if (entry.ExitCode.HasValue)
                                            {
                                                <span class="settings-log-meta-item">exitCode: @entry.ExitCode.Value</span>
                                            }
                                        </p>
                                        @if (!string.IsNullOrWhiteSpace(entry.Detail)
                                             || !string.IsNullOrWhiteSpace(entry.StandardOutput)
                                             || !string.IsNullOrWhiteSpace(entry.StandardError))
                                        {
                                            <div class="settings-log-details">
                                                @if (!string.IsNullOrWhiteSpace(entry.Detail))
                                                {
                                                    <details class="settings-log-detail-block">
                                                        <summary>detail</summary>
                                                        <pre class="settings-log-detail">@entry.Detail</pre>
                                                    </details>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(entry.StandardOutput))
                                                {
                                                    <details class="settings-log-detail-block">
                                                        <summary>stdout</summary>
                                                        <pre class="settings-log-detail">@entry.StandardOutput</pre>
                                                    </details>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(entry.StandardError))
                                                {
                                                    <details class="settings-log-detail-block">
                                                        <summary>stderr</summary>
                                                        <pre class="settings-log-detail">@entry.StandardError</pre>
                                                    </details>
                                                }
                                            </div>
                                        }
                                    </article>
                                }
                            }
                        </div>
                    </section>

                </div>
            </div>
            <div class="editor-actions dialog-footer">
                <button type="button"
                        class="launch-button"
                        @onclick="SaveAppSettingsAsync"
                        disabled="@_isSettingsLoading" aria-disabled="@(_isAppSettingsSaving ? "true" : null)">
                    保存
                </button>
                <button type="button"
                        class="secondary-button"
                        @onclick="RequestCloseSettings" data-dialog-dismiss
                        disabled="@(_isSettingsLoading || _isAutoStartSaving || _isAppSettingsSaving || _isCardSizeSaving)">
                    閉じる
                </button>
            </div>
        </section>
    </div>
}

@if (_isDeleteConfirmOpen)
{
    <div class="editor-overlay delete-confirm-overlay" @onclick="() => CloseDeleteConfirm()">
        <section class="delete-confirm-modal" role="dialog" aria-modal="true" aria-labelledby="delete-title delete-game-name" aria-describedby="delete-impact" tabindex="-1" @onclick:stopPropagation="true">
            <div class="dialog-heading home-dialog-heading">
                <h2 id="delete-title">ゲーム登録を削除</h2>
                @if (HasFeedback)
                {
                    @notificationContent
                }
            </div>
            <p class="delete-confirm-title" id="delete-game-name">@_deleteTargetGameTitle</p>
            <div id="delete-impact" class="delete-confirm-note">
                <p>登録設定・セーブリンク設定・サムネイルを削除します。取り消せません。</p>
                <p>ゲーム本体・セーブデータ・リポジトリ・シナリオ履歴は残ります。</p>
                @if (HasEditorChanges())
                {
                    <p>保存していない編集内容も失われます。</p>
                }
            </div>
            <div class="editor-actions">
                <button type="button"
                        class="danger-button"
                        @onclick="DeleteGameAsync"
                        disabled="@_isDeleting">
                    登録を削除
                </button>
                <button type="button"
                        class="secondary-button"
                        @onclick="() => CloseDeleteConfirm()" data-dialog-dismiss data-dialog-initial
                        disabled="@_isDeleting">
                    キャンセル
                </button>
            </div>
        </section>
    </div>
}

@if (_discardChanges is { } discard)
{
    <div class="editor-overlay delete-confirm-overlay" @onclick="CancelDiscardChanges">
        <section class="delete-confirm-modal" role="dialog" aria-modal="true" aria-labelledby="discard-title" aria-describedby="discard-impact" tabindex="-1" @onclick:stopPropagation="true">
            <h2 id="discard-title">@(discard == DraftKind.Game ? "編集を破棄" : "設定を破棄")</h2>
            <p id="discard-impact" class="delete-confirm-note">まだ保存していない変更が失われます。</p>
            <div class="editor-actions">
                <button type="button" class="danger-button" @onclick="ConfirmDiscardChanges">破棄して閉じる</button>
                <button type="button" class="secondary-button" @onclick="CancelDiscardChanges" data-dialog-dismiss data-dialog-initial>変更を続ける</button>
            </div>
        </section>
    </div>
}

@if (_isGitReady && _isEditorOpen)
{
    <div class="editor-overlay" @onclick="RequestCloseEditor">
        <section class="editor-modal" role="dialog" aria-modal="true" aria-labelledby="editor-title-heading" tabindex="-1" @onclick:stopPropagation="true">
            <div class="dialog-heading home-dialog-heading">
                <h2 id="editor-title-heading" tabindex="-1" data-dialog-initial>@(_isEditMode ? $"ゲーム編集：{_editorSavedTitle}" : "ゲーム追加")</h2>
                @if (HasFeedback && !_isDeleteConfirmOpen)
                {
                    @notificationContent
                }
            </div>
            <div class="dialog-body">

                <div class="editor-field">
                    <label for="editor-title">タイトル</label>
                    <input id="editor-title" @bind="_editorTitle" @bind:event="oninput" readonly="@_isSaving" />
                </div>

                @if (_isEditMode && _editingGameId is not null)
                {
                    <div class="editor-field">
                        <CapturePreference @ref="_capturePreference" GameId="@_editingGameId" Disabled="@_isSaving"
                                           ShowError="OpenCapturePreferenceError" />
                    </div>
                }

                <div class="editor-field">
                    <label for="editor-executable-path">実行ファイル</label>
                    <div class="editor-inline-input">
                        <input id="editor-executable-path" @bind="_editorExecutablePath" @bind:event="oninput" readonly="@(_isSaving || _isEditorPickingPath)" />
                        <button type="button" class="secondary-button picker-button" aria-label="実行ファイルを選択" @onclick="PickExecutablePathAsync" disabled="@IsEditorOperationBusy">
                            選択
                        </button>
                    </div>
                </div>

                <div class="editor-field">
                    <h3>サムネイル</h3>
                    <div class="single-repo-picker">
                        <p class="single-repo-value">@GetThumbnailEditorLabel()</p>
                        <div class="single-repo-actions">
                            <button type="button"
                                    class="secondary-button picker-button"
                                    @onclick="PickThumbnailPathAsync"
                                    aria-label="サムネイルを選択"
                                    disabled="@_isSaving">
                                選択
                            </button>
                            <button type="button"
                                    class="secondary-button picker-button"
                                    @onclick="ClearThumbnailSelection"
                                    aria-label="サムネイルを解除"
                                    disabled="@(!CanClearThumbnailSelection() || _isSaving)">
                                解除
                            </button>
                        </div>
                    </div>
                </div>

                <div class="editor-field">
                    <h3>関連リポジトリ</h3>
                    <div class="single-repo-picker">
                        <p class="single-repo-value">
                            @(string.IsNullOrWhiteSpace(_editorRepositoryPath) ? "未設定" : _editorRepositoryPath)
                        </p>
                        <div class="single-repo-actions">
                            <button type="button"
                                    class="secondary-button picker-button"
                                    @onclick="PickRepositoryDirectoryPathAsync"
                                    aria-label="関連リポジトリを選択"
                                    disabled="@IsEditorOperationBusy">
                                選択
                            </button>
                            <button type="button"
                                    class="secondary-button picker-button"
                                    @onclick="ClearRepositoryPath"
                                    aria-label="関連リポジトリを解除"
                                    disabled="@(IsEditorOperationBusy || string.IsNullOrWhiteSpace(_editorRepositoryPath))">
                                解除
                            </button>
                        </div>
                    </div>
                </div>

                <div class="editor-field">
                    <h3>セーブリンク</h3>
                    <p class="settings-note">リンクを削除して保存すると、同期先データをローカル通常フォルダへ復元してリンク解除します。</p>
                    <div class="save-link-editor">
                        @if (_editorSaveLinks.Count == 0)
                        {
                            <p class="save-link-empty">未設定</p>
                        }
                        else
                        {
                            @for (var index = 0; index < _editorSaveLinks.Count; index++)
                            {
                                var currentIndex = index;
                                var entry = _editorSaveLinks[index];
                                <div class="save-link-item">
                                    <p class="save-link-item-title">リンク @(currentIndex + 1)</p>
                                    <p class="save-link-item-label">ローカルフォルダ</p>
                                    <p class="save-link-item-value">@GetEditorSaveLinkPathLabel(entry.LocalPath)</p>
                                    <p class="save-link-item-label">同期先フォルダ</p>
                                    <p class="save-link-item-value">@GetEditorSaveLinkPathLabel(entry.TargetPath)</p>
                                    <label class="save-link-item-checkbox">
                                        <input type="checkbox"
                                               checked="@entry.EnsureOnLaunch"
                                               @onchange="args => SetEditorSaveLinkEnsureOnLaunch(currentIndex, ParseCheckboxValue(args))"
                                               disabled="@_isSaving" />
                                        <span>起動前チェック対象</span>
                                    </label>
                                    <div class="single-repo-actions">
                                        <button type="button"
                                                class="secondary-button picker-button"
                                                @onclick="() => PickEditorSaveLocalPathAsync(currentIndex)"
                                                disabled="@_isSaving">
                                            ローカル選択
                                        </button>
                                        <button type="button"
                                                class="secondary-button picker-button"
                                                @onclick="() => PickEditorSaveTargetPathAsync(currentIndex)"
                                                disabled="@_isSaving">
                                            同期先選択
                                        </button>
                                        <button type="button"
                                                class="secondary-button picker-button"
                                                @onclick="() => MoveEditorSaveLink(currentIndex, -1)"
                                                aria-label="@($"リンク {currentIndex + 1} を上へ移動")"
                                                disabled="@(_isSaving || currentIndex == 0)">
                                            ↑
                                        </button>
                                        <button type="button"
                                                class="secondary-button picker-button"
                                                @onclick="() => MoveEditorSaveLink(currentIndex, 1)"
                                                aria-label="@($"リンク {currentIndex + 1} を下へ移動")"
                                                disabled="@(_isSaving || currentIndex >= _editorSaveLinks.Count - 1)">
                                            ↓
                                        </button>
                                        <button type="button"
                                                class="danger-button picker-button"
                                                @onclick="() => RemoveEditorSaveLink(currentIndex)"
                                                disabled="@_isSaving">
                                            リンク解除
                                        </button>
                                    </div>
                                </div>
                            }
                        }
                    </div>
                    <div class="single-repo-actions">
                        <button type="button"
                                class="secondary-button picker-button"
                                @onclick="AddEditorSaveLink"
                                disabled="@_isSaving">
                            リンク追加
                        </button>
                    </div>
                </div>

            </div>
            <div class="editor-actions dialog-footer">
                <button type="button" class="launch-button" @onclick="SaveEditorAsync"
                        disabled="@(IsEditorOperationBusy || (_editingGameId is { } id && !HasLoadedSaveLinks(id)))">
                    保存
                </button>
                <button type="button" class="secondary-button" @onclick="RequestCloseEditor" disabled="@IsEditorOperationBusy" data-dialog-dismiss>キャンセル</button>
                @if (_isEditMode && !string.IsNullOrWhiteSpace(_editingGameId))
                {
                    <button type="button"
                            class="danger-button home-delete-action home-labeled-action"
                            @onclick="OpenDeleteConfirmForEditingGame"
                            disabled="@(IsEditorOperationBusy || _isDeleting)">
                        <CaptureIcon Name="Trash" /> 登録を削除
                    </button>
                }
            </div>
        </section>
    </div>
}

