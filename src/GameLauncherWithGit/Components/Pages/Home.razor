    private async Task CopyNotificationHistoryAsync()
    {
        if (_notificationHistoryEntries.Count == 0)
        {
            SetNotification("コピー対象の通知履歴がありません。", false, addToHistory: false);
            return;
        }

        await RunWithUserOperationLoadingAsync(
            "通知履歴をコピーしています...",
            async () =>
            {
                var lines = _notificationHistoryEntries
                    .Select(entry =>
                        $"{FormatNotificationHistoryTimestamp(entry.Timestamp)} [{GetNotificationHistoryTypeLabel(entry.IsSuccess)}] {entry.Message}")
                    .ToArray();

                try
                {
                    await Clipboard.Default.SetTextAsync(string.Join(Environment.NewLine, lines));
                    SetNotification("通知履歴をコピーしました。", true, addToHistory: false);
                }
                catch (Exception ex)
                {
                    SetNotification($"通知履歴のコピーに失敗しました: {ex.Message}", false, addToHistory: false);
                }
            });
    }

    private void ClearNotificationHistory()
    {
