    /// <summary>Persists the selected card's pin, reloads its order, and returns focus to its action.</summary>
    private async Task TogglePinnedAsync(GameCardItem game)
    {
        if (string.IsNullOrWhiteSpace(game.Id) || !_pinningGameIds.Add(game.Id))
        {
            return;
        }

        var nextPinned = !game.IsPinned;
        await RunWithUserOperationLoadingAsync(
            nextPinned ? "ピン留めを更新しています..." : "ピン留め解除を更新しています...",
            async () =>
            {
                try
                {
                    await GameLibraryService.SetPinnedAsync(game.Id, nextPinned);
                    var loaded = await ReloadGamesAsync();
                    SetNotification(
                        !loaded ? $"「{game.Title}」のピン留め設定は保存しました。一覧の再読込に失敗しました。" : nextPinned
                            ? $"ピン留めしました: {game.Title}"
                            : $"ピン留めを解除しました: {game.Title}",
                        loaded, summary: "ピン留め更新", targetId: game.Id);
                }
                catch (Exception ex)
                {
                    SetNotification($"ピン留め更新に失敗しました: {ex.Message}", false, summary: "ピン留め更新", targetId: game.Id);
                }
                finally
                {
                    // Restore after the button is enabled and the new sort order has rendered.
                    _pinningGameIds.Remove(game.Id);
                    _focusPinId = game.Id;
                }
            });
    }

    private static string? NormalizeRepositoryKey(string? repositoryPath)
    {
        if (string.IsNullOrWhiteSpace(repositoryPath))
        {
            return null;
        }

        try
        {
            var normalized = Path.GetFullPath(repositoryPath.Trim());
            return Directory.Exists(normalized) ? normalized : null;
        }
        catch
        {
            return null;
        }
    }

    private static string? NormalizeRepositoryPath(string? repositoryPath)
    {
        if (string.IsNullOrWhiteSpace(repositoryPath))
        {
            return null;
        }

        try
        {
            return Path.TrimEndingDirectorySeparator(Path.GetFullPath(repositoryPath.Trim()));
        }
        catch
        {
            return null;
        }
    }

