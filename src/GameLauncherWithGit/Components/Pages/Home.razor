            GitRepositoryVisualState.Behind => "git-state-behind",
            GitRepositoryVisualState.Diverged => "git-state-diverged",
            GitRepositoryVisualState.Error => "git-state-error",
            GitRepositoryVisualState.NotConfigured => "git-state-not-configured",
            _ => "git-state-unknown"
