@page "/"
@implements IDisposable
@inject IGameLibraryService GameLibraryService
@inject ILauncherService LauncherService
@inject IPathPickerService PathPickerService
@inject IGitService GitService
@inject IAutoStartService AutoStartService
@inject IAppSettingsService AppSettingsService
@inject ILogAccessService LogAccessService
@inject IRepositoryWatcherService RepositoryWatcherService
@inject ISyncOrchestrator SyncOrchestrator
@inject IRepositoryStateStore RepositoryStateStore
@inject ISettingsPanelService SettingsPanelService

<PageTitle>GameLauncherWithGit</PageTitle>

@if (!_isStartupChecking)
{
    <section class="utility-bar">
        <div class="card-size-control">
            <button type="button"
                    class="secondary-button utility-icon-button"
                    title="カードサイズを小さくする"
                    @onclick="DecreaseGameCardSizeAsync"
                    disabled="@(!_isGitReady || _isCardSizeSaving || _gameCardSizePercent <= AppSettings.GameCardSizePercentMin)">
                -
            </button>
            <span class="card-size-label">@_gameCardSizePercent%</span>
            <button type="button"
                    class="secondary-button utility-icon-button"
                    title="カードサイズを大きくする"
                    @onclick="IncreaseGameCardSizeAsync"
                    disabled="@(!_isGitReady || _isCardSizeSaving || _gameCardSizePercent >= AppSettings.GameCardSizePercentMax)">
                +
            </button>
        </div>
        <button type="button"
                class="secondary-button utility-button"
                @onclick="OpenSettingsAsync">
            環境設定
        </button>
    </section>
}

@if (_isStartupChecking)
{
    <section class="library-page startup-check-panel">
        <p>起動要件を確認しています...</p>
    </section>
}
else if (!_isGitReady)
{
    <section class="startup-error-panel">
        <h1>Git が利用できません</h1>
        <p>Git のインストールまたは PATH 設定を確認してから、アプリを再起動してください。</p>
        @if (!string.IsNullOrWhiteSpace(_startupError))
        {
            <p class="startup-error-detail">@_startupError</p>
        }
    </section>
}
else
{
    <section class="library-page">
        <div class="game-grid" style="@GetGameGridStyle()">
            <button type="button" class="game-card add-card" @onclick="OpenCreateEditor">
                <span class="add-icon">+</span>
                <span class="add-label">新規追加</span>
            </button>

            @if (_games is null)
            {
                <div class="game-card loading-card">読み込み中...</div>
            }
            else
            {
                @foreach (var game in _games)
                {
                    var effectiveStatus = GetEffectiveStatus(game);
                    var hasThumbnail = HasThumbnail(game);
                    var thumbnailDataUri = hasThumbnail ? GetThumbnailDataUri(game) : null;
                    <article class="game-card @(hasThumbnail ? "thumbnail-mode-card" : string.Empty)">
                        @if (hasThumbnail)
                        {
                            <div class="game-thumbnail-panel">
                                @if (string.IsNullOrWhiteSpace(thumbnailDataUri))
                                {
                                    <div class="game-thumbnail-missing" title="@game.Title"></div>
                                }
                                else
                                {
                                    <img class="game-thumbnail-image"
                                         src="@thumbnailDataUri"
                                         alt="@($"{game.Title} サムネイル")" />
                                }
                            </div>
                        }
                        else
                        {
                            <div class="game-card-header">
                                <h2>@game.Title</h2>
                                <span class="status-badge @GetStatusClass(effectiveStatus)">@GetStatusLabel(effectiveStatus)</span>
                            </div>

                            <div class="game-card-body">
                                <p class="meta-label">実行ファイル</p>
                                <p class="meta-value">@game.ExecutablePath</p>
                                <p class="meta-label">関連リポジトリ</p>
                                @if (string.IsNullOrWhiteSpace(game.RelatedRepositoryPath))
                                {
                                    <p class="meta-value">未設定</p>
                                }
                                else
                                {
                                    <p class="meta-value">@game.RelatedRepositoryPath</p>
                                }
                                <p class="meta-label">最終プレイ</p>
                                <p class="meta-value">@FormatLastPlayed(game.LastPlayedAt)</p>
                            </div>
                        }

                        <div class="game-card-actions">
                            <button type="button" class="launch-button" @onclick="() => LaunchAsync(game.Id)">▶ 起動</button>
                            @if (CanResumeRepositorySync(game))
                            {
                                <button type="button"
                                        class="secondary-button"
                                        @onclick="() => ResumeRepositorySyncAsync(game)"
                                        disabled="@IsRepositoryBusy(game)">
                                    再開
                                </button>
                            }
                            <button type="button" class="secondary-button" @onclick="() => OpenEditEditor(game)">設定</button>
                        </div>
                    </article>
                }
            }
        </div>
    </section>
}

<div class="notification-dock" aria-live="polite" aria-atomic="true">
    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <p class="notification-message @GetMessageClass()">@_message</p>
    }
</div>

@if (_isSettingsOpen)
{
    <div class="editor-overlay" @onclick="() => CloseSettings()">
        <section class="settings-modal" @onclick:stopPropagation="true">
            <h2>環境設定</h2>

            <div class="settings-section">
                <label class="settings-toggle-row">
                    <span>Windows起動時に自動起動</span>
                    <input type="checkbox"
                           checked="@_autoStartEnabled"
                           @onchange="OnAutoStartChangedAsync"
                           disabled="@(_isSettingsLoading || _isAutoStartSaving)" />
                </label>
                @if (_isSettingsLoading)
                {
                    <p class="settings-note">設定を読み込み中...</p>
                }
            </div>

            <div class="settings-section">
                <h3>同期・通知設定</h3>
                <label class="settings-toggle-row">
                    <span>変更検知デバウンス秒</span>
                    <input type="number"
                           min="1"
                           max="300"
                           @bind="_syncDebounceSeconds"
                           disabled="@(_isSettingsLoading || _isAppSettingsSaving)" />
                </label>
                <label class="settings-toggle-row">
                    <span>再試行 初期待機秒</span>
                    <input type="number"
                           min="1"
                           max="600"
                           @bind="_syncRetryInitialSeconds"
                           disabled="@(_isSettingsLoading || _isAppSettingsSaving)" />
                </label>
                <label class="settings-toggle-row">
                    <span>再試行 最大待機秒</span>
                    <input type="number"
                           min="1"
                           max="3600"
                           @bind="_syncRetryMaxSeconds"
                           disabled="@(_isSettingsLoading || _isAppSettingsSaving)" />
                </label>
                <label class="settings-toggle-row">
                    <span>通知抑制秒（0で無効）</span>
                    <input type="number"
                           min="0"
                           max="600"
                           @bind="_notificationSuppressSeconds"
                           disabled="@(_isSettingsLoading || _isAppSettingsSaving)" />
                </label>
                <label class="settings-toggle-row">
                    <span>ログ保持日数</span>
                    <input type="number"
                           min="1"
                           max="365"
                           @bind="_logRetentionDays"
                           disabled="@(_isSettingsLoading || _isAppSettingsSaving)" />
                </label>
                <label class="settings-toggle-row">
                    <span>ログ最大サイズMB</span>
                    <input type="number"
                           min="1"
                           max="1024"
                           @bind="_logMaxFileSizeMb"
                           disabled="@(_isSettingsLoading || _isAppSettingsSaving)" />
                </label>
                <div class="editor-actions">
                    <button type="button"
                            class="launch-button"
                            @onclick="SaveAppSettingsAsync"
                            disabled="@(_isSettingsLoading || _isAppSettingsSaving)">
                        @(_isAppSettingsSaving ? "保存中..." : "設定を保存")
                    </button>
                </div>
            </div>

            <div class="settings-section settings-actions-row">
                <button type="button"
                        class="secondary-button"
                        @onclick="OpenLatestErrorLogAsync"
                        disabled="@_isSettingsLoading">
                    最新エラーログを開く
                </button>
                <button type="button"
                        class="secondary-button"
                        @onclick="OpenLogDirectoryAsync"
                        disabled="@_isSettingsLoading">
                    ログフォルダを開く
                </button>
            </div>

            <div class="settings-section">
                <h3>ログビューア</h3>
                <div class="settings-log-controls">
                    <label class="settings-log-control">
                        <span>表示件数</span>
                        <input type="number"
                               min="10"
                               max="500"
                               @bind="_logViewerLimit"
                               disabled="@(_isSettingsLoading || _isLogLoading)" />
                    </label>
                    <label class="settings-log-control">
                        <span>レベル</span>
                        <select @bind="_logViewerSeverityFilter"
                                disabled="@(_isSettingsLoading || _isLogLoading)">
                            <option value="all">すべて</option>
                            <option value="Critical">Critical</option>
                            <option value="Error">Error</option>
                            <option value="Warning">Warning</option>
                            <option value="Information">Information</option>
                            <option value="Debug">Debug</option>
                            <option value="Trace">Trace</option>
                        </select>
                    </label>
                </div>
                <label class="settings-log-keyword">
                    <span>キーワード</span>
                    <input type="text"
                           @bind="_logViewerKeyword"
                           @bind:event="oninput"
                           placeholder="メッセージ / TraceId"
                           disabled="@(_isSettingsLoading || _isLogLoading)" />
                </label>
                <div class="editor-actions">
                    <button type="button"
                            class="launch-button"
                            @onclick="LoadLogEntriesAsync"
                            disabled="@(_isSettingsLoading || _isLogLoading)">
                        @(_isLogLoading ? "読み込み中..." : "更新")
                    </button>
                    <button type="button"
                            class="secondary-button"
                            @onclick="CopyLogEntriesAsync"
                            disabled="@(_isSettingsLoading || _isLogLoading || _logViewerEntries.Count == 0)">
                        コピー
                    </button>
                </div>
                @if (!string.IsNullOrWhiteSpace(_logViewerError))
                {
                    <p class="settings-log-error">@_logViewerError</p>
                }
                <div class="settings-log-list" role="log">
                    @if (_isLogLoading && _logViewerEntries.Count == 0)
                    {
                        <p class="settings-log-empty">ログを読み込み中です...</p>
                    }
                    else if (_logViewerEntries.Count == 0)
                    {
                        <p class="settings-log-empty">表示できるログがありません。</p>
                    }
                    else
                    {
                        @foreach (var entry in _logViewerEntries)
                        {
                            <article class="settings-log-item">
                                <div class="settings-log-item-header">
                                    <span class="settings-log-time">@FormatLogTimestamp(entry.Timestamp)</span>
                                    <span class="settings-log-level @GetLogLevelClass(entry.Severity)">
                                        @entry.Severity
                                    </span>
                                </div>
                                <p class="settings-log-message">@entry.Message</p>
                                <p class="settings-log-meta">
                                    @entry.Name
                                    @if (!string.IsNullOrWhiteSpace(entry.TraceId))
                                    {
                                        <span> / TraceId: @entry.TraceId</span>
                                    }
                                </p>
                                @if (!string.IsNullOrWhiteSpace(entry.Detail))
                                {
                                    <pre class="settings-log-detail">@entry.Detail</pre>
                                }
                            </article>
                        }
                    }
                </div>
            </div>

            <div class="editor-actions">
                <button type="button"
                        class="secondary-button"
                        @onclick="() => CloseSettings()"
                        disabled="@(_isSettingsLoading || _isAutoStartSaving || _isAppSettingsSaving || _isCardSizeSaving)">
                    閉じる
                </button>
            </div>
        </section>
    </div>
}

@if (_isGitReady && _isEditorOpen)
{
    <div class="editor-overlay" @onclick="() => CloseEditor()">
        <section class="editor-modal" @onclick:stopPropagation="true">
            <h2>@(_isEditMode ? "ゲーム編集" : "ゲーム追加")</h2>

            <div class="editor-field">
                <label for="editor-title">タイトル</label>
                <input id="editor-title" @bind="_editorTitle" @bind:event="oninput" />
            </div>

            <div class="editor-field">
                <label for="editor-executable-path">実行ファイルパス</label>
                <div class="editor-inline-input">
                    <input id="editor-executable-path" @bind="_editorExecutablePath" @bind:event="oninput" />
                    <button type="button" class="secondary-button picker-button" @onclick="PickExecutablePathAsync" disabled="@_isSaving">
                        参照
                    </button>
                </div>
            </div>

            <div class="editor-field">
                <label>サムネイル画像</label>
                <div class="single-repo-picker">
                    <p class="single-repo-value">@GetThumbnailEditorLabel()</p>
                    <div class="single-repo-actions">
                        <button type="button"
                                class="secondary-button picker-button"
                                @onclick="PickThumbnailPathAsync"
                                disabled="@_isSaving">
                            参照
                        </button>
                        <button type="button"
                                class="secondary-button picker-button"
                                @onclick="ClearThumbnailSelection"
                                disabled="@(!CanClearThumbnailSelection() || _isSaving)">
                            解除
                        </button>
                    </div>
                </div>
            </div>

            <div class="editor-field">
                <label>関連リポジトリ（1件のみ）</label>
                <div class="single-repo-picker">
                    <p class="single-repo-value">
                        @(string.IsNullOrWhiteSpace(_editorRepositoryPath) ? "未設定" : _editorRepositoryPath)
                    </p>
                    <div class="single-repo-actions">
                        <button type="button"
                                class="secondary-button picker-button"
                                @onclick="PickRepositoryDirectoryPathAsync"
                                disabled="@_isSaving">
                            フォルダ選択
                        </button>
                        <button type="button"
                                class="secondary-button picker-button"
                                @onclick="ClearRepositoryPath"
                                disabled="@(_isSaving || string.IsNullOrWhiteSpace(_editorRepositoryPath))">
                            解除
                        </button>
                    </div>
                </div>
            </div>

            <div class="editor-actions">
                <button type="button" class="launch-button" @onclick="SaveEditorAsync" disabled="@_isSaving">
                    @(_isSaving ? "保存中..." : "保存")
                </button>
                <button type="button" class="secondary-button" @onclick="() => CloseEditor()" disabled="@_isSaving">キャンセル</button>
            </div>
        </section>
    </div>
}

@code {
    private IReadOnlyList<GameCardItem>? _games;
    private string? _message;
    private bool? _isLastActionSuccess;
    private bool _isEditorOpen;
    private bool _isEditMode;
    private bool _isSaving;
    private string? _editingGameId;
    private string _editorTitle = string.Empty;
    private string _editorExecutablePath = string.Empty;
    private string? _editorRepositoryPath;
    private string? _editorThumbnailSourcePath;
    private bool _editorHasThumbnail;
    private bool _editorClearThumbnail;
    private bool _isSettingsOpen;
    private bool _isSettingsLoading;
    private bool _isAutoStartSaving;
    private bool _isAppSettingsSaving;
    private bool _isCardSizeSaving;
    private bool _autoStartEnabled;
    private int _syncDebounceSeconds = AppSettings.Default.SyncDebounceSeconds;
    private int _syncRetryInitialSeconds = AppSettings.Default.SyncRetryInitialSeconds;
    private int _syncRetryMaxSeconds = AppSettings.Default.SyncRetryMaxSeconds;
    private int _notificationSuppressSeconds = AppSettings.Default.NotificationSuppressSeconds;
    private int _logRetentionDays = AppSettings.Default.LogRetentionDays;
    private int _logMaxFileSizeMb = AppSettings.Default.LogMaxFileSizeMb;
    private int _gameCardSizePercent = AppSettings.Default.GameCardSizePercent;
    private int _logViewerLimit = 100;
    private string _logViewerSeverityFilter = "all";
    private string _logViewerKeyword = string.Empty;
    private bool _isLogLoading;
    private string? _logViewerError;
    private IReadOnlyList<LogViewerEntry> _logViewerEntries = Array.Empty<LogViewerEntry>();
    private bool _isStartupChecking = true;
    private bool _isGitReady = true;
    private string? _startupError;
    private readonly HashSet<string> _registeredWatcherRepositoryIds = new(StringComparer.OrdinalIgnoreCase);
    private readonly Dictionary<string, string> _thumbnailDataUriCache = new(StringComparer.OrdinalIgnoreCase);
    private readonly CancellationTokenSource _stateRefreshCts = new();
    private Task? _stateRefreshTask;

    protected override void OnInitialized()
    {
        SettingsPanelService.OpenRequested += OnSettingsOpenRequested;
    }

    protected override async Task OnInitializedAsync()
    {
        _isStartupChecking = true;
        _isGitReady = true;
        _startupError = null;

        try
        {
            var gitCheckResult = await GitService.RunAsync(AppContext.BaseDirectory, "--version");
            if (!gitCheckResult.IsSuccess)
            {
                _isGitReady = false;
                _startupError = BuildGitStartupError(gitCheckResult);
                UnregisterAllWatchers();
                return;
            }

            await RunStartupLogMaintenanceAsync();
            _ = SyncOrchestrator;
            await ReloadGamesAsync();
            await RefreshRepositoryWatchersAsync();
            StartStateRefreshLoop();
        }
        finally
        {
            _isStartupChecking = false;
        }
    }

    private async Task LaunchAsync(string gameId)
    {
        SetNotification("起動前同期を実行中です...", null);
        StateHasChanged();

        var result = await LauncherService.LaunchAsync(gameId);
        await ReloadGamesAsync();
        SetNotification(result.Message, result.IsSuccess);
    }

    private async Task OpenSettingsAsync()
    {
        _isSettingsOpen = true;
        await LoadSettingsAsync();
    }

    private void CloseSettings(bool force = false)
    {
        if ((_isSettingsLoading || _isAutoStartSaving || _isAppSettingsSaving || _isCardSizeSaving) && !force)
        {
            return;
        }

        _isSettingsOpen = false;
    }

    private async Task LoadSettingsAsync()
    {
        _isSettingsLoading = true;
        try
        {
            _autoStartEnabled = await AutoStartService.IsEnabledAsync();
            ApplyAppSettings(AppSettingsService.Get());
            await LoadLogEntriesAsync();
        }
        catch (Exception ex)
        {
            SetNotification($"設定の読み込みに失敗しました: {ex.Message}", false);
        }
        finally
        {
            _isSettingsLoading = false;
        }
    }

    private async Task OnAutoStartChangedAsync(ChangeEventArgs args)
    {
        var enabled = ParseCheckboxValue(args);
        _isAutoStartSaving = true;

        try
        {
            await AutoStartService.SetEnabledAsync(enabled);
            _autoStartEnabled = enabled;
            SetNotification(enabled ? "自動起動を有効化しました。" : "自動起動を無効化しました。", true);
        }
        catch (Exception ex)
        {
            SetNotification($"自動起動設定の更新に失敗しました: {ex.Message}", false);
            try
            {
                _autoStartEnabled = await AutoStartService.IsEnabledAsync();
            }
            catch
            {
                _autoStartEnabled = false;
            }
        }
        finally
        {
            _isAutoStartSaving = false;
        }
    }

    private async Task SaveAppSettingsAsync()
    {
        _isAppSettingsSaving = true;
        try
        {
            await SaveCurrentAppSettingsAsync();
            SetNotification("設定を保存しました。", true);
        }
        catch (Exception ex)
        {
            SetNotification($"同期・通知設定の保存に失敗しました: {ex.Message}", false);
        }
        finally
        {
            _isAppSettingsSaving = false;
        }
    }

    private void ApplyAppSettings(AppSettings settings)
    {
        var normalized = (settings ?? AppSettings.Default).Normalize();
        _syncDebounceSeconds = normalized.SyncDebounceSeconds;
        _syncRetryInitialSeconds = normalized.SyncRetryInitialSeconds;
        _syncRetryMaxSeconds = normalized.SyncRetryMaxSeconds;
        _notificationSuppressSeconds = normalized.NotificationSuppressSeconds;
        _logRetentionDays = normalized.LogRetentionDays;
        _logMaxFileSizeMb = normalized.LogMaxFileSizeMb;
        _gameCardSizePercent = normalized.GameCardSizePercent;
    }

    private async Task SaveCurrentAppSettingsAsync()
    {
        var requested = new AppSettings(
            SyncDebounceSeconds: _syncDebounceSeconds,
            SyncRetryInitialSeconds: _syncRetryInitialSeconds,
            SyncRetryMaxSeconds: _syncRetryMaxSeconds,
            NotificationSuppressSeconds: _notificationSuppressSeconds,
            LogRetentionDays: _logRetentionDays,
            LogMaxFileSizeMb: _logMaxFileSizeMb,
            GameCardSizePercent: _gameCardSizePercent);
        var normalized = requested.Normalize();

        await AppSettingsService.SaveAsync(normalized);
        ApplyAppSettings(normalized);
    }

    private Task DecreaseGameCardSizeAsync()
    {
        return AdjustGameCardSizeAsync(-10);
    }

    private Task IncreaseGameCardSizeAsync()
    {
        return AdjustGameCardSizeAsync(10);
    }

    private async Task AdjustGameCardSizeAsync(int delta)
    {
        if (_isCardSizeSaving)
        {
            return;
        }

        var next = Math.Clamp(
            _gameCardSizePercent + delta,
            AppSettings.GameCardSizePercentMin,
            AppSettings.GameCardSizePercentMax);
        if (next == _gameCardSizePercent)
        {
            return;
        }

        var previous = _gameCardSizePercent;
        _gameCardSizePercent = next;
        _isCardSizeSaving = true;

        try
        {
            await SaveCurrentAppSettingsAsync();
        }
        catch (Exception ex)
        {
            _gameCardSizePercent = previous;
            SetNotification($"カードサイズ設定の保存に失敗しました: {ex.Message}", false);
        }
        finally
        {
            _isCardSizeSaving = false;
        }
    }

    private string GetGameGridStyle()
    {
        var scale = _gameCardSizePercent / 100d;
        var scaleText = scale.ToString("0.00", global::System.Globalization.CultureInfo.InvariantCulture);
        return $"--game-card-scale:{scaleText};";
    }

    private async Task OpenLatestErrorLogAsync()
    {
        try
        {
            await LogAccessService.OpenLatestErrorLogAsync();
            SetNotification("最新エラーログを開きました。", true);
        }
        catch (Exception ex)
        {
            SetNotification(ex.Message, false);
        }
    }

    private async Task OpenLogDirectoryAsync()
    {
        try
        {
            await LogAccessService.OpenLogDirectoryAsync();
            SetNotification("ログフォルダを開きました。", true);
        }
        catch (Exception ex)
        {
            SetNotification(ex.Message, false);
        }
    }

    private async Task RunStartupLogMaintenanceAsync()
    {
        try
        {
            await LogAccessService.MaintainLogFilesAsync();
        }
        catch (Exception ex)
        {
            SetNotification($"ログメンテナンスに失敗しました: {ex.Message}", false);
        }
    }

    private async Task LoadLogEntriesAsync()
    {
        if (_isLogLoading)
        {
            return;
        }

        _isLogLoading = true;
        _logViewerError = null;

        try
        {
            var severity = ParseLogSeverityFilter(_logViewerSeverityFilter);
            _logViewerEntries = await LogAccessService.GetLatestEntriesAsync(
                _logViewerLimit,
                severity,
                _logViewerKeyword);
        }
        catch (Exception ex)
        {
            _logViewerEntries = Array.Empty<LogViewerEntry>();
            _logViewerError = $"ログ読み込みに失敗しました。詳細: {ex.Message}";
            SetNotification(_logViewerError, false);
        }
        finally
        {
            _isLogLoading = false;
        }
    }

    private async Task CopyLogEntriesAsync()
    {
        if (_logViewerEntries.Count == 0)
        {
            SetNotification("コピー対象のログがありません。", false);
            return;
        }

        var lines = new List<string>(_logViewerEntries.Count * 3);
        foreach (var entry in _logViewerEntries)
        {
            lines.Add($"{FormatLogTimestamp(entry.Timestamp)} [{entry.Severity}] {entry.Message}");
            lines.Add($"name={entry.Name}, traceId={entry.TraceId ?? "n/a"}");
            if (!string.IsNullOrWhiteSpace(entry.Detail))
            {
                lines.Add(entry.Detail);
            }

            lines.Add(string.Empty);
        }

        try
        {
            await Clipboard.Default.SetTextAsync(string.Join(Environment.NewLine, lines));
            SetNotification("ログをクリップボードにコピーしました。", true);
        }
        catch (Exception ex)
        {
            SetNotification($"ログコピーに失敗しました: {ex.Message}", false);
        }
    }

    private static Microsoft.Extensions.Logging.LogLevel? ParseLogSeverityFilter(string? filter)
    {
        if (string.IsNullOrWhiteSpace(filter)
            || string.Equals(filter, "all", StringComparison.OrdinalIgnoreCase))
        {
            return null;
        }

        return Enum.TryParse<Microsoft.Extensions.Logging.LogLevel>(filter, ignoreCase: true, out var severity)
            ? severity
            : null;
    }

    private static string FormatLogTimestamp(DateTimeOffset value)
    {
