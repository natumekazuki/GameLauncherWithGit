@implements IDisposable

<CaptureOccurrenceImages Occurrence="Occurrence" ImageCount="_ids?.Count" ImageIndex="_index"
                         ImageSource="@_source" ImagesLoading="_loading" ImageError="@_error"
                         RetryImages="RetryAsync" MoveImage="MoveAsync" ImageDecodeFailed="DecodeFailed" />

@code {
    /// <summary>The selected raw position and recording root. Remount when the host recording or connection changes.</summary>
    [Parameter, EditorRequired] public CaptureOccurrenceKey Occurrence { get; set; }

    /// <summary>Reads metadata only; the host validates the displayed target before and after each delegate.</summary>
    [Parameter, EditorRequired] public Func<CaptureOccurrenceKey, CancellationToken, Task<IReadOnlyList<string>>> LoadImageIds { get; set; } = default!;

    /// <summary>Reads one image attached to the selected occurrence, never a whole page or flow.</summary>
    [Parameter, EditorRequired] public Func<CaptureOccurrenceKey, string, CancellationToken, Task<byte[]>> ReadImage { get; set; } = default!;

    private CaptureOccurrenceKey? _selection;
    private CancellationTokenSource? _load;
    private IReadOnlyList<string>? _ids;
    private int _index;
    private string? _source;
    private string? _error;
    private bool _loading;

    /// <summary>Starts a fresh gallery only when the selected occurrence changes.</summary>
    protected override Task OnParametersSetAsync()
    {
        if (_selection == Occurrence) return Task.CompletedTask;
        _selection = Occurrence;
        _ids = null;
        _index = 0;
        return LoadAsync(Occurrence);
    }

    /// <summary>Retrieves the list once, then requests bytes only for the displayed image.</summary>
    private async Task LoadAsync(CaptureOccurrenceKey key)
    {
        var previous = _load;
        using var request = new CancellationTokenSource();
        var token = request.Token;
        _load = request;
        previous?.Cancel();
        _loading = true;
        _source = _error = null;
        bool CanPublish() => ReferenceEquals(_load, request) && !token.IsCancellationRequested && _selection == key;
        try
        {
            if (_ids is null)
            {
                // A caller can finish after cancellation even if its store cannot cancel physical I/O.
                var ids = await LoadImageIds(key, token);
                if (!CanPublish()) return;
                _ids = ids;
            }
            if (_ids.Count == 0) return;
            var png = await ReadImage(key, _ids[_index], token);
            if (CanPublish()) _source = "data:image/png;base64," + Convert.ToBase64String(png);
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested)
        {
            // Selection or disposal superseded this request.
        }
        catch (Exception)
        {
            // Only the active selection owns the recoverable error.
            if (CanPublish()) _error = "画像を読み込めませんでした。";
        }
        finally
        {
            if (CanPublish())
            {
                _load = null;
                _loading = false;
            }
        }
    }

    /// <summary>Retries the selected frame, or its metadata if the list could not be read.</summary>
    private Task RetryAsync(CaptureOccurrenceKey key) =>
        key == _selection ? LoadAsync(key) : Task.CompletedTask;

    /// <summary>Retains the metadata and reads just the newly selected image.</summary>
    private Task MoveAsync((CaptureOccurrenceKey Occurrence, int Direction) action)
    {
        if (action.Occurrence != _selection || _ids is not { Count: > 0 } ids) return Task.CompletedTask;
        var index = Math.Clamp(_index + action.Direction, 0, ids.Count - 1);
        if (index == _index) return Task.CompletedTask;
        _index = index;
        return LoadAsync(action.Occurrence);
    }

    /// <summary>Reports a browser decode failure only for the currently displayed frame.</summary>
    private void DecodeFailed((CaptureOccurrenceKey Occurrence, string Source) failed)
    {
        if (failed.Occurrence != _selection || failed.Source != _source) return;
        _source = null;
        _error = "画像を表示できませんでした。";
    }

    /// <summary>Prevents a pending image or error from appearing after the detail leaves the screen.</summary>
    public void Dispose()
    {
        var request = _load;
        _load = null;
        _selection = null;
        request?.Cancel();
    }
}
