@using GameLauncherWithGit.Application.Models
@using GameLauncherWithGit.Infrastructure.Abstractions
@inject IScenarioCaptureStore Store

<div class="capture-preference">
    <label><input type="checkbox" @bind="_enabled" disabled="@(_profile is null || Disabled)" /> シナリオ抽出（次回起動）</label>
    @if (_error is not null) { <p class="capture-preference-error" role="alert">@_error</p> }
</div>

@code {
    [Parameter, EditorRequired] public string GameId { get; set; } = "";
    [Parameter] public bool Disabled { get; set; }
    private CaptureProfile? _profile;
    private string? _loadedGame;
    private bool _enabled = true;
    public bool HasChanges => _profile is not null && _enabled != _profile.Enabled;
    private string? _error;
    protected override async Task OnParametersSetAsync()
    {
        if (_loadedGame == GameId) return;
        _loadedGame = GameId;
        _profile = null; _error = null;
        try { _profile = await Store.GetOrCreateCaptureProfileAsync(GameId); _enabled = _profile.Enabled; }
        catch (Exception ex) { _error = ex.Message; }
    }
    public async Task SaveAsync()
    {
        if (_profile is null) throw new InvalidOperationException("シナリオ抽出設定を読み込めていないため保存できません。");
        if (!HasChanges) return;
        var current = await Store.GetOrCreateCaptureProfileAsync(GameId);
        var updated = current with { Enabled = _enabled };
        await Store.SaveCaptureProfileAsync(updated); _profile = updated;
    }
}
