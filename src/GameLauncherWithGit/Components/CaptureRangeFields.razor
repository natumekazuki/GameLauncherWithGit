<label>名前<input value="@Name" @onchange="ChangeNameAsync" disabled="@Disabled" /></label>
<CaptureTagsEditor Label="区間タグ" Tags="@Tags" TagsChanged="@TagsChanged" AvailableTags="@AvailableTags"
                   SuggestedTags="@SuggestedTags" Disabled="@Disabled" />

@code {
    [Parameter] public string Name { get; set; } = "";
    [Parameter] public EventCallback<string> NameChanged { get; set; }
    [Parameter] public string[] Tags { get; set; } = [];
    [Parameter] public EventCallback<string[]> TagsChanged { get; set; }
    [Parameter] public IReadOnlyList<string> AvailableTags { get; set; } = [];
    [Parameter] public IReadOnlyList<string> SuggestedTags { get; set; } = [];
    [Parameter] public bool Disabled { get; set; }

    private Task ChangeNameAsync(ChangeEventArgs e) => NameChanged.InvokeAsync(e.Value?.ToString() ?? "");
}
